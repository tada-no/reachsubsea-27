  }
  .charter-timeline__status p {
    margin: 0;
  }
  /* ── Footnotes: the client PDF's fine print, visible under the chart ──────────────────── */
  .charter-timeline__mark {
    margin-left: 0.15em;
    font-size: var(--wp--preset--font-size--caption);
    line-height: var(--wp--custom--line-height--tight);
    font-weight: var(--wp--custom--font-weight--bold);
    color: var(--wp--custom--color--text--accent);
  }
  .charter-timeline__notes {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
    max-width: var(--wp--style--global--content-size);
    margin: 0;
    padding: var(--wp--preset--spacing--24) 0 0;
    list-style: none;
    color: var(--wp--custom--color--text--secondary);
  }
  .charter-timeline__footnote {
    display: grid;
    grid-template-columns: var(--wp--preset--spacing--16) minmax(0, 1fr);
    gap: var(--wp--preset--spacing--4);
  }
  .charter-timeline__footnote-mark {
    font-weight: var(--wp--custom--font-weight--bold);
