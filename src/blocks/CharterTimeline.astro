  /* 900–1279: the name column takes 5 columns, so "Mar 2023 – Mar 2027, 2 × 1-year options" stays on one line and
     every row keeps the same height (the staircase reads by rhythm); the plot keeps 7 (about 120px a year) */
  @media (min-width: 900px) and (max-width: 1279px) {
    .charter-timeline__head,
    .charter-timeline__group-title,
    .charter-timeline__facts {
      grid-column: 1 / span 5;
    }
    .charter-timeline__plot,
    .charter-timeline__status {
      grid-column: 6 / -1;
    }
  }

  /* ── Below 900: the plot runs full width under each name ──────────────────────────── */
  @media (max-width: 899px) {
    .charter-timeline__head,
    .charter-timeline__group-title,
    .charter-timeline__plot,
    .charter-timeline__facts,
    .charter-timeline__status {
      grid-column: 1 / -1;
    }
    .charter-timeline__group-head > .charter-timeline__plot {
      display: none;
    }
    /* Chevron top right (Ross, 7 Oct 2026), as the Accordion: the name, period, bar and open detail then share
       one left edge with the full-width plot. From 900 it stays left, where the right end meets the plot */
    .charter-timeline__toggle {
      justify-content: space-between;
      padding-bottom: var(--wp--preset--spacing--12);
    }
    .charter-timeline__chevron {
      order: 2;
    }
    .charter-timeline__label {
      flex: 1;
    }
    .charter-timeline__facts {
      padding-left: 0;
    }
    .charter-timeline__row > .charter-timeline__plot {
      height: calc(var(--charter-bar) + var(--wp--preset--spacing--8) * 2);
      margin-bottom: var(--wp--preset--spacing--16);
    }
  }
</style>

<script>
  // Rows open on a click anywhere in the row (the name is the real button, for keyboards and screen readers).
  function setOpen(row: Element, open: boolean) {
    row.classList.toggle('is-open', open);
    row.querySelector('[data-charter-toggle]')?.setAttribute('aria-expanded', String(open));
  }

  function syncAll(chart: Element) {
    const rows = [...chart.querySelectorAll('[data-charter-row]')];
    const allOpen = rows.every((r) => r.classList.contains('is-open'));
    const button = chart.querySelector('[data-charter-all]');
    button?.setAttribute('aria-pressed', String(allOpen));
    button?.querySelectorAll('[data-when]').forEach((l) => l.toggleAttribute('aria-hidden', (l as HTMLElement).dataset.when !== (allOpen ? 'open' : 'closed')));
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const all = target.closest('[data-charter-all]');
    if (all) {
      const chart = all.closest('[data-charter-chart]')!;
      const open = all.getAttribute('aria-pressed') !== 'true';
      chart.querySelectorAll('[data-charter-row]').forEach((r) => setOpen(r, open));
      syncAll(chart);
      return;
    }
    const row = target.closest('[data-charter-row]');
    if (!row || target.closest('a, .charter-timeline__detail')) return;
    setOpen(row, !row.classList.contains('is-open'));
    syncAll(row.closest('[data-charter-chart]')!);
  });

  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const row = id ? document.getElementById(id) : null;
    if (!row?.matches('[data-charter-row]')) return;
    setOpen(row, true);
    syncAll(row.closest('[data-charter-chart]')!);
    row.scrollIntoView({ block: 'center' });
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
