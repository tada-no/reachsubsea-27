---
// CTA band · reach/cta (docs/05 §2.9). Style Band · Inline; Show contact. Max one per page.
// Band: full-width, default Navy; text cols 1–7 (H2 + Lead), 1–2 actions in cols 9–12, bottom-aligned.
// Inline: callout inside the container on bg/tint (or bg/accent-subtle), H4 + Body, actions at the end.
// Panel (17 Sep 2026): the page's closing CTA as a rounded Navy panel inside the container that
// straddles the seam between the last section and the (darker) footer, like the dev site. `background`
// is the colour of the section above it; the lower half is the footer's navy/900.
import BlockSection from '../components/BlockSection.astro';
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import MetaItem from '../components/MetaItem.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { makeId } from '../lib/ids';
import type { ActionField, BlockFields } from '../lib/types';

interface Contact {
  /** Panel only: small label above the name, e.g. "Investor relations". */
  label?: string;
  name: string;
  role?: string;
  phone?: string;
  email?: string;
}

interface Props extends BlockFields {
  style?: 'band' | 'inline' | 'panel';
  title: string;
  text?: string;
  /** 0–2: the first renders as a Button, the second as a Link (override with `type`). */
  actions?: ActionField[];
  showContact?: boolean;
  contact?: Contact;
  /** Inline only: callout ground. */
  calloutBackground?: 'tint' | 'accent';
}

const {
  style = 'band',
  title,
  text,
  actions = [],
  showContact = false,
  contact,
  calloutBackground = 'tint',
  background = style === 'band' ? 'navy' : 'white',
  spacing,
  anchor,
} = Astro.props;

const panel = style === 'panel';
// Panel + contact (18 Sep 2026): message and actions on the left, the person as a quiet card on the
// right, instead of squeezing name, role, phone and email into one wrapping row under the lead.
const panelContact = panel && showContact && Boolean(contact);
const band = style === 'band' || panel;
const titleId = makeId('cta', title);
const shownActions = actions.slice(0, 2);
const telHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
---

<BlockSection
  slug="cta"
  root="cta-band"
  class={panel ? 'cta-band--band cta-band--panel' : `cta-band--${style}`}
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
>
  {panelContact && contact ? (
  <div class="cta-band__inner cta-band__inner--contact has-surface-navy">
    <div class="cta-band__main">
      <div class="cta-band__text">
        <h2 id={titleId} class="cta-band__title text-h2">{title}</h2>
        {text && <p class="cta-band__lead text-lead">{text}</p>}
      </div>
      {shownActions.length > 0 && (
        <div class="cta-band__actions">
          {shownActions.map((action, i) =>
            (action.type ?? (i === 0 ? 'button' : 'link')) === 'button' ? (
              <Button label={action.label} href={action.url} variant={action.buttonStyle ?? 'primary'} />
            ) : (
              <Link label={action.label} href={action.url} action={action.action ?? 'page'} context={action.context} />
            ),
          )}
        </div>
      )}
    </div>
    <address class="cta-band__card">
      {contact.label && <Eyebrow text={contact.label} as="span" />}
      <div class="cta-band__person">
        <p class="text-h4">{contact.name}</p>
        {contact.role && <p class="cta-band__role text-small">{contact.role}</p>}
      </div>
      <div class="cta-band__card-links">
        {contact.email && (
          <a class="cta-band__contact-link" href={`mailto:${contact.email}`}>
            <MetaItem icon="mail" text={contact.email} as="span" />
          </a>
        )}
        {contact.phone && (
          <a class="cta-band__contact-link" href={telHref(contact.phone)}>
            <MetaItem icon="phone" text={contact.phone} as="span" />
          </a>
        )}
      </div>
    </address>
  </div>
  ) : (
  <div class:list={['cta-band__inner', panel && 'has-surface-navy', !band && `cta-band__callout cta-band__callout--${calloutBackground}`]}>
    <div class="cta-band__text">
      <h2 id={titleId} class:list={['cta-band__title', band ? 'text-h2' : 'text-h4']}>{title}</h2>
      {text && <p class:list={['cta-band__lead', band ? 'text-lead' : 'text-body']}>{text}</p>}
      {
        showContact && contact && (
          <address class="cta-band__contact">
            <div class="cta-band__person">
              <p class="text-h5">{contact.name}</p>
              {contact.role && <p class="cta-band__role text-small">{contact.role}</p>}
            </div>
            {contact.phone && (
              <a class="cta-band__contact-link" href={telHref(contact.phone)}>
                <MetaItem icon="phone" text={contact.phone} as="span" />
              </a>
            )}
            {contact.email && (
              <a class="cta-band__contact-link" href={`mailto:${contact.email}`}>
                <MetaItem icon="mail" text={contact.email} as="span" />
              </a>
            )}
          </address>
        )
      }
    </div>
    {
      shownActions.length > 0 && (
        <div class="cta-band__actions">
          {shownActions.map((action, i) =>
            (action.type ?? (i === 0 ? 'button' : 'link')) === 'button' ? (
              <Button label={action.label} href={action.url} variant={action.buttonStyle ?? 'primary'} />
            ) : (
              <Link label={action.label} href={action.url} action={action.action ?? 'page'} context={action.context} />
            ),
          )}
        </div>
      )
    }
  </div>
  )}
</BlockSection>

<style is:global>
  .cta-band__text {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
    min-width: 0;
  }
  .cta-band__lead,
  .cta-band__role {
    color: var(--wp--custom--color--text--secondary);
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--16) var(--wp--preset--spacing--24);
  }

  .cta-band__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--12) var(--wp--preset--spacing--24);
    padding-top: var(--wp--preset--spacing--16);
    font-style: normal;
  }
  .cta-band__contact-link:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Band: 12-column grid, text 1–7, actions 9–12 bottom-aligned */
  .cta-band--band .cta-band__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--wp--custom--grid--gutter);
    align-items: end;
  }
  .cta-band--band .cta-band__text {
    grid-column: 1 / span 7;
  }
  .cta-band--band .cta-band__actions {
    grid-column: 9 / span 4;
    justify-content: flex-end;
  }

  /* Panel: Band's grid inside a rounded Navy panel; the section paints the seam behind it. */
  .cta-band--panel.block {
    padding-block: 0;
    background-image: linear-gradient(to bottom, transparent 50%, var(--wp--preset--color--navy-900) 50%);
  }
  .cta-band--panel .cta-band__inner {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: var(--wp--preset--spacing--64) var(--wp--preset--spacing--64);
    border-radius: var(--wp--custom--radius--xl);
    background-color: var(--wp--custom--color--bg--default);
    box-shadow: var(--wp--preset--shadow--lg);
  }
  .cta-band--panel .cta-band__text {
    grid-column: 1 / span 8;
  }
  .cta-band--panel .cta-band__title {
    color: var(--wp--custom--color--text--accent);
  }
  /* Panel ≥900 (17 Sep 2026): the text takes every column the button doesn't need, so the title
     stays on one line as long as it fits; when it can't, the break is balanced. */
  @media (min-width: 900px) {
    .cta-band--panel .cta-band__inner {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--wp--custom--grid--gutter);
    }
    .cta-band--panel .cta-band__text {
      flex: 1 1 auto;
      min-width: 0;
    }
    .cta-band--panel .cta-band__actions {
      flex: none;
    }
  }
  .cta-band--panel .cta-band__title {
    text-wrap: balance;
  }
  /* Lead size (review round 4, all panels): the H3-sized line competed with the title */
  .cta-band--panel .cta-band__lead {
    color: var(--wp--custom--color--text--primary);
  }
  .cta-band--panel .cta-band__text {
    gap: var(--wp--preset--spacing--4);
  }

  /* Panel + contact */
  .cta-band--panel .cta-band__inner--contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
    align-items: center;
    gap: var(--wp--custom--stack--xl) var(--wp--preset--spacing--64);
  }
  .cta-band__main {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--lg);
    min-width: 0;
  }
  .cta-band--panel .cta-band__inner--contact .cta-band__actions {
    justify-content: flex-start;
  }
  .cta-band__card {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--16);
    padding-left: var(--wp--preset--spacing--48);
    border-left: 1px solid var(--wp--custom--color--border--subtle);
    font-style: normal;
  }
  .cta-band__card .cta-band__person {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
  }
  .cta-band__card-links {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
  }
  @media (max-width: 899px) {
    .cta-band--panel .cta-band__inner--contact {
      grid-template-columns: 1fr;
    }
    .cta-band__card {
      padding: var(--wp--preset--spacing--32) 0 0;
      border-left: 0;
      border-top: 1px solid var(--wp--custom--color--border--subtle);
    }
  }

  /* Inline: callout inside the container */
  .cta-band__callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wp--custom--grid--gutter);
    padding: var(--wp--preset--spacing--48);
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--wp--custom--color--bg--tint);
  }
  .cta-band__callout--accent {
    background-color: var(--wp--custom--color--bg--accent-subtle);
  }
  .cta-band--inline .cta-band__actions {
    flex: none;
  }

  @media (max-width: 899px) {
    .cta-band--band .cta-band__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--wp--custom--stack--xl);
    }
    .cta-band--band .cta-band__actions {
      justify-content: flex-start;
    }
    .cta-band__callout {
      flex-direction: column;
      align-items: stretch;
      gap: var(--wp--custom--stack--md);
    }
    .cta-band--inline .cta-band__actions {
      flex: initial;
    }
  }

  /* Figma Mobile (Band 178:2767, Inline 179:2774, Q41): the CTA is tighter than a standard block —
     48 top and bottom, and the Band insets its own content to 40 (the grid margin is 24). */
  @media (max-width: 599px) {
    .cta-band.block:not(.has-spacing-sm):not(.has-spacing-lg) {
      padding-block: var(--wp--preset--spacing--48);
    }
    .cta-band.cta-band--panel.block:not(.has-spacing-sm):not(.has-spacing-lg) {
      padding-block: 0;
    }
    .cta-band--band:not(.cta-band--panel) .container {
      padding-inline: var(--wp--preset--spacing--40);
    }
    .cta-band--panel .cta-band__inner {
      padding: var(--wp--preset--spacing--40) var(--wp--preset--spacing--32);
      border-radius: var(--wp--custom--radius--lg);
    }
    .cta-band__callout {
      padding: var(--wp--preset--spacing--48) var(--wp--preset--spacing--40);
    }
  }
</style>
