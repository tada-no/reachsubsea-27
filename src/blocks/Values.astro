---
// Values · reach/values (19 Sep 2026, Company › About). Learn · Teach · Reach, after the live site's pinned
// values scroll, rebuilt without GSAP. Split layout (20 Sep 2026, Ross): from 900 up a full-bleed navy band
// (figure 40% · words + copy 60%, 96px between) is pinned under the docked subnav, only as tall as its
// content, while the page scrolls through an invisible runway; scroll only drives the change. The next
// value rises up from below while the last leaves upward (clip + rise, no fades), each costs about a third
// of a viewport of scroll, and the band lets go when the promise has held for one runway. The figure is one
// person who never moves: only what she stands beside (book, board, target) changes, rolling in and out
// with a clip. After the last value the promise ("Everything within Reach.") rises in and the figure keeps
// standing at the target. The step list is the runway (its content hidden) and the accessible content; the
// pinned figure and reel are a decorative copy. Below 900, and without JS, the same content reads as a
// plain list on navy. Reduced motion keeps the state changes and drops the transitions (base.css).
import BlockSection from '../components/BlockSection.astro';
import Pictogram from '../components/Pictogram.astro';
import { makeId } from '../lib/ids';
import type { BlockFields } from '../lib/types';

interface ValueItem {
  word: string;
  text: string;
  pictogram?: string;
}

interface Props extends BlockFields {
  eyebrow?: string;
  /** The section's heading (visually hidden from 900 up, where the words themselves are the headings). */
  title: string;
  values: ValueItem[];
  /** The closing promise: `lead` + the last value's word ("Everything within" + "Reach").
   * `short` is the form the `line` layout sets under the finished line ("Within Reach.", the PDF's heading). */
  promise?: { lead: string; word: string; short?: string };
}

const { eyebrow, title, values = [], promise, background = 'navy', spacing, anchor } = Astro.props;
const titleId = makeId('values', title);
const figure = values[0]?.pictogram;
---

{
  values.length > 0 && (
    <BlockSection slug="values" root="values" background={background} spacing={spacing} anchor={anchor} labelledBy={titleId}>
      <div class="values__layout" data-values data-active="0" style={`--values-count: ${values.length}`}>
        <div class="values__band">
          <div class="values__band-inner">
            <div class="values__head">
              {eyebrow && <p class="values__eyebrow text-eyebrow">{eyebrow}</p>}
              <h2 id={titleId} class="values__title text-h1">{title}</h2>
            </div>

            {/* The pinned band (decorative; the list below carries the content) */}
            {eyebrow && <p class="values__eyebrow values__eyebrow--band text-eyebrow" aria-hidden="true">{eyebrow}</p>}
            <div class="values__grid" aria-hidden="true">
              <p class="values__line">
                {values.map((value, i) => (
                  <span class="values__line-word" data-word={i}>
                    <span class="values__line-clip"><span class="values__line-text">{value.word}.</span></span>
                  </span>
                ))}
              </p>
              <div class="values__figure">
                <div class="values__marks">
                  {figure && <span class="values__person"><Pictogram name={figure} size={320} /></span>}
                  {values.map((value, i) => value.pictogram && (
                    <span class="values__mark" data-mark={i}><Pictogram name={value.pictogram} size={320} /></span>
                  ))}
                </div>
              </div>
              <div class="values__reel">
                <div class="values__items">
                  {values.map((value, i) => (
                    <div class="values__item" data-item={i}>
                      <p class="values__item-text text-lead">{value.text}</p>
                    </div>
                  ))}
                  {promise && (
                    <div class="values__item values__item--promise" data-item={values.length}>
                      <p class="values__item-promise">{promise.short ?? `${promise.lead} ${promise.word}.`}</p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="values__runway">
          <ol class="values__steps">
            {values.map((value, i) => (
              <li class="values__step" data-step={i}>
                {value.pictogram && <Pictogram name={value.pictogram} size={96} class="values__pictogram" />}
                <h3 class="values__step-word text-h2">{value.word}.</h3>
                <p class="values__text text-lead">{value.text}</p>
              </li>
            ))}
          </ol>
          {promise && (
            <div class="values__promise" data-step={values.length} data-promise>
              <p class="values__promise-line text-h2">
                {promise.lead} <strong>{promise.word}.</strong>
              </p>
            </div>
          )}
        </div>
      </div>
    </BlockSection>
  )
}

<style is:global>
  .values {
    --pg-bg: var(--wp--custom--color--bg--default);
    /* The pinned figure's (and reel's) height, the band around them (a full viewport under the subnav, its
       content centred) and the scroll each value costs (about half a viewport: at a third of one the
       values flew past, 20 Sep 2026) */
    --values-h: clamp(300px, 44vh, 400px);
    --values-band: max(calc(var(--values-h) + 156px), calc(100vh - var(--reach-subnav-top, 0px) - 72px));
    --values-run: clamp(420px, 65vh, 680px);
    /* The figure beside the copy: big enough to balance the word line, and tied to the width rather than
       the height, because the word line grows with the width too — at 1100 a height-based size reached back
       into "Reach." (20 Sep 2026) */
    --values-figure: clamp(200px, 21vw, 320px);
  }
  .values__layout {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--xl);
  }
  .values__eyebrow {
    margin: 0;
    color: var(--wp--custom--color--text--accent);
  }
  .values__head {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
  }
  .values__title {
    margin: 0;
  }
  .values__eyebrow--band,
  .values__grid {
    display: none;
  }
  .values__steps {
    display: grid;
    gap: var(--wp--preset--spacing--48);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .values__step {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
  }
  .values__pictogram {
    margin: 0 0 var(--wp--preset--spacing--8) calc(var(--wp--preset--spacing--12) * -1);
  }
  .values__step-word {
    margin: 0;
  }
  .values__text {
    margin: 0;
    max-width: 36rem;
    color: var(--wp--custom--color--text--secondary);
  }
  .values__promise {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--md);
    margin-top: var(--wp--preset--spacing--64);
    padding-top: var(--wp--preset--spacing--32);
    border-top: 1px solid var(--wp--custom--color--border--subtle);
  }
  .values__promise-line {
    margin: 0;
  }
  .values__promise-line strong {
    color: var(--wp--custom--color--text--accent-display);
  }

  /* Tablet: the steps pair up two across under the heading, so the width is used; the promise spans. */
  @media (min-width: 600px) and (max-width: 899px) {
    .values__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--wp--preset--spacing--48) var(--wp--preset--spacing--32);
    }
    .values__step:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* The figure: one person, drawn once (the first pictogram with its subject hidden). The three subjects are
     stacked over it without the person; the one whose state is current rolls in, the others wait above (past)
     or below (future) and roll out the way they came. Persons are identical in all three SVGs. */
  .values__marks svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .values__person,
  .values__mark {
    position: absolute;
    inset: 0;
  }
  .values__person svg > :not(.pg-person) {
    display: none;
  }
  .values__mark svg .pg-person {
    display: none;
  }
  .values__mark {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--wp--custom--motion--ease-in-out);
  }
  .values__mark[data-state='future'] {
    clip-path: inset(100% 0 0 0);
  }
  .values__mark[data-state='current'] {
    clip-path: inset(0 0 0 0);
  }

  /* ── 900 up, live: a navy band pinned under the subnav, an invisible runway under it ── */
  @media (min-width: 900px) {
    /* The section hands its colour to the band and its padding to the runway */
    .wp-block-reach-values.values.is-live {
      padding-block: 0;
      background-color: var(--wp--preset--color--white);
    }
    .wp-block-reach-values.values.is-live > .container {
      max-width: none;
      padding-inline: 0;
    }
    .values.is-live .values__layout {
      display: block;
    }
    .values.is-live .values__band {
      position: sticky;
      top: calc(var(--reach-subnav-top, 0px) + 72px);
      height: var(--values-band);
      display: flex;
      align-items: center;
      background-color: var(--wp--custom--color--bg--default);
      color: var(--wp--custom--color--text--primary);
    }
    .values.is-live .values__band-inner {
      width: 100%;
      max-width: calc(
        var(--wp--style--global--wide-size) + var(--wp--style--root--padding-left) + var(--wp--style--root--padding-right)
      );
      margin-inline: auto;
      padding-inline: var(--wp--style--root--padding-left) var(--wp--style--root--padding-right);
      display: flex;
      flex-direction: column;
      gap: var(--wp--custom--stack--lg);
    }
    .values.is-live .values__head {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .values.is-live .values__eyebrow--band {
      display: block;
    }
    /* The word line runs across the top; under it the copy (and the payoff) on the left, the figure on the
       right, centred in its own column so it is not pinned to the container's edge and balances the type
       (20 Sep 2026, Ross) */
    .values.is-live .values__grid {
      display: grid;
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--wp--preset--spacing--48);
      row-gap: var(--wp--preset--spacing--16);
      align-items: start;
    }
    .values.is-live .values__line {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .values.is-live .values__marks {
      aspect-ratio: 1;
    }

    /* The reel: the current value's words + copy; the next rises from below, the last leaves upward */
    .values__items {
      display: grid;
    }
    .values__item {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      gap: var(--wp--custom--stack--md);
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, -24px, 0);
      transition:
        clip-path 0.7s var(--wp--custom--motion--ease-in-out),
        transform 0.7s var(--wp--custom--motion--ease-in-out);
    }
    .values__item[data-state='future'] {
      clip-path: inset(100% 0 0 0);
      transform: translate3d(0, 24px, 0);
    }
    .values__item[data-state='current'] {
      clip-path: inset(0 0 0 0);
      transform: none;
      transition-delay: 0.12s;
    }
    .values__item p {
      margin: 0;
      color: var(--wp--custom--color--text--primary);
    }
    .values__item-text {
      max-width: 52rem;
      color: var(--wp--custom--color--text--secondary) !important;
    }

    /* Runway: one --values-run per value (and for the promise), starting half a band up so each value
       holds for exactly one runway; its content is visually hidden (the band shows a copy). */
    .values.is-live .values__runway {
      margin-top: calc(var(--values-band) / -2);
      /* Inside the layout's content box (the band stops pinning at its end), so the promise holds a runway */
      padding-bottom: calc(var(--values-band) / 2);
    }
    .values.is-live .values__steps {
      gap: 0;
    }
    .values.is-live :is(.values__step, .values__promise) {
      position: relative;
      min-height: var(--values-run);
      margin: 0;
      padding: 0;
      border: 0;
    }
    .values.is-live :is(.values__step, .values__promise) > * {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  
    /* ── Line layout (20 Sep 2026, Ross): the three words on one line, each arriving as it is reached and
       tinting once it is past; the copy sits under them with the figure; the promise arrives under the
       finished line. Each word holds its place from the start (the clip only hides it), so the line never
       reflows as words arrive. */
    .values.is-live .values__line {
      display: flex;
      flex-wrap: wrap;
      /* No word spaces: the full stops already separate them, and the tighter line leaves the figure room
         (20 Sep 2026, Ross) */
      gap: 0;
      margin: 0;
      line-height: var(--wp--custom--line-height--figure);
      font-weight: var(--wp--custom--font-weight--bold);
      /* The three words stay on one line at every width: Display, but never wider than the container
         allows (the line runs about 15 characters wide, so width / 15 is its largest safe size) */
      font-size: min(
        var(--wp--preset--font-size--display),
        calc((100vw - 2 * var(--wp--style--root--padding-left)) / 15)
      );
    }
    .values.is-live .values__line-word {
      color: var(--wp--custom--color--text--disabled);
      transition: color 0.5s var(--wp--custom--motion--ease-out);
    }
    .values.is-live .values__line-clip {
      display: block;
      overflow: clip;
      overflow-clip-margin: 0.12em;
      padding-bottom: 0.08em;
    }
    .values.is-live .values__line-text {
      display: block;
      transform: translate3d(0, 110%, 0);
      transition: transform 0.6s var(--wp--custom--motion--ease-in-out);
    }
    .values.is-live .values__line-word[data-state='current'],
    .values.is-live .values__line-word[data-state='past'] {
      color: var(--wp--custom--color--text--primary);
    }
    .values.is-live .values__line-word[data-state='past'] {
      color: var(--wp--custom--color--text--disabled);
    }
    .values.is-live .values__line-word:is([data-state='current'], [data-state='past']) .values__line-text {
      transform: none;
    }
    /* Under the line: the copy on the left, under the words it belongs to, and the figure on the right
       (20 Sep 2026, Ross), so the payoff lands directly under Learn · Teach · Reach */
    /* Row 2: the copy (and the payoff) sit straight under the line, so the row is only as tall as the text.
       The figure takes no height of its own (20 Sep 2026, Ross) and is centred on that text, rather than on a
       row its own height had stretched, which had pushed the copy down and left the icon sitting low. */
    .values.is-live .values__reel {
      grid-row: 2;
      grid-column: 1;
      align-self: start;
    }
    .values.is-live .values__figure {
      position: relative;
      /* Spans the word line and the copy, so the figure centres on the whole text block rather than on the
         copy alone, which left it sitting low (20 Sep 2026, Ross) */
      grid-row: 1 / span 2;
      grid-column: 2;
      /* Stretches to the row the copy sets; the figure itself is out of flow, so it adds no height */
      align-self: stretch;
    }
    .values.is-live .values__marks {
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      width: min(100%, var(--values-figure));
    }
    /* The payoff takes the copy's place, in the line's own size and weight */
    .values.is-live .values__item-promise {
      margin: 0;
      line-height: var(--wp--custom--line-height--figure);
      font-weight: var(--wp--custom--font-weight--bold);
      font-size: min(
        var(--wp--preset--font-size--display),
        calc((100vw - 2 * var(--wp--style--root--padding-left)) / 15)
      );
      color: var(--wp--custom--color--text--primary);
    }
    .values.is-live .values__item-text {
      max-width: 44rem;
    }
    .values.is-live .values__band-inner {
      gap: var(--wp--custom--stack--md);
    }
  }
</style>

<script>
  // Stage state: which value is at the middle of the pinned band. Derived from the scroll position rather
  // than from an IntersectionObserver: a fling crosses a 1px line between frames, so the observer skipped
  // Teach and Reach and the reel jumped straight from Learn to the promise (20 Sep 2026). Reading the
  // runway's own offsets can't skip a state, and a fling simply lands on the value it stops at. Every figure
  // subject gets a state (past · current · future) so it can roll away the way it came; the promise counts
  // as one step past the last value, and the figure keeps standing at the last subject without replaying it.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-values]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const count = steps.filter((s) => !s.hasAttribute('data-promise')).length;
    const marks = [...root.querySelectorAll<HTMLElement>('[data-mark]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const words = [...root.querySelectorAll<HTMLElement>('[data-word]')];
    const section = root.closest<HTMLElement>('.values');
    const band = root.querySelector<HTMLElement>('.values__band');
    if (steps.length === 0 || !band) return;
    root.classList.add('is-live');
    section?.classList.add('is-live');

    let current = -1;
    const setState = (i: number) => {
      if (i === current) return;
      const first = current === -1;
      current = i;
      const at = Math.min(i, count - 1);
      root.classList.toggle('is-promise', i >= count);
      root.dataset.active = String(at);
      steps.forEach((step, n) => step.classList.toggle('is-current', n === i));
      marks.forEach((mark) => {
        const n = Number(mark.dataset.mark);
        mark.dataset.state = n < at ? 'past' : n > at ? 'future' : 'current';
      });
      words.forEach((word) => {
        const n = Number(word.dataset.word);
        word.dataset.state = n < i ? 'past' : n > i ? 'future' : 'current';
      });
      items.forEach((item) => {
        const n = Number(item.dataset.item);
        item.dataset.state = n < i ? 'past' : n > i ? 'future' : 'current';
      });
      if (reduce || first) return;
      steps[i]?.querySelector('.pictogram--live')?.classList.add('is-playing');
      // The figure stays at the target through the promise, so nothing replays there
      if (i < count) root.querySelector(`[data-mark="${i}"] .pictogram--live`)?.classList.add('is-playing');
    };
    setState(0);

    // Each step's top in page coordinates, and the line the change happens on: the middle of the pinned
    // band (its sticky `top` + half its height), or the middle of the viewport before it pins.
    let tops: number[] = [];
    let centre = 0;
    const measure = () => {
      tops = steps.map((step) => step.getBoundingClientRect().top + window.scrollY);
      const style = getComputedStyle(band);
      centre = style.position === 'sticky' ? parseFloat(style.top) + band.offsetHeight / 2 : window.innerHeight / 2;
    };
    const update = () => {
      const line = window.scrollY + centre;
      let i = 0;
      for (let n = 0; n < tops.length; n++) if (line >= tops[n]) i = n;
      setState(i);
    };
    let frame = 0;
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; update(); });
    };
    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    let resizing = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizing);
      resizing = window.setTimeout(() => { measure(); update(); }, 150);
    });
    // Late layout shifts (fonts, images above the section) move the runway under the line
    window.addEventListener('load', () => { measure(); update(); });
  });
</script>
