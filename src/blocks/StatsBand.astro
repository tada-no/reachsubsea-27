---
// Stats band · reach/stats (docs/05 §2.5). Count 3 · 4 × Style Plain · Panel. Optional Section header,
// Stat Large, Align Start (Center when the header is centred). 1px border/subtle rules between stats:
// vertical on desktop, none for a 4-stat mobile 2×2 grid, horizontal for a 3-stat mobile column.
// Panel = white panel in flow (bg/default, Light forced, radius lg, Shadow/sm).
// Feature (17 Sep 2026, proposal v2): one figure leads in a navy tile, the others sit beside it as equal
// columns with a rule between, all sharing one bottom line with the lead's label. Stacks below 900.
// Results (18 Sep 2026, Why invest): the latest reported quarter. Title + "As reported" badge + date,
// 4 headline figures (unit · value · scale, change line) over a 2px navy rule, 4 secondary figures in
// a ruled row, then the next report date (add to calendar, .ics) and the report downloads. Reads the
// Latest results options page (src/data/investor-results.ts). Replaces the PDF's overlapping card.
// Max one Stats band per page (docs/05 §0).
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stat from '../components/Stat.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import Link from '../components/Link.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, LinkField, SectionHeaderField, StatField } from '../lib/types';

interface Props extends BlockFields {
  sectionHeader?: SectionHeaderField;
  style?: 'plain' | 'panel' | 'feature' | 'results';
  /** Feature style: key of the figure that leads. Defaults to the first. */
  featureKey?: string;
  /** 3–4 figures; count is derived from the length. */
  stats: StatField[];
  /** Defaults to Center when the section header is centred, Start otherwise. */
  align?: 'start' | 'center';
  /** Stats enter one by one and count up from 0 when the band scrolls into view (17 Sep 2026). */
  animate?: boolean;
  /** Results style: ISO publication date, the secondary figures, the report downloads and the next report. */
  published?: string;
  /** Results style: stated once in the stamp ("All figures in NOK"), never on each figure. */
  currency?: string;
  secondary?: StatField[];
  /** Results style: 0–2 PDF downloads (latest quarterly report, annual report), one line of meta each. */
  documents?: (LinkField & { meta?: string })[];
  next?: { label: string; date: string };
  class?: string;
}

const {
  sectionHeader,
  style = 'plain',
  featureKey,
  stats,
  align,
  animate = false,
  published,
  currency,
  secondary = [],
  documents = [],
  next,
  background,
  spacing,
  anchor,
  class: className,
} = Astro.props;

const panel = style === 'panel';
const feature = style === 'feature';
const results = style === 'results';
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const nextDate = next ? new Date(`${next.date}T12:00:00Z`) : undefined;
// One all-day event. Editors only set the label and date; the file is generated.
const icsHref = next
  ? 'data:text/calendar;charset=utf-8,' +
    encodeURIComponent(
      [
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Reach Subsea//Investors//EN', 'BEGIN:VEVENT',
        `UID:${next.date}-results@reachsubsea.com`, `DTSTAMP:${next.date.replace(/-/g, '')}T000000Z`,
        `DTSTART;VALUE=DATE:${next.date.replace(/-/g, '')}`, `SUMMARY:Reach Subsea ${next.label}`,
        'END:VEVENT', 'END:VCALENDAR',
      ].join('\r\n'),
    )
  : undefined;
const leadIndex = Math.max(0, featureKey ? stats.findIndex((s) => s.key === featureKey) : 0);
const lead = stats[leadIndex];
const rest = stats.filter((_, i) => i !== leadIndex);
const count = stats.length;
const alignment = align ?? (sectionHeader?.align === 'center' ? 'center' : 'start');
const titleId = sectionHeader ? makeId('stats', sectionHeader.title) : undefined;
const rootClass = [`stats-band--${style}`, `stats-band--count-${count}`, animate && 'stats-band--animate', className].filter(Boolean).join(' ');
const STAT_STAGGER = 160;
---

{
  count > 0 && (
    <BlockSection
      slug="stats"
      root="stats-band"
      class={rootClass}
      background={background}
      spacing={spacing}
      anchor={anchor}
      labelledBy={titleId}
      label={titleId ? undefined : 'Key figures'}
    >
      <div class="stats-band__body">
        {sectionHeader && !results && <SectionHeader {...sectionHeader} align={alignment} id={titleId} />}
        {results ? (
          <div class="stats-band__group stats-band__results">
            <div class="results__top">
              <div class="results__title">
                {sectionHeader && <h2 id={titleId} class="text-h2">{sectionHeader.title}</h2>}
                {currency && <p class="results__currency text-small">All figures in {currency}</p>}
              </div>
              {published && (
                <p class="results__stamp text-small">
                  <Badge label="As reported" tone="accent" />
                  <span>Published <time datetime={published}>{longDate(published)}</time></span>
                </p>
              )}
            </div>
            <ul class="results__headline">
              {stats.map((stat, i) => (
                <li class="results__item" style={`--stat-i: ${i}`}>
                  <p class="results__label text-small">{stat.label}</p>
                  {/* The scale ("m", "bn") is part of the counted text, so it always sits hard against the digits */}
                  <p class="results__value">
                    {stat.unit && <span class="results__unit">{stat.unit}</span>}
                    {animate ? (
                      <span data-count-up data-count-up-delay={150 + i * STAT_STAGGER}>{stat.value}{stat.suffix}</span>
                    ) : (
                      `${stat.value}${stat.suffix ?? ''}`
                    )}
                  </p>
                  {stat.delta && (
                    <p class:list={['results__delta text-small', stat.trend && `results__delta--${stat.trend}`]}>
                      {stat.trend && <Icon name={stat.trend === 'up' ? 'arrow-up-right' : 'arrow-down-right'} size={16} />}
                      {stat.delta}
                    </p>
                  )}
                </li>
              ))}
            </ul>
            {secondary.length > 0 && (
              <dl class="results__secondary">
                {secondary.map((stat) => (
                  <div class="results__row">
                    <dt class="text-small">{stat.label}</dt>
                    <dd class="text-h4">{stat.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {(next || documents.length > 0) && (
              <div class="results__footer">
                {next && nextDate && (
                  <div class="results__doc">
                    <span class="results__tile" aria-hidden="true">
                      <span class="results__tile-band">{nextDate.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' })}</span>
                      <span class="results__tile-body">{nextDate.getUTCDate()}</span>
                    </span>
                    <div class="results__doc-text">
                      <h3 class="text-h4">{next.label}</h3>
                      <p class="text-small">Next report · <time datetime={next.date}>{longDate(next.date)}</time></p>
                      <Link label="Add to calendar" href={icsHref} action="file" size="small" context={next.label} download={`reach-subsea-${next.date}.ics`} />
                    </div>
                  </div>
                )}
                {documents.slice(0, 2).map((doc) => (
                  <div class="results__doc">
                    <span class="results__tile" aria-hidden="true">
                      <span class="results__tile-band">PDF</span>
                      <span class="results__tile-body"><Icon name="file-text" size={24} /></span>
                    </span>
                    <div class="results__doc-text">
                      <h3 class="text-h4">{doc.label}</h3>
                      {doc.meta && <p class="text-small">{doc.meta}</p>}
                      <Link label="Download report" href={doc.url} action="file" size="small" context={doc.context ?? doc.label} />
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        ) : feature ? (
          <div class="stats-band__group stats-band__feature has-surface-light">
            <div class="stats-band__lead has-surface-navy">
              <p class="stats-band__lead-value text-display">
                {animate ? <span data-count-up data-count-up-delay={150}>{lead.value}</span> : lead.value}
              </p>
              <p class="stats-band__lead-label text-small">{lead.label}</p>
              {lead.note && <p class="stat__note text-small">{lead.note}</p>}
            </div>
            <ul class="stats-band__rows" style={`grid-template-columns: ${rest.map(() => 'max-content').join(' minmax(var(--rule-gap), 1fr) ')}`}>
              {rest.map((stat, i) => (
                <Fragment>
                {i > 0 && <li class="stats-band__rule" role="presentation" aria-hidden="true" />}
                <li class="stats-band__row" style={`--stat-i: ${i + 1}`}>
                  <p class="stats-band__row-value text-h2">
                    {animate ? <span data-count-up data-count-up-delay={150 + (i + 1) * STAT_STAGGER}>{stat.value}</span> : stat.value}
                  </p>
                  <p class="stats-band__row-label text-small">{stat.label}</p>
                </li>
                </Fragment>
              ))}
            </ul>
          </div>
        ) : (
        <div class:list={['stats-band__group', panel && 'has-surface-light']}>
          <ul class="stats-band__list">
            {stats.map((stat, i) => (
              <Stat
                value={stat.value}
                label={stat.label}
                note={stat.note}
                size="large"
                align={alignment}
                as="li"
                countUp={animate}
                countDelay={150 + i * STAT_STAGGER}
                style={`--stat-i: ${i}`}
              />
            ))}
          </ul>
        </div>
        )}
      </div>
    </BlockSection>
  )
}

<style is:global>
  .stats-band__body {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--xl);
  }

  .stats-band--panel .stats-band__group {
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--wp--custom--color--bg--default);
    box-shadow: var(--wp--preset--shadow--sm);
    padding: var(--wp--preset--spacing--40);
  }

  .stats-band__list {
    display: flex;
  }

  /* Feature (17 Sep 2026): navy lead tile + figures in one panel. It wraps rather than breakpoints:
     the figures never shrink below their natural width, so the row stacks under the lead only when
     it genuinely can't fit. Figures are content-width; spare space goes into the gaps, with each
     rule centred in its gap. */
  .stats-band__feature {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--wp--custom--color--bg--default);
    box-shadow: var(--wp--preset--shadow--sm);
  }
  .stats-band__lead {
    /* Grows only when it has the line to itself (stacked) */
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--wp--preset--spacing--4);
    padding: var(--wp--preset--spacing--40);
  }
  .stats-band__lead-value {
    color: var(--wp--custom--color--text--accent);
    font-variant-numeric: tabular-nums lining-nums;
    font-size: clamp(3.5rem, 2.4rem + 2.2vw, 5rem);
    line-height: 1;
    /* Optical: pull the display digits back onto the label's left edge */
    margin-left: -0.05em;
  }
  .stats-band__lead-label {
    color: var(--wp--custom--color--text--primary);
    white-space: nowrap;
  }
  .stats-band__rows {
    --rule-gap: var(--wp--preset--spacing--48);
    flex: 1000 1 max-content;
    display: grid;
    align-items: end;
    padding: var(--wp--preset--spacing--40);
  }
  .stats-band__row {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
  }
  .stats-band__rule {
    justify-self: center;
    align-self: stretch;
    width: 1px;
    background-color: var(--wp--custom--color--border--subtle);
  }
  .stats-band__row-value {
    color: var(--wp--custom--color--text--primary);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1;
  }
  .stats-band__row-label {
    color: var(--wp--custom--color--text--secondary);
    white-space: nowrap;
  }
  /* Rows rise in sequence beside the lead; the lead itself pops rather than rises — it's the hero
     figure in its own navy tile, not one more item in the row, so it reads as switching on first
     instead of queuing with the rest (17 Sep 2026). */
  html.js .stats-band--animate .stats-band__row {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 0.7s var(--wp--custom--motion--ease-out),
      transform 0.7s var(--wp--custom--motion--ease-out);
    transition-delay: calc(0.15s + var(--stat-i, 0) * 0.16s);
  }
  html.js .stats-band--animate .stats-band__lead > * {
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 0.6s var(--wp--custom--motion--ease-out),
      transform 0.6s var(--wp--custom--motion--ease-out);
  }
  html.js .stats-band--animate .is-revealed .stats-band__row,
  html.js .stats-band--animate .is-revealed .stats-band__lead > * {
    opacity: 1;
    transform: none;
  }
  /* Phones and narrow tablets: figures in a 2×2 grid, no rules */
  @media (max-width: 767px) {
    .stats-band__lead {
      padding: var(--wp--preset--spacing--24);
    }
    .stats-band__rows {
      flex-basis: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      /* The desktop row's align-items: end keeps every figure on one shared baseline; in this 2×2
         grid each cell can wrap to a different number of label lines, so bottom-aligning pushes a
         1-line label's figure down below a 2-line neighbour's. Top-align instead, so all four
         figures start on the same line regardless of how their label wraps (17 Sep 2026 fix). */
      align-items: start;
      gap: var(--wp--preset--spacing--24);
      padding: var(--wp--preset--spacing--24);
    }
    .stats-band__rule {
      display: none;
    }
    .stats-band__row-label {
      white-space: normal;
    }
    .stats-band__row-value {
      font-size: var(--wp--preset--font-size--h3);
    }
  }

  .stats-band__list > li {
    flex: 1;
    min-width: 0;
    padding-right: var(--wp--preset--spacing--40);
  }
  .stats-band__list > li:last-child {
    padding-right: 0;
  }
  .stats-band__list > li + li {
    padding-left: var(--wp--preset--spacing--40);
    border-left: 1px solid var(--wp--custom--color--border--subtle);
  }

  /* Animate: each stat rises in after the previous one; motion.ts reveals the group (.is-revealed)
     and runs the count-up with the same 160 ms step. */
  html.js .stats-band--animate .stats-band__list > li {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 0.7s var(--wp--custom--motion--ease-out),
      transform 0.7s var(--wp--custom--motion--ease-out);
    transition-delay: calc(0.15s + var(--stat-i, 0) * 0.16s);
  }
  html.js .stats-band--animate .is-revealed .stats-band__list > li {
    opacity: 1;
    transform: none;
  }

  /* ── Results (18 Sep 2026) ─────────────────────────────────── */
  .results__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--wp--preset--spacing--16) var(--wp--preset--spacing--32);
    margin-bottom: var(--wp--custom--stack--lg);
  }
  .stats-band__results {
    display: flex;
    flex-direction: column;
  }
  .results__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--wp--preset--spacing--4) var(--wp--preset--spacing--16);
  }
  .results__currency {
    color: var(--wp--custom--color--text--secondary);
  }
  .results__stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--8) var(--wp--preset--spacing--12);
    color: var(--wp--custom--color--text--secondary);
  }
  .results__headline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .results__item {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
    min-width: 0;
    padding: var(--wp--preset--spacing--24) var(--wp--preset--spacing--32) var(--wp--preset--spacing--32);
  }
  .results__item:first-child {
    padding-left: 0;
  }
  .results__item + .results__item {
    border-left: 1px solid var(--wp--custom--color--border--subtle);
  }
  .results__label {
    color: var(--wp--custom--color--text--secondary);
  }
  .results__value {
    display: flex;
    align-items: baseline;
    color: var(--wp--custom--color--text--primary);
    /* One step below the H2 title (48) so the heading still leads (review round 4) */
    font-size: clamp(2rem, 1.6479rem + 0.7512vw, 2.5rem); /* 32 → 40 */
    line-height: 1;
    font-weight: var(--wp--custom--font-weight--bold);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }
  .results__unit {
    margin-right: var(--wp--preset--spacing--8);
    font-size: var(--wp--preset--font-size--body);
    font-weight: var(--wp--custom--font-weight--medium);
    letter-spacing: 0;
    color: var(--wp--custom--color--text--secondary);
  }
  /* The arrow sits on the first line: when the change wraps (2-up on phones) it must not drop to the
     middle of the block. (1lh − 16) / 2 centres the 16px icon on one line box */
  .results__delta {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--wp--preset--spacing--4);
    margin-top: var(--wp--preset--spacing--4);
    color: var(--wp--custom--color--text--secondary);
    font-weight: var(--wp--custom--font-weight--medium);
  }
  .results__delta .icon {
    flex: none;
    margin-top: calc((1lh - 16px) / 2);
  }
  .results__delta--up {
    color: var(--wp--custom--color--text--accent);
  }
  /* One rule, between the headline and secondary rows (review round 2) */
  .results__secondary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--wp--custom--color--border--subtle);
  }
  .results__row {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
    padding: var(--wp--preset--spacing--16) var(--wp--preset--spacing--32) var(--wp--preset--spacing--24);
  }
  .results__row:first-child {
    padding-left: 0;
  }
  .results__row + .results__row {
    border-left: 1px solid var(--wp--custom--color--border--subtle);
  }
  .results__row dt {
    color: var(--wp--custom--color--text--secondary);
  }
  .results__row dd {
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }
  /* Footer (review round 4): a full-width tint strip that closes the section, flush with its bottom
     edge; three items evenly spaced on the container (no rules, round 5). The strip bleeds with
     a box-shadow + clip-path pair, so it never causes a horizontal scrollbar. */
  .results__footer {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--wp--custom--section--sm);
    margin-bottom: calc(var(--wp--custom--section--md) * -1);
    padding-block: var(--wp--preset--spacing--64) var(--wp--preset--spacing--48);
    background-color: var(--wp--custom--color--bg--tint);
    box-shadow: 0 0 0 100vmax var(--wp--custom--color--bg--tint);
    clip-path: inset(0 -100vmax);
  }
  .results__footer > * {
    padding-inline: var(--wp--preset--spacing--40);
  }
  .results__footer > :first-child {
    padding-left: 0;
  }
  .results__doc {
    display: flex;
    align-items: flex-start;
    gap: var(--wp--preset--spacing--16);
  }
  .results__doc-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--wp--preset--spacing--4);
  }
  .results__doc-text .text-small {
    color: var(--wp--custom--color--text--secondary);
  }
  /* The link's 44px tap target adds 12px above its label: pull it up so the visible gap to the
     meta line is 12, without shrinking the target (review round 5) */
  .results__doc-text .link-arrow {
    margin-top: calc(var(--wp--preset--spacing--4) * -1);
  }
  .results__tile {
    flex: none;
    /* Optical: top of the tile level with the title's cap height, not its line box (H4 leading puts
       the caps ~0.28em down); scales with the fluid H4 (review round 5) */
    margin-top: calc(var(--wp--preset--font-size--h4) * 0.28);
    display: grid;
    grid-template-rows: 24px 40px;
    width: 56px;
    overflow: hidden;
    border: 2px solid var(--wp--custom--color--text--primary);
    border-radius: var(--wp--custom--radius--sm);
    text-align: center;
  }
  .results__tile-band {
    background-color: var(--wp--custom--color--text--primary);
    color: var(--wp--custom--color--bg--default);
    font-size: 0.75rem;
    line-height: 22px;
    font-weight: var(--wp--custom--font-weight--bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .results__tile-body {
    display: grid;
    place-items: center;
    /* Secondary figures, footer titles and the calendar day share H4 (24) (review round 5) */
    font-size: var(--wp--preset--font-size--h4);
    font-weight: var(--wp--custom--font-weight--bold);
    font-variant-numeric: tabular-nums;
    color: var(--wp--custom--color--text--primary);
  }
  html.js .stats-band--animate .results__item {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 0.7s var(--wp--custom--motion--ease-out),
      transform 0.7s var(--wp--custom--motion--ease-out);
    transition-delay: calc(0.15s + var(--stat-i, 0) * 0.16s);
  }
  html.js .stats-band--animate .is-revealed .results__item {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 1099px) {
    .results__headline,
    .results__secondary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .results__item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .results__row:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    /* Tablet: keep three columns, each tile above its text (as cards stack), instead of one
       left-hugging column with an empty right half (review round 7) */
    .results__footer {
      padding-block: var(--wp--preset--spacing--48) var(--wp--preset--spacing--40);
    }
    .results__footer > * {
      padding-inline: var(--wp--preset--spacing--24);
    }
    .results__doc {
      flex-direction: column;
      gap: var(--wp--preset--spacing--16);
    }
    .results__tile {
      margin-top: 0;
    }
  }
  /* Phones: one compact column, tile beside the text again */
  @media (max-width: 599px) {
    .results__footer {
      grid-template-columns: 1fr;
      row-gap: var(--wp--preset--spacing--32);
      padding-block: var(--wp--preset--spacing--40);
    }
    .results__footer > * {
      padding-inline: 0;
    }
    .results__doc {
      flex-direction: row;
    }
    .results__tile {
      margin-top: calc(var(--wp--preset--font-size--h4) * 0.28);
    }
  }
