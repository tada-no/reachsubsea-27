---
// Figures · reach/figures (docs/05 §2.4b). Split out of Split media on 21 Sep 2026 (Q67): proof figures, 2–4 points,
// each with its own figure (a value, or a two-part split such as the revenue mix) and a caption.
//   Layout Sticky (pinned pair since 8 Oct 2026, Ross: "each section comes through together"): from 900, with JS,
//     a band pins under the subnav, as About's Values: the heading on top, then one point at a time, its figure
//     (cols 1–5) and its title and text (cols 7–12) as one unit. Scroll drives the change: the next point rises in
//     as the last leaves upward (clip + rise, never a fade), with quiet step ticks under the heading. The ordered
//     list under the band is the runway and the accessible content; the band's copy is decorative. A split point
//     grows in as a two-part bar. Below 900 and without JS: the list, each point with its figure inline.
//   Layout Cards (Why invest, review rounds 3–7, Q61): the value points stack as tint cards (title → body →
//     proof figure, counting up) in cols 1–7; a split point becomes the navy feature card in cols 8–12 with a
//     donut that sweeps clockwise. Best on White. Below 1280 the feature card spans the full width.
//   Layout Grid (8 Oct 2026, Careers › Why work with us, Q135): every point in view, 2 × 2 tiles from 900 (one column
//     below), each title → text → figure and caption, on subgrid rows so the figures line up across a row.
// Figures come from the editor per page, but the numbers themselves should be quoted from Key figures / Latest
// results, never retyped (docs/05 §0).
import Donut from '../components/Donut.astro';
import BlockSection from '../components/BlockSection.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { makeId } from '../lib/ids';
import type { BlockFields } from '../lib/types';

interface FigurePoint {
  /** Short label above the point title, e.g. "Reach Remote". */
  kicker?: string;
  title: string;
  text: string;
  /** The proof figure, e.g. "+111%". Ignored when `split` is set. */
  figure?: string;
  /** One line under the figure: what it measures and when. */
  caption: string;
  /** Two-part split bar instead of a figure; values are percentages. */
  split?: { label: string; value: number }[];
  /** Split only: the period, shown first in the donut centre ("Q2 2026"). */
  period?: string;
}

interface Props extends BlockFields {
  eyebrow?: string;
  title: string;
  layout?: 'sticky' | 'cards' | 'grid';
  figures: FigurePoint[];
}

const { eyebrow, title, layout = 'sticky', figures = [], background, spacing, anchor } = Astro.props;

const titleId = makeId('figures', title);
const figureCards = layout === 'cards';
// Cards: value points stack in the left column; a split point becomes the feature card on the right.
const valuePoints = figures.filter((p) => !p.split);
const splitPoint = figures.find((p) => p.split);
// The ring itself is the shared Donut component (7 Oct 2026; geometry and sweep notes there).
---

{
  figures.length > 0 && (
<BlockSection
  slug="figures"
  root="figures"
  class={`figures--${layout}`}
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
>
  {layout === 'grid' ? (
    <div class="figures__stack">
      <div class="figures__stack-head">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <h2 id={titleId} class="figures__heading text-h2">{title}</h2>
      </div>
      <ul class="figures__grid">
        {figures.map((point) => (
          <li class="figures__tile">
            <h3 class="text-h4">{point.title}</h3>
            <p class="figures__text text-body">{point.text}</p>
            <div class="figures__tile-proof">
              <p class="figures__value"><span data-count-up>{point.figure}</span></p>
              <p class="figures__caption text-small">{point.caption}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ) : figureCards ? (
    <div class="figures__stack">
      <div class="figures__stack-head">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <h2 id={titleId} class="figures__heading text-h2">{title}</h2>
      </div>
      <div class:list={['figures__cards', !splitPoint && 'figures__cards--single']}>
        <ul class="figures__list">
          {valuePoints.map((point) => (
            <li class="figures__card">
              <div class="figures__card-text">
                <h3 class="text-h4">{point.title}</h3>
                <p class="figures__text text-small">{point.text}</p>
              </div>
              <div class="figures__proof">
                <p class="figures__value"><span data-count-up>{point.figure}</span></p>
                <p class="figures__caption text-caption">{point.caption}</p>
              </div>
            </li>
          ))}
        </ul>
        {splitPoint?.split && (
          <div class="figures__card figures__card--feature has-surface-navy">
            <h3 class="text-h4">{splitPoint.title}</h3>
            <figure class="figures__donut">
              <div class="figures__donut-chart">
                <Donut parts={splitPoint.split} lead={splitPoint.period} text={splitPoint.caption} />
              </div>
            </figure>
            {/* Arcs start at 12 o'clock and run clockwise, so the first share sits on the right and
                the second on the left: under the ring each label sits beside its own arc */}
            <div class="figures__donut-labels">
              {splitPoint.split.slice(0, 2).map((part, n) => (
                <p class={`figures__donut-label figures__donut-label--${n === 0 ? 'end' : 'start'}`}>
                  <span class="figures__donut-value">{part.value}%</span>
                  <span class="figures__donut-name text-small">
                    <span class={`figures__swatch figures__swatch--${n}`} aria-hidden="true" />
                    {part.label}
                  </span>
                </p>
              ))}
            </div>
            <p class="figures__text text-small">{splitPoint.text}</p>
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class="figures__sticky" data-figures>
      <div class="figures__pin">
        <div class="figures__sticky-head">
          {eyebrow && <Eyebrow text={eyebrow} />}
          <h2 id={titleId} class="figures__heading text-h2">{title}</h2>
          <ol class="figures__ticks" aria-hidden="true">
            {figures.map((_, i) => <li class="figures__tick" data-figure-tick={i} />)}
          </ol>
        </div>
        <div class="figures__stage" aria-hidden="true">
          {figures.map((point, i) => (
            <div class="figures__slot" data-figure-slot={i} data-state={i === 0 ? 'current' : 'future'}>
              <div class="figures__slot-figure">
                {point.split ? (
                  <div class="figures__split" style={`--split-a: ${point.split[0]?.value ?? 50}%`}>
                    <div class="figures__bar">
                      {point.split.map((part) => <span class="figures__part">{part.value}%</span>)}
                    </div>
                    <div class="figures__keys text-small">
                      {point.split.map((part) => <span>{part.label}</span>)}
                    </div>
                  </div>
                ) : (
                  <p class="figures__value">{point.figure}</p>
                )}
                <p class="figures__caption text-body">{point.caption}</p>
              </div>
              <div class="figures__slot-text">
                {point.kicker && <Eyebrow text={point.kicker} as="span" />}
                <p class="figures__title text-h3">{point.title}</p>
                <p class="figures__text text-lead">{point.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <ol class="figures__points">
        {figures.map((point, i) => (
          <li class="figures__point" data-figure-point={i}>
            <div class="figures__inline">
              {point.split ? (
                <div class="figures__split" style={`--split-a: ${point.split[0]?.value ?? 50}%`}>
                  <div class="figures__bar">
                    {point.split.map((part) => <span class="figures__part">{part.value}%</span>)}
                  </div>
                  <div class="figures__keys text-small">
                    {point.split.map((part) => <span>{part.label}</span>)}
                  </div>
                </div>
              ) : (
                <p class="figures__value">{point.figure}</p>
              )}
              <p class="figures__caption text-small">{point.caption}</p>
            </div>
            {point.kicker && <Eyebrow text={point.kicker} as="span" />}
            <h3 class="figures__title text-h3">{point.title}</h3>
            <p class="figures__text text-lead">{point.text}</p>
          </li>
        ))}
      </ol>
    </div>
  )}
</BlockSection>
  )
}

<style is:global>
  /* Cards layout: heading on top, then the cards */
  .figures__stack {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--xl);
  }
  .figures__stack-head {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--md);
    max-width: 880px;
  }
  .figures__stack-head .figures__heading {
    text-wrap: balance;
  }

  /* ── Figures · Cards (review round 4) ─────────────────────── */
  /* Reading order inside each card: title → body → proof figure. Value points stack on the left;
     the split (revenue mix) is the feature card on the right, drawn as a donut. */
  .figures__cards {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--wp--custom--grid--gutter);
  }
  .figures__list {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--grid--gutter);
  }
  .figures__cards--single .figures__list {
    grid-column: 1 / -1;
  }
  .figures__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--wp--preset--spacing--24) var(--wp--preset--spacing--48);
    /* Card · Featured metrics (docs/04): these cards are 7 and 5 columns wide, past the 416 Default */
    padding: var(--wp--preset--spacing--48);
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--wp--custom--color--bg--tint);
  }
  .figures__card-text {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
  }
  .figures__card .figures__text {
    color: var(--wp--custom--color--text--secondary);
  }
  .figures__proof {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--wp--preset--spacing--4);
    text-align: right;
    min-width: 176px;
  }
  .figures__card .figures__value {
    font-size: var(--wp--preset--font-size--figure);
    line-height: var(--wp--custom--line-height--figure);
    letter-spacing: var(--wp--custom--letter-spacing--figure);
  }
  .figures__proof .figures__caption {
    max-width: 200px;
  }
  /* The feature card is Navy (review round 5): the section's one chart, and a break in the run of
     tint cards. Its tokens flip through `has-surface-navy`; the ground is set explicitly to navy/800 */
  .figures__card--feature {
    background-color: var(--wp--preset--color--navy-800);
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    /* Children span the card (the base card's grid centring would shrink the labels row to the middle, so
       the two shares sat 272 apart under a 432 text column; Ross, 7 Oct 2026: they sit at the card's sides) */
    align-items: stretch;
    /* Heading → ring → body: the heading lines up with the value cards' titles */
    gap: var(--wp--preset--spacing--24);
  }
  /* Donut (review rounds 5–7). Tall card (1280+): heading → ring → labels → body. The value cards
     alone set the row height; the figure takes the height left over (flex 1 with size containment,
     so it adds nothing to the row) and the ring is the largest square that fits. Arcs meet with no
     gap, so a 100% split reads as a full ring; the centre names the period and measure */
  .figures__donut {
    flex: 1 1 0;
    align-self: stretch; /* size containment gives it no content width of its own */
    min-height: 240px;
    container-type: size;
    display: grid;
    place-items: center;
  }
  .figures__donut-chart {
    position: relative;
    width: min(100cqw, 100cqh, 400px);
    aspect-ratio: 1;
  }
  /* Under the ring each label sits on its own arc's side: renewables (the last share, closing the
     ring on the left) left, oil & gas right */
  .figures__donut-labels {
    display: flex;
    justify-content: space-between;
    gap: var(--wp--preset--spacing--24);
  }
  .figures__donut-label--start {
    order: -1;
  }
  .figures__donut-label {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
  }
  .figures__donut-label--end {
    align-items: flex-end;
    text-align: right;
  }
  /* A dot beside the name keys the colour (a dash above the value read as a minus sign) */
  .figures__donut-name {
    display: inline-flex;
    align-items: center;
    gap: var(--wp--preset--spacing--8);
    white-space: nowrap;
  }
  .figures__donut-name .figures__swatch {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .figures__donut-value {
    font-size: var(--wp--preset--font-size--h4);
    font-weight: var(--wp--custom--font-weight--bold);
    line-height: var(--wp--custom--line-height--h4);
    letter-spacing: var(--wp--custom--letter-spacing--display);
    font-variant-numeric: tabular-nums;
    color: var(--wp--custom--color--text--primary);
  }
  .figures__donut-name {
    color: var(--wp--custom--color--text--secondary);
  }
  /* The counterpart's swatch matches the ring (Donut): navy/100 since 7 Oct 2026 (navy/200 read grey; navy/400
     read as disabled, the text/disabled token) */
  .figures__swatch--0 {
    background-color: var(--wp--preset--color--navy-100);
  }
  .figures__swatch--1 {
    background-color: var(--wp--preset--color--sage-400);
  }
  .figures__swatch {
    width: 12px;
    height: 12px;
    border-radius: var(--wp--custom--radius--xs);
  }
  /* Below 1280 a 5-column navy card is too narrow (heavy wrapping, a small ring), so the feature
     card spans the full width under the value cards */
  @media (max-width: 1279px) {
    .figures__list,
    .figures__card--feature {
      grid-column: 1 / -1;
    }
  }
  /* Full-width feature card (768–1279, review round 7): one reading column on the left (heading →
     body → the two shares, side by side) and the donut on the right as the image, both vertically
     centred */
  @media (min-width: 768px) and (max-width: 1279px) {
    .figures__card--feature {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto auto auto 1fr;
      grid-template-areas: '. fig' 'title fig' 'text fig' 'labels fig' '. fig';
      column-gap: var(--wp--preset--spacing--64);
      row-gap: 0;
    }
    .figures__card--feature > h3 {
      grid-area: title;
    }
    .figures__card--feature > .figures__text {
      grid-area: text;
      margin-top: var(--wp--preset--spacing--12);
      max-width: 520px;
    }
    .figures__card--feature > .figures__donut-labels {
      grid-area: labels;
      justify-content: flex-start;
      gap: var(--wp--preset--spacing--48);
      margin-top: var(--wp--preset--spacing--32);
    }
    .figures__card--feature .figures__donut-label--end {
      align-items: flex-start;
      text-align: left;
    }
    .figures__card--feature > .figures__donut {
      grid-area: fig;
      width: clamp(280px, 30vw, 360px);
      height: clamp(280px, 30vw, 360px);
    }
  }
  /* Stacked on small screens: heading → ring → labels → body, the ring at a fixed height */
  @media (max-width: 767px) {
    .figures__donut {
      flex: none;
      height: min(100vw - 112px, 400px);
    }
  }
  @media (max-width: 599px) {
    .figures__card {
      grid-template-columns: 1fr;
      padding: var(--wp--preset--spacing--32); /* Featured falls back to Default on phones */
    }
    .figures__proof {
      align-items: flex-start;
      text-align: left;
      min-width: 0;
    }
  }

  /* ── Figures · Grid (8 Oct 2026, Careers › Why work with us, Q135) ──────────── */
  /* Ross: Sticky on a page felt clunky (four points over ~2,000px of scroll, each figure apart from its point).
     Grid keeps every point and its proof together in one view: 2 × 2 tiles from 900 (one column below), each in
     Why invest's card order, title → body → proof, the figures on one line across a row. Tiles take
     `bg/tint` (navy/900 in Navy mode: wells in the band), White on a Tint block. */
  .figures__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--wp--custom--grid--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .figures__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Each tile is a subgrid of three rows (title · text · proof), so across a row the titles, texts and figures
     share lines even when one caption or text runs a line longer */
  .figures__tile {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: var(--wp--preset--spacing--12);
    padding: var(--wp--preset--spacing--32);
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--wp--custom--color--bg--tint);
  }
  @media (min-width: 600px) {
    .figures__tile {
      padding: var(--wp--preset--spacing--48);
    }
  }
  .has-surface-tint .figures__tile {
    background-color: var(--wp--custom--color--bg--default);
  }
  .figures__tile .figures__text {
    max-width: 560px;
  }
  .figures__tile-proof {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
    padding-top: var(--wp--preset--spacing--32);
  }
  .figures__tile .figures__value {
    font-size: var(--wp--preset--font-size--display);
    line-height: var(--wp--custom--line-height--display);
    letter-spacing: var(--wp--custom--letter-spacing--display);
  }

  /* ── Figures ──────────────────────────────────────────────── */
  /* Sticky, base (below 900 and without JS): the heading, then the list with each figure inline */
  .figures__sticky-head {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--md);
    max-width: 880px;
  }
  .figures__sticky-head .figures__heading {
    text-wrap: balance;
  }
  .figures__ticks,
  .figures__stage {
    display: none;
  }
  .figures__slot-figure,
  .figures__slot-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--wp--preset--spacing--16);
  }
  .figures__value {
    color: var(--wp--custom--color--text--accent-display);
    font-size: var(--wp--preset--font-size--display-xl);
    line-height: var(--wp--custom--line-height--display-xl);
    font-weight: var(--wp--custom--font-weight--bold);
    letter-spacing: var(--wp--custom--letter-spacing--display-xl);
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }
  .has-surface-navy .figures__value {
    color: var(--wp--preset--color--sage-400);
  }
  .figures__caption {
    color: var(--wp--custom--color--text--secondary);
  }
  .figures__split {
    width: 100%;
    max-width: 520px;
  }
  .figures__bar {
    display: grid;
    grid-template-columns: var(--split-a) 1fr;
    gap: var(--wp--preset--spacing--4);
    height: 64px;
    transition: grid-template-columns 1.1s var(--wp--custom--motion--ease-out) 0.15s;
  }
  .figures__part {
    display: flex;
    align-items: center;
    padding-inline: var(--wp--preset--spacing--16);
    border-radius: var(--wp--custom--radius--sm);
    font-size: var(--wp--preset--font-size--h4);
    font-weight: var(--wp--custom--font-weight--bold);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    white-space: nowrap;
  }
  .figures__part:first-child {
    background-color: var(--wp--preset--color--navy-600);
    color: var(--wp--preset--color--white);
  }
  .figures__part:last-child {
    background-color: var(--wp--preset--color--sage-400);
    color: var(--wp--preset--color--navy-900);
  }
  /* Grows from an all-oil-&-gas bar to the real split each time the point becomes active */
  html.js .figures__slot:not([data-state='current']) .figures__bar {
    grid-template-columns: calc(100% - 8px) 1fr;
    transition-duration: 0s;
  }
  .figures__keys {
    display: flex;
    justify-content: space-between;
    gap: var(--wp--preset--spacing--16);
    margin-top: var(--wp--preset--spacing--12);
    color: var(--wp--custom--color--text--secondary);
  }
  .figures__points {
    margin: var(--wp--custom--stack--lg) 0 0;
    padding: 0;
    list-style: none;
  }
  .figures__point {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--16);
    padding-block: var(--wp--preset--spacing--32);
  }
  .figures__text {
    color: var(--wp--custom--color--text--secondary);
    max-width: 560px;
  }
  .figures__inline {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
    margin-bottom: var(--wp--preset--spacing--8);
  }
  .figures__inline .figures__value {
    font-size: var(--wp--preset--font-size--display);
  }

  /* Pinned pair (900 up, JS adds .is-live): the band pins under the subnav for as long as the runway scrolls under
     it. Band = the viewport below the header and subnav (520 at least); each point owns one run of scroll. */
  @media (min-width: 900px) {
    .figures__sticky.is-live {
      --figures-band: max(520px, calc(100vh - var(--reach-subnav-top, 0px) - 72px));
      --figures-run: clamp(360px, 55vh, 560px);
    }
    .figures__sticky.is-live .figures__pin {
      position: sticky;
      top: calc(var(--reach-subnav-top, 0px) + 72px);
      height: var(--figures-band);
      display: flex;
      flex-direction: column;
      gap: var(--wp--custom--stack--lg);
      padding-block: var(--wp--preset--spacing--48);
    }
    .figures__sticky.is-live .figures__ticks {
      display: flex;
      gap: var(--wp--preset--spacing--8);
      margin: var(--wp--preset--spacing--8) 0 0;
      padding: 0;
      list-style: none;
    }
    .figures__tick {
      width: var(--wp--preset--spacing--32);
      height: 3px;
      border-radius: var(--wp--custom--radius--full);
      background-color: var(--wp--custom--color--border--subtle);
      transition: background-color 0.4s var(--wp--custom--motion--ease-out);
    }
    .figures__tick.is-current {
      background-color: var(--wp--custom--color--icon--accent);
    }
    .figures__sticky.is-live .figures__stage {
      display: block;
      position: relative;
      flex: 1;
    }
    /* One point = one unit: its figure in cols 1–5, its title and text in cols 7–12 */
    .figures__slot {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--wp--custom--grid--gutter);
      align-items: center;
      clip-path: inset(100% 0 0 0);
      transform: translate3d(0, 48px, 0);
      transition:
        clip-path 0.32s var(--wp--custom--motion--ease-in-out),
        transform 0.32s var(--wp--custom--motion--ease-in-out);
    }
    .figures__slot-figure {
      grid-column: 1 / span 5;
    }
    .figures__slot-text {
      grid-column: 7 / span 6;
    }
    /* The outgoing point exits up through a ceiling quickly; the incoming one rises from a floor just behind it
       with a crisper ease-out, so each change lands as one beat */
    .figures__slot[data-state='past'] {
      clip-path: inset(0 0 100% 0);
      transform: translate3d(0, -48px, 0);
    }
    .figures__slot[data-state='current'] {
      clip-path: inset(0 0 0 0);
      transform: none;
      transition-duration: 0.55s;
      transition-timing-function: var(--wp--custom--motion--ease-out);
      transition-delay: 0.14s;
    }
    /* The runway starts under the band's top and gives every point one run; the last one holds for a run too.
       Its content is the accessible copy, visually hidden while the band shows it. */
    .figures__sticky.is-live .figures__points {
      margin-top: calc(var(--figures-band) * -1);
      padding-bottom: calc(var(--figures-band) / 2);
    }
    .figures__sticky.is-live .figures__point {
      position: relative;
      min-height: var(--figures-run);
      padding: 0;
    }
    .figures__sticky.is-live .figures__point > * {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .figures__slot,
    .figures__slot[data-state] {
      transform: none;
    }
  }

</style>

<script>
  // Figures, Sticky: the pinned pair (8 Oct 2026). The state comes from the scroll position, not an
  // IntersectionObserver, so a fling can't skip a point (the Values block's lesson, 20 Sep 2026): the point whose top
  // has passed the middle of the pinned band is current. Live only from 900 with JS; below that the list reads as is.
  document.querySelectorAll<HTMLElement>('[data-figures]').forEach((root) => {
    const slots = [...root.querySelectorAll<HTMLElement>('[data-figure-slot]')];
    const ticks = [...root.querySelectorAll<HTMLElement>('[data-figure-tick]')];
    const points = [...root.querySelectorAll<HTMLElement>('[data-figure-point]')];
    const pin = root.querySelector<HTMLElement>('.figures__pin');
    if (slots.length === 0 || !pin) return;
    const wide = window.matchMedia('(min-width: 900px)');

    let current = -1;
    const setState = (i: number) => {
      if (i === current) return;
      current = i;
      slots.forEach((slot, n) => (slot.dataset.state = n < i ? 'past' : n > i ? 'future' : 'current'));
      ticks.forEach((tick, n) => tick.classList.toggle('is-current', n === i));
    };

    let tops: number[] = [];
    let centre = 0;
    const measure = () => {
      tops = points.map((point) => point.getBoundingClientRect().top + window.scrollY);
      centre = parseFloat(getComputedStyle(pin).top) + pin.offsetHeight / 2;
    };
    const update = () => {
      if (!root.classList.contains('is-live')) return;
      const line = window.scrollY + centre;
      let i = 0;
      for (let n = 0; n < tops.length; n++) if (line >= tops[n]) i = n;
      setState(i);
    };
    const setLive = () => {
      root.classList.toggle('is-live', wide.matches);
      measure();
      update();
    };

    let frame = 0;
    window.addEventListener('scroll', () => {
      if (frame) return;
      frame = requestAnimationFrame(() => ((frame = 0), update()));
    }, { passive: true });
    let resizing = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizing);
      resizing = window.setTimeout(() => (measure(), update()), 150);
    });
    wide.addEventListener('change', setLive);
    // Late layout shifts (fonts, images above the section) move the runway under the line
    window.addEventListener('load', () => (measure(), update()));
    setState(0);
    setLive();
  });
</script>
