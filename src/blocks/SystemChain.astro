---
// System chain · reach/system-chain (docs/05 §2.33; Q167, 10 Oct 2026; redrawn 11 Oct 2026 after the Q2 2026 report
// p19, then as a horizon after the critique the same day, Ross: neater, no eyebrows, shorter copy, Reach Horizon
// less clunky). One system drawn as a link diagram on a horizon: the two ends' discs stand on a line across the
// block (the horizon), the link sits in the sky above it, its disc at the top of a dotted arc that rises out of one
// end's disc and comes down into the other's, its words inside the arch; under the line, one row: the first end, the
// platform (the base, centred under the link, the ground it all stands on) and the other end.
// Reach Remote's "More than a vessel": the vessel and the ROC on Reach Horizon, Reach Relay over the satellite.
//
// The dots are the tour's dimension lines' (round 2 px every 6), so the page draws in one hand. Motion: a quarter in
// view the horizon runs out from the centre, the arc draws left to right, each disc lands (scale, no fade) as the arc
// reaches it, the words rise out of a clip; then two solid data dots travel the arc, one each way, passing under the
// discs, while the block is on screen (Ross, 11 Oct 2026: keep looping); each disc sends a ring out (its own line colour,
// spreading and fading) as a dot reaches it. Still under reduced motion and without JS
// (no arc without JS). Below 900 one column: each disc beside its words, a dotted line down the left joining the
// three discs and ending on the horizon, the platform's words under it; no travelling dots.
// On Reach Remote it follows a Split media Beside that introduces it (the client PDF's paragraph), `joined` so the
// two read as one section; then it carries no header of its own, only an accessible name.
// Fields: `sectionHeader`, `ariaLabel`, `joined`, `ends` (two: pictogram, title, text), `link` (pictogram, title,
// text), `base` (title, text: one line, may hold an inline link), `background`.
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Pictogram from '../components/Pictogram.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, SectionHeaderField } from '../lib/types';

export interface ChainNode {
  pictogram: string;
  title: string;
  /** One line */
  text: string;
}

interface Props extends BlockFields {
  sectionHeader?: SectionHeaderField;
  /** The two ends of the link, on the horizon: left, right */
  ends: [ChainNode, ChainNode];
  /** The link, in the sky */
  link: ChainNode;
  /** The platform under it all, named under the horizon; no disc. `text` is HTML (an inline link allowed) */
  base?: { title: string; text: string };
  /** Accessible name when there is no section header */
  ariaLabel?: string;
  /** Follows the block that introduces it, on the same ground: no top padding */
  joined?: boolean;
}

const { sectionHeader, ends, link, base, ariaLabel, joined = false, background = 'navy', spacing, anchor } = Astro.props;
const titleId = sectionHeader?.title ? makeId('system-chain', sectionHeader.title) : undefined;
const columns = [
  { node: ends[0], role: 'a' },
  { node: link, role: 'link' },
  { node: ends[1], role: 'b' },
];
---

<BlockSection
  slug="system-chain"
  root="system-chain"
  class={joined ? 'system-chain--joined' : undefined}
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
  label={titleId ? undefined : ariaLabel}
>
  <div class="block__body">
    {sectionHeader && <SectionHeader {...sectionHeader} id={titleId} />}
    <div class="system-chain__diagram" data-system-chain>
      <svg class="system-chain__arc" aria-hidden="true"><path data-arc /></svg>
      <span class="system-chain__packet" aria-hidden="true" data-packet></span>
      <span class="system-chain__packet system-chain__packet--back" aria-hidden="true" data-packet></span>
      {
        columns.map(({ node, role }) => (
          <div class={`system-chain__node system-chain__node--${role}`}>
            <span class="system-chain__mark" data-mark>
              <Pictogram name={node.pictogram} size={56} />
            </span>
            <div class="system-chain__text">
              <h3 class="system-chain__title text-h4">{node.title}</h3>
              <p class="system-chain__body text-small">{node.text}</p>
            </div>
          </div>
        ))
      }
      <span class="system-chain__horizon" aria-hidden="true"></span>
      {
        base && (
          <div class="system-chain__base system-chain__text">
            <h3 class="system-chain__title text-h4">{base.title}</h3>
            <p class="system-chain__body text-small" set:html={base.text} />
          </div>
        )
      }
    </div>
  </div>
</BlockSection>

<style is:global>
  /* Desktop: three columns, four rows. Rows 1–2 (the sky): the link's disc, then its words. Row 3: the horizon, the
     ends' discs standing on it. Row 4: the ends' words with the platform's between them. The arc is drawn over the grid from the
     discs' measured centres (script below); discs paint over the arc and the horizon. */
  .system-chain__diagram {
    --sc-mark: 80px;
    --sc-glyph: 56px;
    --sc-step: 0.45s;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--wp--custom--grid--gutter);
  }
  .system-chain__node {
    display: contents;
  }
  .system-chain__mark {
    position: relative;
    z-index: 2;
    display: grid;
    flex: none;
    place-items: center;
    width: var(--sc-mark);
    height: var(--sc-mark);
    border: 1px solid var(--wp--custom--color--border--default);
    border-radius: var(--wp--custom--radius--full);
    background-color: var(--wp--custom--color--bg--default);
  }
  .system-chain__mark .pictogram {
    width: var(--sc-glyph);
    height: var(--sc-glyph);
  }
  .system-chain__text {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--wp--preset--spacing--8);
    max-width: 48ch;
    text-align: center;
  }
  .system-chain__title,
  .system-chain__body {
    margin: 0;
  }
  .system-chain__body {
    max-width: 26ch;
    color: var(--wp--custom--color--text--secondary);
    text-wrap: balance;
  }
  /* An inline link in a line (Reach Horizon's), as prose links */
  .system-chain__body a {
    color: var(--wp--custom--color--text--primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .system-chain__body a:hover {
    color: var(--wp--custom--color--text--accent);
  }
  .system-chain.system-chain--joined {
    padding-top: 0;
  }

  /* Placement */
  .system-chain__node--link .system-chain__mark,
  .system-chain__node--link .system-chain__text {
    grid-column: 2;
    justify-self: center;
  }
  .system-chain__node--link .system-chain__mark {
    grid-row: 1;
  }
  .system-chain__node--link .system-chain__text {
    grid-row: 2;
    margin-top: var(--wp--preset--spacing--16);
    margin-bottom: var(--wp--preset--spacing--48);
  }
  .system-chain__node--a .system-chain__mark,
  .system-chain__node--a .system-chain__text {
    grid-column: 1;
    justify-self: center;
  }
  .system-chain__node--b .system-chain__mark,
  .system-chain__node--b .system-chain__text {
    grid-column: 3;
    justify-self: center;
  }
  .system-chain__node--a .system-chain__mark,
  .system-chain__node--b .system-chain__mark {
    grid-row: 3;
  }
  .system-chain__node--a .system-chain__text,
  .system-chain__node--b .system-chain__text,
  .system-chain__base {
    grid-row: 4;
    margin-top: var(--wp--preset--spacing--24);
  }
  .system-chain__base {
    grid-column: 2;
    justify-self: center;
  }
  /* The horizon: one solid line across the block through the ends' disc centres, under the discs, in the discs'
     ring colour (Ross, 11 Oct 2026: tinted back from border/strong) */
  .system-chain__horizon {
    grid-row: 3;
    grid-column: 1 / -1;
    align-self: center;
    z-index: 1;
    height: 2px;
    background-color: var(--wp--custom--color--border--default);
    transform-origin: center;
  }

  /* The arc: one dotted path over the whole diagram */
  .system-chain__arc {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .system-chain__arc path {
    fill: none;
    stroke: var(--wp--custom--color--text--primary);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 0 6;
  }
  /* Data on the link: solid dots travelling the arc, under the discs */
  .system-chain__packet {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: none;
    width: var(--wp--preset--spacing--8);
    height: var(--wp--preset--spacing--8);
    border-radius: var(--wp--custom--radius--full);
    background-color: var(--wp--custom--color--icon--accent);
    offset-rotate: 0deg;
    pointer-events: none;
  }

  /* Draw-in: the horizon runs out from the centre, the arc runs left to right, each disc lands as it arrives, the
     words rise out of a clip; then the data dots start */
  html.js .system-chain__horizon {
    transition: scale calc(var(--sc-step) * 2) var(--wp--custom--motion--ease-out);
  }
  html.js .system-chain__arc {
    transition: clip-path calc(var(--sc-step) * 2) linear calc(var(--sc-step) * 0.5);
  }
  html.js .system-chain__mark {
    transition: scale 0.4s var(--wp--custom--motion--ease-out);
  }
  html.js .system-chain__text {
    transition:
      clip-path 0.6s var(--wp--custom--motion--ease-out),
      translate 0.6s var(--wp--custom--motion--ease-out);
  }
  html.js .system-chain__node--a :is(.system-chain__mark, .system-chain__text) {
    transition-delay: calc(var(--sc-step) * 0.5);
  }
  html.js .system-chain__node--link :is(.system-chain__mark, .system-chain__text) {
    transition-delay: calc(var(--sc-step) * 1.5);
  }
  html.js .system-chain__node--b :is(.system-chain__mark, .system-chain__text) {
    transition-delay: calc(var(--sc-step) * 2.5);
  }
  html.js .system-chain__base {
    transition-delay: calc(var(--sc-step) * 3);
  }
  html.js .system-chain__diagram:not(.is-drawn) .system-chain__horizon {
    scale: 0 1;
  }
  html.js .system-chain__diagram:not(.is-drawn) .system-chain__arc {
    clip-path: inset(0 100% 0 0);
  }
  html.js .system-chain__diagram:not(.is-drawn) .system-chain__mark {
    scale: 0;
  }
  html.js .system-chain__diagram:not(.is-drawn) .system-chain__text {
    clip-path: inset(0 0 100% 0);
    translate: 0 var(--wp--preset--spacing--16);
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
    .system-chain__diagram.has-arc .system-chain__packet {
      display: block;
      animation: system-chain-travel 4.8s linear calc(var(--sc-step) * 4) infinite both paused;
    }
    .system-chain__diagram.has-arc .system-chain__packet--back {
      animation-direction: reverse;
      animation-delay: calc(var(--sc-step) * 4 + 2.4s);
    }
    /* A dot arriving sends a ring out from its disc: a copy of the disc's line spreads out and fades, the disc and
       its pictogram still (Ross, 11 Oct 2026). On the dots' clock, so arrivals and pulses stay in step: the outbound
       dot reaches the far end every 4.8 s from its first arrival, the return dot the near end 2.4 s later, and one or
       the other crosses the link's disc every 2.4 s. */
    .system-chain__diagram.has-arc .system-chain__mark {
      --sc-cycle: 4.8s;
      --sc-start: calc(var(--sc-step) * 4);
    }
    .system-chain__diagram.has-arc .system-chain__mark::after {
      content: '';
      position: absolute;
      inset: -1px;
      border: 2px solid var(--wp--custom--color--border--default);
      border-radius: var(--wp--custom--radius--full);
      opacity: 0;
      pointer-events: none;
    }
    .system-chain__diagram.has-arc .system-chain__node--b .system-chain__mark::after {
      animation: system-chain-arrive var(--sc-cycle) var(--wp--custom--motion--ease-out) calc(var(--sc-start) + var(--sc-cycle)) infinite paused;
    }
    .system-chain__diagram.has-arc .system-chain__node--a .system-chain__mark::after {
      animation: system-chain-arrive var(--sc-cycle) var(--wp--custom--motion--ease-out) calc(var(--sc-start) + var(--sc-cycle) * 1.5) infinite paused;
    }
    .system-chain__diagram.has-arc .system-chain__node--link .system-chain__mark::after {
      animation: system-chain-pass calc(var(--sc-cycle) / 2) var(--wp--custom--motion--ease-out) calc(var(--sc-start) + var(--sc-cycle) / 2) infinite paused;
    }
    /* (Two selectors: a pseudo-element can't sit inside :is(), which would drop the whole rule) */
    .system-chain__diagram.is-drawn.is-running .system-chain__packet,
    .system-chain__diagram.is-drawn.is-running .system-chain__mark::after {
      animation-play-state: running;
    }
  }
  /* The ring leaves the disc's edge at full strength and spreads to 1.5× as it fades: about 1.2 s */
  @keyframes system-chain-arrive {
    0% {
      scale: 1;
      opacity: 1;
    }
    25%,
    100% {
      scale: 1.5;
      opacity: 0;
    }
  }
  @keyframes system-chain-pass {
    0% {
      scale: 1;
      opacity: 1;
    }
    50%,
    100% {
      scale: 1.5;
      opacity: 0;
    }
  }
  @keyframes system-chain-travel {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }

  /* Below 900: one column. Each disc beside its words; a dotted line down the left from the first disc to the last,
     ending on the horizon; the platform's words under the horizon, on the words' edge */
  @media (max-width: 899px) {
    .system-chain__diagram {
      --sc-mark: 64px;
      --sc-glyph: 48px;
      --sc-row: var(--wp--preset--spacing--40);
      --sc-text-edge: calc(var(--sc-mark) + var(--wp--preset--spacing--24));
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--sc-row);
    }
    .system-chain__arc {
      display: none;
    }
    .system-chain__node {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: var(--wp--preset--spacing--24);
    }
    .system-chain__node .system-chain__mark,
    .system-chain__node .system-chain__text,
    .system-chain__base {
      grid-row: auto;
      grid-column: auto;
      justify-self: stretch;
      margin: 0;
    }
    .system-chain__body {
      max-width: none;
    }
    .system-chain__text {
      justify-items: start;
      max-width: 60ch;
      padding-top: var(--wp--preset--spacing--8);
      text-align: start;
    }
    .system-chain__base {
      padding-top: 0;
      padding-left: var(--sc-text-edge);
    }
    .system-chain__horizon {
      grid-row: auto;
      grid-column: auto;
    }
    /* The spine: from each disc's centre to the next disc's; the last runs on to the horizon */
    .system-chain__node::after {
      content: '';
      position: absolute;
      z-index: 1;
      top: calc(var(--sc-mark) / 2);
      bottom: calc(-1 * (var(--sc-row) + var(--sc-mark) / 2));
      left: calc(var(--sc-mark) / 2 - 1px);
      width: 2px;
      background-image: radial-gradient(circle, var(--wp--custom--color--text--primary) 1px, transparent 1.25px);
      background-size: 2px 6px;
      background-repeat: repeat-y;
    }
    .system-chain__node--b::after {
      bottom: calc(-1 * var(--sc-row));
    }
  }
</style>

<script>
  // The arc from the discs' measured centres: up out of the first end's disc, level through the link's, down into the
  // other end's (two quarter ellipses). The data dots ride the same path. Each diagram draws on first view; the dots
  // run only while it is on screen.
  const K = 0.5523; // cubic Bézier approximation of a quarter ellipse
  for (const diagram of document.querySelectorAll<HTMLElement>('[data-system-chain]')) {
    const svg = diagram.querySelector<SVGSVGElement>('.system-chain__arc')!;
    const path = svg.querySelector<SVGPathElement>('[data-arc]')!;
    const marks = [...diagram.querySelectorAll<HTMLElement>('[data-mark]')];
    const packets = [...diagram.querySelectorAll<HTMLElement>('[data-packet]')];
    const layout = () => {
      if (marks.length < 3) return;
      const box = diagram.getBoundingClientRect();
      // centres from the layout boxes (offset*), so the discs' landing scale doesn't move them
      const centre = (el: HTMLElement) => {
        let x = el.offsetWidth / 2;
        let y = el.offsetHeight / 2;
        for (let n: HTMLElement | null = el; n && n !== diagram; n = n.offsetParent as HTMLElement | null) {
          x += n.offsetLeft;
          y += n.offsetTop;
        }
        return [x, y];
      };
      const [[ax, ay], [sx, sy], [bx, by]] = marks.map(centre);
      const d = `M ${ax} ${ay} C ${ax} ${ay - K * (ay - sy)} ${sx - K * (sx - ax)} ${sy} ${sx} ${sy} C ${sx + K * (bx - sx)} ${sy} ${bx} ${by - K * (by - sy)} ${bx} ${by}`;
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      path.setAttribute('d', d);
      for (const p of packets) {
        p.style.offsetPath = `path("${d}")`;
        p.style.offsetAnchor = 'center';
      }
      diagram.classList.add('has-arc');
    };
    new ResizeObserver(layout).observe(diagram);
    layout();
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          diagram.classList.toggle('is-running', entry.isIntersecting);
          if (entry.isIntersecting && entry.intersectionRatio >= 0.25) diagram.classList.add('is-drawn');
        },
        { threshold: [0, 0.25] },
      );
      io.observe(diagram);
    } else diagram.classList.add('is-drawn', 'is-running');
  }
</script>
