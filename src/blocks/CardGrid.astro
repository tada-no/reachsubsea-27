---
// Card grid (manual) · reach/card-grid (docs/05 §2.2). Layout 2 columns · 3 columns · 4 columns · Featured first.
// Section header + Card instances sharing one Media/Surface for the whole grid. Gap grid/gutter both ways.
// Column spans on 12: 2 → 6, 3 → 4, 4 → 3. Featured first: row 1 = Featured (8) + Default (4), then rows of 3.
// Pictogram panel: wide (Featured) cards never share a row with narrow ones. 2 columns and Featured first
// both render as 2 columns of wide cards; 3 and 4 columns keep narrow cards.
// Cards in a row are equal height with the action pinned to the bottom (Card already does this).
// Mobile (<600): 1 column, Featured renders as Default (Card's own CSS already falls back). Tablet (600–1199): 2 columns.
// Bento (17 Sep 2026): the one layout where cards differ. Each card keeps its own Media/Surface and
// carries a `span` (cols on 12 × rows), so image, stat, news and event cards tile into one composition.
// Plan exactly as many cards as cells. Tablet: 6 columns (wide cards full width, the rest halves);
// mobile: one column.
// Strip (19 Sep 2026, Subsea single: the PDF's "Industries we serve"; Ross's "Where it's used"
// reference): one row of light tiles, each a looping line pictogram beside a short label, on
// bg/accent-subtle. Eyebrow above; no section header, no actions. 2×2 below 1200; one compact
// row per industry below 600.
// No cards → render nothing (docs/05 §0).
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Pictogram from '../components/Pictogram.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, CardField, SectionHeaderField } from '../lib/types';

interface Props extends BlockFields {
  sectionHeader?: SectionHeaderField;
  layout?: '2-columns' | '3-columns' | '4-columns' | 'featured-first' | 'bento' | 'strip';
  /** Strip: a short label above the tiles, in the container (the strip has no section header). */
  eyebrow?: string;
  /** Eyebrow auto-fills 01, 02, 03… (generated here, in the template, not a CSS counter — see report). */
  numbered?: boolean;
  /** One card look for the whole grid. */
  media?: CardField['media'];
  surface?: CardField['surface'];
  cards?: CardField[];
  /** The grid continues the block above it on the same ground (Careers, 20 Sep 2026: four value cards under their
   * text): it drops its top padding. Same-ground blocks otherwise keep both paddings. */
  joined?: boolean;
}

const {
  sectionHeader,
  layout = '3-columns',
  numbered = false,
  media = 'icon',
  surface = 'white',
  cards = [],
  eyebrow,
  joined = false,
  background,
  spacing,
  anchor,
} = Astro.props;

const hasCards = cards.length > 0;
const widePanels = media === 'pictogram-panel' && (layout === '2-columns' || layout === 'featured-first');
const resolvedLayout = widePanels ? '2-columns' : layout;
const featuredFirst = resolvedLayout === 'featured-first';
const bento = resolvedLayout === 'bento';
const strip = resolvedLayout === 'strip';
const titleId = sectionHeader?.title ? makeId('card-grid', sectionHeader.title) : undefined;
const pad = (n: number) => String(n).padStart(2, '0');

// Bento on tablet (6 columns): wide cards go full width, the rest halves and one row tall. If that leaves a hole, the
// last single-row wide card drops to a half so it fills the gap beside its neighbour; failing that,
// the last single-row card grows to full width (17 Sep 2026).
const bentoWide = cards.map((card) => (card.span?.cols ?? 4) >= 6);
if (bento) {
  const area = () => cards.reduce((sum, card, i) => sum + (bentoWide[i] ? 6 * (card.span?.rows ?? 1) : 3), 0);
  for (let i = cards.length - 1; i >= 0 && area() % 6 !== 0; i--) {
    if (bentoWide[i] && (cards[i].span?.rows ?? 1) === 1) bentoWide[i] = false;
  }
  for (let i = cards.length - 1; i >= 0 && area() % 6 !== 0; i--) {
    if (!bentoWide[i] && (cards[i].span?.rows ?? 1) === 1) bentoWide[i] = true;
  }
}
---

{
  hasCards && (
    <BlockSection
      slug="card-grid"
      root="card-grid"
      class={joined ? 'card-grid--joined' : undefined}
      background={background}
      spacing={spacing}
      anchor={anchor}
      labelledBy={titleId}
      label={titleId ? undefined : eyebrow ?? 'Card grid'}
    >
      {strip ? (
        <div class="block__body card-grid__strip">
          {eyebrow && <p class="card-grid__eyebrow text-eyebrow">{eyebrow}</p>}
          <ul class="card-grid__list card-grid__list--strip">
            {cards.map((card) => (
              <li class="card-grid__tile">
                {card.pictogram && <Pictogram name={card.pictogram} size={64} />}
                <span class="card-grid__tile-label">{card.title}</span>
              </li>
            ))}
          </ul>
        </div>
      ) : (
      <div class="block__body">
        {sectionHeader && <SectionHeader {...sectionHeader} id={titleId} />}
        <ul class:list={['card-grid__list', `card-grid__list--${resolvedLayout}`]}>
          {cards.map((card, i) =>
            bento ? (
              <li
                class:list={['card-grid__item', bentoWide[i] && 'card-grid__item--wide', (card.span?.rows ?? 1) === 1 && 'card-grid__item--short']}
                style={`--span-cols: ${card.span?.cols ?? 4}; --span-rows: ${card.span?.rows ?? 1}`}
              >
                <Card {...card} />
              </li>
            ) : (
              <li class="card-grid__item">
                <Card
                  {...card}
                  media={media}
                  surface={surface}
                  size={widePanels || (featuredFirst && i === 0) ? 'featured' : 'default'}
                  eyebrow={numbered ? pad(i + 1) : card.eyebrow}
                />
              </li>
            ),
          )}
        </ul>
      </div>
      )}
    </BlockSection>
  )
}

<style is:global>
  .card-grid__list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--wp--custom--grid--gutter);
    align-items: stretch;
  }
  .card-grid__item {
    display: flex;
  }
  .card-grid.card-grid--joined {
    padding-top: 0;
  }
  .card-grid__item > * {
    width: 100%;
  }
  /* Text-only cards in a row (Careers vacancies, 20 Sep 2026): like image-top cards, the meta line sits
     with the action at the foot, so a title that wraps one line more doesn't knock the meta out of line */
  .card-grid .card--media-none .card__meta:has(+ .card__action) {
    margin-top: auto;
  }
  .card-grid .card--media-none .card__meta + .card__action {
    margin-top: 0;
  }

  /* Bento reveal (17 Sep 2026): tiles settle into their grid cell instead of rising, since a dense
     multi-row grid has no shared "below" direction for a translate to read from. Wide cards move less
     — they already fill most of the row, so a big scale jump reads as a glitch rather than a tile
     dropping into place. */
  html.js .card-grid__list--bento .card-grid__item[data-reveal] {
    transform: scale(0.95);
  }
  html.js .card-grid__list--bento .card-grid__item--wide[data-reveal] {
    transform: scale(0.97);
  }
  html.js .card-grid__list--bento .card-grid__item[data-reveal].is-revealed {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .card-grid__list--bento .card-grid__item[data-reveal] {
      transform: none;
    }
  }

  .card-grid__list--2-columns .card-grid__item {
    grid-column: span 6;
  }
  .card-grid__list--3-columns .card-grid__item {
    grid-column: span 4;
  }
  .card-grid__list--4-columns .card-grid__item {
    grid-column: span 3;
  }
  .card-grid__list--featured-first .card-grid__item {
    grid-column: span 4;
  }
  .card-grid__list--featured-first .card-grid__item:first-child {
    grid-column: span 8;
  }

  /* Bento */
  .card-grid__list--bento {
    grid-auto-rows: minmax(264px, auto);
    grid-auto-flow: dense;
  }
  .card-grid__list--bento .card-grid__item {
    grid-column: span var(--span-cols, 4);
    grid-row: span var(--span-rows, 1);
  }
  .card-grid__list--bento .card--media-image-bg {
    min-height: 0;
  }
  /* Short image cards (one row, 17 Sep 2026): read like their text neighbours. Eyebrow at the top on
     the shared padding line, action pinned to the bottom, and a left-to-right scrim so the right of
     the photo stays clear. Tall image cards keep the bottom-up ramp and bottom-anchored text. */
  .card-grid__list--bento .card-grid__item--short .card--media-image-bg .card__content {
    flex: 1 1 auto;
    margin-top: 0;
  }
  .card-grid__list--bento .card-grid__item--short .card__overlay {
    background: linear-gradient(to right, var(--wp--custom--color--scrim--solid) 0%, rgb(27 29 59 / 0.82) 45%, rgb(27 29 59 / 0.4) 80%, var(--wp--custom--color--scrim--floor) 100%);
  }
  @media (max-width: 1199px) {
    /* Tablet: every half-width card is one row tall, so all of them take the short treatment */
    .card-grid__list--bento .card-grid__item:not(.card-grid__item--wide) .card--media-image-bg .card__content {
      flex: 1 1 auto;
      margin-top: 0;
    }
    .card-grid__list--bento .card-grid__item:not(.card-grid__item--wide) .card__overlay {
      background: linear-gradient(to right, var(--wp--custom--color--scrim--solid) 0%, rgb(27 29 59 / 0.82) 45%, rgb(27 29 59 / 0.4) 80%, var(--wp--custom--color--scrim--floor) 100%);
    }
    .card-grid__list.card-grid__list--bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .card-grid__list--bento .card-grid__item {
      grid-column: span 3;
      grid-row: span 1;
    }
    .card-grid__list--bento .card-grid__item--wide {
      grid-column: span 6;
      grid-row: span var(--span-rows, 1);
    }
  }
  @media (max-width: 599px) {
    .card-grid__list.card-grid__list--bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .card-grid__list--bento .card-grid__item,
    .card-grid__list--bento .card-grid__item--wide {
      grid-column: span 1;
      grid-row: auto;
    }
    .card-grid__list--bento .card--media-image-bg {
      min-height: 360px;
    }
    /* Phones: stacked full width, so every image card goes back to bottom-anchored text */
    .card-grid__list.card-grid__list--bento .card-grid__item .card--media-image-bg .card__content {
      flex: 0 0 auto;
      margin-top: auto;
    }
    .card-grid__list.card-grid__list--bento .card-grid__item .card__overlay {
      background: linear-gradient(to top, var(--wp--custom--color--scrim--solid) 0%, rgb(27 29 59 / 0.86) 38%, rgb(27 29 59 / 0.5) 62%, var(--wp--custom--color--scrim--floor) 100%);
    }
  }

  /* 4 columns go 2×2 below desktop: four across a tablet width leaves ~220px cards. 3 columns too
     (docs/05 §2.2, tablet 600–1199 = 2 columns): at ~1100 three text cards wrap their titles to three
     lines and their lists fall out of line (19 Sep 2026, Subsea) */
  @media (max-width: 1199px) {
    .card-grid__list--3-columns,
    .card-grid__list--4-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid__list--3-columns .card-grid__item,
    .card-grid__list--4-columns .card-grid__item {
      grid-column: span 1;
    }
  }

  @media (max-width: 899px) {
    .card-grid__list:not(.card-grid__list--bento) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid__item,
    .card-grid__list--2-columns .card-grid__item,
    .card-grid__list--3-columns .card-grid__item,
    .card-grid__list--4-columns .card-grid__item,
    .card-grid__list--featured-first .card-grid__item {
      grid-column: span 1;
    }
    .card-grid__list--featured-first .card-grid__item:first-child {
      grid-column: span 2;
    }
  }

  /* Same specificity as the 899 rule above, so phones really get one column */
  @media (max-width: 599px) {
    .card-grid__list:not(.card-grid__list--bento) {
      grid-template-columns: 1fr;
    }
    .card-grid__list:not(.card-grid__list--bento) .card-grid__item,
    .card-grid__list--2-columns .card-grid__item,
    .card-grid__list--3-columns .card-grid__item,
    .card-grid__list--4-columns .card-grid__item,
    .card-grid__list--featured-first .card-grid__item,
    .card-grid__list--featured-first .card-grid__item:first-child {
      grid-column: span 1;
    }
  }

  /* Strip: light tiles, pictogram beside a short label (tight caption leading) */
  .card-grid__strip {
    gap: var(--wp--preset--spacing--24);
  }
  /* A strip follows the section it annotates on the same ground, so it drops its top padding */
  .card-grid:has(.card-grid__strip) {
    padding-top: 0;
  }
  /* ...but not when the section before it is on a different ground (a tint or navy band, e.g. About's stats):
     then the strip starts a new section and keeps its own top padding */
  .block.has-surface-tint + .card-grid:has(.card-grid__strip),
  .block.has-surface-tint + script + .card-grid:has(.card-grid__strip),
  .block.has-surface-navy + .card-grid:has(.card-grid__strip),
  .block.has-surface-navy + script + .card-grid:has(.card-grid__strip) {
    padding-top: var(--wp--custom--section--sm);
  }
  .card-grid__eyebrow {
    margin: 0;
    color: var(--wp--custom--color--text--accent);
  }
  .card-grid__list--strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--wp--preset--spacing--16);
  }
  .card-grid__tile {
    --pg-bg: var(--wp--custom--color--bg--accent-subtle);
    display: flex;
    align-items: center;
    gap: var(--wp--preset--spacing--16);
    padding: var(--wp--preset--spacing--16) var(--wp--preset--spacing--24) var(--wp--preset--spacing--16) var(--wp--preset--spacing--16);
    border-radius: var(--wp--custom--radius--md);
    background-color: var(--pg-bg);
  }
  .card-grid__tile-label {
    font-size: var(--wp--preset--font-size--body);
    line-height: 1.3;
    font-weight: var(--wp--custom--font-weight--medium);
    color: var(--wp--custom--color--text--primary);
  }
  @media (max-width: 1199px) {
    .card-grid__list--strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Three tiles (19 Sep 2026, About certificates): three across from 600 up, so a row never has a hole or a
     lone half-width tile. 600–899: the pictogram sits above its label to fit the narrower tiles. */
  @media (min-width: 600px) {
    .card-grid__list--strip:has(> :nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 600px) and (max-width: 899px) {
    .card-grid__list--strip:has(> :nth-child(3):last-child) .card-grid__tile {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--wp--preset--spacing--16);
    }
  }
  /* Phones: one compact row per industry, pictogram beside the label (the reference's list) */
  @media (max-width: 599px) {
    .card-grid__list.card-grid__list--strip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--wp--preset--spacing--8);
    }
    .card-grid__tile {
      padding: var(--wp--preset--spacing--12) var(--wp--preset--spacing--16);
    }
    .card-grid__tile .pictogram {
      width: 48px;
      height: 48px;
    }
  }
</style>
