---
// Card grid (manual) · reach/card-grid (docs/05 §2.2). Layout 2 columns · 3 columns · 4 columns · Featured first · Strip.
// The Bento layout moved to its own block, Card bento (src/blocks/CardBento.astro), on 21 Sep 2026 (Q67).
// Section header + Card instances sharing one Media/Surface for the whole grid. Gap grid/gutter both ways.
// Column spans on 12: 2 → 6, 3 → 4, 4 → 3. Featured first: row 1 = Featured (8) + Default (4), then rows of 3.
// Pictogram panel: wide (Featured) cards never share a row with narrow ones. 2 columns and Featured first
// both render as 2 columns of wide cards; 3 and 4 columns keep narrow cards.
// Cards in a row are equal height with the action pinned to the bottom (Card already does this).
// Mobile (<600): 1 column, Featured renders as Default (Card's own CSS already falls back). Tablet (768–1199): 2 columns (4 columns: up to 1319). 1 column below 768.
// Strip (19 Sep 2026, Subsea single: the PDF's "Industries we serve"; Ross's "Where it's used"
// reference): one row of light tiles, each a looping line pictogram beside a short label, on
// bg/accent-subtle. Eyebrow above; no section header, no actions. 2×2 below 1200; one compact
// row per industry below 600.
// Rows (7 Oct 2026, Sustainability: the ESG pillars, long copy that reads badly in three narrow columns): the
// Section header full width, then one open row per item (no card box): pictogram, title and lead in cols 1–4, the
// description and note in cols 6–12 (30/70, as Accordion Split), centred on the first column. Fifth pass (Q117).
// No cards → render nothing (docs/05 §0).
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import Pictogram from '../components/Pictogram.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, CardField, SectionHeaderField } from '../lib/types';

interface Props extends BlockFields {
  sectionHeader?: SectionHeaderField;
  layout?: '2-columns' | '3-columns' | '4-columns' | 'featured-first' | 'strip' | 'rows';
  /** Rows only: `open` rows on the block's ground, or each row in a `cards` box of the given surface (Tint on White, as
   *  Why invest's value cards). */
  rowStyle?: 'open' | 'cards';
  /** Rows + cards only: the last row as a navy feature with its own layout (copy left as one column, pictogram
   *  right), for a closing item that is not one of the set: Our culture's "Never leave anyone behind" after
   *  Learn · Teach · Reach (Ross, 8 Oct 2026). */
  featureLast?: boolean;
  /** Rows + cards only: every row in the feature's mirrored layout (tag, title and copy as one column on the left,
   *  pictogram on the right), on its own surface; the feature row stays navy (Ross, 8 Oct 2026, Our culture). */
  mirrored?: boolean;
  /** Strip: a short label above the tiles, in the container (the strip has no section header). */
  eyebrow?: string;
  /** The section's accessible name when it has no section header (7 Oct 2026, HSEQ campaign steps: the cards
   * continue the block above, so a visible heading would only repeat it). */
  ariaLabel?: string;
  /** Eyebrow auto-fills 01, 02, 03… (generated here, in the template, not a CSS counter — see report). */
  numbered?: boolean;
  /** One card look for the whole grid. */
  media?: CardField['media'];
  surface?: CardField['surface'];
  cards?: CardField[];
  /** The grid continues the block above it on the same ground (Careers, 20 Sep 2026: four value cards under their
   * text): it drops its top padding. Same-ground blocks otherwise keep both paddings. */
  joined?: boolean;
}

const {
  sectionHeader,
  layout = '3-columns',
  rowStyle = 'open',
  featureLast = false,
  mirrored = false,
  numbered = false,
  media = 'icon',
  surface = 'white',
  cards = [],
  eyebrow,
  ariaLabel,
  joined = false,
  background,
  spacing,
  anchor,
} = Astro.props;

const hasCards = cards.length > 0;
const widePanels = media === 'pictogram-panel' && (layout === '2-columns' || layout === 'featured-first');
const resolvedLayout = widePanels ? '2-columns' : layout;
const featuredFirst = resolvedLayout === 'featured-first';
const rows = resolvedLayout === 'rows';
const strip = resolvedLayout === 'strip';
const titleId = sectionHeader?.title ? makeId('card-grid', sectionHeader.title) : undefined;
const pad = (n: number) => String(n).padStart(2, '0');
// Pictogram cards open up into hairline-separated rows on phones (see the CSS below)
const openRows = (media === 'icon' || media === 'pictogram-panel') && layout !== 'rows';
// Three pictogram-panel cards with lists (Services overview): at 768–1199 one column of side-by-side cards
// (panel beside the text), where three narrow columns squashed the lists (Ross, 5 Oct 2026)
const trioPanels = media === 'pictogram-panel' && cards.length === 3;
// Three text cards with lists (Monitoring's Environmental group, 6 Oct 2026): three across at 900–1199 left
// ~190–250px of text, one column of wide cards at 768–899 left them half empty, so 768–1199 is two columns with
// the third spanning both (no hole).
const trioText = media === 'none' && cards.length === 3;

---

{
  hasCards && (
    <BlockSection
      slug="card-grid"
      root="card-grid"
      class={joined ? 'card-grid--joined' : undefined}
      background={background}
      spacing={spacing}
      anchor={anchor}
      labelledBy={titleId}
      label={titleId ? undefined : ariaLabel ?? eyebrow ?? 'Card grid'}
    >
      {strip ? (
        <div class="block__body card-grid__strip">
          {eyebrow && <p class="card-grid__eyebrow text-eyebrow">{eyebrow}</p>}
          <ul class="card-grid__list card-grid__list--strip">
            {cards.map((card) => (
              <li class="card-grid__tile">
                {card.pictogram && <Pictogram name={card.pictogram} size={64} />}
                <span class="card-grid__tile-label">{card.title}</span>
              </li>
            ))}
          </ul>
        </div>
      ) : (
      <div class="block__body">
        {sectionHeader && <SectionHeader {...sectionHeader} id={titleId} />}
        <ul class:list={['card-grid__list', `card-grid__list--${resolvedLayout}`, openRows && 'card-grid__list--open', layout === 'rows' && rowStyle === 'cards' && 'card-grid__list--row-cards', widePanels && 'card-grid__list--wide', trioPanels && 'card-grid__list--trio-panels', trioText && 'card-grid__list--trio-text']}>
          {cards.map((card, i) => {
            const feature = featureLast && rows && rowStyle === 'cards' && i === cards.length - 1;
            return (
            <li class:list={['card-grid__item', feature && 'card-grid__item--feature', (feature || (mirrored && rows && rowStyle === 'cards')) && 'card-grid__item--mirrored']}>
              <Card
                {...card}
                media={media}
                surface={feature ? 'navy' : surface}
                size={widePanels || rows || (featuredFirst && i === 0) ? 'featured' : 'default'}
                eyebrow={numbered ? pad(i + 1) : card.eyebrow}
              />
            </li>
            );
          })}
        </ul>
      </div>
      )}
    </BlockSection>
  )
}

<style is:global>
  .card-grid__list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--wp--custom--grid--gutter);
    align-items: stretch;
  }
  .card-grid__item {
    display: flex;
  }
  .card-grid.card-grid--joined {
    padding-top: 0;
  }
  .card-grid__item > * {
    width: 100%;
  }
  /* Text-only cards in a row (Careers vacancies, 20 Sep 2026): like image-top cards, the meta line sits
     with the action at the foot, so a title that wraps one line more doesn't knock the meta out of line */
  .card-grid .card--media-none .card__meta:has(+ .card__action) {
    margin-top: auto;
  }
  .card-grid .card--media-none .card__meta + .card__action {
    margin-top: 0;
  }

  .card-grid__list--2-columns .card-grid__item {
    grid-column: span 6;
  }
  .card-grid__list--3-columns .card-grid__item {
    grid-column: span 4;
  }
  .card-grid__list--4-columns .card-grid__item {
    grid-column: span 3;
  }
  /* Rows (7 Oct 2026, Ross, Sustainability's ESG pillars): the Section header full width above, then one row per
     item, open or in a card (`rowStyle`). From 900 each row splits on the 12-column grid, 30/70 as Accordion Split:
     the pictogram (200, the Services overview size) and the title (H2 size) in cols 1–4; the copy (the lead's tag,
     the lead at H3 size, the description, the note) in cols 6–12, centred as one unit on the first column. Below
     900 one stack in that order. */
  .card-grid__list--rows {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--64);
  }
  .card-grid__list--rows .card {
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  /* No card edge: the row is open */
  .card-grid__list--rows .card::after {
    display: none;
  }
  .card-grid__list--rows .card__content {
    gap: 0;
    padding: 0;
  }
  .card-grid__list--rows :is(.card__text, .card__heading) {
    display: contents;
  }
  /* Row cards (Ross, 7 Oct 2026: tighter than open rows): each row in its own box, gutter apart, the same split
     inside. Tint cards on a White block, as Why invest's value cards. */
  .card-grid__list--row-cards {
    gap: var(--wp--custom--grid--gutter);
  }
  .card-grid__list--row-cards .card {
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--pg-bg);
  }
  .card-grid__list--row-cards .card__content {
    padding: var(--wp--preset--spacing--32) var(--wp--preset--spacing--24);
  }
  @media (min-width: 600px) {
    .card-grid__list--row-cards .card__content {
      padding: var(--wp--preset--spacing--48);
    }
  }
  /* 80 from 1200 (Ross, 8 Oct 2026): at full width the card carries a 200 pictogram and an H2 word, and 48 read
     tight. Below 1200 the copy column is already near its narrowest, so it keeps 48 */
  @media (min-width: 1200px) {
    .card-grid__list--row-cards .card__content {
      padding: var(--wp--preset--spacing--80);
    }
  }
  /* The pictogram at the Services overview's service-line size (Ross, 7 Oct 2026): 200 from 1200, 160 at
     768–1199, 96 below, as the pictogram panels there */
  .card-grid__list--rows .card__pictogram {
    width: 96px;
    height: 96px;
  }
  @media (min-width: 768px) {
    .card-grid__list--rows .card__pictogram {
      width: 160px;
      height: 160px;
    }
  }
  @media (min-width: 1200px) {
    .card-grid__list--rows .card__pictogram {
      width: 200px;
      height: 200px;
    }
  }
  /* Type (Ross, 7 Oct 2026, sixth pass): the pillar at H2 size beside its pictogram; on the copy side its claim as
     a large heading (H3 size) under its tag, then the description and the proof line */
  .card-grid__list--rows .card__title {
    margin-top: var(--wp--preset--spacing--24);
    font-size: var(--wp--preset--font-size--h2);
    line-height: var(--wp--custom--line-height--h2);
    letter-spacing: var(--wp--custom--letter-spacing--h2);
  }
  .card-grid__list--rows .card__lead-eyebrow {
    margin: var(--wp--preset--spacing--24) 0 0;
  }
  .card-grid__list--rows .card__lead {
    margin-top: var(--wp--preset--spacing--24);
    font-size: var(--wp--preset--font-size--h3);
    font-weight: var(--wp--custom--font-weight--bold);
    line-height: var(--wp--custom--line-height--h3);
    letter-spacing: var(--wp--custom--letter-spacing--h3);
  }
  .card-grid__list--rows .card__lead-eyebrow + .card__lead {
    margin-top: var(--wp--preset--spacing--8);
  }
  /* A tag straight over the description, no claim between (Our culture values, Ross 8 Oct 2026) */
  .card-grid__list--rows .card__lead-eyebrow + .card__description {
    margin-top: var(--wp--preset--spacing--8);
  }
  .card-grid__list--rows .card__description {
    max-width: none;
    margin-top: var(--wp--preset--spacing--16);
  }
  .card-grid__list--rows .card__note {
    max-width: none;
    margin-top: var(--wp--preset--spacing--24);
  }
  @media (min-width: 900px) {
    /* The pictogram and the pillar in cols 1–4; the copy (tag, claim, description, proof) in cols 6–12 as one unit,
       centred on them. The two flexible rows top and bottom take the difference, so the shorter side centres on
       the taller one and each side keeps its own spacing. */
    .card-grid__list--rows .card__content {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1fr auto auto 1fr;
      column-gap: var(--wp--custom--grid--gutter);
    }
    .card-grid__list--rows :is(.card__pictogram, .card__top, .card__title) {
      grid-column: 1 / span 4;
    }
    .card-grid__list--rows .card__pictogram {
      grid-row: 2;
    }
    .card-grid__list--rows .card__title {
      grid-row: 3;
    }
    .card-grid__list--rows .card__copy {
      grid-column: 6 / span 7;
      grid-row: 1 / -1;
      align-self: center;
      display: flex;
      flex-direction: column;
    }
    .card-grid__list--rows .card__copy > :first-child {
      margin-top: 0;
    }
  }
  /* Mirrored rows (the featureLast row, or every row with `mirrored`): the tag, title and copy run as one column on
     the left (cols 1–7), the pictogram sits on the right (cols 9–12), centred on the text. The feature row is also
     navy, so the closing item reads apart from the set */
  @media (min-width: 900px) {
    /* Rows: tag, title, then the lead, description and note, each on its own row (the copy box opens up so its tag
       can sit over the title, as a Section header reads; Ross, 8 Oct 2026, Our culture) */
    .card-grid__item--mirrored .card__content {
      grid-template-rows: 1fr repeat(5, auto) 1fr;
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__pictogram {
      grid-column: 9 / span 4;
      grid-row: 1 / -1;
      align-self: center;
      justify-self: end;
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__copy {
      display: contents;
    }
    .card-grid__list--rows .card-grid__item--mirrored :is(.card__lead-eyebrow, .card__title, .card__lead, .card__description, .card__note) {
      grid-column: 1 / span 7;
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__lead-eyebrow {
      grid-row: 2;
      margin: 0 0 var(--wp--preset--spacing--8);
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__title {
      grid-row: 3;
      margin-top: 0;
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__lead {
      grid-row: 4;
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__description {
      grid-row: 5;
      margin-top: var(--wp--preset--spacing--16);
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__note {
      grid-row: 6;
    }
  }
  /* Mirrored rows below 900 stack as the others, but keep their own order: the tag over the title (it sits in the
     heading's stack, so `order` lifts it) */
  @media (max-width: 899px) {
    .card-grid__list--rows .card-grid__item--mirrored .card__pictogram {
      order: -2;
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__lead-eyebrow {
      order: -1;
      margin: var(--wp--preset--spacing--24) 0 var(--wp--preset--spacing--4);
    }
    .card-grid__list--rows .card-grid__item--mirrored .card__title {
      margin-top: 0;
    }
    /* 16 under the title, as from 900 */
    .card-grid__list--rows .card-grid__item--mirrored .card__description {
      margin-top: var(--wp--preset--spacing--16);
    }
  }
  /* 900–1199: the pillar at H2 size outgrows four columns ("Environmental"), so the first column takes five and
     the copy starts a gutter after it */
  @media (min-width: 900px) and (max-width: 1199px) {
    .card-grid__list--rows :is(.card__pictogram, .card__top, .card__title) {
      grid-column: 1 / span 5;
    }
    .card-grid__list--rows .card__copy {
      grid-column: 6 / span 7;
    }
  }
  @media (min-width: 1200px) {
    .card-grid__list--rows:not(.card-grid__list--row-cards) {
      gap: var(--wp--preset--spacing--96);
    }
  }
  @media (max-width: 599px) {
    .card-grid__list--rows:not(.card-grid__list--row-cards) {
      gap: var(--wp--preset--spacing--48);
    }
  }
  .card-grid__list--featured-first .card-grid__item {
    grid-column: span 4;
  }
  .card-grid__list--featured-first .card-grid__item:first-child {
    grid-column: span 8;
  }

  /* 4 columns go 2×2 below desktop: four across a tablet width leaves ~220px cards. 3 columns too
     (docs/05 §2.2, tablet 600–1199 = 2 columns): at ~1100 three text cards wrap their titles to three
     lines and their lists fall out of line (19 Sep 2026, Subsea) */
  @media (max-width: 1199px) {
    .card-grid__list--3-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid__list--3-columns .card-grid__item {
      grid-column: span 1;
    }
  }
  /* A grid of exactly three cards (5 Oct 2026, Q79: Home's three services) never drops to 2 + 1 with a
     hole: short icon cards keep three columns down to 900, then go to one column of open rows at 768–899,
     as on phones. */
  @media (min-width: 900px) and (max-width: 1199px) {
    .card-grid__list--3-columns:has(> :nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Three pictogram-panel cards with six-item lists (Services overview, Ross 5 Oct 2026): three columns at
     900–1199 squashed every list item onto two lines, so from 768 to 1199 they are one column of
     side-by-side cards, the panel (160) beside a text column that holds the list on single lines. */
  @media (min-width: 768px) and (max-width: 1199px) {
    .card-grid .card-grid__list--3-columns.card-grid__list--trio-panels {
      grid-template-columns: 1fr;
    }
    .card-grid .card-grid__list--trio-panels .card-grid__item {
      grid-column: span 1;
    }
    .card-grid__list--trio-panels .card__content {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--wp--preset--spacing--32);
    }
    .card-grid__list--trio-panels .card__pictogram-panel {
      flex: none;
      width: 160px;
    }
    .card-grid__list--trio-panels .card__body {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
      gap: var(--wp--custom--stack--md);
    }
  }
  /* Four across only from 1320 (22 Sep 2026, Q74): at 1200–1319 four cards left ~190px of text and
     titles ran to four lines */
  @media (max-width: 1319px) {
    .card-grid__list--4-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid__list--4-columns .card-grid__item {
      grid-column: span 1;
    }
  }

  @media (max-width: 899px) {
    .card-grid .card-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid__item,
    .card-grid__list--2-columns .card-grid__item,
    .card-grid__list--3-columns .card-grid__item,
    .card-grid__list--4-columns .card-grid__item,
    .card-grid__list--featured-first .card-grid__item {
      grid-column: span 1;
    }
    .card-grid__list--featured-first .card-grid__item:first-child {
      grid-column: span 2;
    }
  }

  /* Same specificity as the 899 rule above, so phones really get one column.
     767, not 599 (22 Sep 2026): at 600–767 two cards left ~190px of text, so long descriptions ran to
     six lines and list items wrapped. One column until two cards clear ~280px of text. */
  @media (max-width: 767px) {
    .card-grid .card-grid__list {
      grid-template-columns: 1fr;
    }
    .card-grid .card-grid__list .card-grid__item,
    .card-grid__list--2-columns .card-grid__item,
    .card-grid__list--3-columns .card-grid__item,
    .card-grid__list--4-columns .card-grid__item,
    .card-grid__list--featured-first .card-grid__item,
    .card-grid__list--featured-first .card-grid__item:first-child {
      grid-column: span 1;
    }
  }
  /* Wide pictogram cards (Services' four lines) need more: one column until 900, where Card switches
     them to the pictogram beside the text once the card is 600 wide */
  @media (max-width: 899px) {
    .card-grid .card-grid__list--wide {
      grid-template-columns: 1fr;
    }
    .card-grid .card-grid__list--wide .card-grid__item {
      grid-column: span 1;
    }
  }

  /* Phones (22 Sep 2026, ref/service cards mobile.jpg): pictogram cards drop their container. A tint
     panel inside the page gutter left the text ~260 wide; as open rows they take the full column and
     a hairline between them does the separating. Light grounds only: on navy the cards keep their panels.
     Up to 767, wherever the row is one column. */
  @media (min-width: 768px) and (max-width: 899px) {
    .card-grid .card-grid__list--3-columns:has(> :nth-child(3):last-child) {
      grid-template-columns: 1fr;
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) {
      gap: 0;
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) .card-grid__item + .card-grid__item {
      border-top: 1px solid var(--wp--custom--color--border--subtle);
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) .card {
      --pg-bg: var(--wp--custom--color--bg--default);
      border-radius: 0;
      box-shadow: none;
      transform: none;
    }
    .card-grid.has-surface-tint .card-grid__list--open:has(> :nth-child(3):last-child) .card {
      --pg-bg: var(--wp--custom--color--bg--tint);
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) .card::after {
      content: none;
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) .card__content {
      padding-inline: 0;
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) .card__pictogram-panel {
      width: 96px;
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) .card-grid__item:first-child .card__content {
      padding-top: 0;
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open:has(> :nth-child(3):last-child) .card-grid__item:last-child .card__content {
      padding-bottom: 0;
    }
  }
  @media (min-width: 768px) and (max-width: 1199px) {
    /* :has() matches the three-card one-column rule above, which otherwise out-ranked this at 768–899 */
    .card-grid .card-grid__list--3-columns.card-grid__list--trio-text:has(> :nth-child(3):last-child) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid .card-grid__list--trio-text .card-grid__item:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .card-grid:not(.has-surface-navy) .card-grid__list--open {
      gap: 0;
    }
    .card-grid:not(.has-surface-navy) .card-grid__list--open .card-grid__item + .card-grid__item {
