---
// Card grid (manual) · reach/card-grid (docs/05 §2.2). Layout 2 columns · 3 columns · 4 columns · Featured first.
// Section header + Card instances sharing one Media/Surface for the whole grid. Gap grid/gutter both ways.
// Column spans on 12: 2 → 6, 3 → 4, 4 → 3. Featured first: row 1 = Featured (8) + Default (4), then rows of 3.
// Pictogram panel: wide (Featured) cards never share a row with narrow ones. 2 columns and Featured first
// both render as 2 columns of wide cards; 3 and 4 columns keep narrow cards.
// Cards in a row are equal height with the action pinned to the bottom (Card already does this).
// Mobile (<600): 1 column, Featured renders as Default (Card's own CSS already falls back). Tablet (600–1199): 2 columns.
// Bento (17 Sep 2026): the one layout where cards differ. Each card keeps its own Media/Surface and
// carries a `span` (cols on 12 × rows), so image, stat, news and event cards tile into one composition.
// Plan exactly as many cards as cells. Tablet: 6 columns (wide cards full width, the rest halves);
// mobile: one column.
// No cards → render nothing (docs/05 §0).
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, CardField, SectionHeaderField } from '../lib/types';

interface Props extends BlockFields {
  sectionHeader?: SectionHeaderField;
  layout?: '2-columns' | '3-columns' | '4-columns' | 'featured-first' | 'bento';
  /** Eyebrow auto-fills 01, 02, 03… (generated here, in the template, not a CSS counter — see report). */
  numbered?: boolean;
  /** One card look for the whole grid. */
  media?: CardField['media'];
  surface?: CardField['surface'];
  cards?: CardField[];
}

const {
  sectionHeader,
  layout = '3-columns',
  numbered = false,
  media = 'icon',
  surface = 'white',
  cards = [],
  background,
  spacing,
  anchor,
} = Astro.props;

const hasCards = cards.length > 0;
const widePanels = media === 'pictogram-panel' && (layout === '2-columns' || layout === 'featured-first');
const resolvedLayout = widePanels ? '2-columns' : layout;
const featuredFirst = resolvedLayout === 'featured-first';
const bento = resolvedLayout === 'bento';
const titleId = sectionHeader?.title ? makeId('card-grid', sectionHeader.title) : undefined;
const pad = (n: number) => String(n).padStart(2, '0');

// Bento on tablet (6 columns): wide cards go full width, the rest halves and one row tall. If that leaves a hole, the
// last single-row wide card drops to a half so it fills the gap beside its neighbour; failing that,
// the last single-row card grows to full width (17 Sep 2026).
const bentoWide = cards.map((card) => (card.span?.cols ?? 4) >= 6);
if (bento) {
  const area = () => cards.reduce((sum, card, i) => sum + (bentoWide[i] ? 6 * (card.span?.rows ?? 1) : 3), 0);
  for (let i = cards.length - 1; i >= 0 && area() % 6 !== 0; i--) {
    if (bentoWide[i] && (cards[i].span?.rows ?? 1) === 1) bentoWide[i] = false;
  }
  for (let i = cards.length - 1; i >= 0 && area() % 6 !== 0; i--) {
    if (!bentoWide[i] && (cards[i].span?.rows ?? 1) === 1) bentoWide[i] = true;
  }
}
---

{
  hasCards && (
    <BlockSection
      slug="card-grid"
      root="card-grid"
      background={background}
      spacing={spacing}
      anchor={anchor}
      labelledBy={titleId}
      label={titleId ? undefined : 'Card grid'}
    >
      <div class="block__body">
        {sectionHeader && <SectionHeader {...sectionHeader} id={titleId} />}
        <ul class:list={['card-grid__list', `card-grid__list--${resolvedLayout}`]}>
          {cards.map((card, i) =>
            bento ? (
              <li
                class:list={['card-grid__item', bentoWide[i] && 'card-grid__item--wide', (card.span?.rows ?? 1) === 1 && 'card-grid__item--short']}
                style={`--span-cols: ${card.span?.cols ?? 4}; --span-rows: ${card.span?.rows ?? 1}`}
              >
                <Card {...card} />
              </li>
            ) : (
              <li class="card-grid__item">
                <Card
                  {...card}
                  media={media}
                  surface={surface}
                  size={widePanels || (featuredFirst && i === 0) ? 'featured' : 'default'}
                  eyebrow={numbered ? pad(i + 1) : card.eyebrow}
                />
              </li>
            ),
          )}
        </ul>
      </div>
    </BlockSection>
  )
}

<style is:global>
  .card-grid__list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--wp--custom--grid--gutter);
    align-items: stretch;
  }
  .card-grid__item {
    display: flex;
  }
  .card-grid__item > * {
    width: 100%;
  }

  .card-grid__list--2-columns .card-grid__item {
    grid-column: span 6;
  }
  .card-grid__list--3-columns .card-grid__item {
    grid-column: span 4;
  }
  .card-grid__list--4-columns .card-grid__item {
    grid-column: span 3;
  }
  .card-grid__list--featured-first .card-grid__item {
    grid-column: span 4;
  }
  .card-grid__list--featured-first .card-grid__item:first-child {
    grid-column: span 8;
  }

  /* Bento */
  .card-grid__list--bento {
    grid-auto-rows: minmax(264px, auto);
    grid-auto-flow: dense;
  }
  .card-grid__list--bento .card-grid__item {
    grid-column: span var(--span-cols, 4);
    grid-row: span var(--span-rows, 1);
  }
  .card-grid__list--bento .card--media-image-bg {
    min-height: 0;
  }
  /* Short image cards (one row, 17 Sep 2026): read like their text neighbours. Eyebrow at the top on
     the shared padding line, action pinned to the bottom, and a left-to-right scrim so the right of
     the photo stays clear. Tall image cards keep the bottom-up ramp and bottom-anchored text. */
  .card-grid__list--bento .card-grid__item--short .card--media-image-bg .card__content {
    flex: 1 1 auto;
    margin-top: 0;
  }
  .card-grid__list--bento .card-grid__item--short .card__overlay {
    background: linear-gradient(to right, rgb(27 29 59 / 0.94) 0%, rgb(27 29 59 / 0.82) 45%, rgb(27 29 59 / 0.4) 80%, rgb(27 29 59 / 0.25) 100%);
  }
  @media (max-width: 1199px) {
    /* Tablet: every half-width card is one row tall, so all of them take the short treatment */
    .card-grid__list--bento .card-grid__item:not(.card-grid__item--wide) .card--media-image-bg .card__content {
      flex: 1 1 auto;
      margin-top: 0;
    }
    .card-grid__list--bento .card-grid__item:not(.card-grid__item--wide) .card__overlay {
      background: linear-gradient(to right, rgb(27 29 59 / 0.94) 0%, rgb(27 29 59 / 0.82) 45%, rgb(27 29 59 / 0.4) 80%, rgb(27 29 59 / 0.25) 100%);
    }
    .card-grid__list.card-grid__list--bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .card-grid__list--bento .card-grid__item {
      grid-column: span 3;
      grid-row: span 1;
    }
    .card-grid__list--bento .card-grid__item--wide {
      grid-column: span 6;
      grid-row: span var(--span-rows, 1);
    }
  }
  @media (max-width: 599px) {
    .card-grid__list.card-grid__list--bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .card-grid__list--bento .card-grid__item,
    .card-grid__list--bento .card-grid__item--wide {
      grid-column: span 1;
      grid-row: auto;
    }
    .card-grid__list--bento .card--media-image-bg {
      min-height: 360px;
    }
    /* Phones: stacked full width, so every image card goes back to bottom-anchored text */
    .card-grid__list.card-grid__list--bento .card-grid__item .card--media-image-bg .card__content {
      flex: 0 0 auto;
      margin-top: auto;
    }
    .card-grid__list.card-grid__list--bento .card-grid__item .card__overlay {
      background: linear-gradient(to top, rgb(27 29 59 / 0.96) 0%, rgb(27 29 59 / 0.86) 38%, rgb(27 29 59 / 0.5) 62%, rgb(27 29 59 / 0.22) 100%);
    }
  }

  /* 4 columns go 2×2 below desktop: four across a tablet width leaves ~220px cards */
  @media (max-width: 1199px) {
    .card-grid__list--4-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid__list--4-columns .card-grid__item {
      grid-column: span 1;
    }
  }

  @media (max-width: 899px) {
    .card-grid__list:not(.card-grid__list--bento) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card-grid__item,
    .card-grid__list--2-columns .card-grid__item,
    .card-grid__list--3-columns .card-grid__item,
    .card-grid__list--4-columns .card-grid__item,
    .card-grid__list--featured-first .card-grid__item {
      grid-column: span 1;
    }
    .card-grid__list--featured-first .card-grid__item:first-child {
      grid-column: span 2;
    }
  }

  /* Same specificity as the 899 rule above, so phones really get one column */
  @media (max-width: 599px) {
    .card-grid__list:not(.card-grid__list--bento) {
      grid-template-columns: 1fr;
    }
    .card-grid__list:not(.card-grid__list--bento) .card-grid__item,
    .card-grid__list--2-columns .card-grid__item,
    .card-grid__list--3-columns .card-grid__item,
    .card-grid__list--4-columns .card-grid__item,
    .card-grid__list--featured-first .card-grid__item,
    .card-grid__list--featured-first .card-grid__item:first-child {
      grid-column: span 1;
    }
  }
</style>
