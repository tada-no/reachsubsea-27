---
// Share bars · reach/share-bars (7 Oct 2026, Sustainability; proposed block, outside the 14-block budget). Replaces
// the PDF's stats bar (four equal figures with long labels) where one figure is a share that is moving.
// Third pass (7 Oct 2026, Ross's review, Q117): no panel, the share crossing half is the story, the chart says each
// thing once. Key figures that only sit near the share go in a Stats band below, not in this block.
// Layout from 900 (Ross, 7 Oct 2026): the Section header (the sentence, e.g. "More than half our revenue now comes
// from outside oil & gas") with the bars right under it in cols 1–7, and beside the pair the latest share as a ring
// in cols 9–12 (the shared Donut component, drawn and swept as Why invest's; up to 400 so its centre text has
// room), its figure ("51%") and line ("First half 2026, up from 39%") in the centre. 600–899: the heading across,
// then the bars and the ring side by side. Phones: the heading, the ring, then the bars.
// Bars (Data viz restraint): one 48-tall track per period, oldest first, on the heading's left edge with its period
// under it. Only the share is marked: sage/400 with its percentage inside; the rest of the track is a quiet colour
// with no label. The two parts are named once over the ends of the tracks (no legend). No 50% marker: the heading
// and the figure already say "more than half"; the bars show the change. Motion (data-grow in motion.ts): the
// shares grow in, top to bottom, as the chart enters; reduced motion shows them at once.
// The chart is a list for assistive tech, each bar read in full ("First half 2026: Renewables & other 51%, Oil &
// gas 49%"). Numbers come from the data (investor-results.ts), never retyped.
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Donut from '../components/Donut.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, SectionHeaderField } from '../lib/types';

interface Props extends BlockFields {
  /** The block's heading: say what the share means, as a sentence. */
  sectionHeader: SectionHeaderField;
  /** The line under the figure in the ring's centre: the period and the change, e.g. "First half 2026, up from 39%". */
  caption?: string;
  /** Names of the two parts: the share the block is about (shown over the bars), then the rest (screen readers). */
  parts: [string, string];
  /** One bar per period, oldest first; `value` is the first part's share in percent. The last is the lead figure. */
  bars: { label: string; value: number }[];
}

const { sectionHeader, caption, parts, bars = [], background, spacing, anchor } = Astro.props;
const titleId = makeId('share-bars', sectionHeader.title);
const lead = bars[bars.length - 1];
---

{
  lead && (
    <BlockSection slug="share-bars" background={background} spacing={spacing} anchor={anchor} labelledBy={titleId}>
      <div class="block__body share-bars__body">
        <div class="share-bars__main">
          <SectionHeader {...sectionHeader} id={titleId} />
          <div class="share-bars__plot">
            <p class="share-bars__names text-caption" aria-hidden="true">
              <span>{parts[0]}</span>
              <span>{parts[1]}</span>
            </p>
            <ol class="share-bars__bars" data-grow>
              {bars.map((bar, i) => (
                <li class="share-bars__bar" style={`--v: ${bar.value}; --i: ${i}`}>
                  <span class="share-bars__track" aria-hidden="true">
                    <span class="share-bars__share">{bar.value}%</span>
                  </span>
                  <span class="share-bars__period text-caption" aria-hidden="true">{bar.label}</span>
                  <span class="visually-hidden">
                    {bar.label}: {parts[0]} {bar.value}%, {parts[1]} {100 - bar.value}%
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <div class="share-bars__donut">
          <Donut parts={[{ label: parts[1], value: 100 - lead.value }, { label: parts[0], value: lead.value }]} lead={`${lead.value}%`} leadStyle="figure" text={caption} />
        </div>
      </div>
    </BlockSection>
  )
}

<style is:global>
  /* Phones: the heading, the ring (the headline figure), then the bars. The left column's wrapper steps aside
     (display: contents) so the ring can sit between its heading and bars. */
  .share-bars__body {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--xl);
  }
  .share-bars__main {
    display: contents;
  }
  .share-bars__plot {
    order: 1;
  }
  /* The latest share as a ring (the shared Donut, as Why invest), its figure and line in the centre */
  .share-bars__donut {
    width: min(100%, 280px);
  }

  /* Plot: the two parts named once over the ends of the tracks, each track on the heading's left edge with
     its period under it (Ross, 7 Oct 2026) */
  .share-bars__plot {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--12);
    min-width: 0;
  }
  .share-bars__names {
    display: flex;
    justify-content: space-between;
    gap: var(--wp--preset--spacing--16);
    margin: 0;
    color: var(--wp--custom--color--text--secondary);
  }
  .share-bars__bars {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--24);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .share-bars__bar {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
  }
  .share-bars__period {
    color: var(--wp--custom--color--text--secondary);
  }
  /* Track: the rest of the whole, quiet; the share grows over it from the left */
  .share-bars__track {
    display: flex;
    height: var(--wp--preset--spacing--48);
    overflow: hidden;
    border-radius: var(--wp--custom--radius--sm);
    /* The counterpart (oil & gas) in the ring's navy/100 */
    background-color: var(--wp--preset--color--navy-100);
  }
  .share-bars__share {
    display: flex;
    align-items: center;
    width: calc(var(--v) * 1%);
    min-width: 0;
    padding-inline: var(--wp--preset--spacing--16);
    overflow: hidden;
    white-space: nowrap;
    background-color: var(--wp--preset--color--sage-400);
    font-size: var(--wp--preset--font-size--body-sm);
    font-weight: var(--wp--custom--font-weight--bold);
    line-height: var(--wp--custom--line-height--tight);
    font-variant-numeric: tabular-nums;
    color: var(--wp--preset--color--navy-900);
    transition:
      width 1.1s var(--wp--custom--motion--ease-out),
      padding 1.1s var(--wp--custom--motion--ease-out);
    transition-delay: calc(0.15s + var(--i) * var(--wp--custom--motion--stagger));
  }
  /* Grow (motion.ts initGrow): JS on, each share waits at nothing, then grows in */
  html.js .share-bars__bars[data-grow]:not(.is-grown) .share-bars__share {
    width: 0;
    padding-inline: 0;
    transition-duration: 0s;
  }

  /* 600–899 (Ross, 7 Oct 2026): the heading across, then the bars and the ring side by side */
  @media (min-width: 600px) and (max-width: 899px) {
    .share-bars__body {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--wp--custom--grid--gutter);
      row-gap: var(--wp--custom--stack--lg);
      align-items: center;
    }
    .share-bars__body .section-header {
      grid-column: 1 / -1;
    }
    .share-bars__plot {
      grid-column: 1 / span 7;
      grid-row: 2;
    }
    .share-bars__donut {
      grid-column: 8 / span 5;
      grid-row: 2;
      justify-self: end;
      width: min(100%, 280px);
    }
  }
  /* From 900: the heading with the bars right under it in cols 1–7 (the heading keeps two lines at 1440), the
     ring beside the pair in cols 9–12, centred on it */
  @media (min-width: 900px) {
    .share-bars__body {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--wp--custom--grid--gutter);
      align-items: center;
    }
    .share-bars__main {
      grid-column: 1 / span 7;
      display: flex;
      flex-direction: column;
      gap: var(--wp--custom--stack--lg);
    }
    .share-bars__donut {
      grid-column: 9 / span 4;
      justify-self: end;
      width: min(100%, 400px);
    }
  }
  /* Phones: a smaller ring */
  @media (max-width: 599px) {
    .share-bars__donut {
      width: min(100%, 240px);
    }
  }
</style>
