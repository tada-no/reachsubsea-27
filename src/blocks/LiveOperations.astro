---
// Live operations · reach/live-operations (PROTOTYPE, 17 Sep 2026, not in docs/05 yet).
// Where Reach's assets are working now, by sea region: never vessel positions (docs/07-live-operations.md).
// Distinct from the 3D World embed: those zones are illustrative scenes; these regions are real work.
//
// Layout: status + count headline, filters above the map, region list in its own column. The list IS the
// content (an <ol> of disclosure buttons, readable with no JS, no CSS, no map); the map is a picture of
// the list, and its markers are pointer shortcuts to the list buttons. No on-page "by region, not position"
// note (17 Sep 2026): the freshness is in the status line and the region level is enforced by the data
// and the zoom cap, not by a sentence.
//
// Map (17 Sep 2026, user decision): an interactive GL map like the dev site's Contact map — zoom
// controls inside the map, drag to pan, clusters that split as you zoom. Prototype runs MapLibre GL
// (open-source fork of Mapbox GL, same API, no access token) with no tiles at all: MapLibre handles
// the camera, gestures and clustering, and the land is the brand dot matrix drawn on a canvas overlay
// (a solid 'like Contact' style was reviewed and dropped); production can swap to mapbox-gl + the dev
// site's style (docs/07 §3). Markers are HTML, so the pulse and the dashed cluster ring are plain CSS.
// Zoom is capped at region level.
// Dots (22 Sep 2026): a screen-fixed hex grid; a dot is drawn where its centre falls on land in a
// Mercator land mask (/data/land-mask.png, 23 KB), so nothing is ever cut at a coastline. The static
// poster is the same grid, tested against the same mask at build time, in the same framing
// (src/lib/dot-map.ts), so the fade from poster to live map shows no jump. `dots` picks the density
// (Regular, chosen 22 Sep 2026 over Fine and Finer, Q72).
// Performance: the poster renders first; MapLibre (JS + CSS) and the mask only load when the block
// nears the viewport, then the live map fades in over the poster.
// Shared (22 Sep 2026): the map itself (poster, camera, dot overlay, markers, clusters, zoom pill,
// reduced motion) is DotMap.astro + src/lib/dot-map-client.ts, also used by the Contact page's
// Offices map. This block owns the status line, filters, region list and the Live/Stale/Unavailable
// state, and drives the map through the handle createDotMap() returns.
//
// States: live · stale (feed older than STALE_AFTER_HOURS) · unavailable (no feed: static map only).
// The script re-checks staleness in the browser, because a cached WordPress page can outlive its data.
import BlockSection from '../components/BlockSection.astro';
import FilterChip from '../components/FilterChip.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import Link from '../components/Link.astro';
import DotMap from '../components/DotMap.astro';
import DotMapZoom from '../components/DotMapZoom.astro';
import { makeId } from '../lib/ids';
import type { DotPreset } from '../lib/dot-map';
import { assetTypes, STALE_AFTER_HOURS, type LiveOperationsFeed } from '../data/live-operations';
import type { BlockFields, LinkField } from '../lib/types';

export type LiveOpsState = 'live' | 'stale' | 'unavailable';

interface Props extends BlockFields {
  /** The feed. Omit (or pass no regions) for the Unavailable state. */
  feed?: LiveOperationsFeed;
  /** Force a state for review. Omit in production: it is derived from `feed.updatedAt`. */
  state?: LiveOpsState;
  intro?: string;
  showFilters?: boolean;
  /** Unavailable state fallback, from Key figures (`countries`). */
  fallbackFigure?: { value: string; label: string };
  action?: LinkField;
  /** Show the "Sample data" badge (prototype only). */
  sample?: boolean;
  /** Dot density of the land (src/lib/dot-map.ts DOT_PRESETS). */
  dots?: DotPreset;
}

const {
  feed,
  state: forcedState,
  // No default intro (17 Sep 2026): the filter chips already name the asset types, and the privacy
  // point lives in the note under the list. Optional field for pages that need context.
  intro,
  showFilters = true,
  fallbackFigure = { value: '9', label: 'countries' },
  action = { label: 'See our assets', url: '/assets/' },
  sample = false,
  dots = 'regular',
  background = 'navy',
  spacing = 'lg',
  anchor = 'live-operations',
} = Astro.props;

const regions = feed?.regions.filter((r) => r.operations.length > 0) ?? [];
const updatedAt = feed ? new Date(feed.updatedAt) : undefined;
const ageHours = updatedAt ? (Date.now() - updatedAt.getTime()) / 36e5 : Infinity;
const state: LiveOpsState =
  forcedState ?? (regions.length === 0 ? 'unavailable' : ageHours > STALE_AFTER_HOURS ? 'stale' : 'live');

const titleId = makeId('live-ops', 'title');
const uid = anchor;
const n = regions.length;
const regionWord = (count: number) => (count === 1 ? 'region' : 'regions');

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dateFmt = { format: (d: Date) => `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}` };
const timeFmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
const statusText = updatedAt
  ? state === 'stale'
    ? `Last confirmed ${dateFmt.format(updatedAt)}`
    : `Updated ${dateFmt.format(updatedAt)}, ${timeFmt.format(updatedAt)} UTC`
  : '';

const counts = Object.fromEntries(
  assetTypes.map((t) => [t.key, regions.reduce((sum, r) => sum + r.operations.filter((o) => o.type === t.key).length, 0)]),
);
const totalAssets = regions.reduce((sum, r) => sum + r.operations.length, 0);

// Region points for the map. Label points are whole degrees (docs/07 §2): never a vessel position.
// `count` = assets in the region (shown in the marker; clusters add them up).
const mapData = regions.map((r) => ({ id: r.id, name: r.name, lon: r.lon, lat: r.lat, count: r.operations.length }));

const mapSummary =
  state === 'unavailable'
    ? 'World map.'
    : `Map of ${n} active ${regionWord(n)}: ${regions.map((r) => r.name).join(', ')}. Details in the list.`;
const typeOf = (type: string) => assetTypes.find((t) => t.key === type)!;
---

<BlockSection
  slug="live-operations"
  root="live-ops"
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
  data-live-ops
  data-state={state}
  data-state-forced={forcedState ? '' : undefined}
  data-updated={feed?.updatedAt}
  data-stale-hours={STALE_AFTER_HOURS}
  data-dots={dots}
>
  <div class="live-ops__layout">
    <header class="live-ops__head">
      <p class="live-ops__status text-label">
        {state !== 'unavailable' && <span class="live-ops__beacon" aria-hidden="true" />}
        {state === 'live' && <span class="live-ops__status-live">Live</span>}
        {state !== 'unavailable' && <span data-live-ops-status>{statusText}</span>}
        {sample && <Badge label="Sample data" tone="accent" />}
      </p>

      {
        state === 'unavailable' ? (
          <h2 id={titleId} class="live-ops__title text-h2">
            Working across <span class="live-ops__count">{fallbackFigure.value}</span> {fallbackFigure.label}
          </h2>
        ) : (
          <h2 id={titleId} class="live-ops__title text-h2">
            <span data-live-ops-prefix>{state === 'stale' ? 'Recently active in' : 'Active in'}</span>{' '}
            <span class="live-ops__count" data-live-ops-count>{n}</span>{' '}
            <span data-live-ops-word>{regionWord(n)}</span>
            <span data-live-ops-suffix>{state === 'live' ? ' today' : ''}</span>
          </h2>
        )
      }

      {
        state === 'unavailable' ? (
          <p class="live-ops__intro text-lead">
            Subsea, survey and monitoring work for offshore energy and infrastructure clients worldwide.
          </p>
        ) : (
          intro && <p class="live-ops__intro text-lead">{intro}</p>
        )
      }
      <p class="visually-hidden" aria-live="polite" data-live-ops-announce></p>
    </header>

    {
      state !== 'unavailable' && (
        <div class="live-ops__toolbar">
          {showFilters && (
            <div class="live-ops__filters" role="group" aria-label="Show asset type">
              <FilterChip label="All" count={totalAssets} selected data-live-ops-filter="all" />
              {assetTypes.map((t) => (
                <FilterChip label={t.filter} count={counts[t.key]} disabled={counts[t.key] === 0} data-live-ops-filter={t.key} />
              ))}
            </div>
          )}
          {/* Zoom, in the toolbar row (17 Sep 2026): the shared pill, enabled once the map has loaded */}
          <DotMapZoom class="live-ops__controls" data-live-ops-controls />
        </div>
      )
    }

    {/* The map: poster first, live map over it once the script loads. Pulse only while Live. */}
    <DotMap
      class="live-ops__map"
      points={state !== 'unavailable' ? mapData : undefined}
      summary={mapSummary}
      dots={dots}
      pulse={state === 'live'}
      data-live-ops-map=""
    />

    <div class="live-ops__side">
      {
        state !== 'unavailable' ? (
          <ol class="live-ops__regions" data-live-ops-regions>
            {regions.map((r) => {
              const panelId = `${uid}-${r.id}`;
              return (
                <li class="live-ops__region" data-live-ops-region={r.id}>
                  <h3 class="live-ops__region-heading">
                    <button type="button" class="live-ops__region-toggle" aria-expanded="false" aria-controls={panelId} data-live-ops-toggle={r.id}>
                      <span class="live-ops__region-name text-h5">{r.name}</span>
                      <span class="live-ops__region-meta">
                        <span class="live-ops__region-area text-small">{r.area}</span>
                        <span class="live-ops__region-types" aria-hidden="true">
                          {assetTypes
                            .filter((t) => r.operations.some((o) => o.type === t.key))
                            .map((t) => (
                              <span class="live-ops__type-dot" data-type={t.key} title={t.filter}>
                                <Icon name={t.icon} size={14} />
                              </span>
                            ))}
                        </span>
                      </span>
                      <span class="visually-hidden" data-live-ops-region-count>
                        , {r.operations.length} {r.operations.length === 1 ? 'asset' : 'assets'}
                      </span>
                      <Icon name="chevron-down" size={20} class="live-ops__chevron" />
                    </button>
                  </h3>
                  <div class="live-ops__panel" id={panelId} hidden>
                    <ul class="live-ops__ops">
                      {r.operations.map((o) => (
                        <li class="live-ops__op" data-type={o.type}>
                          <span class="live-ops__op-icon" aria-hidden="true">
                            <Icon name={typeOf(o.type).icon} size={16} />
                          </span>
                          <span class="live-ops__op-text">
                            <span class="live-ops__op-asset text-label">
                              {o.assetUrl ? <a href={o.assetUrl}>{o.asset}</a> : o.asset}
                              <span class="visually-hidden">, {typeOf(o.type).label}</span>
                            </span>
                            <span class="live-ops__op-scope text-small">{o.scope}</span>
                            <span class="live-ops__op-meta text-caption">
                              {o.sector}
                              {o.since && ` · Since ${o.since}`}
                            </span>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="live-ops__fallback text-body">Current operations aren't available right now. See the fleet and where we have worked.</p>
        )
      }

      <div class="live-ops__foot">
        {action && <Link label={action.label} href={action.url} action={action.action ?? 'page'} />}
      </div>
    </div>
  </div>
</BlockSection>

<script>
  import { createDotMap } from '../lib/dot-map-client';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  /** Region level: never close enough to read as a position. */
  const MAX_ZOOM = 5;
  /** Zoom when a region is opened from the list or a marker: its sea area with context around it. */
  const REGION_ZOOM = 3.5;
  /** Clusters split from this zoom up. */
  const CLUSTER_MAX_ZOOM = 2;

  function initLiveOps(root: HTMLElement) {
    root.classList.add('is-enhanced');
    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-live-ops-toggle]')];
    const toggleFor = (id: string) => toggles.find((t) => t.dataset.liveOpsToggle === id);
    const rowFor = (id: string) => toggleFor(id)?.closest<HTMLElement>('li');
    const announce = root.querySelector<HTMLElement>('[data-live-ops-announce]');
    const say = (text: string) => announce && (announce.textContent = text);
    const figure = root.querySelector<HTMLElement>('[data-live-ops-map]')!;

    /** Assets shown per region under the current filter. */
    const shownBy: Record<string, number> = {};
    toggles.forEach((t) => {
      const id = t.dataset.liveOpsToggle!;
      shownBy[id] = rowFor(id)!.querySelectorAll('.live-ops__op').length;
    });

    // ── Staleness re-check (a cached page can outlive its data) ────────────────
    const updated = root.dataset.updated ? new Date(root.dataset.updated) : undefined;
    const staleHours = Number(root.dataset.staleHours ?? 72);
    if (updated && root.dataset.state === 'live' && !('stateForced' in root.dataset)) {
      const hours = (Date.now() - updated.getTime()) / 36e5;
      const status = root.querySelector<HTMLElement>('[data-live-ops-status]');
      if (hours > staleHours) {
        root.dataset.state = 'stale';
        figure.classList.remove('dot-map--pulse');
        root.querySelector('[data-live-ops-prefix]')!.textContent = 'Recently active in';
        root.querySelector('[data-live-ops-suffix]')!.textContent = '';
        root.querySelector('.live-ops__status-live')?.remove();
        const month = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split(' ')[updated.getUTCMonth()];
        if (status) status.textContent = `Last confirmed ${updated.getUTCDate()} ${month} ${updated.getUTCFullYear()}`;
      } else if (status && hours >= 0) {
        const h = Math.floor(hours);
        status.textContent = h < 1 ? 'Updated within the hour' : `Updated ${h} ${h === 1 ? 'hour' : 'hours'} ago`;
      }
    }

    // ── Map (shared; loads lazily when the figure nears the viewport) ───────────
    const dotMap = createDotMap(figure, {
      controls: root.querySelector<HTMLElement>('[data-live-ops-controls]'),
      maxZoom: MAX_ZOOM,
      focusZoom: REGION_ZOOM,
      fitMaxZoom: 3.5,
      clusterMaxZoom: CLUSTER_MAX_ZOOM,
      clusterRadius: 48,
      showCount: 'always',
      clusterLabel: (n) => `${n} regions`,
      countOf: (id) => shownBy[id] ?? 0,
      announce: say,
      // A marker click opens (or closes) its row and moves focus there
      onSelect: (id) => {
        const t = toggleFor(id);
        if (!t) return;
        select(t.getAttribute('aria-expanded') === 'true' ? null : id);
        t.focus({ preventScroll: true });
        if (window.matchMedia('(min-width: 900px)').matches)
          t.closest('li')!.scrollIntoView({ block: 'nearest', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      },
      onHover: (ids, on) => ids.forEach((id) => rowFor(id)?.classList.toggle('is-hover', on)),
    });
    // Debug handle for review tooling (harmless in production)
    Object.defineProperty(root, 'liveOpsMap', { get: () => dotMap.map, configurable: true });

    let currentFilter = 'all';
    /** Frame whatever the filter leaves on the map ("All" = the home view). */
    const fitToShown = (all: boolean) => {
      const shown = Object.keys(shownBy).filter((id) => shownBy[id] > 0);
      if (all || shown.length === 0) dotMap.fitHome();
      else dotMap.fitTo(shown);
    };

    // ── Region selection: one open at a time; list and map stay in sync ────────
    function select(id: string | null, moveMap = true) {
      toggles.forEach((t) => {
        const open = t.dataset.liveOpsToggle === id;
        t.setAttribute('aria-expanded', String(open));
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !open;
        t.closest('li')!.classList.toggle('is-open', open);
      });
      root.classList.toggle('has-selection', id !== null);
      dotMap.setActive(id);
      // Opening a row always takes the map to that region, at region level (never closer)
      if (id && moveMap) dotMap.flyTo(id);
      // Closing the open row returns to the current filter's view
      else if (!id && moveMap) fitToShown(currentFilter === 'all');
    }

    toggles.forEach((t) => {
      const id = t.dataset.liveOpsToggle!;
      t.addEventListener('click', () => select(t.getAttribute('aria-expanded') === 'true' ? null : id));
      const li = t.closest<HTMLElement>('li')!;
      const hover = (on: boolean) => dotMap.setHover(on ? [id] : []);
      li.addEventListener('pointerenter', () => hover(true));
      li.addEventListener('pointerleave', () => hover(false));
      t.addEventListener('focus', () => hover(true));
      t.addEventListener('blur', () => hover(false));
    });

    // ── Asset-type filter ───────────────────────────────────────────────────────
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-live-ops-filter]')];
    filters.forEach((f) =>
      f.addEventListener('click', () => {
        const type = f.dataset.liveOpsFilter!;
        currentFilter = type;
        filters.forEach((b) => b.setAttribute('aria-pressed', String(b === f)));
        let visible = 0;
        root.querySelectorAll<HTMLElement>('[data-live-ops-region]').forEach((li) => {
          const ops = [...li.querySelectorAll<HTMLElement>('.live-ops__op')];
          let shown = 0;
          ops.forEach((op) => {
            const match = type === 'all' || op.dataset.type === type;
            op.hidden = !match;
            if (match) shown += 1;
          });
          const id = li.dataset.liveOpsRegion!;
          shownBy[id] = shown;
          li.hidden = shown === 0;
          li.querySelectorAll<HTMLElement>('.live-ops__type-dot').forEach((d) =>
            d.classList.toggle('is-dim', type !== 'all' && d.dataset.type !== type),
          );
          const count = li.querySelector('[data-live-ops-region-count]');
          if (count) count.textContent = `, ${shown} ${shown === 1 ? 'asset' : 'assets'}`;
          if (shown === 0 && li.classList.contains('is-open')) select(null, false);
          if (shown > 0) visible += 1;
        });
        dotMap.refresh();
        fitToShown(type === 'all');
        const word = visible === 1 ? 'region' : 'regions';
        root.querySelector('[data-live-ops-count]')!.textContent = String(visible);
        root.querySelector('[data-live-ops-word]')!.textContent = word;
        const label = f.querySelector('.filter-chip__label')?.textContent ?? '';
        say(type === 'all' ? `Showing all ${visible} ${word}` : `${label}: ${visible} ${word}`);
      }),
    );
  }

  document.querySelectorAll<HTMLElement>('[data-live-ops]').forEach(initLiveOps);
</script>

<style is:global>
  .live-ops {
    overflow: clip;
  }
  /* Desktop: head across the top; filters + map in the main column, region list beside them */
  .live-ops__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    grid-template-rows: auto auto 1fr;
    grid-template-areas:
      'head head'
      'filters side'
      'map side';
    column-gap: var(--wp--preset--spacing--64);
    align-items: start;
  }

  /* ── Head ─────────────────────────────────────────────── */
  .live-ops__head {
    grid-area: head;
    display: grid;
    gap: var(--wp--preset--spacing--16);
    margin-bottom: var(--wp--preset--spacing--40);
  }
  .live-ops__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--8) var(--wp--preset--spacing--12);
    color: var(--wp--custom--color--text--secondary);
  }
  .live-ops__status-live {
    color: var(--wp--custom--color--text--accent);
    font-weight: var(--wp--custom--font-weight--bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .live-ops__beacon {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: var(--wp--custom--radius--full);
    background-color: var(--wp--custom--color--border--accent);
  }
  .live-ops[data-state='stale'] .live-ops__beacon {
    background-color: var(--wp--custom--color--text--disabled);
  }
  .live-ops[data-state='live'] .live-ops__beacon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: inherit;
    animation: live-ops-ping 2.4s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }
  .live-ops__title {
    color: var(--wp--custom--color--text--primary);
    text-wrap: balance;
  }
  .live-ops__count {
    color: var(--wp--custom--color--text--accent);
    font-variant-numeric: tabular-nums;
  }
  .live-ops__intro {
    color: var(--wp--custom--color--text--secondary);
  }
  /* Toolbar: filter chips on the left, zoom on the right, above the map */
  .live-ops__toolbar {
    grid-area: filters;
    display: flex;
    align-items: center;
    gap: var(--wp--preset--spacing--16);
    margin-bottom: var(--wp--preset--spacing--24);
  }
  .live-ops__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wp--preset--spacing--8);
    min-width: 0;
  }

  /* ── Map (DotMap.astro) ──────────────────────────────── */
  .live-ops__map {
    grid-area: map;
  }
  /* Zoom pill (DotMapZoom.astro) at the end of the toolbar row */
  .live-ops__controls {
    margin-inline-start: auto;
  }

  /* ── Region list ──────────────────────────────────────── */
  .live-ops__side {
    grid-area: side;
    display: grid;
    gap: var(--wp--preset--spacing--24);
  }
  .live-ops__regions {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .live-ops__region {
    border-bottom: 1px solid var(--wp--custom--color--border--subtle);
    transition: background-color 200ms var(--wp--custom--motion--easing);
  }
  /* Only between rows — nothing above the first or below the last, both already bounded by
     other spacing (the head above, "See our assets" below). */
  .live-ops__region:last-child {
    border-bottom: none;
  }
  .live-ops__region.is-hover {
    background-color: var(--wp--custom--color--alpha--navy-8);
  }
  .live-ops.has-surface-navy .live-ops__region.is-hover {
    background-color: color-mix(in srgb, var(--wp--preset--color--white) 5%, transparent);
  }
  /* Open (persistent) or keyboard-focused (transient, from Tab or a marker click moving
     focus here): a solid fill reads better here than the sage focus outline, which looked
     like a stray line rather than a highlighted row. Rounded on all four corners, so the
     hairline above and below has to give way too (this rule and the two around it). */
  .live-ops__region.is-open,
  .live-ops__region:has(.live-ops__region-toggle:focus-visible) {
    background-color: var(--wp--custom--color--alpha--navy-16);
    border-radius: var(--wp--custom--radius--md);
    border-bottom-color: transparent;
  }
  .live-ops.has-surface-navy .live-ops__region.is-open,
  .live-ops.has-surface-navy .live-ops__region:has(.live-ops__region-toggle:focus-visible) {
    background-color: var(--wp--preset--color--navy-900);
  }
  .live-ops__region:has(+ .live-ops__region:is(.is-open, :has(.live-ops__region-toggle:focus-visible))) {
    border-bottom-color: transparent;
  }
  .live-ops__region-heading {
    margin: 0;
  }
  /* Two lines per row: name, then area + asset-type icons */
  .live-ops__region-toggle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name chevron' 'meta meta';
    align-items: center;
    column-gap: var(--wp--preset--spacing--12);
    row-gap: var(--wp--preset--spacing--4);
    width: 100%;
    padding: var(--wp--preset--spacing--16);
    text-align: start;
    color: var(--wp--custom--color--text--primary);
  }
  /* The fill above (on .live-ops__region) is the focus indicator here, so the row's own
