---
// Live operations · reach/live-operations (PROTOTYPE, 17 Sep 2026, not in docs/05 yet).
// Where Reach's assets are working now, by sea region: never vessel positions (docs/07-live-operations.md).
// Distinct from the 3D World embed: those zones are illustrative scenes; these regions are real work.
//
// Layout: status + count headline, filters above the map, region list in its own column. The list IS the
// content (an <ol> of disclosure buttons, readable with no JS, no CSS, no map); the map is a picture of
// the list, and its markers are pointer shortcuts to the list buttons. No on-page "by region, not position"
// note (17 Sep 2026): the freshness is in the status line and the region level is enforced by the data
// and the zoom cap, not by a sentence.
//
// Map (17 Sep 2026, user decision): an interactive GL map like the dev site's Contact map — zoom
// controls inside the map, drag to pan, clusters that split as you zoom. Prototype runs MapLibre GL
// (open-source fork of Mapbox GL, same API, no access token) on a local Natural Earth style: land as
// the brand dot matrix, coloured from the tokens (a solid 'like Contact' style was reviewed and dropped); production can swap to mapbox-gl + the dev site's style (docs/07 §3). Markers are
// HTML, so the pulse and the dashed cluster ring are plain CSS. Zoom is capped at region level.
// Performance: a static dot-matrix map renders first; MapLibre (JS + CSS + ~45 KB GeoJSON) only loads
// when the block nears the viewport, then fades in over the poster.
//
// States: live · stale (feed older than STALE_AFTER_HOURS) · unavailable (no feed: static map only).
// The script re-checks staleness in the browser, because a cached WordPress page can outlive its data.
import BlockSection from '../components/BlockSection.astro';
import FilterChip from '../components/FilterChip.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import Link from '../components/Link.astro';
import { makeId } from '../lib/ids';
import { WORLD_BOX, worldDotsPath } from '../lib/world-dots';
import { assetTypes, STALE_AFTER_HOURS, type LiveOperationsFeed } from '../data/live-operations';
import type { BlockFields, LinkField } from '../lib/types';

export type LiveOpsState = 'live' | 'stale' | 'unavailable';

interface Props extends BlockFields {
  /** The feed. Omit (or pass no regions) for the Unavailable state. */
  feed?: LiveOperationsFeed;
  /** Force a state for review. Omit in production: it is derived from `feed.updatedAt`. */
  state?: LiveOpsState;
  intro?: string;
  showFilters?: boolean;
  /** Unavailable state fallback, from Key figures (`countries`). */
  fallbackFigure?: { value: string; label: string };
  action?: LinkField;
  /** Show the "Sample data" badge (prototype only). */
  sample?: boolean;
}

const {
  feed,
  state: forcedState,
  // No default intro (17 Sep 2026): the filter chips already name the asset types, and the privacy
  // point lives in the note under the list. Optional field for pages that need context.
  intro,
  showFilters = true,
  fallbackFigure = { value: '9', label: 'countries' },
  action = { label: 'See our assets', url: '/assets/' },
  sample = false,
  background = 'navy',
  spacing = 'lg',
  anchor = 'live-operations',
} = Astro.props;

const regions = feed?.regions.filter((r) => r.operations.length > 0) ?? [];
const updatedAt = feed ? new Date(feed.updatedAt) : undefined;
const ageHours = updatedAt ? (Date.now() - updatedAt.getTime()) / 36e5 : Infinity;
const state: LiveOpsState =
  forcedState ?? (regions.length === 0 ? 'unavailable' : ageHours > STALE_AFTER_HOURS ? 'stale' : 'live');

const titleId = makeId('live-ops', 'title');
const uid = anchor;
const n = regions.length;
const regionWord = (count: number) => (count === 1 ? 'region' : 'regions');

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dateFmt = { format: (d: Date) => `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}` };
const timeFmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' });
const statusText = updatedAt
  ? state === 'stale'
    ? `Last confirmed ${dateFmt.format(updatedAt)}`
    : `Updated ${dateFmt.format(updatedAt)}, ${timeFmt.format(updatedAt)} UTC`
  : '';

const counts = Object.fromEntries(
  assetTypes.map((t) => [t.key, regions.reduce((sum, r) => sum + r.operations.filter((o) => o.type === t.key).length, 0)]),
);
const totalAssets = regions.reduce((sum, r) => sum + r.operations.length, 0);

// Region points for the map. Label points are whole degrees (docs/07 §2): never a vessel position.
const mapData = regions.map((r) => ({ id: r.id, name: r.name, lon: r.lon, lat: r.lat }));

const mapSummary =
  state === 'unavailable'
    ? 'World map.'
    : `Map of ${n} active ${regionWord(n)}: ${regions.map((r) => r.name).join(', ')}. Details in the list.`;
const typeOf = (type: string) => assetTypes.find((t) => t.key === type)!;
const wb = WORLD_BOX;
---

<BlockSection
  slug="live-operations"
  root="live-ops"
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
  data-live-ops
  data-state={state}
  data-state-forced={forcedState ? '' : undefined}
  data-updated={feed?.updatedAt}
  data-stale-hours={STALE_AFTER_HOURS}
>
  <div class="live-ops__layout">
    <header class="live-ops__head">
      <p class="live-ops__status text-label">
        {state !== 'unavailable' && <span class="live-ops__beacon" aria-hidden="true" />}
        {state === 'live' && <span class="live-ops__status-live">Live</span>}
        {state !== 'unavailable' && <span data-live-ops-status>{statusText}</span>}
        {sample && <Badge label="Sample data" tone="accent" />}
      </p>

      {
        state === 'unavailable' ? (
          <h2 id={titleId} class="live-ops__title text-h2">
            Working across <span class="live-ops__count">{fallbackFigure.value}</span> {fallbackFigure.label}
          </h2>
        ) : (
          <h2 id={titleId} class="live-ops__title text-h2">
            <span data-live-ops-prefix>{state === 'stale' ? 'Recently active in' : 'Active in'}</span>{' '}
            <span class="live-ops__count" data-live-ops-count>{n}</span>{' '}
            <span data-live-ops-word>{regionWord(n)}</span>
            <span data-live-ops-suffix>{state === 'live' ? ' today' : ''}</span>
          </h2>
        )
      }

      {
        state === 'unavailable' ? (
          <p class="live-ops__intro text-lead">
            Subsea, survey and monitoring work for offshore energy and infrastructure clients worldwide.
          </p>
        ) : (
          intro && <p class="live-ops__intro text-lead">{intro}</p>
        )
      }
      <p class="visually-hidden" aria-live="polite" data-live-ops-announce></p>
    </header>

    {
      state !== 'unavailable' && (
        <div class="live-ops__toolbar">
          {showFilters && (
            <div class="live-ops__filters" role="group" aria-label="Show asset type">
              <FilterChip label="All" count={totalAssets} selected data-live-ops-filter="all" />
              {assetTypes.map((t) => (
                <FilterChip label={t.filter} count={counts[t.key]} disabled={counts[t.key] === 0} data-live-ops-filter={t.key} />
              ))}
            </div>
          )}
          {/* Zoom, in the toolbar row (17 Sep 2026). Disabled until the map has loaded. No "world" button:
              "All", closing a row and zoom out already get back to the full view. */}
          <div class="live-ops__controls" role="group" aria-label="Map zoom" data-live-ops-controls>
            <button type="button" class="live-ops__control" data-map-zoom-out aria-label="Zoom out" disabled>
              <Icon name="minus" size={20} />
            </button>
            <button type="button" class="live-ops__control" data-map-zoom-in aria-label="Zoom in" disabled>
              <Icon name="plus" size={20} />
            </button>
          </div>
        </div>
      )
    }

    <figure class="live-ops__map" data-live-ops-map>
      {/* Poster: static dot map, shown until the GL map is ready (and the whole map without JS) */}
      <svg class="live-ops__poster" viewBox={`${wb.x} ${wb.y} ${wb.w} ${wb.h}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <path class="live-ops__land" d={worldDotsPath()} />
      </svg>
      {
        state !== 'unavailable' && (
          <Fragment>
            <div class="live-ops__canvas" data-live-ops-canvas role="region" aria-label={mapSummary} />
            <script type="application/json" data-live-ops-points set:html={JSON.stringify(mapData)} />
          </Fragment>
        )
      }
    </figure>

    <div class="live-ops__side">
      {
        state !== 'unavailable' ? (
          <ol class="live-ops__regions" data-live-ops-regions>
            {regions.map((r) => {
              const panelId = `${uid}-${r.id}`;
              return (
                <li class="live-ops__region" data-live-ops-region={r.id}>
                  <h3 class="live-ops__region-heading">
                    <button type="button" class="live-ops__region-toggle" aria-expanded="false" aria-controls={panelId} data-live-ops-toggle={r.id}>
                      <span class="live-ops__region-name text-h5">{r.name}</span>
                      <span class="live-ops__region-meta">
                        <span class="live-ops__region-area text-small">{r.area}</span>
                        <span class="live-ops__region-types" aria-hidden="true">
                          {assetTypes
                            .filter((t) => r.operations.some((o) => o.type === t.key))
                            .map((t) => (
                              <span class="live-ops__type-dot" data-type={t.key} title={t.filter}>
                                <Icon name={t.icon} size={14} />
                              </span>
                            ))}
                        </span>
                      </span>
                      <span class="visually-hidden" data-live-ops-region-count>
                        , {r.operations.length} {r.operations.length === 1 ? 'asset' : 'assets'}
                      </span>
                      <Icon name="chevron-down" size={20} class="live-ops__chevron" />
                    </button>
                  </h3>
                  <div class="live-ops__panel" id={panelId} hidden>
                    <ul class="live-ops__ops">
                      {r.operations.map((o) => (
                        <li class="live-ops__op" data-type={o.type}>
                          <span class="live-ops__op-icon" aria-hidden="true">
                            <Icon name={typeOf(o.type).icon} size={20} />
                          </span>
                          <span class="live-ops__op-text">
                            <span class="live-ops__op-asset text-label">
                              {o.assetUrl ? <a href={o.assetUrl}>{o.asset}</a> : o.asset}
                              <span class="visually-hidden">, {typeOf(o.type).label}</span>
                            </span>
                            <span class="live-ops__op-scope text-small">{o.scope}</span>
                            <span class="live-ops__op-meta text-caption">
                              {o.sector}
                              {o.since && ` · Since ${o.since}`}
                            </span>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="live-ops__fallback text-body">Current operations aren't available right now. See the fleet and where we have worked.</p>
        )
      }

      <div class="live-ops__foot">
        {action && <Link label={action.label} href={action.url} action={action.action ?? 'page'} />}
      </div>
    </div>
  </div>
</BlockSection>

<script>
  import type { GeoJSONSource, Map as GLMap, Marker } from 'maplibre-gl';
  // MapLibre loads its tile worker from a URL next to the library, which breaks once Vite pre-bundles it.
  // Bundle the worker (with its shared chunk) ourselves and hand MapLibre the URL.
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const COUNTRIES_URL = `${import.meta.env.BASE_URL}data/world-countries.json`;
  /** Region level: never close enough to read as a position. */
  const MAX_ZOOM = 5;
  /** Zoom when a region is opened from the list or a marker: its sea area with context around it. */
  const REGION_ZOOM = 3.5;
  /** Clusters split from this zoom up. */
  const CLUSTER_MAX_ZOOM = 2;
  /** The world view: every continent Reach could work off, without the polar stretch of Mercator. */
  const HOME: [[number, number], [number, number]] = [
    [-130, -50],
    [160, 70],
  ];

  interface Point {
    id: string;
    name: string;
    lon: number;
    lat: number;
  }

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function initLiveOps(root: HTMLElement) {
    root.classList.add('is-enhanced');
    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-live-ops-toggle]')];
    const toggleFor = (id: string) => toggles.find((t) => t.dataset.liveOpsToggle === id);
    const rowFor = (id: string) => toggleFor(id)?.closest<HTMLElement>('li');
    const announce = root.querySelector<HTMLElement>('[data-live-ops-announce]');
    const say = (text: string) => announce && (announce.textContent = text);
    const points: Point[] = JSON.parse(root.querySelector('[data-live-ops-points]')?.textContent ?? '[]');
    const pointFor = (id: string) => points.find((p) => p.id === id);

    /** Assets shown per region under the current filter. */
    const shownBy: Record<string, number> = {};
    toggles.forEach((t) => {
      const id = t.dataset.liveOpsToggle!;
      shownBy[id] = rowFor(id)!.querySelectorAll('.live-ops__op').length;
    });
    let activeId: string | null = null;
    let hoverIds: string[] = [];

    // ── Staleness re-check (a cached page can outlive its data) ────────────────
    const updated = root.dataset.updated ? new Date(root.dataset.updated) : undefined;
    const staleHours = Number(root.dataset.staleHours ?? 72);
    if (updated && root.dataset.state === 'live' && !('stateForced' in root.dataset)) {
      const hours = (Date.now() - updated.getTime()) / 36e5;
      const status = root.querySelector<HTMLElement>('[data-live-ops-status]');
      if (hours > staleHours) {
        root.dataset.state = 'stale';
        root.querySelector('[data-live-ops-prefix]')!.textContent = 'Recently active in';
        root.querySelector('[data-live-ops-suffix]')!.textContent = '';
        root.querySelector('.live-ops__status-live')?.remove();
        const month = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split(' ')[updated.getUTCMonth()];
        if (status) status.textContent = `Last confirmed ${updated.getUTCDate()} ${month} ${updated.getUTCFullYear()}`;
      } else if (status && hours >= 0) {
        const h = Math.floor(hours);
        status.textContent = h < 1 ? 'Updated within the hour' : `Updated ${h} ${h === 1 ? 'hour' : 'hours'} ago`;
      }
    }

    // ── Map (loaded lazily) ─────────────────────────────────────────────────────
    let map: GLMap | undefined;
    let refreshMarkers = () => {};

    const figure = root.querySelector<HTMLElement>('[data-live-ops-map]')!;
    const canvas = root.querySelector<HTMLElement>('[data-live-ops-canvas]');

    const featureCollection = () => ({
      type: 'FeatureCollection' as const,
      features: points
        .filter((p) => shownBy[p.id] > 0)
        .map((p) => ({
          type: 'Feature' as const,
          properties: { id: p.id, name: p.name, assets: shownBy[p.id] },
          geometry: { type: 'Point' as const, coordinates: [p.lon, p.lat] },
        })),
    });

    async function loadMap() {
      if (!canvas || map) return;
      const [ml] = await Promise.all([import('maplibre-gl'), import('maplibre-gl/dist/maplibre-gl.css')]);
      ml.setWorkerUrl(workerUrl);
      const css = getComputedStyle(figure);
      const token = (name: string) => css.getPropertyValue(name).trim();

      map = new ml.Map({
        container: canvas,
        style: {
          version: 8,
          sources: {
            // Natural Earth is public domain: no on-map credit required (Mapbox in production must show its own)
            countries: { type: 'geojson', data: COUNTRIES_URL },
            regions: {
              type: 'geojson',
              data: featureCollection(),
              cluster: true,
              clusterRadius: 48,
              clusterMaxZoom: CLUSTER_MAX_ZOOM,
              clusterProperties: { assets: ['+', ['get', 'assets']] },
            },
          },
          layers: [
            // Markers are HTML; this invisible layer only makes the clustered source load and be queryable
            { id: 'regions-query', type: 'circle', source: 'regions', paint: { 'circle-radius': 1, 'circle-opacity': 0 } },
          ],
        },
        bounds: HOME,
        fitBoundsOptions: { padding: 24 },
        maxZoom: MAX_ZOOM,
        renderWorldCopies: false,
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
        cooperativeGestures: true,
        attributionControl: false,
        fadeDuration: reduceMotion.matches ? 0 : 300,
      });
      map.touchZoomRotate.disableRotation();
      map.keyboard.disableRotation();
      const m = map;
      // Debug handle for review tooling (harmless in production)
      (root as HTMLElement & { liveOpsMap?: GLMap }).liveOpsMap = m;

      // Dot-matrix land: a tiny tiled image, fixed in screen px, so the dots stay crisp at every zoom
      function dotsImage() {
        const dpr = Math.max(1, Math.round(window.devicePixelRatio || 1));
        const size = 14 * dpr;
        const c = document.createElement('canvas');
        c.width = size;
        c.height = size;
        const ctx = c.getContext('2d')!;
        ctx.fillStyle = token('--map-dot');
        for (const [x, y] of [
          [3.5, 3.5],
          [10.5, 10.5],
        ]) {
          ctx.beginPath();
          ctx.arc(x * dpr, y * dpr, 1.7 * dpr, 0, Math.PI * 2);
          ctx.fill();
        }
        return { img: ctx.getImageData(0, 0, size, size), dpr };
      }

      m.on('load', () => {
        const { img, dpr } = dotsImage();
        m.addImage('live-ops-dots', img, { pixelRatio: dpr });
        m.addLayer({ id: 'land-dots', type: 'fill', source: 'countries', paint: { 'fill-pattern': 'live-ops-dots' } }, 'regions-query');
        figure.classList.add('is-ready');
      });

      // ── Zoom buttons in the toolbar row ──────────────────────────────────────────
      const controls = root.querySelector<HTMLElement>('[data-live-ops-controls]')!;
      const zoomIn = controls.querySelector<HTMLButtonElement>('[data-map-zoom-in]')!;
      const zoomOut = controls.querySelector<HTMLButtonElement>('[data-map-zoom-out]')!;
      let minZoom = 0;
      function syncZoomButtons() {
        zoomIn.disabled = m.getZoom() >= MAX_ZOOM - 0.01;
        zoomOut.disabled = m.getZoom() <= minZoom + 0.01;
      }
      m.once('load', () => {
        // The home view is as far out as it goes, so "Zoom out" is disabled there on every screen size
        minZoom = m.getZoom();
        m.setMinZoom(minZoom);
        syncZoomButtons();
      });
      m.on('moveend', syncZoomButtons);
      zoomIn.addEventListener('click', () => m.zoomIn({ animate: !reduceMotion.matches }));
      zoomOut.addEventListener('click', () => m.zoomOut({ animate: !reduceMotion.matches }));

      // ── HTML markers from the clustered source ─────────────────────────────────
      const markers = new Map<string, Marker>();
      let onScreen = new Map<string, Marker>();

      function markerEl(key: string, label: string, count: number, cluster: boolean) {
        const el = document.createElement('div');
        el.className = `live-ops__marker${cluster ? ' live-ops__marker--cluster' : ''}`;
        el.dataset.key = key;
        el.setAttribute('aria-hidden', 'true');
        el.innerHTML = `
          <span class="live-ops__marker-pulse"></span>
          ${cluster ? '<span class="live-ops__marker-ring"></span>' : ''}
          <span class="live-ops__marker-dot">${count}</span>
          <span class="live-ops__marker-label">${esc(label)}</span>`;
        return el;
      }

      refreshMarkers = () => {
        markers.forEach((mk) => mk.remove());
        markers.clear();
        onScreen = new Map();
        (m.getSource('regions') as GeoJSONSource | undefined)?.setData(featureCollection());
      };

      function updateMarkers() {
        const source = m.getSource('regions') as GeoJSONSource | undefined;
        if (!source || !m.isSourceLoaded('regions')) return;
        const next = new Map<string, Marker>();
        const width = canvas!.clientWidth;
        const placed: { el: HTMLElement; x: number }[] = [];
        for (const f of m.querySourceFeatures('regions')) {
          const p = f.properties as Record<string, unknown>;
          const cluster = Boolean(p.cluster);
          const key = cluster ? `c${p.cluster_id}` : String(p.id);
          if (next.has(key)) continue;
          let mk = markers.get(key);
          if (!mk) {
            const count = Number(cluster ? p.assets : p.assets);
            const el = markerEl(key, cluster ? `${p.point_count} regions` : String(p.name), count, cluster);
            const coords = (f.geometry as GeoJSON.Point).coordinates as [number, number];
            mk = new ml.Marker({ element: el }).setLngLat(coords);
            if (cluster) {
              const clusterId = Number(p.cluster_id);
              source.getClusterLeaves(clusterId, Infinity, 0).then((leaves) => {
                el.dataset.ids = leaves.map((l) => String(l.properties?.id)).join(' ');
                paint(el);
              });
              el.addEventListener('click', async () => {
                const zoom = await source.getClusterExpansionZoom(clusterId);
                m.easeTo({ center: coords, zoom: Math.min(MAX_ZOOM, zoom + 0.5), duration: reduceMotion.matches ? 0 : 700 });
                say(`Map zoomed in to ${p.point_count} regions`);
              });
              el.addEventListener('pointerenter', () => ids(el).forEach((id) => rowFor(id)?.classList.add('is-hover')));
              el.addEventListener('pointerleave', () => ids(el).forEach((id) => rowFor(id)?.classList.remove('is-hover')));
            } else {
              const id = String(p.id);
              el.addEventListener('click', () => {
                const t = toggleFor(id);
                if (!t) return;
                select(t.getAttribute('aria-expanded') === 'true' ? null : id);
                t.classList.add('js-focus-no-ring');
                t.addEventListener('blur', () => t.classList.remove('js-focus-no-ring'), { once: true });
                t.focus({ preventScroll: true });
                if (window.matchMedia('(min-width: 900px)').matches)
                  t.closest('li')!.scrollIntoView({ block: 'nearest', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
              });
              el.addEventListener('pointerenter', () => rowFor(id)?.classList.add('is-hover'));
              el.addEventListener('pointerleave', () => rowFor(id)?.classList.remove('is-hover'));
            }
            markers.set(key, mk);
          }
          next.set(key, mk);
          if (!onScreen.has(key)) mk.addTo(m);
          placed.push({ el: mk.getElement(), x: m.project(mk.getLngLat()).x });
          paint(mk.getElement());
        }
        // Labels point away from the middle of the visible markers, so neighbours' labels don't cross
        // each other's markers; near an edge they point inwards
        const mid = placed.length > 1 ? placed.reduce((sum, p) => sum + p.x, 0) / placed.length : width / 2;
        placed.forEach(({ el, x }) => {
          const left = x < 170 ? false : x > width - 170 ? true : x < mid;
          el.classList.toggle('is-label-left', left);
        });
        onScreen.forEach((mk, key) => !next.has(key) && mk.remove());
        onScreen = next;
        // Once clusters have split, every region carries its name
        root.classList.toggle('is-detail', m.getZoom() > CLUSTER_MAX_ZOOM + 0.25);
      }

      const ids = (el: HTMLElement) => (el.dataset.ids ?? el.dataset.key ?? '').split(' ').filter(Boolean);
      function paint(el: HTMLElement) {
        const members = el.classList.contains('live-ops__marker--cluster') ? ids(el) : [el.dataset.key!];
        el.classList.toggle('is-active', activeId !== null && members.includes(activeId));
        el.classList.toggle('is-hover', members.some((id) => hoverIds.includes(id)));
      }
      paintAll = () => onScreen.forEach((mk) => paint(mk.getElement()));

      m.on('render', updateMarkers);

      // Filters: frame whatever the chip leaves on the map ("All" = the home view). Padding keeps markers
      // and labels clear of the controls; maxZoom keeps a single region at region level, not a close-up.
      fitToShown = (all: boolean) => {
        const shown = points.filter((p) => shownBy[p.id] > 0);
        const animate = !reduceMotion.matches;
        if (all || shown.length === 0) {
          m.fitBounds(HOME, { padding: 24, animate, duration: 900 });
          return;
        }
        const lons = shown.map((p) => p.lon);
        const lats = shown.map((p) => p.lat);
        m.fitBounds(
          [
            [Math.min(...lons), Math.min(...lats)],
            [Math.max(...lons), Math.max(...lats)],
          ],
          { padding: { top: 72, bottom: 56, left: 72, right: 96 }, maxZoom: 3.5, animate, duration: 900 },
        );
      };
      flyToRegion = (id: string) => {
        const pt = pointFor(id);
        if (!pt) return;
        // Opening a row always takes the map to that region, at region level (never closer)
        const options = { center: [pt.lon, pt.lat] as [number, number], zoom: REGION_ZOOM };
        if (reduceMotion.matches) m.jumpTo(options);
        else m.flyTo({ ...options, duration: 900 });
      };
    }

    let paintAll = () => {};
    let flyToRegion = (_id: string) => {};
    let fitToShown = (_all: boolean) => {};
    let currentFilter = 'all';

    if (canvas) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            loadMap().catch((err) => console.error('Live operations map failed to load', err));
          }
        },
        { rootMargin: '400px' },
      );
      io.observe(figure);
    }


    // ── Region selection: one open at a time; list and map stay in sync ────────
    function select(id: string | null, moveMap = true) {
      toggles.forEach((t) => {
        const open = t.dataset.liveOpsToggle === id;
        t.setAttribute('aria-expanded', String(open));
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !open;
        t.closest('li')!.classList.toggle('is-open', open);
      });
      activeId = id;
      root.classList.toggle('has-selection', id !== null);
      paintAll();
      if (id && moveMap) flyToRegion(id);
      // Closing the open row returns to the current filter's view
      else if (!id && moveMap) fitToShown(currentFilter === 'all');
    }

    toggles.forEach((t) => {
      const id = t.dataset.liveOpsToggle!;
      t.addEventListener('click', () => select(t.getAttribute('aria-expanded') === 'true' ? null : id));
      const li = t.closest<HTMLElement>('li')!;
      const hover = (on: boolean) => {
        hoverIds = on ? [id] : [];
        paintAll();
      };
      li.addEventListener('pointerenter', () => hover(true));
      li.addEventListener('pointerleave', () => hover(false));
      t.addEventListener('focus', () => hover(true));
      t.addEventListener('blur', () => hover(false));
    });

    // ── Asset-type filter ───────────────────────────────────────────────────────
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-live-ops-filter]')];
    filters.forEach((f) =>
      f.addEventListener('click', () => {
        const type = f.dataset.liveOpsFilter!;
        currentFilter = type;
        filters.forEach((b) => b.setAttribute('aria-pressed', String(b === f)));
        let visible = 0;
        root.querySelectorAll<HTMLElement>('[data-live-ops-region]').forEach((li) => {
          const ops = [...li.querySelectorAll<HTMLElement>('.live-ops__op')];
          let shown = 0;
          ops.forEach((op) => {
            const match = type === 'all' || op.dataset.type === type;
            op.hidden = !match;
            if (match) shown += 1;
          });
          const id = li.dataset.liveOpsRegion!;
          shownBy[id] = shown;
          li.hidden = shown === 0;
          li.querySelectorAll<HTMLElement>('.live-ops__type-dot').forEach((d) =>
            d.classList.toggle('is-dim', type !== 'all' && d.dataset.type !== type),
          );
          const count = li.querySelector('[data-live-ops-region-count]');
          if (count) count.textContent = `, ${shown} ${shown === 1 ? 'asset' : 'assets'}`;
          if (shown === 0 && li.classList.contains('is-open')) select(null, false);
          if (shown > 0) visible += 1;
        });
        refreshMarkers();
        fitToShown(type === 'all');
        const word = visible === 1 ? 'region' : 'regions';
        root.querySelector('[data-live-ops-count]')!.textContent = String(visible);
        root.querySelector('[data-live-ops-word]')!.textContent = word;
        const label = f.querySelector('.filter-chip__label')?.textContent ?? '';
        say(type === 'all' ? `Showing all ${visible} ${word}` : `${label}: ${visible} ${word}`);
      }),
    );
  }

  document.querySelectorAll<HTMLElement>('[data-live-ops]').forEach(initLiveOps);
</script>

