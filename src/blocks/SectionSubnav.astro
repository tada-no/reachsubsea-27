---
// Section subnav · reach/subnav (docs/05 §2.14). No new component: places the Phase 2 Subnav pill
// bar (docs/04 §15, Subnav item) directly under the Page hero. Two link sources —
//   Section pages: children of the section landing page; `current` marks the active one, static
//     `aria-current="page"`.
//   In-page: block anchors on the same page; a scroll-spy sets `aria-current="location"` on the
//     pill for the section in view (<script> below).
// Not a `<section>` and carries no block padding, so it renders its own <nav> rather than going
// through BlockSection. One style everywhere (`.has-surface-light` forces Light even on a Navy
// page, per the spec note "a Navy section doesn't change it").
//
// Sticky: `position: sticky; top: var(--reach-subnav-top, 0px)`. On the real site the header sets
// `--reach-subnav-top` as it shows/hides (96 → 72 → 0, docs/04 §16) so the subnav docks to the
// header's current bottom edge and then to `top: 0` once the header is hidden. The header script
// sets it (18 Sep 2026); the 0px fallback covers pages without the site header.
import SubnavItem from '../components/SubnavItem.astro';

export interface SubnavLink {
  label: string;
  href: string;
}

interface Props {
  source: 'section-pages' | 'in-page';
  /** nav aria-label, e.g. "Investors". */
  label: string;
  items: SubnavLink[];
  /** Current page href — Section pages only. */
  current?: string;
}

const { source, label, items, current } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="wp-block-reach-subnav subnav has-surface-light" aria-label={`${label} section`} data-subnav data-subnav-source={source}>
      <div class="subnav__row container">
        {items.map((item) => (
          <SubnavItem
            label={item.label}
            href={item.href}
            aria-current={source === 'section-pages' && item.href === current ? 'page' : undefined}
            data-subnav-target={source === 'in-page' ? item.href.replace(/^#/, '') : undefined}
          />
        ))}
      </div>
    </nav>
    <script is:inline>
      (function () {
        try {
          var n = document.querySelector('[data-subnav-source="section-pages"]');
          var k = sessionStorage.getItem('reach-subnav');
          if (!n || !k) return;
          sessionStorage.removeItem('reach-subnav');
          var s = JSON.parse(k);
          var r = n.querySelector('.subnav__row');
          if (r) r.scrollLeft = s.x;
          if (s.docked) {
            // The page below the bar has not been parsed yet, so scrolling now would clamp to 0: wait for it
            history.scrollRestoration = 'manual';
            var go = function () {
              window.scrollTo(0, n.getBoundingClientRect().top + window.scrollY);
            };
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
            else go();
          }
        } catch (e) {}
      })();
    </script>
  )
}

<style is:global>
  .subnav {
    position: sticky;
    top: var(--reach-subnav-top, 0px);
    z-index: 20;
    background-color: var(--wp--custom--color--bg--default);
    /* Same curve and duration as the header's show/hide, so the two move as one */
    transition:
      top 0.4s var(--wp--custom--motion--ease-out),
      box-shadow var(--wp--custom--motion--duration) var(--wp--custom--motion--easing);
  }
  /* No hairline in the page flow (18 Sep 2026). Once docked it becomes part of the header: it takes
     over the header's shadow, so the two read as one bar (base.css drops the header's own shadow). */
  .subnav.is-docked {
    box-shadow: var(--wp--preset--shadow--sm);
  }
  .subnav__row {
    display: flex;
    align-items: center;
    gap: var(--wp--preset--spacing--8);
    padding-block: var(--wp--preset--spacing--16);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav__row::-webkit-scrollbar {
    display: none;
  }
  .subnav-item {
    flex: none;
  }
</style>

<script>
  // Section subnav (docs/05 §2.14): keeps the active pill in view inside the row — scrolling the
  // row's own scrollLeft, never the page — and, for In-page sources, runs the scroll-spy.
  function scrollPillIntoView(row: HTMLElement, pill: HTMLElement) {
    const rowRect = row.getBoundingClientRect();
    const pillRect = pill.getBoundingClientRect();
    const margin = 16;
    if (pillRect.left < rowRect.left) {
      row.scrollLeft -= rowRect.left - pillRect.left + margin;
    } else if (pillRect.right > rowRect.right) {
      row.scrollLeft += pillRect.right - rowRect.right + margin;
    }
  }

  function initSubnav(nav: HTMLElement) {
    const row = nav.querySelector<HTMLElement>('.subnav__row');
    if (!row) return;
    const pills = Array.from(row.querySelectorAll<HTMLElement>('.subnav-item'));
    if (pills.length === 0) return;

    function setActive(pill: HTMLElement) {
      pills.forEach((p) => {
        if (p === pill) p.setAttribute('aria-current', 'location');
        else p.removeAttribute('aria-current');
      });
      scrollPillIntoView(row as HTMLElement, pill);
    }

    const initialActive = pills.find((p) => p.getAttribute('aria-current') === 'page');
    if (initialActive) scrollPillIntoView(row, initialActive);

    if (nav.dataset.subnavSource !== 'in-page') return;

    const targets = pills
      .map((pill) => {
        const id = pill.dataset.subnavTarget;
        const section = id ? document.getElementById(id) : null;
        return section && { pill, section };
      })
      .filter((t): t is { pill: HTMLElement; section: HTMLElement } => Boolean(t));
    if (targets.length === 0) return;

    // The review iframe doesn't scroll internally, so this only fires when the demo is opened on
    // its own (/blocks/subnav/, or the "Open frame" link) rather than embedded in the /blocks page.
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        const match = visible[0] && targets.find((t) => t.section === visible[0].target);
        if (match) setActive(match.pill);
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );
    targets.forEach((t) => observer.observe(t.section));
    setActive(targets[0].pill); // sensible default before the first scroll/observer callback
  }

  document.querySelectorAll<HTMLElement>('[data-subnav]').forEach(initSubnav);

  // Same-page anchors in the bar (4 Oct 2026, Assets: Vessels and ROVs & equipment are anchors into the
  // overview). The browser's own jump lands the target under the sticky bars: base.css clears the docked
  // subnav for a jump down (the header hides on a downward scroll), but a jump up brings the header back
  // (72px once scrolled) over the subnav. So the bar scrolls the target itself, allowing for the header
  // when the target is above, and keeps the URL and focus in step with a native jump.
  const BAR = 72;
  const GAP = 24;
  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-subnav] a[href*="#"]');
    if (!link || link.pathname !== location.pathname || !link.hash) return;
    const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (!target) return;
    event.preventDefault();
    const above = target.getBoundingClientRect().top < 0;
    const top = target.getBoundingClientRect().top + window.scrollY - BAR - GAP - (above ? BAR : 0);
    window.scrollTo({ top: Math.max(0, top), behavior: 'auto' });
    history.pushState(null, '', link.hash);
    if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
    target.focus({ preventScroll: true });
  });

  // Moving between section pages (6 Oct 2026, Ross: a glitch clicking between pills): each pill is a full page
  // load, which threw the page back to the top, replayed the hero and reset the row's sideways scroll. The bar
  // now remembers its sideways scroll and whether it was docked; the next page (inline script after the nav)
  // restores both, so the bar stays where the eye is.
  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-subnav-source="section-pages"] a[href]');
    if (!link || link.pathname === location.pathname || event.defaultPrevented) return;
    const nav = link.closest<HTMLElement>('[data-subnav]');
    const row = nav?.querySelector<HTMLElement>('.subnav__row');
    try {
      sessionStorage.setItem('reach-subnav', JSON.stringify({ x: row?.scrollLeft ?? 0, docked: nav?.classList.contains('is-docked') ?? false }));
    } catch {}
  });

  // Docked state: a 1px sentinel just above the bar leaves the viewport's top band when the bar sticks.
  document.querySelectorAll<HTMLElement>('[data-subnav]').forEach((nav) => {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'height:1px;margin-bottom:-1px';
    nav.before(sentinel);
    let docked = false;
    const update = () => {
      const top = parseFloat(getComputedStyle(nav).top) || 0;
      const next = sentinel.getBoundingClientRect().bottom <= top + 1;
      if (next === docked) return;
      docked = next;
      nav.classList.toggle('is-docked', docked);
      document.documentElement.classList.toggle('has-docked-subnav', docked);
    };
    window.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
  });
</script>
