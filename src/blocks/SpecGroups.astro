---
// Spec groups · reach/spec-groups (docs/05 §2.34; Q167, 10 Oct 2026). Grouped Spec rows under a Section header: an
// H5 per group over its label · value rows (hairlines belong here, docs/08 §5). Four groups across from 1200 (four or
// eight groups fill their rows), two from 600, one on phones. Reach Remote: "The vessel in numbers", the brochure's main particulars, then each tour
// chapter's three rows, so the facts that left the stage (the cards carry a name and one line) are all on the page.
// A group marked `fromTour` repeats a Model stage chapter's rows, so it hides while the tour is not live (no JS,
// reduced motion), where the chapters read as rows with those same specs. Fields: `sectionHeader`, `groups[]`
// (title, specs[] label · value). No groups → nothing.
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SpecRow from '../components/SpecRow.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, SectionHeaderField } from '../lib/types';

export interface SpecGroup {
  title: string;
  specs: { label: string; value: string }[];
  /** Repeats a Model stage chapter on the same page: shown only while the tour runs */
  fromTour?: boolean;
}

interface Props extends BlockFields {
  sectionHeader?: SectionHeaderField;
  groups: SpecGroup[];
}

const { sectionHeader, groups, background = 'white', spacing, anchor } = Astro.props;
const titleId = sectionHeader?.title ? makeId('spec-groups', sectionHeader.title) : undefined;
---

{
  groups.length > 0 && (
    <BlockSection slug="spec-groups" root="spec-groups" background={background} spacing={spacing} anchor={anchor} labelledBy={titleId}>
      <div class="block__body">
        {sectionHeader && <SectionHeader {...sectionHeader} id={titleId} />}
        <div class="spec-groups__list">
          {groups.map((g) => (
            <div class="spec-groups__group" data-from-tour={g.fromTour ? '' : undefined}>
              <h3 class="spec-groups__title text-h5">{g.title}</h3>
              <dl class="spec-groups__rows">
                {g.specs.map((s) => (
                  <SpecRow label={s.label} value={s.value} />
                ))}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </BlockSection>
  )
}

<style is:global>
  .spec-groups__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--wp--preset--spacing--40) var(--wp--custom--grid--gutter);
  }
  .spec-groups__group {
    display: grid;
    gap: var(--wp--preset--spacing--12);
    align-content: start;
  }
  .spec-groups__title {
    margin: 0;
  }
  .spec-groups__rows {
    margin: 0;
  }
  .spec-groups__rows .spec-row:first-child {
    border-top: 1px solid var(--wp--custom--color--border--subtle);
  }
  /* Four across, a group is ~300 wide: a 50/50 row would break values mid-phrase ("seas to 3 / m"), so each row
     stacks its label over its value, the hairlines kept */
  @media (min-width: 1200px) {
    .spec-groups .spec-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--wp--preset--spacing--4);
    }
  }
  /* Not live, the Model stage's chapter rows carry these same facts beside their sentences */
  .model-stage:not(.is-live) ~ .spec-groups .spec-groups__group[data-from-tour] {
    display: none;
  }
  @media (max-width: 1199px) {
    .spec-groups__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .spec-groups__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
