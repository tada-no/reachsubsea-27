---
// Data list · reach/data-list (docs/05 §2.7). Type Reports · Documents · Dates · Publications.
// Latest is a Navy panel (not a Card instance, it holds several actions): 416 beside the table on
// Desktop, full width on Mobile. Reports/Documents share the "newest N, then archive toggle"
// pattern; Reports alone has tabs; Publications alone has a search field, multi-select filter chips
// (OR within a facet, AND across, Q90) + Load more,
// in a sticky rail beside the list from 1100 (Q88). Row style is
// shared everywhere: header UI/Eyebrow text/secondary, row eyebrows text/accent (as card eyebrows, Q88),
// rows padding y space/16, 1px border/subtle
// dividers, no zebra. Mobile drops the boxed table for plain top-rule rows, except Reports, whose
// nested quarter groups become closed/open Accordion items instead (same underlying data).
import BlockSection from '../components/BlockSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Badge from '../components/Badge.astro';
import Link from '../components/Link.astro';
import Button from '../components/Button.astro';
import MetaItem from '../components/MetaItem.astro';
import FilterChip from '../components/FilterChip.astro';
import SearchField from '../components/SearchField.astro';
import AccordionItem from '../components/AccordionItem.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, LinkField, SectionHeaderField } from '../lib/types';
import type { CalendarDate, Meeting, Publication, ReportYear, SimpleDocument } from '../data/documents';

export interface DataListTab {
  id: string;
  label: string;
}

export interface DataListLatest {
  title: string;
  date: string;
  links: LinkField[];
}

export interface DataListFacetOption {
  id: string;
  label: string;
}

export interface DataListFacet {
  id: string;
  label: string;
  options: DataListFacetOption[];
}

interface Props extends BlockFields {
  type: 'reports' | 'documents' | 'dates' | 'publications';
  sectionHeader?: SectionHeaderField;
  showLatest?: boolean;
  latest?: DataListLatest;
  /** Reports only. */
  tabs?: DataListTab[];
  activeTab?: string;
  /** Reports only: document lists for every tab besides "Quarterly reports". */
  tabPanels?: Record<string, SimpleDocument[]>;
  showArchiveToggle?: boolean;
  /** Reports. */
  years?: ReportYear[];
  /** Newest rows shown before the archive toggle (years for Reports, meetings for Documents). */
  visibleYears?: number;
  /** Documents. */
  meetings?: Meeting[];
  /** Dates. */
  dates?: CalendarDate[];
  /** Publications. */
  publications?: Publication[];
  facets?: DataListFacet[];
  /** Publications page size. */
  count?: number;
  showLoadMore?: boolean;
}

const {
  type,
  sectionHeader,
  showLatest = false,
  latest,
  tabs = [],
  activeTab,
  tabPanels = {},
  showArchiveToggle = true,
  years = [],
  visibleYears = 4,
  meetings = [],
  dates = [],
  publications = [],
  facets = [],
  count = 4,
  showLoadMore = true,
  background,
  spacing,
  anchor,
} = Astro.props;

const titleId = sectionHeader ? makeId('data-list', sectionHeader.title) : undefined;
const instanceId = makeId('data-list', type);

const hasLatest = showLatest && Boolean(latest);
const activeTabId = activeTab ?? tabs[0]?.id;

// Reports: newest N years shown, the rest behind "Show all years (N)".
const yearsShown = years.slice(0, visibleYears);
const yearsHidden = showArchiveToggle ? years.slice(visibleYears) : [];
const yearsArchiveCount = yearsHidden.length;

// Documents: newest N meetings shown, same pattern.
const meetingsShown = meetings.slice(0, visibleYears);
const meetingsHidden = showArchiveToggle ? meetings.slice(visibleYears) : [];
const meetingsArchiveCount = meetingsHidden.length;

// Publications facets: which option a publication falls under
const facetValueOf = (p: Publication, facet: string) => (facet === 'year' ? p.yearId : facet === 'topic' ? p.topicId : undefined);

// Publications search: title, authors, venue, topic and year, lower-cased with accents folded (Vassvåg = vassvag)
const searchText = (p: Publication) =>
  [p.title, p.byline, p.topicLabel, p.year]
    .join(' ')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();

type QuarterEntry = { n: number; label: string; date: string; report?: { url: string }; presentation?: { url: string }; webcast?: { url: string } };

function quartersOf(y: ReportYear): (QuarterEntry | null)[] {
  return [
    y.q1 && { n: 1, label: 'Q1', ...y.q1 },
    y.q2 && { n: 2, label: 'Q2', ...y.q2 },
    y.q3 && { n: 3, label: 'Q3', ...y.q3 },
    y.q4 && { n: 4, label: 'Q4', ...y.q4 },
  ];
}
---

<BlockSection
  slug="data-list"
  root="data-list"
  class={`data-list--${type}`}
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
  label={titleId ? undefined : 'Data list'}
  data-type={type}
  data-count={count}
  id={instanceId}
>
  <div class="data-list__body">
    {sectionHeader && <SectionHeader {...sectionHeader} id={titleId} class="data-list__header" />}

    {
      tabs.length > 0 && (
        <div class="data-list__tabs scroll-row" role="tablist" aria-label={sectionHeader?.title ?? 'Categories'}>
          {tabs.map((tab) => (
            <button
              type="button"
              class:list={['subnav-item', 'text-label', tab.id === activeTabId && 'is-active']}
              role="tab"
              id={`${instanceId}-tab-${tab.id}`}
              aria-controls={`${instanceId}-panel-${tab.id}`}
              aria-selected={String(tab.id === activeTabId)}
              tabindex={tab.id === activeTabId ? 0 : -1}
            >
              {tab.label}
            </button>
          ))}
        </div>
      )
    }

    {
      /* ── Reports ─────────────────────────────────────────────── */
      type === 'reports' &&
        (tabs.length > 0 ? tabs : [{ id: 'quarterly', label: 'Quarterly reports' }]).map((tab) => (
          <div
            id={`${instanceId}-panel-${tab.id}`}
            role={tabs.length > 0 ? 'tabpanel' : undefined}
            aria-labelledby={tabs.length > 0 ? `${instanceId}-tab-${tab.id}` : undefined}
            hidden={tabs.length > 0 && tab.id !== activeTabId}
            class="data-list__panel"
          >
            {tab.id === 'quarterly' ? (
              <div class="data-list__columns">
                {hasLatest && (
                  <div class="data-list__latest has-surface-navy">
                    <Badge label="Latest" tone="navy" class="data-list__latest-badge" />
                    <p class="data-list__latest-title text-h4">{latest!.title}</p>
                    <MetaItem icon="calendar" text={latest!.date} class="data-list__latest-date" />
                    <div class="data-list__latest-links">
                      {latest!.links.map((link) => (
                        <Link label={link.label} href={link.url} action={link.action ?? 'file'} size="small" context={link.context} />
                      ))}
                    </div>
                  </div>
                )}
                <div class="data-list__main">
                  <div class="data-list__table-wrap">
                    <table class="data-list__table">
                      <thead>
                        <tr>
                          <th scope="col" class="text-eyebrow">
                            Year
                          </th>
                          <th scope="col" class="text-eyebrow">
                            Q1
                          </th>
                          <th scope="col" class="text-eyebrow">
                            Q2
                          </th>
                          <th scope="col" class="text-eyebrow">
                            Q3
                          </th>
                          <th scope="col" class="text-eyebrow">
                            Q4
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {[...yearsShown, ...yearsHidden].map((y, i) => (
                          <tr data-archive-row hidden={i >= yearsShown.length}>
                            <th scope="row" class="data-list__year text-h5">
                              {y.year}
                            </th>
                            {quartersOf(y).map((q) => (
                              <td>
                                {q ? (
                                  <Fragment>
                                    <p class="data-list__cell-date text-caption">{q.date}</p>
                                    <div class="data-list__cell-links">
                                      {q.report && (
                                        <Link
                                          label="Report"
                                          href={q.report.url}
                                          action="file"
                                          size="small"
                                          context={`Q${q.n} ${y.year} report, PDF`}
                                        />
                                      )}
                                      {q.presentation && (
                                        <Link
                                          label="Presentation"
                                          href={q.presentation.url}
                                          action="file"
                                          size="small"
                                          context={`Q${q.n} ${y.year} presentation, PDF`}
                                        />
                                      )}
                                      {q.webcast && (
                                        <Link
                                          label="Webcast"
                                          href={q.webcast.url}
                                          action="external"
                                          size="small"
                                          context={`Q${q.n} ${y.year} webcast`}
                                        />
                                      )}
                                    </div>
                                  </Fragment>
                                ) : (
                                  <span class="data-list__empty text-caption">
                                    – <span class="visually-hidden">Not published</span>
                                  </span>
                                )}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  <div class="data-list__mobile-years">
                    {[...yearsShown, ...yearsHidden].map((y, i) => (
                      <div data-archive-row hidden={i >= yearsShown.length}>
                        <AccordionItem question={String(y.year)} open={i === 0} id={`${instanceId}-year-${y.year}`}>
                          {quartersOf(y)
                            .filter((q): q is QuarterEntry => Boolean(q))
                            .reverse()
                            .map((q) => (
                              <div class="data-list__quarter">
                                <p class="text-label">
                                  {q.label} · {q.date}
                                </p>
                                <div class="data-list__mobile-links">
                                  {q.report && <Link label={`${q.label} ${y.year} report (PDF)`} href={q.report.url} action="file" size="small" />}
                                  {q.presentation && (
                                    <Link label={`${q.label} ${y.year} presentation (PDF)`} href={q.presentation.url} action="file" size="small" />
                                  )}
                                  {q.webcast && <Link label={`${q.label} ${y.year} webcast`} href={q.webcast.url} action="external" size="small" />}
                                </div>
                              </div>
                            ))}
                        </AccordionItem>
                      </div>
                    ))}
                  </div>

                  {yearsArchiveCount > 0 && (
                    <Link
                      label={`Show all years (${yearsArchiveCount})`}
                      action="expand"
                      size="small"
                      class="data-list__archive-toggle"
                      data-archive-toggle
                      aria-expanded="false"
                    />
                  )}
                </div>
              </div>
            ) : (
              <ul class="data-list__simple-list">
                {(tabPanels[tab.id] ?? []).map((doc) => (
                  <li class="data-list__row">
                    <Link label={doc.label} href={doc.url} action="file" size="small" />
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
    }

    {
      /* ── Documents (general meetings) ───────────────────────── */
      type === 'documents' && (
        <div class="data-list__columns">
          {hasLatest && (
            <div class="data-list__latest has-surface-navy">
              <Badge label="Latest" tone="navy" class="data-list__latest-badge" />
              <p class="data-list__latest-title text-h4">{latest!.title}</p>
              <MetaItem icon="calendar" text={latest!.date} class="data-list__latest-date" />
              <div class="data-list__latest-links">
                {latest!.links.map((link) => (
                  <Link label={link.label} href={link.url} action={link.action ?? 'file'} size="small" context={link.context} />
                ))}
              </div>
            </div>
          )}
          <div class="data-list__main">
            <div class="data-list__table-wrap">
              <table class="data-list__table">
                <thead>
                  <tr>
                    <th scope="col" class="text-eyebrow">
                      Year
                    </th>
                    <th scope="col" class="text-eyebrow">
                      Meeting
                    </th>
                    <th scope="col" class="text-eyebrow">
                      Documents
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {[...meetingsShown, ...meetingsHidden].map((m, i) => (
                    <tr data-archive-row hidden={i >= meetingsShown.length}>
                      <th scope="row" class="data-list__year text-h5">
                        {m.year}
                      </th>
                      <td>
                        <p class="text-small data-list__meeting-name">{m.name}</p>
                        <p class="text-caption data-list__meeting-date">{m.date}</p>
                      </td>
                      <td>
                        <div class="data-list__mobile-links">
                          {m.documents.map((doc) => (
                            <Link label={doc.label} href={doc.url} action="file" size="small" />
                          ))}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="data-list__mobile-rows">
              {[...meetingsShown, ...meetingsHidden].map((m, i) => (
                <div class="data-list__row" data-archive-row hidden={i >= meetingsShown.length}>
                  <p class="text-eyebrow data-list__row-eyebrow">
                    {m.year} · {m.date}
                  </p>
                  <p class="text-h5">{m.name}</p>
                  <div class="data-list__mobile-links">
                    {m.documents.map((doc) => (
                      <Link label={doc.label} href={doc.url} action="file" size="small" />
                    ))}
                  </div>
                </div>
              ))}
            </div>

            {meetingsArchiveCount > 0 && (
              <Link
                label={`Show all years (${meetingsArchiveCount})`}
                action="expand"
                size="small"
                class="data-list__archive-toggle"
                data-archive-toggle
                aria-expanded="false"
              />
            )}
          </div>
        </div>
      )
    }

    {
      /* ── Dates (financial calendar) ─────────────────────────── */
      type === 'dates' && (
        <div class="data-list__main data-list__main--capped">
          <div class="data-list__table-wrap">
            <table class="data-list__table">
              <colgroup>
                <col style="width: 160px" />
                <col />
                <col style="width: auto" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col" class="text-eyebrow">
                    Date
                  </th>
                  <th scope="col" class="text-eyebrow">
                    Event
                  </th>
                  <th scope="col">
                    <span class="visually-hidden">Add to calendar</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {dates.map((d) => (
                  <tr>
                    <td class="text-label">{d.date}</td>
                    <td class="text-body">{d.event}</td>
                    <td>
                      <Link label="Add to calendar (.ics)" href={d.icsHref ?? '#'} action="file" size="small" />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="data-list__mobile-rows">
            {dates.map((d) => (
              <div class="data-list__row">
                <p class="text-eyebrow data-list__row-eyebrow">{d.date}</p>
                <p class="text-body">{d.event}</p>
                <Link label="Add to calendar (.ics)" href={d.icsHref ?? '#'} action="file" size="small" />
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      /* ── Publications ────────────────────────────────────────── */
      type === 'publications' && (
        <div class="data-list__pubs">
          <div class="data-list__rail">
            <div class="data-list__search">
              <SearchField id={`${instanceId}-search`} label="Search publications" placeholder="Title, author or journal" />
              {/* The count belongs to the search: right under it, with Clear all once anything narrows the list (Q89) */}
              <div class="data-list__summary">
                <p class="data-list__count text-small" aria-live="polite" data-pub-count data-total={publications.length}>
                  {publications.length} publication{publications.length === 1 ? '' : 's'}
                </p>
                <Link label="Clear all" showIcon={false} size="small" class="data-list__clear-all" data-pub-reset data-off />
              </div>
            </div>
            {facets.length > 0 && (
              <div class="data-list__facets">
                {facets.map((facet) => (
                  <div class="data-list__facet" role="group" aria-labelledby={`${instanceId}-${facet.id}`}>
                    <span class="data-list__facet-label text-eyebrow" id={`${instanceId}-${facet.id}`}>
                      {facet.label}
                    </span>
                    <div class="data-list__facet-chips scroll-row">
                      {facet.options.map((opt) => (
                        <FilterChip
                          label={opt.label}
                          count={publications.filter((p) => facetValueOf(p, facet.id) === opt.id).length}
                          data-facet={facet.id}
                          data-value={opt.id}
                          aria-pressed="false"
                        />
                      ))}
                      {/* One year picked from the Year bars chart (Q88): filled in and shown by the script */}
                      {facet.id === 'year' && (
                        <FilterChip label="" count="" data-facet="year" data-value="" data-single-year aria-pressed="false" hidden />
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="data-list__pub-results">
            <ul class="data-list__pub-list">
              {publications.map((p, i) => (
                <li
                  class="data-list__row"
                  data-pub-row
                  data-year={p.yearId}
                  data-single={p.year}
                  data-topic={p.topicId}
                  data-search={searchText(p)}
                  hidden={i >= count}
                  tabindex="-1"
                >
                  <div class="data-list__pub-main">
                    <p class="text-eyebrow data-list__row-eyebrow">
                      {p.year} · {p.topicLabel}
                    </p>
                    <h3 class="text-h5">{p.title}</h3>
                    <p class="text-small data-list__pub-byline">{p.byline}</p>
                  </div>
                  <div class="data-list__pub-action">
                    <Link label={p.link.label} href={p.link.url} action={p.link.action} size="small" />
                  </div>
                </li>
              ))}
            </ul>

            <div class="data-list__no-match" data-pub-empty hidden>
              <p class="text-body">No publications match these filters.</p>
              <Link label="Clear search and filters" showIcon={false} size="small" data-pub-reset />
            </div>

            {showLoadMore && publications.length > count && (
              <div class="data-list__load-more">
                <Button label="Load more" variant="outline" data-load-more />
              </div>
            )}
          </div>
        </div>
      )
    }
  </div>
</BlockSection>

<script>
  function activateTab(tab: HTMLElement) {
    const list = tab.closest('[role="tablist"]');
    const root = tab.closest('.data-list');
    if (!list || !root) return;
    list.querySelectorAll('[role="tab"]').forEach((t) => {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      t.setAttribute('tabindex', active ? '0' : '-1');
      t.classList.toggle('is-active', active);
    });
    const panelId = tab.getAttribute('aria-controls');
    root.querySelectorAll('[role="tabpanel"]').forEach((panel) => {
      panel.toggleAttribute('hidden', panel.id !== panelId);
    });
  }

  // Multi-select (Q90): the picked values of one facet; none picked = no limit
  function activeFacetValues(root: Element, facet: string) {
    return Array.from(root.querySelectorAll<HTMLElement>(`[data-facet="${facet}"][aria-pressed="true"]`))
      .map((chip) => chip.dataset.value ?? '')
      .filter(Boolean);
  }

  // Which row fields a facet value can match: a year run or a single year (from the Year bars chart), a topic
  const ROW_FIELDS: Record<string, ('year' | 'single' | 'topic')[]> = { year: ['year', 'single'], topic: ['topic'] };

  const fold = (text: string) =>
    text
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

  // One test for every publications filter: any picked value within a facet (OR), every facet (AND), the search
  function publicationMatcher(root: Element, override?: { facet: string; values: string[] }) {
    const picked = Object.keys(ROW_FIELDS).map((facet) => ({
      facet,
      values: override?.facet === facet ? override.values : activeFacetValues(root, facet),
    }));
    const field = root.querySelector<HTMLInputElement>('[data-search-field]');
    const terms = fold(field?.value ?? '').split(/\s+/).filter(Boolean);
    return (row: HTMLElement) =>
      picked.every(
        ({ facet, values }) => values.length === 0 || values.some((v) => ROW_FIELDS[facet].some((f) => row.dataset[f] === v)),
      ) && terms.every((t) => (row.dataset.search ?? '').includes(t));
  }

  function filterPublications(root: Element) {
    const matches = publicationMatcher(root);
    const step = Number(root.getAttribute('data-count') || '4');
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-pub-row]'));
    let shown = 0;
    let matched = 0;
    rows.forEach((row) => {
      if (!matches(row)) {
        row.hidden = true;
        return;
      }
      matched += 1;
      row.hidden = shown >= step;
      if (shown < step) shown += 1;
    });
    const countEl = root.querySelector<HTMLElement>('[data-pub-count]');
    if (countEl) {
      const total = Number(countEl.dataset.total || rows.length);
      countEl.textContent =
        matched === total ? `${total} publication${total === 1 ? '' : 's'}` : `${matched} of ${total} publications`;
    }
    const empty = root.querySelector<HTMLElement>('[data-pub-empty]');
    if (empty) empty.hidden = matched > 0;
    updateFacetCounts(root, rows);
    // Clear all shows once a search or any facet narrows the list
    const field = root.querySelector<HTMLInputElement>('[data-search-field]');
    const narrowed = Boolean(field?.value.trim()) || root.querySelector('[data-facet][aria-pressed="true"]') !== null;
    root.querySelector<HTMLElement>('.data-list__clear-all')?.toggleAttribute('data-off', !narrowed);
    const loadMoreWrap = root.querySelector<HTMLElement>('.data-list__load-more');
    if (loadMoreWrap) loadMoreWrap.hidden = shown >= matched;
  }

  // Each option's count is its own share given the search and the other facet (Q89, Q90), so it does not
  // move as options in its own facet are ticked. An option with none is disabled unless it is ticked.
  function updateFacetCounts(root: Element, rows: HTMLElement[]) {
    root.querySelectorAll<HTMLButtonElement>('[data-facet]').forEach((chip) => {
      const facet = chip.dataset.facet;
      const value = chip.dataset.value;
      if (!facet || !value) return;
      const n = rows.filter(publicationMatcher(root, { facet, values: [value] })).length;
      const countEl = chip.querySelector('.filter-chip__count');
      if (countEl) countEl.textContent = String(n);
      chip.disabled = n === 0 && chip.getAttribute('aria-pressed') !== 'true';
    });
  }

  // Ticks or unticks one option; the single-year chip only lives while it is ticked
  function toggleChip(chip: HTMLElement, on = chip.getAttribute('aria-pressed') !== 'true') {
    chip.setAttribute('aria-pressed', String(on));
    if (!on && chip.hasAttribute('data-single-year')) chip.hidden = true;
  }

  function pickSingleYear(root: Element, year: string) {
    const single = root.querySelector<HTMLElement>('[data-single-year]');
    if (!single) return;
    single.dataset.value = year;
    const label = single.querySelector('.filter-chip__label');
    if (label) label.textContent = year;
    single.hidden = false;
    // A chart pick is a jump to that one year: it replaces the other year ticks
    root.querySelectorAll<HTMLElement>('[data-facet="year"]').forEach((chip) => toggleChip(chip, chip === single));
    filterPublications(root);
  }

  function resetPublications(root: Element) {
    const field = root.querySelector<HTMLInputElement>('[data-search-field]');
    if (field) field.value = '';
    root.querySelector<HTMLElement>('[data-search-clear]')?.toggleAttribute('hidden', true);
    root.querySelectorAll<HTMLElement>('[data-facet]').forEach((chip) => toggleChip(chip, false));
    filterPublications(root);
  }

  function revealMore(button: HTMLElement) {
    const root = button.closest('.data-list');
    if (!root) return;
    const matches = publicationMatcher(root);
    const step = Number(root.getAttribute('data-count') || '4');
    const matching = Array.from(root.querySelectorAll<HTMLElement>('[data-pub-row]')).filter(matches);
    const hiddenMatching = matching.filter((row) => row.hidden);
    const toShow = hiddenMatching.slice(0, step);
    toShow.forEach((row) => {
      row.hidden = false;
    });
    if (hiddenMatching.length <= step) {
      const loadMoreWrap = button.closest<HTMLElement>('.data-list__load-more');
      if (loadMoreWrap) loadMoreWrap.hidden = true;
    }
    toShow[0]?.focus();
  }

  // Search as you type (Search field, Q88)
  document.addEventListener('input', (event) => {
    const field = (event.target as Element).closest?.<HTMLInputElement>('[data-search-field]');
    const root = field?.closest('.data-list');
    if (!field || !root) return;
    root.querySelector<HTMLElement>('[data-search-clear]')?.toggleAttribute('hidden', field.value === '');
    filterPublications(root);
  });

  // Another block asks for a filter, e.g. a Year bars column: { target: section id, facet: 'year', value: '2017' }
  document.addEventListener('reach:filter', (event) => {
    const { target, facet, value } = (event as CustomEvent<{ target: string; facet: string; value: string }>).detail;
    const root = document.getElementById(target);
    if (!root?.classList.contains('data-list') || facet !== 'year') return;
    pickSingleYear(root, value);
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Element;

    const archiveToggle = target.closest('[data-archive-toggle]');
    if (archiveToggle) {
      const expanded = archiveToggle.getAttribute('aria-expanded') === 'true';
      archiveToggle.setAttribute('aria-expanded', String(!expanded));
      const root = archiveToggle.closest('.data-list');
      root?.querySelectorAll('[data-archive-row]').forEach((row) => {
        row.toggleAttribute('hidden', expanded);
      });
      return;
    }

    const tab = target.closest<HTMLElement>('[role="tab"]');
    if (tab) {
      activateTab(tab);
      return;
    }

    const chip = target.closest<HTMLElement>('[data-facet]');
    if (chip) {
      const root = chip.closest('.data-list');
      if (root) {
        toggleChip(chip);
        filterPublications(root);
      }
      return;
    }

    const clear = target.closest<HTMLElement>('[data-search-clear]');
    if (clear) {
      const root = clear.closest('.data-list');
      const field = root?.querySelector<HTMLInputElement>('[data-search-field]');
      if (root && field) {
        field.value = '';
        clear.hidden = true;
        field.focus();
        filterPublications(root);
      }
      return;
    }

    const reset = target.closest<HTMLElement>('[data-pub-reset]');
    if (reset) {
      const root = reset.closest('.data-list');
      if (root) resetPublications(root);
      return;
    }

    const loadMore = target.closest<HTMLElement>('[data-load-more]');
    if (loadMore) revealMore(loadMore);
  });

  document.addEventListener('keydown', (event) => {
    const tab = (event.target as Element)?.closest?.('[role="tab"]');
    if (!tab) return;
    const list = tab.closest('[role="tablist"]');
    if (!list) return;
    const tabs = Array.from(list.querySelectorAll<HTMLElement>('[role="tab"]'));
    const i = tabs.indexOf(tab as HTMLElement);
    let next: HTMLElement | undefined;
    if (event.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
    else if (event.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
    else if (event.key === 'Home') next = tabs[0];
    else if (event.key === 'End') next = tabs[tabs.length - 1];
    if (next) {
      event.preventDefault();
      next.focus();
      activateTab(next);
    }
  });
</script>

