---
// Split media · reach/split-media (docs/05 §2.4). Media Image · Video · Spec table · Numbered list ×
// Position End · Start. Text side cols 1–5 (Eyebrow, H2/H3, rich text, 0–2 actions, gap stack/md),
// media side cols 7–12, vertically centred; Position=Start swaps the sides.
// Mobile (≤899): Image/Video stack above the text; Spec table/Numbered list stack below it (DOM order
// is always text-then-media; only Image/Video get `order: -1` at the mobile breakpoint).
// 18 Sep 2026 (Why invest), three more media options:
//   Figures: a sequence of 2–4 points, each with its own proof figure. Title spans the top; the
//     figure column (cols 1–5) is sticky and swaps to the point crossing the middle of the viewport
//     (a clip + rise wipe, never a fade); the points scroll past in cols 7–12. A point's figure can
//     be a value or a split bar (e.g. revenue mix) that grows in. Mobile: no sticky, each point shows
//     its figure inline.
//   Card: a Card (usually Image bg, Featured) as the media, uncovered by a wipe as it enters.
//   Embed: an iframe (ir.oms.no share graph) cropped to `crop` px, with a source line and link.
// Any media except Numbered list can also carry `items` as a numbered list under the body copy.
// Layout Wide (19 Sep 2026, About › Our story): for long copy. Heading on top, the body in
// two columns (one paragraph each), then the image as a full-width 21:9 banner (16:9 tablet, 4:3 phone).
// Below 900 the columns stack. The image is optional: Careers › Who thrives (20 Sep 2026) is the same
// heading over two columns with no banner.
// Layout Stacked (18 Sep 2026 review): heading on top, `items` as three numbered cards in columns,
// and optionally a Card as a full-width banner below (left-to-right scrim, text bottom-left).
import BlockSection from '../components/BlockSection.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Link from '../components/Link.astro';
import MediaFrame from '../components/MediaFrame.astro';
import SpecRow from '../components/SpecRow.astro';
import NumberedItem from '../components/NumberedItem.astro';
import Card from '../components/Card.astro';
import Pictogram from '../components/Pictogram.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, CardField, ImageField, LinkField } from '../lib/types';

interface VideoField {
  url: string;
  title: string;
  /** Link label under the media frame, e.g. "Watch: remote operations explained (2:40)". */
  label?: string;
}

interface SpecItem {
  label: string;
  value: string;
}

interface NumberedListItem {
  title: string;
  text: string;
}

interface FigurePoint {
  /** Short label above the point title, e.g. "Reach Remote". */
  kicker?: string;
  title: string;
  text: string;
  /** The proof figure, e.g. "+111%". Ignored when `split` is set. */
  figure?: string;
  /** One line under the figure: what it measures and when. */
  caption: string;
  /** Two-part split bar instead of a figure; values are percentages. */
  split?: { label: string; value: number }[];
  /** Split only: the period, shown first in the donut centre ("Q2 2026"). */
  period?: string;
}

interface EmbedField {
  src: string;
  title: string;
  /** Full iframe height (px); the frame shows only the top `crop` px. */
  height: number;
  crop?: number;
  source?: string;
  link?: LinkField;
}

interface Props extends BlockFields {
  media?: 'image' | 'video' | 'spec-table' | 'numbered-list' | 'figures' | 'card' | 'embed';
  /** Card media only: `stacked` = heading, items in columns, the card as a full-width banner below.
   * Figures media: `cards` = all points visible as cards (default `split` = sticky figure).
   * Image media: `wide` = heading, two-column body, full-width banner image. */
  layout?: 'split' | 'stacked' | 'cards' | 'wide';
  position?: 'end' | 'start';
  eyebrow?: string;
  title: string;
  headingLevel?: 'h2' | 'h3';
  /** Rich text HTML string, rendered in .prose via set:html. A default slot also renders in .prose. */
  body?: string;
  /** 0–2 action Links under the body copy. */
  actions?: LinkField[];
  image?: ImageField;
  caption?: string;
  video?: VideoField;
  specHeading?: string;
  specs?: SpecItem[];
  /** Only renders when it has a url ("Download spec sheet (PDF)"). */
  specFile?: LinkField;
  /** 3–6 numbered items (Reach Remote oversight levels, HOP). */
  items?: NumberedListItem[];
  figures?: FigurePoint[];
  card?: CardField;
  embed?: EmbedField;
  /** A quote in place of the visible heading (19 Sep 2026, Investors overview CEO letter). `title` stays the
   * section's accessible name (a visually hidden H2); the quote reads as H3, then the attribution. */
  quote?: { text: string; name: string; role?: string };
  /** A 96 line pictogram above the heading (19 Sep 2026, service singles: the line's own pictogram,
   * which plays its loop once as the section scrolls in). */
  pictogram?: string;
  class?: string;
}

const {
  media = 'image',
  layout = 'split',
  position = 'end',
  eyebrow,
  title,
  headingLevel: Heading = 'h2',
  body,
  actions = [],
  image,
  caption,
  video,
  specHeading,
  specs = [],
  specFile,
  items = [],
  figures = [],
  card,
  embed,
  quote,
  pictogram,
  background,
  spacing,
  anchor,
  class: className,
} = Astro.props;

const titleId = makeId('split-media', title);
const shownActions = actions.slice(0, 2);
const hasSpecFile = Boolean(specFile?.url);
const listInText = media !== 'numbered-list' && items.length > 0;
const stacked = layout === 'stacked' && media !== 'figures';
const wide = layout === 'wide' && media === 'image';
const figureCards = media === 'figures' && layout === 'cards';
// Cards: value points stack in the left column; a split point becomes the feature card on the right.
const valuePoints = figures.filter((p) => !p.split);
const splitPoint = figures.find((p) => p.split);
// Donut geometry: r = 100/2π, so the circumference is exactly 100 and dash lengths are percentages.
const DONUT_R = 15.9155;
// No gap between arcs (review round 6): gaps made a 100% split read as an incomplete ring.
const DONUT_GAP = 0;
const rootClass = [wide && 'split-media--wide', stacked && 'split-media--stacked', figureCards && 'split-media--figure-cards', `split-media--${media}`, `split-media--${position}`, className].filter(Boolean).join(' ');
---

<BlockSection
  slug="split-media"
  root="split-media"
  class={rootClass}
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
>
  {wide ? (
    <div class="split-media__stack">
      <div class="split-media__stack-head">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <Heading id={titleId} class:list={['split-media__title', Heading === 'h3' ? 'text-h3' : 'text-h2']}>{title}</Heading>
      </div>
      <div class="prose split-media__body split-media__body--cols">
        {body && <Fragment set:html={body} />}
        <slot />
      </div>
      {image && (
        <div class="split-media__wide-media">
          <MediaFrame ratio="21:9" image={image} caption={caption} />
        </div>
      )}
    </div>
  ) : stacked ? (
    <div class="split-media__stack">
      <div class="split-media__stack-head">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <Heading id={titleId} class:list={['split-media__title', Heading === 'h3' ? 'text-h3' : 'text-h2']}>{title}</Heading>
        {body && <div class="prose split-media__body"><Fragment set:html={body} /></div>}
      </div>
      {items.length > 0 && (
        <ol class="split-media__list split-media__cols">
          {items.map((item) => (
            <NumberedItem title={item.title} text={item.text} />
          ))}
        </ol>
      )}
      {card && (
        <div class="split-media__banner" data-wipe>
          <Card {...card} />
        </div>
      )}
    </div>
  ) : figureCards ? (
    <div class="split-media__stack">
      <div class="split-media__stack-head">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <Heading id={titleId} class:list={['split-media__title', 'text-h2']}>{title}</Heading>
      </div>
      <div class:list={['figures__cards', !splitPoint && 'figures__cards--single']}>
        <ul class="figures__list">
          {valuePoints.map((point) => (
            <li class="figures__card">
              <div class="figures__card-text">
                <h3 class="text-h4">{point.title}</h3>
                <p class="figures__text text-small">{point.text}</p>
              </div>
              <div class="figures__proof">
                <p class="figures__value"><span data-count-up>{point.figure}</span></p>
                <p class="figures__caption text-caption">{point.caption}</p>
              </div>
            </li>
          ))}
        </ul>
        {splitPoint?.split && (
          <div class="figures__card figures__card--feature has-surface-navy">
            <h3 class="text-h4">{splitPoint.title}</h3>
            <figure class="figures__donut">
              <div class="figures__donut-chart">
                <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false">
                  <mask id={`${titleId}-sweep`} maskUnits="userSpaceOnUse" x="0" y="0" width="42" height="42">
                    <circle class="figures__sweep" cx="21" cy="21" r={DONUT_R} fill="none" stroke="#fff" stroke-width="9" />
                  </mask>
                  <g mask={`url(#${titleId}-sweep)`}>
                  {splitPoint.split.map((part, n) => {
                    const offset = splitPoint.split!.slice(0, n).reduce((sum, p) => sum + p.value, 0);
                    return (
                      <circle
                        class={`figures__arc figures__arc--${n}`}
                        cx="21"
                        cy="21"
                        r={DONUT_R}
                        fill="none"
                        style={`--arc: ${part.value - DONUT_GAP}; --arc-offset: ${-offset}`}
                      />
                    );
                  })}
                  </g>
                </svg>
                <p class="figures__donut-centre">
                  {splitPoint.period && <strong class="figures__donut-period">{splitPoint.period}</strong>}
                  <span class="text-small">{splitPoint.caption}</span>
                </p>
              </div>
            </figure>
            {/* Arcs start at 12 o'clock and run clockwise, so the first share sits on the right and
                the second on the left: under the ring each label sits beside its own arc */}
            <div class="figures__donut-labels">
              {splitPoint.split.slice(0, 2).map((part, n) => (
                <p class={`figures__donut-label figures__donut-label--${n === 0 ? 'end' : 'start'}`}>
                  <span class="figures__donut-value">{part.value}%</span>
                  <span class="figures__donut-name text-small">
                    <span class={`figures__swatch figures__swatch--${n}`} aria-hidden="true" />
                    {part.label}
                  </span>
                </p>
              ))}
            </div>
            <p class="figures__text text-small">{splitPoint.text}</p>
          </div>
        )}
      </div>
    </div>
  ) : media === 'figures' ? (
    <div class="split-media__figures" data-figures>
      <div class="split-media__figures-head">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <Heading id={titleId} class:list={['split-media__title', 'text-h2']}>{title}</Heading>
      </div>
      <div class="figures__stage" aria-hidden="true">
        {figures.map((point, i) => (
          <div class:list={['figures__slot', i === 0 && 'is-active']} data-figure-slot={i}>
            {point.split ? (
              <div class="figures__split" style={`--split-a: ${point.split[0]?.value ?? 50}%`}>
                <div class="figures__bar">
                  {point.split.map((part) => <span class="figures__part">{part.value}%</span>)}
                </div>
                <div class="figures__keys text-small">
                  {point.split.map((part) => <span>{part.label}</span>)}
                </div>
              </div>
            ) : (
              <p class="figures__value">{point.figure}</p>
            )}
            <p class="figures__caption text-body">{point.caption}</p>
          </div>
        ))}
      </div>
      <ol class="figures__points">
        {figures.map((point, i) => (
          <li class="figures__point" data-figure-point={i}>
            <div class="figures__inline">
              {point.split ? (
                <div class="figures__split" style={`--split-a: ${point.split[0]?.value ?? 50}%`}>
                  <div class="figures__bar">
                    {point.split.map((part) => <span class="figures__part">{part.value}%</span>)}
                  </div>
                  <div class="figures__keys text-small">
                    {point.split.map((part) => <span>{part.label}</span>)}
                  </div>
                </div>
              ) : (
                <p class="figures__value">{point.figure}</p>
              )}
              <p class="figures__caption text-small">{point.caption}</p>
            </div>
            {point.kicker && <Eyebrow text={point.kicker} as="span" />}
            <h3 class="figures__title text-h3">{point.title}</h3>
            <p class="figures__text text-lead">{point.text}</p>
          </li>
        ))}
      </ol>
    </div>
  ) : (
  <div class="split-media__columns">
    <div class="split-media__text">
      {pictogram && <Pictogram name={pictogram} size={96} class="split-media__pictogram" />}
      {eyebrow && <Eyebrow text={eyebrow} />}
      {quote ? (
        <Fragment>
          <Heading id={titleId} class="visually-hidden">{title}</Heading>
          <figure class="split-media__quote">
            <blockquote class="text-h3"><p>{quote.text}</p></blockquote>
            <figcaption class="text-small">
              <strong>{quote.name}</strong>{quote.role && `, ${quote.role}`}
            </figcaption>
          </figure>
        </Fragment>
      ) : (
        <Heading id={titleId} class:list={['split-media__title', Heading === 'h3' ? 'text-h3' : 'text-h2']}>
          {title}
        </Heading>
      )}
      <div class="prose split-media__body">
        {body && <Fragment set:html={body} />}
        <slot />
      </div>
      {
        listInText && (
          <ol class="split-media__list split-media__list--text">
            {items.map((item) => (
              <NumberedItem title={item.title} text={item.text} />
            ))}
          </ol>
        )
      }
      {
        shownActions.length > 0 && (
          <div class="split-media__actions">
            {shownActions.map((action) => (
              <Link label={action.label} href={action.url} action={action.action ?? 'page'} context={action.context} />
            ))}
          </div>
        )
      }
    </div>

    <div class="split-media__media">
      {media === 'image' && <MediaFrame ratio="4:3" image={image} caption={caption} />}

      {
        media === 'video' && video && (
          <Fragment>
            <MediaFrame
              ratio="16:9"
              image={image}
              caption={caption}
              showPlay
              playLabel={`Play: ${video.title}`}
              playAttrs={{ 'data-video-src': video.url, 'data-video-title': video.title }}
            />
            <Link
              label={video.label ?? `Watch: ${video.title}`}
              action="video"
              data-video-src={video.url}
              data-video-title={video.title}
            />
          </Fragment>
        )
      }

      {
        media === 'spec-table' && specs.length > 0 && (
          <div class="split-media__spec-table">
            {specHeading && <h3 class="split-media__spec-heading text-h5">{specHeading}</h3>}
            <dl class="split-media__specs">
              {specs.map((spec) => (
                <SpecRow label={spec.label} value={spec.value} />
              ))}
            </dl>
            {hasSpecFile && specFile && (
              <Link label={specFile.label} href={specFile.url} action="file" size="small" context={specFile.context} />
            )}
          </div>
        )
      }

      {
        media === 'numbered-list' && items.length > 0 && (
          <ol class="split-media__list">
            {items.map((item) => (
              <NumberedItem title={item.title} text={item.text} />
            ))}
          </ol>
        )
      }

      {
        media === 'card' && card && (
          <div class="split-media__card" data-wipe>
            <Card {...card} />
          </div>
        )
      }

      {
        media === 'embed' && embed && (
          <figure class="split-media__embed">
            <div class="split-media__embed-crop" style={`height: ${embed.crop ?? embed.height}px`}>
              <iframe
                src={embed.src}
                title={embed.title}
                width="100%"
                height={embed.height}
                loading="lazy"
                scrolling="no"
                referrerpolicy="strict-origin-when-cross-origin"
              />
            </div>
            {(embed.source || embed.link) && (
              <figcaption class="split-media__embed-caption text-caption">
                {embed.source && <span>{embed.source}</span>}
                {embed.link && <Link label={embed.link.label} href={embed.link.url} action={embed.link.action ?? 'page'} size="small" />}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </div>
  )}
</BlockSection>

<style is:global>
  .split-media__columns {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--wp--custom--grid--gutter);
    align-items: center;
  }
  /* Both sides on row 1: with Position start the media column comes before the text in the grid,
     and auto-placement would otherwise push it to a second row */
  .split-media__text {
    grid-row: 1;
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--md);
    min-width: 0;
  }
  .split-media__media {
    grid-row: 1;
    grid-column: 7 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--16);
    min-width: 0;
  }
  .split-media--start .split-media__text {
    grid-column: 8 / span 5;
  }
  /* The loop's travelling gaps are painted in the section ground. The art sits 12px inside the 96
     grid, so pull it out to line up with the heading's left edge */
  .split-media__pictogram {
    --pg-bg: var(--wp--custom--color--bg--default);
    margin-left: -12px;
  }
  .has-surface-tint .split-media__pictogram {
    --pg-bg: var(--wp--custom--color--bg--tint);
  }
  .split-media--start .split-media__media {
    grid-column: 1 / span 6;
  }

  /* Quote: the text reads as H3 with hanging marks, the attribution one line under it */
  .split-media__quote {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
    margin: 0;
  }
  .split-media__quote blockquote {
    margin: 0;
    text-indent: -0.4em;
    text-wrap: pretty;
  }
  .split-media__quote figcaption {
    color: var(--wp--custom--color--text--secondary);
  }
  .split-media__quote figcaption strong {
    color: var(--wp--custom--color--text--primary);
    font-weight: var(--wp--custom--font-weight--bold);
  }

  .split-media__body:empty {
    display: none;
  }

  /* Wide: two-column body, banner image */
  .split-media__body--cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--wp--custom--stack--sm) var(--wp--custom--grid--gutter);
  }
  .split-media__body--cols > * + * {
    margin-top: 0;
  }
  /* A column holding several paragraphs keeps the normal paragraph rhythm */
  .split-media__body--cols > div > * + * {
    margin-top: var(--wp--custom--stack--sm);
  }
  @media (max-width: 899px) {
    .split-media__body--cols {
      grid-template-columns: 1fr;
    }
    .split-media__wide-media .media-frame__frame {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 599px) {
    .split-media__wide-media .media-frame__frame {
      aspect-ratio: 4 / 3;
    }
  }

  .split-media__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--16) var(--wp--preset--spacing--24);
  }

  .split-media__spec-table,
  .split-media__list {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
  }
  .split-media__specs {
    display: flex;
    flex-direction: column;
  }
  .split-media__list {
    counter-reset: numbered-item;
    gap: 0;
  }


  .split-media__list--text {
    margin-top: var(--wp--preset--spacing--8);
  }
  .split-media__list--text .numbered-item {
    grid-template-columns: 56px 1fr;
  }
  /* The list follows the heading directly; a rule above the first item only adds noise (18 Sep 2026) */
  .split-media__list:not(.split-media__cols) .numbered-item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  /* ── Card ─────────────────────────────────────────────────── */
  .split-media--card .split-media__columns {
    align-items: stretch;
  }
  .split-media__card {
    display: flex;
    flex: 1;
    min-height: 560px;
  }
  .split-media__card > .card {
    flex: 1;
  }


  /* ── Stacked (Card) ───────────────────────────────────────── */
  .split-media__stack {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--xl);
  }
  .split-media__stack-head {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--md);
    max-width: 880px;
  }
  .split-media__stack-head .split-media__title {
    text-wrap: balance;
  }
  .split-media__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: auto;
    gap: var(--wp--custom--stack--lg) var(--wp--custom--grid--gutter);
  }
  /* In columns the number sits above the title instead of beside it */
  .split-media__cols .numbered-item {
    grid-template-columns: 1fr;
    /* Cards (review round 4) */
    padding: var(--wp--preset--spacing--32);
    border-radius: var(--wp--custom--radius--md);
    background-color: var(--wp--custom--color--bg--tint);
    /* Number, title and text share rows across the three columns, so the text always starts on
       one line even when a title wraps to two */
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: var(--wp--preset--spacing--12);
    border-top: 0;
  }
  .split-media__cols .numbered-item__body {
    display: contents;
  }
  .split-media__banner {
    display: flex;
    min-height: 480px;
  }
  .split-media__banner > .card {
    flex: 1;
  }
  .split-media__banner .card__content {
    max-width: 720px;
  }
  /* Wide banner: the scrim runs from the text side instead of from the bottom, so the right half
     stays a photo */
  .split-media__banner .card__overlay {
    background:
      linear-gradient(to right, var(--wp--custom--color--scrim--solid) 0%, rgb(27 29 59 / 0.82) 38%, rgb(27 29 59 / 0.3) 68%, var(--wp--custom--color--scrim--floor) 100%),
      linear-gradient(to top, rgb(27 29 59 / 0.5) 0%, rgb(27 29 59 / 0) 45%);
  }
  @media (max-width: 899px) {
    .split-media__cols {
      grid-template-columns: 1fr;
    }
    .split-media__banner {
      min-height: 440px;
    }
    .split-media__banner .card__overlay {
      background: linear-gradient(to top, var(--wp--custom--color--scrim--solid) 0%, rgb(27 29 59 / 0.86) 45%, rgb(27 29 59 / 0.3) 75%, var(--wp--custom--color--scrim--floor) 100%);
    }
  }


  /* ── Figures · Cards (review round 4) ─────────────────────── */
  /* Reading order inside each card: title → body → proof figure. Value points stack on the left;
     the split (revenue mix) is the feature card on the right, drawn as a donut. */
  .figures__cards {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--wp--custom--grid--gutter);
  }
  .figures__list {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
