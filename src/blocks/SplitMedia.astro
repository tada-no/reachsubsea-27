---
// Split media · reach/split-media (docs/05 §2.4). Media Image · Video · Spec table · Numbered list ×
// Position End · Start. Text side cols 1–5 (Eyebrow, H2/H3, rich text, 0–2 actions, gap stack/md),
// media side cols 7–12, vertically centred; Position=Start swaps the sides.
// Mobile (≤899): Image/Video stack above the text; Spec table/Numbered list stack below it (DOM order
// is always text-then-media; only Image/Video get `order: -1` at the mobile breakpoint).
// 21 Sep 2026 (Q67): Figures, Card and Embed media moved out. Figures is its own block (src/blocks/Figures.astro),
// the share-graph embed is Split embed (src/blocks/SplitEmbed.astro), and the Card media (unused on any page)
// was dropped: a Card in a section is Card grid / Card bento. This block is now Image · Video · Spec table ·
// Numbered list, so every field applies to what the editor picked.
// Any media except Numbered list can also carry `items` as a numbered list under the body copy, or `tiles`
// (4 Oct 2026): 2–3 pictogram tiles, one per row, for a few short items that are too few for a card row.
// Layout Wide (19 Sep 2026, About › Our story): for long copy. Heading on top, the body in
// two columns (one paragraph each), then the image as a full-width 21:9 banner (16:9 tablet, 4:3 phone).
// Below 900 the columns stack. The image is optional: Careers › Who thrives (20 Sep 2026) is the same
// heading over two columns with no banner.
// Layout Beside (8 Oct 2026, Careers › Who thrives, Ross; Figma 435:17585): short copy that answers the heading.
// Eyebrow on top, then the heading in cols 1–6 and one paragraph in cols 7–12, top-aligned with the heading's first
// line. No media. Below 900 the body follows the heading.
// Poster (6 Oct 2026, HSEQ campaigns, Q115): a campaign poster or similar artwork shown whole, at its own
// proportions (no crop, no photo tint: it is artwork) in 5 columns, the text in 6, a 1px subtle edge; it opens the
// Lightbox (the page renders <Dialog type="lightbox" />). Below 900 it follows the text (a tall poster first
// would push the title a screen down).
// Documents (6 Oct 2026, HSEQ policies, Q115): the media side is a list of named file links (a policy set, a
// governance pack) under an optional H5 heading, rows divided like Spec rows, two columns from 600.
// Documents stacked (7 Oct 2026, HSEQ policies, Ross: the split's two columns zig-zagged and wrapped): heading,
// body and actions across the top (max 880), then the list full width in newspaper columns that read top-down,
// three from 1200, two from 600, one on phones.
// Layout Stacked (18 Sep 2026 review, Numbered list only): heading on top, `items` as three numbered cards in
// columns. Spec table stacked (6 Oct 2026, HSEQ standards, Q115): heading and body on top, then two parallel,
// top-aligned lists: the `tiles` (under `tilesHeading`) in cols 1–5 and the spec table in cols 7–12.
// Stacked heads (7 Oct 2026, Ross: on HSEQ the stacked blocks headed differently from the Card grid and Checklist
// grid around them): every stacked layout opens with the shared Section header (Eyebrow, H2, Lead `intro`, one
// action at the row's far end from 900), so a stacked Split media reads like any other full-width block.
// Numbered list split (6 Oct 2026, HSEQ): a long list beside short copy, so the text column is top-aligned and
// sticky from 900, like Accordion split, instead of floating mid-list.
import BlockSection from '../components/BlockSection.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Link from '../components/Link.astro';
import MediaFrame from '../components/MediaFrame.astro';
import SpecRow from '../components/SpecRow.astro';
import NumberedItem from '../components/NumberedItem.astro';
import PictogramTile from '../components/PictogramTile.astro';
import Pictogram from '../components/Pictogram.astro';
import { makeId } from '../lib/ids';
import type { BlockFields, ImageField, LinkField } from '../lib/types';

interface VideoField {
  url: string;
  title: string;
  /** Link label under the media frame, e.g. "Watch: remote operations explained (2:40)". */
  label?: string;
}

interface SpecItem {
  label: string;
  value: string;
}

interface NumberedListItem {
  title: string;
  text: string;
}

interface TileItem {
  pictogram: string;
  title: string;
  text: string;
  link?: LinkField;
}

interface Props extends BlockFields {
  media?: 'image' | 'video' | 'spec-table' | 'numbered-list' | 'documents' | 'poster';
  /** Numbered list media: `stacked` = heading, then the items as numbered cards in columns.
   * Image media: `wide` = heading, two-column body, full-width banner image; `beside` = heading in the start
   * half, one paragraph beside it in the end half, no image. */
  layout?: 'split' | 'stacked' | 'wide' | 'beside';
  position?: 'end' | 'start';
  eyebrow?: string;
  title: string;
  headingLevel?: 'h2' | 'h3';
  /** Rich text HTML string, rendered in .prose via set:html. A default slot also renders in .prose. */
  body?: string;
  /** Stacked layouts: the head is a Section header (7 Oct 2026), so its copy is one plain-text Lead
   * paragraph, not rich text, and only the first action shows, at the row's far end from 900. */
  intro?: string;
  /** 0–2 action Links under the body copy. */
  actions?: LinkField[];
  image?: ImageField;
  caption?: string;
  video?: VideoField;
  specHeading?: string;
  specs?: SpecItem[];
  /** Only renders when it has a url ("Spec sheet (PDF)"). */
  specFile?: LinkField;
  /** Documents media: an optional heading over the list, and the files (each a named LinkField). */
  documentsHeading?: string;
  documents?: LinkField[];
  /** 3–6 numbered items (Reach Remote oversight levels, HOP). */
  items?: NumberedListItem[];
  /** 2–3 pictogram tiles under the body copy, one per row in the text column (4 Oct 2026, Assets overview:
   * the survey suite and the monitoring technology). Library pictograms only. */
  tiles?: TileItem[];
  /** Spec table stacked: an H5 over the tiles, parallel to `specHeading`. */
  tilesHeading?: string;
  /** A quote in place of the visible heading (19 Sep 2026, Investors overview CEO letter). `title` stays the
   * section's accessible name (a visually hidden H2); the quote reads as H3, then the attribution. */
  quote?: { text: string; name: string; role?: string };
  /** Spec table stacked: a second spec table in the start column in place of the tiles, under `pairHeading`
   * (7 Oct 2026, HSEQ campaign: The golden rules beside Offshore risks, both as Spec rows). */
  pairSpecs?: SpecItem[];
  pairHeading?: string;
  /** Keep `title` as the section's accessible name only (a visually hidden heading), where the block continues
   * the one above (`joined`) and its own H3s head the content. */
  titleHidden?: boolean;
  /** Continues the block above on the same ground (7 Oct 2026, HSEQ campaign): no top padding, as Card grid's
   * `joined`, so a run of blocks reads as one section. */
  joined?: boolean;
  /** Image media is artwork (an illustration, not a photo): no photo tint, shown whole on its own ground. */
  artwork?: boolean;
  /** A 96 line pictogram above the heading (19 Sep 2026, service singles: the line's own pictogram,
   * which plays its loop once as the section scrolls in). */
  pictogram?: string;
  class?: string;
}

const {
  media = 'image',
  layout = 'split',
  position = 'end',
  eyebrow,
  title,
  headingLevel: Heading = 'h2',
  body,
  intro,
  actions = [],
  image,
  caption,
  video,
  specHeading,
  specs = [],
  specFile,
  documentsHeading,
  documents = [],
  items = [],
  tiles = [],
  tilesHeading,
  quote,
  pictogram,
  pairSpecs = [],
  pairHeading,
  titleHidden = false,
  artwork = false,
  joined = false,
  background,
  spacing,
  anchor,
  class: className,
} = Astro.props;

const titleId = makeId('split-media', title);
const shownActions = actions.slice(0, 2);
const hasSpecFile = Boolean(specFile?.url);
const listInText = media !== 'numbered-list' && items.length > 0;
const stacked = layout === 'stacked' && media === 'numbered-list';
const specStacked = layout === 'stacked' && media === 'spec-table';
const docsStacked = layout === 'stacked' && media === 'documents';
const wide = layout === 'wide' && media === 'image';
const beside = layout === 'beside';
const rootClass = [joined && 'split-media--joined', wide && 'split-media--wide', beside && 'split-media--beside', (stacked || specStacked || docsStacked) && 'split-media--stacked', `split-media--${media}`, `split-media--${position}`, className].filter(Boolean).join(' ');
---

<BlockSection
  slug="split-media"
  root="split-media"
  class={rootClass}
  background={background}
  spacing={spacing}
  anchor={anchor}
  labelledBy={titleId}
>
  {beside ? (
    <div class="split-media__beside">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <Heading id={titleId} class:list={['split-media__title', Heading === 'h3' ? 'text-h3' : 'text-h2']}>{title}</Heading>
      <div class="prose split-media__body">
        {body && <Fragment set:html={body} />}
        <slot />
      </div>
    </div>
  ) : wide ? (
    <div class="split-media__stack">
      <div class="split-media__stack-head">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <Heading id={titleId} class:list={['split-media__title', Heading === 'h3' ? 'text-h3' : 'text-h2']}>{title}</Heading>
      </div>
      <div class="prose split-media__body split-media__body--cols">
        {body && <Fragment set:html={body} />}
        <slot />
      </div>
      {image && (
        <div class="split-media__wide-media">
          <MediaFrame ratio="21:9" image={image} caption={caption} />
        </div>
      )}
    </div>
  ) : docsStacked ? (
    <div class="split-media__stack">
      <SectionHeader eyebrow={eyebrow} title={title} intro={intro} action={shownActions[0]} id={titleId} as={Heading} />
      {documents.length > 0 && (
        <div class="split-media__documents split-media__documents--stacked">
          {documentsHeading && <h3 class="split-media__spec-heading text-h5">{documentsHeading}</h3>}
          <ul class="split-media__document-list">
            {documents.map((doc) => (
              <li class="split-media__document">
                <Link label={doc.label} href={doc.url} action={doc.action ?? 'file'} size="small" context={doc.context} />
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  ) : specStacked ? (
    <div class="split-media__stack">
      {titleHidden ? (
        <Heading id={titleId} class="visually-hidden">{title}</Heading>
      ) : (
        <SectionHeader eyebrow={eyebrow} title={title} intro={intro} action={shownActions[0]} id={titleId} as={Heading} />
      )}
      <div class="split-media__pair">
        {pairSpecs.length > 0 && (
          <div class="split-media__spec-table split-media__pair-start">
            {pairHeading && <h3 class="split-media__spec-heading text-h5">{pairHeading}</h3>}
            <dl class="split-media__specs">
              {pairSpecs.map((spec) => (
                <SpecRow label={spec.label} value={spec.value} />
              ))}
            </dl>
          </div>
        )}
        {tiles.length > 0 && pairSpecs.length === 0 && (
          <div class="split-media__pair-start">
            {tilesHeading && <h3 class="split-media__spec-heading text-h5">{tilesHeading}</h3>}
            <ul class="split-media__tiles">
              {tiles.map((tile) => (
                <PictogramTile pictogram={tile.pictogram} title={tile.title} text={tile.text} link={tile.link} headingLevel={tilesHeading ? 'h4' : 'h3'} />
              ))}
            </ul>
          </div>
        )}
        {specs.length > 0 && (
          <div class="split-media__spec-table split-media__pair-end">
            {specHeading && <h3 class="split-media__spec-heading text-h5">{specHeading}</h3>}
            <dl class="split-media__specs">
              {specs.map((spec) => (
                <SpecRow label={spec.label} value={spec.value} />
              ))}
            </dl>
            {hasSpecFile && specFile && (
              <Link label={specFile.label} href={specFile.url} action="file" size="small" context={specFile.context} />
            )}
          </div>
        )}
      </div>
    </div>
  ) : stacked ? (
    <div class="split-media__stack">
      <SectionHeader eyebrow={eyebrow} title={title} intro={intro} action={shownActions[0]} id={titleId} as={Heading} />
      {items.length > 0 && (
        <ol class="split-media__list split-media__cols">
          {items.map((item) => (
            <NumberedItem title={item.title} text={item.text} />
          ))}
        </ol>
      )}
    </div>
  ) : (
  <div class="split-media__columns">
    <div class="split-media__text">
      {pictogram && <Pictogram name={pictogram} size={96} class="split-media__pictogram" />}
      {eyebrow && <Eyebrow text={eyebrow} />}
      {quote ? (
        <Fragment>
          <Heading id={titleId} class="visually-hidden">{title}</Heading>
          <figure class="split-media__quote">
            <blockquote class="text-h3"><p>{quote.text}</p></blockquote>
            <figcaption class="text-small">
              <strong>{quote.name}</strong>{quote.role && `, ${quote.role}`}
            </figcaption>
          </figure>
        </Fragment>
      ) : (
        <Heading id={titleId} class:list={['split-media__title', Heading === 'h3' ? 'text-h3' : 'text-h2']}>
          {title}
        </Heading>
      )}
      <div class="prose split-media__body">
        {body && <Fragment set:html={body} />}
        <slot />
      </div>
      {
        listInText && (
          <ol class="split-media__list split-media__list--text">
            {items.map((item) => (
              <NumberedItem title={item.title} text={item.text} />
            ))}
          </ol>
        )
      }
      {
        tiles.length > 0 && (
          <ul class="split-media__tiles">
            {tiles.map((tile) => (
              <PictogramTile pictogram={tile.pictogram} title={tile.title} text={tile.text} link={tile.link} />
            ))}
          </ul>
        )
      }
      {
        shownActions.length > 0 && (
          <div class="split-media__actions">
            {shownActions.map((action) => (
              <Link label={action.label} href={action.url} action={action.action ?? 'page'} context={action.context} />
            ))}
          </div>
        )
      }
    </div>

    <div class="split-media__media">
      {media === 'image' && <MediaFrame ratio="4:3" image={image} caption={caption} class={artwork ? 'media-frame--artwork' : undefined} />}

      {
        media === 'poster' && image?.src && (
          <button
            type="button"
            class="split-media__poster"
            data-lightbox={titleId}
            data-src={image.src}
            data-alt={image.alt}
            data-caption={caption ?? image.alt}
            aria-label={`Enlarge: ${image.alt}`}
          >
            <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
          </button>
        )
      }

      {
        media === 'video' && video && (
          <Fragment>
            <MediaFrame
              ratio="16:9"
              image={image}
              caption={caption}
              showPlay
              playLabel={`Play: ${video.title}`}
              playAttrs={{ 'data-video-src': video.url, 'data-video-title': video.title }}
            />
            <Link
              label={video.label ?? `Watch: ${video.title}`}
              action="video"
              data-video-src={video.url}
              data-video-title={video.title}
            />
          </Fragment>
        )
      }

      {
        media === 'spec-table' && specs.length > 0 && (
          <div class="split-media__spec-table">
            {specHeading && <h3 class="split-media__spec-heading text-h5">{specHeading}</h3>}
            <dl class="split-media__specs">
              {specs.map((spec) => (
                <SpecRow label={spec.label} value={spec.value} />
              ))}
            </dl>
            {hasSpecFile && specFile && (
              <Link label={specFile.label} href={specFile.url} action="file" size="small" context={specFile.context} />
            )}
          </div>
        )
      }

      {
        media === 'documents' && documents.length > 0 && (
          <div class="split-media__documents">
            {documentsHeading && <h3 class="split-media__spec-heading text-h5">{documentsHeading}</h3>}
            <ul class="split-media__document-list">
              {documents.map((doc) => (
                <li class="split-media__document">
                  <Link label={doc.label} href={doc.url} action={doc.action ?? 'file'} size="small" context={doc.context} />
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        media === 'numbered-list' && items.length > 0 && (
          <ol class="split-media__list">
            {items.map((item) => (
              <NumberedItem title={item.title} text={item.text} />
            ))}
          </ol>
        )
      }

    </div>
  </div>
  )}
</BlockSection>

<style is:global>
  .split-media__columns {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--wp--custom--grid--gutter);
    align-items: center;
  }
  /* Both sides on row 1: with Position start the media column comes before the text in the grid,
     and auto-placement would otherwise push it to a second row */
  .split-media__text {
    grid-row: 1;
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--md);
    min-width: 0;
  }
  .split-media__media {
    grid-row: 1;
    grid-column: 7 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--16);
    min-width: 0;
  }
  .split-media--start .split-media__text {
    grid-column: 8 / span 5;
  }
  /* The loop's travelling gaps are painted in the section ground. The art sits 12px inside the 96
     grid, so pull it out to line up with the heading's left edge */
  .split-media__pictogram {
    --pg-bg: var(--wp--custom--color--bg--default);
    margin-left: calc(-1 * var(--wp--preset--spacing--12));
  }
  .has-surface-tint .split-media__pictogram {
    --pg-bg: var(--wp--custom--color--bg--tint);
  }
  .split-media--start .split-media__media {
    grid-column: 1 / span 6;
  }

  /* Quote: the text reads as H3 with hanging marks, the attribution one line under it */
  .split-media__quote {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
    margin: 0;
  }
  .split-media__quote blockquote {
    margin: 0;
    text-indent: -0.4em;
    text-wrap: pretty;
  }
  .split-media__quote figcaption {
    color: var(--wp--custom--color--text--secondary);
  }
  .split-media__quote figcaption strong {
    color: var(--wp--custom--color--text--primary);
    font-weight: var(--wp--custom--font-weight--bold);
  }

  .split-media__body:empty {
    display: none;
  }

  /* Beside: heading cols 1–6, body cols 7–12 on the heading's row, top-aligned */
  .split-media__beside {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--wp--custom--grid--gutter);
    row-gap: var(--wp--custom--stack--md);
    align-items: start;
  }
  .split-media__beside > .eyebrow {
    grid-column: 1 / span 6;
  }
  .split-media__beside > .split-media__title {
    grid-column: 1 / span 6;
    text-wrap: balance;
  }
  .split-media__beside > .split-media__body {
    grid-column: 7 / span 6;
  }
  @media (max-width: 899px) {
    .split-media__beside > :is(.eyebrow, .split-media__title, .split-media__body) {
      grid-column: 1 / -1;
    }
  }

  /* Wide: two-column body, banner image */
  /* Two columns on the 12-column grid, cols 1–5 and 7–11 (Ross, 8 Oct 2026: a single gutter between two dense
     paragraphs read tight). The gap is a column and two gutters, and the lines run ~65–70 characters, in line with
     Split media's text column (1–5) and media column (from 7) elsewhere on the site */
  .split-media__body--cols {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--wp--custom--stack--sm) var(--wp--custom--grid--gutter);
  }
  .split-media__body--cols > :nth-child(odd) {
    grid-column: 1 / span 5;
  }
  .split-media__body--cols > :nth-child(even) {
    grid-column: 7 / span 5;
  }
  .split-media__body--cols > * + * {
    margin-top: 0;
  }
  /* A column holding several paragraphs keeps the normal paragraph rhythm */
  .split-media__body--cols > div > * + * {
    margin-top: var(--wp--custom--stack--sm);
  }
  @media (max-width: 899px) {
    .split-media__body--cols {
      grid-template-columns: 1fr;
    }
    .split-media__body--cols > :is(:nth-child(odd), :nth-child(even)) {
      grid-column: auto;
    }
    .split-media__wide-media .media-frame__frame {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 599px) {
    .split-media__wide-media .media-frame__frame {
      aspect-ratio: 4 / 3;
    }
  }

  .split-media__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--16) var(--wp--preset--spacing--24);
  }

  .split-media__spec-table,
  .split-media__list {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
  }
  .split-media__specs {
    display: flex;
    flex-direction: column;
  }
  /* Poster: whole artwork, no tint, opens the Lightbox */
  @media (min-width: 900px) {
    .split-media--poster.split-media--start .split-media__media {
      grid-column: 1 / span 5;
    }
    .split-media--poster.split-media--start .split-media__text {
      grid-column: 7 / span 6;
    }
    .split-media--poster.split-media--end .split-media__text {
      grid-column: 1 / span 6;
    }
    .split-media--poster.split-media--end .split-media__media {
      grid-column: 8 / span 5;
    }
  }
  .split-media__poster {
    display: block;
    width: 100%;
    max-width: 560px;
    overflow: hidden;
    border: 1px solid var(--wp--custom--color--border--subtle);
    border-radius: var(--wp--custom--radius--md);
    cursor: zoom-in;
  }
  .split-media__poster img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--wp--custom--motion--duration) var(--wp--custom--motion--ease-out);
  }
  .split-media__poster:focus-visible {
    outline: 2px solid var(--wp--custom--color--border--focus);
    outline-offset: 4px;
  }
  @media (hover: hover) {
    .split-media__poster:hover img {
      transform: scale(1.02);
    }
  }

  /* Documents: Spec-row rhythm (padding y space/12, a subtle rule under each), two columns from 600 (at
     900–1199 the longest title wraps; one column there ran 11 rows, twice the text column's height) */
  .split-media__documents {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
  }
  .split-media__document-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--wp--custom--grid--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* No hairlines (Ross, 7 Oct 2026): a one-line link needs no rule to be read, only a 48 tap row. Rules stay
     where the eye tracks across a gap (Spec rows) or a row is a control (Accordion). */
  .split-media__document {
    display: flex;
    align-items: center;
    min-height: 48px;
  }
  @media (max-width: 599px) {
    .split-media__document-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Stacked: newspaper columns, so the list reads top-down in each column */
  .split-media__documents--stacked .split-media__document-list {
    display: block;
    columns: 3;
    column-gap: var(--wp--custom--grid--gutter);
  }
  .split-media__documents--stacked .split-media__document {
    break-inside: avoid;
  }
