---
// Breadcrumb (docs/04 §11): Desktop shows every crumb (links text/secondary, chevron-right 16
// separators border/strong, current page text/primary aria-current). Mobile (<600) collapses to
// chevron-left 16 + the immediate parent link only. Sits above the Page hero title (depth ≥ 3).
import Icon from './Icon.astro';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  /** False (8 Oct 2026, News single, Q148): the trail ends on the parent, every item a link, and the page's own
   * title is left to the H1 right under it. A story's title repeated (or cut with "…") added nothing. */
  endsWithCurrent?: boolean;
  class?: string;
}

const { items, endsWithCurrent = true, class: className } = Astro.props;
// Phones show one link up: the parent, or the last item when the trail already ends on the parent
const parent = endsWithCurrent ? (items.length > 1 ? items[items.length - 2] : undefined) : items[items.length - 1];
---

{
  items.length > 0 && (
    <nav aria-label="Breadcrumb" class:list={['breadcrumb', className]}>
      <ol class="breadcrumb__list">
        {items.map((item, i) => {
          const isLast = i === items.length - 1;
          const isCurrent = isLast && endsWithCurrent;
          return (
            <li class="breadcrumb__item">
              {!isCurrent && item.href ? (
                <a class="breadcrumb__link text-label" href={item.href}>
                  {item.label}
                </a>
              ) : (
                <span class="breadcrumb__current text-label" aria-current={isCurrent ? 'page' : undefined}>
                  {item.label}
                </span>
              )}
              {!isLast && <Icon name="chevron-right" size={16} class="breadcrumb__sep" />}
            </li>
          );
        })}
      </ol>
      {parent && (
        <a class="breadcrumb__mobile-link text-label" href={parent.href}>
          <Icon name="chevron-left" size={16} />
          <span>{parent.label}</span>
        </a>
      )}
    </nav>
  )
}

<style is:global>
  /* 18 Sep 2026: tightened from 8 + 8 around each chevron to 4 + 4 */
  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--4);
  }
  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--wp--preset--spacing--4);
    min-width: 0;
  }
  .breadcrumb__link {
    color: var(--wp--custom--color--text--secondary);
  }
  .breadcrumb__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--wp--custom--color--text--primary);
  }
  .breadcrumb__current {
    color: var(--wp--custom--color--text--primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .breadcrumb__sep {
    flex: none;
    color: var(--wp--custom--color--border--strong);
  }
  .breadcrumb__mobile-link {
    display: none;
    align-items: center;
    gap: var(--wp--preset--spacing--4);
    color: var(--wp--custom--color--text--secondary);
  }
  .breadcrumb__mobile-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--wp--custom--color--text--primary);
  }

  @media (max-width: 599px) {
    .breadcrumb__list {
      display: none;
    }
    .breadcrumb__mobile-link {
      display: inline-flex;
    }
  }
</style>
