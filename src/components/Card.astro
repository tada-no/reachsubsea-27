---
// Card (docs/04 §13): Media none | icon | pictogram-panel | image-top | image-bg | stat (17 Sep 2026) × Surface white | tint | navy × Size default | featured.
// Image bg is always Navy. Page and External actions make the whole card the link (stretched link,
// one tab stop); File, Video and Expand keep the action as the only target. Cards fill their grid
// cell height and pin the action to the bottom (docs/05 §2.2).
import Eyebrow from './Eyebrow.astro';
import Badge from './Badge.astro';
import MetaItem from './MetaItem.astro';
import Link from './Link.astro';
import Pictogram from './Pictogram.astro';
import Icon from './Icon.astro';
import type { CardField } from '../lib/types';

interface Props extends CardField {
  headingLevel?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  media = 'none',
  surface = 'white',
  size = 'default',
  pictogram,
  image,
  statValue,
  eyebrow,
  badge,
  title,
  lead,
  leadEyebrow,
  description,
  note,
  meta = [],
  links = [],
  scope = [],
  specs = [],
  specColumns = 1,
  action,
  headingLevel: Heading = 'h3',
  class: className,
} = Astro.props;

const featured = size === 'featured';
const navy = surface === 'navy' || media === 'image-bg';
const actionType = action?.action ?? 'page';
const showAction = Boolean(action && (action.url || actionType === 'expand'));
const linked = links.length === 0 && showAction && Boolean(action?.url) && (actionType === 'page' || actionType === 'external');
const hasImage = media === 'image-top' || media === 'image-bg';
const fp = image?.focalPoint;
const objectPosition = fp ? `object-position: ${fp.x * 100}% ${fp.y * 100}%` : undefined;
---

<article
  class:list={[
    'card',
    `card--${navy ? 'navy' : surface}`,
    `card--media-${media}`,
    featured && 'card--featured',
    // The surface sets the card's own colour mode: a White or Tint card stays light inside a Navy section
    navy ? 'has-surface-navy' : 'has-surface-light',
    linked && 'card--linked',
    specColumns === 2 && 'card--specs-2',
    className,
  ]}
>
  {
    hasImage && (
      <div class={media === 'image-top' ? 'card__media' : 'card__bg'}>
        {image?.src ? (
          <img class="card__image" src={image.src} alt={image.alt} loading="lazy" decoding="async" style={objectPosition} />
        ) : (
          <div class="card__placeholder">
            <Icon name="photo" size={24} />
          </div>
        )}
        {media === 'image-bg' && <div class="card__overlay" />}
      </div>
    )
  }
  <div class="card__content">
    {media === 'icon' && pictogram && <Pictogram name={pictogram} size={featured ? 128 : 96} class="card__pictogram" />}
    {
      media === 'pictogram-panel' && pictogram && (
        <div class="card__pictogram-panel">
          <Pictogram name={pictogram} size={96} />
        </div>
      )
    }
    {media === 'stat' && statValue && (
      <p class="card__stat text-display" data-count-up>{statValue}</p>
    )}
    <div class="card__body">
    <div class="card__text">
      {
        (eyebrow || badge) && (
          <div class="card__top">
            {eyebrow && <Eyebrow text={eyebrow} as="span" />}
            {badge && <Badge label={badge.label} tone={badge.tone} icon={badge.icon} />}
          </div>
        )
      }
      <div class="card__heading">
        <Heading class:list={['card__title', featured ? 'text-h3' : 'text-h4']}>{title}</Heading>
        {(lead || description || note) && (
          <div class="card__copy">
            {leadEyebrow && (lead || description) && <Eyebrow text={leadEyebrow} class="card__lead-eyebrow" />}
            {lead && <p class="card__lead text-lead">{lead}</p>}
            {description && <p class:list={['card__description', featured ? 'text-body' : 'text-small']}>{description}</p>}
            {note && <p class:list={['card__note', featured ? 'text-body' : 'text-small']}>{note}</p>}
          </div>
        )}
      </div>
    </div>
    {
      meta.length > 0 && (
        <ul class="card__meta">
          {meta.map((item) => (
            <MetaItem icon={item.icon} text={item.text} href={item.href} as="li" />
          ))}
        </ul>
      )
    }
    {
      scope.length > 0 && (
        <ul class="card__scope text-small">
          {scope.map((item) => <li>{item}</li>)}
        </ul>
      )
    }
    {
      specs.length > 0 && (
        <dl class="card__specs text-small">
          {specs.map((row) => (
            <div class="card__spec">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    {
      links.length > 0 && (
        <ul class="card__links">
          {links.map((link) => (
            <li>
              <a class="card__sublink text-small" href={link.url}>
                <Icon name="chevron-right" size={16} />
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      showAction && action && (
        <div class="card__action">
          <Link
            label={action.label}
            href={action.url}
            action={actionType}
            size="small"
            context={action.context}
            {...(actionType === 'video' && action.url ? { 'data-video-src': action.url, 'data-video-title': title } : {})}
          />
        </div>
      )
    }
    </div>
  </div>
</article>

<style is:global>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--wp--custom--radius--lg);
    /* The card's solid surface colour, for pictogram loops that cut gaps without transparency (Pictogram.astro) */
    --pg-bg: var(--wp--custom--color--bg--default);
    background-color: var(--pg-bg);
    color: var(--wp--custom--color--text--primary);
    transition:
      transform 0.4s var(--wp--custom--motion--ease-out),
      box-shadow 0.4s var(--wp--custom--motion--ease-out);
  }
  /* White: 1px inside stroke border/subtle, drawn above the image like Figma */
  .card--white::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 1px solid var(--wp--custom--color--border--subtle);
    border-radius: inherit;
    pointer-events: none;
  }
  /* The stroke shows only on a white ground. On tint or navy the ground itself draws the card's edge, and the
     light hairline read as a grey rim inside the white card (Ross, 4–5 Oct 2026, Assets ROV and vessel grids). */
  .has-surface-navy .card--white::after,
  .has-surface-tint .card--white::after {
    display: none;
  }
  .card--tint {
    --pg-bg: var(--wp--custom--color--bg--tint);
  }
  /* A Navy card inside a Navy section (7 Oct 2026, HSEQ campaign, as the poster's cards): raised a step to
     navy/700 with a subtle edge, so it doesn't vanish into the ground */
  .has-surface-navy .card--navy {
    --pg-bg: var(--wp--custom--color--bg--accent-subtle);
    box-shadow: inset 0 0 0 1px var(--wp--custom--color--border--subtle);
  }

  .card__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: var(--wp--custom--color--bg--disabled);
  }
  /* Side by side (Card grid and Feed grid image trios at 768–1199, Ross 8 Oct 2026): the image (40%) beside the
     text, filling the card's height; the grid on .cards-beside sets one column at those widths */
  @media (min-width: 768px) and (max-width: 1199px) {
    .cards-beside:has(> :nth-child(3):last-child) .card--media-image-top {
      flex-direction: row;
    }
    .cards-beside:has(> :nth-child(3):last-child) .card--media-image-top .card__media {
      flex: none;
      width: 40%;
      aspect-ratio: auto;
      min-height: 100%;
    }
    .cards-beside:has(> :nth-child(3):last-child) .card--media-image-top .card__content {
      flex: 1;
      min-width: 0;
      justify-content: center;
    }
  }
  .card__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--wp--custom--color--bg--disabled);
  }
  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--wp--custom--motion--ease-out);
  }
  .card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--wp--custom--color--text--secondary);
  }
  /* Image bg scrim: a bottom-up navy ramp (17 Sep 2026) so the photo stays a photo and the text
     still clears AA; was a flat 64 % wash. Deepened through the text zone, with a light base wash.
     19 Sep 2026: solid navy at the text edge down to the scrim floor (10 %), never 0. */
  .card__overlay {
    position: absolute;
    inset: 0;
    background: var(--wp--custom--scrim--card-up);
  }

  .card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--wp--custom--stack--md);
    padding: var(--wp--preset--spacing--32);
  }
  .card--featured .card__content {
    padding: var(--wp--preset--spacing--48);
  }
  .card--media-image-bg {
    min-height: 520px;
  }
  .card--media-image-bg .card__content {
    flex: 0 0 auto;
    margin-top: auto;
  }

  /* Phones (22 Sep 2026): an image card no longer runs its photo behind the text. The photo takes the
     top of the card (4:3) and fades into a solid navy panel that holds the text, like the photo hero.
     The card's surface matches the fade's end (navy/900) so there is no seam. */
  @media (max-width: 599px) {
    .card.card--media-image-bg {
      --pg-bg: var(--wp--custom--color--scrim--solid);
      min-height: 0;
    }
    .card--media-image-bg .card__bg {
      position: relative;
      inset: auto;
      z-index: auto;
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }
    .card.card--media-image-bg .card__overlay {
      background: linear-gradient(to top, var(--wp--custom--color--scrim--solid) 0%, var(--wp--custom--color--scrim--solid) 16%, transparent 64%);
    }
    .card.card--media-image-bg .card__content {
      position: relative;
      flex: 1 1 auto;
      margin-top: calc(-1 * var(--wp--preset--spacing--32));
      padding-top: 0;
    }
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--12);
  }
  /* Title + description read as one unit: a tighter gap than the text group around them */
  .card__heading {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
  }
  /* Lead (with its tag), description and note: no box of their own (they sit in the heading's stack), so a layout
     can place them as one unit (Card grid Rows puts it beside the pictogram and title, centred on them) */
  .card__copy {
    display: contents;
  }
  .card--featured .card__heading {
    gap: var(--wp--preset--spacing--4);
  }
  /* Pictogram panel: the pictogram as the card's media, full width with no fill (Figma 217:8162) */
  /* Text, meta and action: part of the content stack, except beside a Featured pictogram panel */
  .card__body {
    display: contents;
  }
  /* Default pictogram panel: capped at 200 (the wide card's beside-the-text size), not the card width. At
     416 in a 3-column row the pictogram ran to 350 and read as a poster (Ross, 5 Oct 2026, Services overview). */
  .card__pictogram-panel {
    width: 200px;
    max-width: 100%;
  }
  /* Stacked wide card (card under 600): the panel above the text is capped at 128, so a 2-column
     row at 600–1199 doesn't blow the pictogram up to the card width (19 Sep 2026, Services overview) */
  .card--featured .card__pictogram-panel {
    width: 128px;
  }
  /* Featured pictogram panel (Figma 217:8241): a 260 square panel beside the body. Keyed to the card's
     own width, not the viewport, so two wide cards in a 2-column row switch together; below 600 the
     text column would be too narrow and the card stacks like Default. */
  .card--featured.card--media-pictogram-panel {
    container-type: inline-size;
  }
  @container (min-width: 600px) {
    .card--featured.card--media-pictogram-panel .card__content {
      flex-direction: row;
      align-items: stretch;
    }
    .card--featured.card--media-pictogram-panel .card__pictogram-panel {
      align-self: flex-start;
    }
    .card--featured .card__pictogram-panel {
      flex: none;
      width: 200px;
    }
    .card--featured.card--media-pictogram-panel .card__body {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-width: 0;
      gap: var(--wp--custom--stack--md);
    }
  }
  /* Full 260 panel once the card is wide enough (864 in Figma); a 640 card in 2 columns keeps 200 so
     the text column stays readable (~320) */
  @container (min-width: 800px) {
    .card--featured .card__pictogram-panel {
      width: 260px;
    }
  }
  .card__pictogram-panel .pictogram {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Stat: the figure is the media. It sits at the top, the text settles at the bottom of the card. */
  /* The figure scales with the card so long values ("988.1m", "1,850m") fit a 3-column bento cell;
     short ones ("750+") still reach Display (19 Sep 2026, Investors overview) */
  .card--media-stat {
    container-type: inline-size;
  }
  .card__stat {
    color: var(--wp--custom--color--text--accent-display);
    font-variant-numeric: tabular-nums lining-nums;
    font-size: min(var(--wp--preset--font-size--display), 22cqi);
    white-space: nowrap;
  }
  .card--media-stat .card__text {
    margin-top: auto;
  }
  .card--media-stat .card__action {
    margin-top: 0;
  }
  .card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--wp--preset--spacing--8) var(--wp--preset--spacing--12);
  }
  /* Capped measure so a wide card wraps title + description into one block, not a long strip */
  .card__description {
    max-width: 36rem;
    color: var(--wp--custom--color--text--secondary);
  }
  .card__lead {
    margin-top: var(--wp--preset--spacing--4);
    color: var(--wp--custom--color--text--primary);
  }
  .card__note {
    max-width: 36rem;
    margin-top: var(--wp--preset--spacing--12);
    color: var(--wp--custom--color--text--primary);
    font-weight: var(--wp--custom--font-weight--bold);
  }
  /* Meta belongs to the title (date, place): 12px under it rather than the full content gap */
  .card__text + .card__meta {
    margin-top: calc(var(--wp--preset--spacing--12) - var(--wp--custom--stack--md));
  }
  .card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
  }
  .card__action {
    margin-top: auto;
  }
  /* Text and image-top cards whose description ends on a meta line (Life at Reach places, 8 Oct 2026): the meta sits at the foot,
     so a description one line longer than its neighbour's doesn't knock it out of line; the text keeps the 12px
     gap. Not without a description: there the meta is the content (Contact's addresses) and stays under the title */
  .card--media-none .card__text:has(.card__description):has(+ .card__meta:last-child),
  .card--media-image-top .card__text:has(.card__description):has(+ .card__meta:last-child) {
    margin-bottom: calc(var(--wp--preset--spacing--12) - var(--wp--custom--stack--md));
  }
  .card--media-none .card__text:has(.card__description) + .card__meta:last-child,
  .card--media-image-top .card__text:has(.card__description) + .card__meta:last-child {
    margin-top: auto;
  }
  /* Image-top cards in a row: the meta line sits with the action at the foot, so a title that wraps
     one line more than its neighbours doesn't knock the meta out of line (19 Sep 2026, Subsea) */
  .card--media-image-top .card__meta:has(+ .card__action) {
    margin-top: auto;
  }
  .card--media-image-top .card__meta + .card__action {
    margin-top: 0;
  }
  /* Scope: a quiet list of 3 short items, sage dashes, regular weight in text/secondary so it steps
     back behind the title (review 19 Sep 2026: a run-on line read as a second paragraph) */
  .card__scope {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
    color: var(--wp--custom--color--text--secondary);
    line-height: var(--wp--custom--line-height--tight);
  }
  /* No action below it: the list takes the card's foot, so lists line up across a row even when one
     summary wraps a line less. With no summary the list follows the title (8 Oct 2026, Sponsorship policy:
     lists of 4, 4 and 3 pinned to the foot started on different lines) */
  .card:has(.card__description) .card__scope:last-child {
    margin-top: auto;
  }
  .card__scope li {
    display: flex;
    align-items: baseline;
    gap: var(--wp--preset--spacing--12);
  }
  /* A 6px accent dot (Ross, 5 Oct 2026: a bullet over the 19 Sep dash, nearer the discs in rich-text prose) */
  .card__scope li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    /* On the first line's centre, not the item's, so a wrapped item keeps its dot at the top (Ross, 5 Oct 2026) */
    align-self: flex-start;
    margin-top: calc((1lh - 6px) / 2);
    border-radius: var(--wp--custom--radius--full);
    background-color: var(--wp--custom--color--icon--accent);
  }

  /* Spec rows (3 Oct 2026, Assets overview): label · value pairs like the Q2 report's vessel cards. The
     labels share one column per card so the values line up; no rules between rows (card rule, docs/08 §2).
     The rows follow the title (not pinned to the foot): a kicker that wraps on one card would otherwise
     open an uneven gap under the titles across the row. */
  .card__specs {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--wp--preset--spacing--8) var(--wp--preset--spacing--16);
  }
  .card__spec {
    display: contents;
  }
  .card__specs dt {
    color: var(--wp--custom--color--text--secondary);
  }
  .card__specs dd {
    color: var(--wp--custom--color--text--primary);
    font-weight: var(--wp--custom--font-weight--medium);
    overflow-wrap: anywhere;
  }
  /* Two pairs across once the card is 560 wide (short values only: ROVs, DriX). Keyed to the card's own
     width; the second pair's label gets space/16 more so the pairs read apart (Ross, 5 Oct 2026). */
  .card--specs-2 {
    container-type: inline-size;
  }
  @container (min-width: 560px) {
    .card--specs-2 .card__specs {
      grid-template-columns: max-content minmax(0, 1fr) max-content minmax(0, 1fr);
    }
    .card--specs-2 .card__spec:nth-child(even) dt {
      padding-left: var(--wp--preset--spacing--16);
    }
  }

  /* Sub-page links: a quiet list under the text, 44px rows on touch via padding, no rules */
  .card__links {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
    margin-top: calc(var(--wp--preset--spacing--8) - var(--wp--custom--stack--md));
  }
  .card__sublink {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--wp--preset--spacing--8);
    padding-block: var(--wp--preset--spacing--4);
    font-weight: var(--wp--custom--font-weight--medium);
    color: var(--wp--custom--color--text--primary);
    text-decoration: none;
  }
  .card__sublink .icon {
    flex: none;
    margin-top: 0.2em;
    color: var(--wp--custom--color--icon--accent);
    transition: transform 0.3s var(--wp--custom--motion--ease-out);
  }
  .card__sublink:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .card__sublink:hover .icon {
    transform: translateX(3px);
  }
  .card__sublink:focus-visible {
    outline: 2px solid var(--wp--custom--color--border--focus);
    outline-offset: 2px;
    border-radius: var(--wp--custom--radius--sm);
  }

  /* Stretched link: the whole card is the target, the ring moves to the card */
  .card--linked .link-arrow {
    position: static;
  }
  .card--linked .link-arrow::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  .card--linked .link-arrow:focus-visible::after {
    display: none;
  }
  .card--linked:has(.link-arrow:focus-visible) {
    outline: 2px solid var(--wp--custom--color--border--focus);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .card--linked:hover {
      transform: translateY(-3px);
      box-shadow: var(--wp--preset--shadow--md);
    }
    .card--linked:hover .card__image {
      transform: scale(1.04);
    }
  }

  /* Featured falls back to Default metrics on phones (docs/05 §2.2) */
  @media (max-width: 599px) {
    .card--featured .card__content {
      padding: var(--wp--preset--spacing--32);
    }
    .card--featured .card__title {
      font-size: var(--wp--preset--font-size--h4);
      line-height: var(--wp--custom--line-height--h4);
      letter-spacing: normal;
    }
    .card--featured .card__description {
      font-size: var(--wp--preset--font-size--body-sm);
      line-height: var(--wp--custom--line-height--body-sm);
    }
    .card--featured .card__heading {
      gap: var(--wp--preset--spacing--4);
    }
    .card--featured .card__pictogram {
      width: 96px;
      height: 96px;
    }
  }
</style>
