---
// Dot map zoom (22 Sep 2026, shared by Live operations and Offices map): one horizontal pill of
// − / + buttons, the same height and outline as the filter chips, placed by the block in its toolbar
// row above the map. Disabled until the map has loaded; the script (src/lib/dot-map-client.ts)
// enables them and keeps "Zoom out" disabled at the home view. No "world" button: closing a row
// and zooming out already get back to the full view.
import Icon from './Icon.astro';

interface Props {
  class?: string;
  [attr: string]: unknown;
}

const { class: className, ...attrs } = Astro.props;
---

<div class:list={['dot-map-zoom', className]} role="group" aria-label="Map zoom" data-dot-map-zoom {...attrs}>
  <button type="button" class="dot-map-zoom__button" data-map-zoom-out aria-label="Zoom out" disabled>
    <Icon name="minus" size={20} />
  </button>
  <button type="button" class="dot-map-zoom__button" data-map-zoom-in aria-label="Zoom in" disabled>
    <Icon name="plus" size={20} />
  </button>
</div>

<style is:global>
  .dot-map-zoom {
    display: flex;
    flex: none;
    /* Solid ground: the pill can sit over the map's dots */
    background-color: var(--wp--custom--color--bg--default);
    border-radius: var(--wp--custom--radius--full);
    box-shadow: inset 0 0 0 1px var(--wp--custom--color--border--default);
    overflow: hidden;
  }
  .dot-map-zoom__button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--wp--custom--color--text--primary);
    transition: background-color 160ms var(--wp--custom--motion--easing);
  }
  .dot-map-zoom__button + .dot-map-zoom__button {
    box-shadow: inset 1px 0 0 var(--wp--custom--color--border--default);
  }
  .dot-map-zoom__button:hover:not(:disabled) {
    background-color: var(--wp--custom--color--alpha--navy-8);
  }
  .has-surface-navy .dot-map-zoom__button:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--wp--preset--color--white) 8%, transparent);
  }
  .dot-map-zoom__button:disabled {
    color: var(--wp--custom--color--text--disabled);
    cursor: default;
  }
  .dot-map-zoom__button:focus-visible {
    outline: 2px solid var(--wp--custom--color--border--focus);
    outline-offset: -3px;
    border-radius: var(--wp--custom--radius--full);
  }
</style>
