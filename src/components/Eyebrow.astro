---
// Eyebrow (docs/04 §8): UI/Eyebrow, Tone Accent (text/accent) | Muted (text/secondary).
interface Props {
  text: string;
  tone?: 'accent' | 'muted';
  as?: 'p' | 'span' | 'div';
  class?: string;
}

const { text, tone = 'accent', as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['eyebrow', 'text-eyebrow', tone === 'muted' && 'eyebrow--muted', className]}>{text}</Tag>

<style is:global>
  .eyebrow {
    color: var(--wp--custom--color--text--accent);
  }
  .eyebrow--muted {
    color: var(--wp--custom--color--text--secondary);
  }
</style>
