---
// Button (docs/04 §4). Figma `Style` is `variant` here (style is an HTML attribute).
// Renders <a> with href, otherwise <button>. Dev theme classes: .btn, .btn--primary, .btn--small.
import Icon from './Icon.astro';

interface Props {
  label: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'medium' | 'small';
  leadingIcon?: string;
  trailingIcon?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const {
  label,
  href,
  variant = 'primary',
  size = 'medium',
  leadingIcon,
  trailingIcon,
  type = 'button',
  disabled = false,
  class: className,
  ...attrs
} = Astro.props;

const isLink = Boolean(href) && !disabled;
const iconSize = size === 'small' ? 16 : 20;
const classes = ['btn', `btn--${variant}`, size === 'small' && 'btn--small', className];
---

{
  isLink ? (
    <a class:list={classes} href={href} {...attrs}>
      {leadingIcon && <Icon name={leadingIcon} size={iconSize} />}
      <span class="btn__label">{label}</span>
      {trailingIcon && <Icon name={trailingIcon} size={iconSize} />}
    </a>
  ) : (
    <button class:list={classes} type={type} disabled={disabled} {...attrs}>
      {leadingIcon && <Icon name={leadingIcon} size={iconSize} />}
      <span class="btn__label">{label}</span>
      {trailingIcon && <Icon name={trailingIcon} size={iconSize} />}
    </button>
  )
}

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--wp--preset--spacing--8);
    min-height: 48px;
    padding-inline: var(--wp--preset--spacing--24);
    border-radius: var(--wp--custom--radius--full);
    font-size: var(--wp--preset--font-size--button);
    line-height: var(--wp--custom--line-height--button);
    font-weight: var(--wp--custom--font-weight--bold);
    text-align: center;
    text-decoration: none;
    width: fit-content;
    cursor: pointer;
    background-color: var(--wp--custom--color--action--primary--bg);
    color: var(--wp--custom--color--action--primary--fg);
    transition:
      transform var(--wp--custom--motion--duration) var(--wp--custom--motion--easing),
      background-color var(--wp--custom--motion--duration) var(--wp--custom--motion--easing);
  }
  .btn--small {
    min-height: 40px;
    padding-inline: var(--wp--preset--spacing--16);
    font-size: var(--wp--preset--font-size--button-sm);
    line-height: var(--wp--custom--line-height--button-sm);
  }
  .btn--secondary {
    background-color: var(--wp--custom--color--action--secondary--bg);
    color: var(--wp--custom--color--action--secondary--fg);
  }
  .btn--outline {
    background-color: transparent;
    color: var(--wp--custom--color--action--outline--fg);
    box-shadow: inset 0 0 0 2px var(--wp--custom--color--action--outline--border);
  }
  .btn .icon {
    flex: none;
  }

  @media (hover: hover) {
    .btn:not(:disabled):hover {
      transform: translateY(-3px);
    }
    .btn--primary:not(:disabled):hover {
      background-color: var(--wp--custom--color--action--primary--bg-hover);
    }
    .btn--secondary:not(:disabled):hover {
      background-color: var(--wp--custom--color--action--secondary--bg-hover);
    }
    .btn--outline:not(:disabled):hover {
      background-color: var(--wp--custom--color--action--outline--bg-hover);
    }
  }

  .btn:disabled {
    cursor: not-allowed;
    background-color: var(--wp--custom--color--bg--disabled);
    color: var(--wp--custom--color--text--disabled);
  }
  .btn--outline:disabled {
    background-color: transparent;
    box-shadow: inset 0 0 0 2px var(--wp--custom--color--border--default);
  }
</style>
