---
// Media frame (docs/05 §1): Ratio 3:2 · 4:3 · 16:9, Show play, Show caption.
// No image src → the Figma placeholder (bg/disabled + 24px photo icon).
// Radius: lg for 3:2 (grids), xl for 4:3 and 16:9 (large media). object-fit cover + focal point.
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import type { ImageField } from '../lib/types';

interface Props {
  ratio?: '3:2' | '4:3' | '16:9';
  image?: ImageField;
  radius?: 'lg' | 'xl';
  caption?: string;
  showPlay?: boolean;
  playLabel?: string;
  /** Attributes for the play button, e.g. { 'data-video-src': url, 'data-video-title': title }. */
  playAttrs?: Record<string, string>;
  /** Page hero only: eager + fetchpriority high. */
  priority?: boolean;
  class?: string;
}

const {
  ratio = '3:2',
  image,
  radius = ratio === '3:2' ? 'lg' : 'xl',
  caption,
  showPlay = false,
  playLabel = 'Play video',
  playAttrs = {},
  priority = false,
  class: className,
} = Astro.props;

const Tag = caption ? 'figure' : 'div';
const fp = image?.focalPoint;
const objectPosition = fp ? `object-position: ${fp.x * 100}% ${fp.y * 100}%` : undefined;
---

<Tag class:list={['media-frame', `media-frame--${ratio.replace(':', '-')}`, className]}>
  <div
    class:list={['media-frame__frame', `media-frame__frame--${radius}`]}
    style={`--media-ratio: ${ratio.replace(':', ' / ')}`}
  >
    {
      image?.src ? (
        <img
          class="media-frame__image"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          style={objectPosition}
        />
      ) : (
        <div
          class="media-frame__placeholder"
          role={image?.alt ? 'img' : undefined}
          aria-label={image?.alt || undefined}
        >
          <Icon name="photo" size={24} />
        </div>
      )
    }
    {showPlay && <IconButton icon="player-play" label={playLabel} variant="primary" class="media-frame__play" {...playAttrs} />}
  </div>
  {caption && <figcaption class="media-frame__caption text-caption">{caption}</figcaption>}
</Tag>

<style is:global>
  .media-frame {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--8);
    min-width: 0;
  }
  .media-frame__frame {
    position: relative;
    aspect-ratio: var(--media-ratio, 3 / 2);
    overflow: hidden;
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--wp--custom--color--bg--disabled);
  }
  .media-frame__frame--xl {
    border-radius: var(--wp--custom--radius--xl);
  }
  .media-frame__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media-frame__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--wp--custom--color--text--secondary);
  }
  .media-frame__play {
    position: absolute;
    inset: 0;
    margin: auto;
  }
  .media-frame__caption {
    color: var(--wp--custom--color--text--secondary);
  }
</style>
