---
// Search panel (docs/04 §16): modal with scrim, opened from the header Search icon. One field (the shared Search
// box, docs/04 §10c, Q158) that submits to the Search results page, plus 4–6 editor-set Popular links (a row at
// ≥900, a list on mobile), unlabelled (Ross, 9 Oct 2026: the "Popular" eyebrow wasn't needed; the list keeps the name
// for screen readers). Live suggestions are a later phase (docs/extract/header-recommendation.md §3.6).
import SearchBox from '../SearchBox.astro';
import Link from '../Link.astro';
import { popularSearchLinks } from '../../data/navigation';

interface Props {
  id: string;
  open?: boolean;
}

const { id, open = false } = Astro.props;
---

<div class="search-panel" id={id} role="dialog" aria-modal="true" aria-label="Search" hidden={!open}>
  <div class="container">
    <SearchBox id={`${id}-field`} class="search-panel__form" />
    {
      popularSearchLinks.length > 0 && (
        <div class="search-panel__popular">
          <ul class="search-panel__links" aria-label="Popular pages">
            {popularSearchLinks.map((link) => (
              <li>
                <Link label={link.label} href={link.url} action={link.external ? 'external' : 'page'} size="small" />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</div>

<style is:global>
  .search-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 30;
    background-color: var(--wp--custom--color--bg--default);
    box-shadow: var(--wp--preset--shadow--lg);
    padding-block: var(--wp--preset--spacing--32);
  }
  /* The links' own 12 of target padding makes up the rest: their text sits 24 under the box */
  .search-panel__popular {
    margin-top: var(--wp--preset--spacing--12);
  }
  .search-panel__links {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
  }

  @media (min-width: 900px) {
    .search-panel__links {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--wp--preset--spacing--32);
      row-gap: var(--wp--preset--spacing--8);
    }
  }
</style>
