---
// Mobile menu panel (docs/04 §16): what the hamburger opens below 900px. Modal, full height under
// the header (the menu icon becomes `x`), scroll-locked. Menu accordion rows, one open at a time
// (the current section starts open). The bar's sections come first, then Projects and Newsroom, then FAQ and
// Contact as plain rows (no chevron, no panel): the same grouping as desktop, where Projects, Newsroom and FAQ
// sit in the Site menu apart from the bar (Ross, 9 Oct 2026). Then the
// desktop menu strip, full bleed (6 Oct 2026, Q114): a bg/tint band holding the navy 3D World button at full width,
// the same button as every Mega menu and the Site menu (Q112: below 900 the 3D World had no menu entry). Then
// (Q113) one 2-column grid of small links in the accordion children's style (48px rows, Body/Body text/secondary,
// ↗ on external links): Open positions · LinkedIn · Facebook; then the legal links in the same columns. From 900
// they sit on one row, the legal links on the right.
// "Contact us" went: it repeated the Contact row.
import Icon from '../Icon.astro';
import MenuAccordion from './MenuAccordion.astro';
import { navSections, mobileUtility, socialLinks, legalLinks, siteMenu } from '../../data/navigation';

interface Props {
  id: string;
  open?: boolean;
  current?: string;
}

const { id, open = false, current } = Astro.props;
const order = ['services', 'assets', 'company', 'investors', 'careers', 'projects', 'newsroom'];
const sections = [...navSections].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
// The current section starts expanded (docs/04 §16), in its usual place: the order never changes
// from page to page, so people can find a section where they last saw it.
---

<div class="mobile-menu" id={id} role="dialog" aria-modal="true" aria-label="Menu" hidden={!open}>
  <div class="mobile-menu__body">
    <div class="container mobile-menu__accordions">
      {sections.map((section) => <MenuAccordion section={section} open={open && section.id === current} />)}
      <div class="menu-accordion">
        <a class="mobile-menu__contact text-h5" href="/faq/" aria-current={current === 'faq' ? 'page' : undefined}>FAQ</a>
      </div>
      <div class="menu-accordion">
        <a class="mobile-menu__contact text-h5" href="/contact/" aria-current={current === 'contact' ? 'page' : undefined}>Contact</a>
      </div>
    </div>
    <div class="mobile-menu__strip">
      <div class="container">
        <a class="menu-world mobile-menu__world has-surface-navy" href={siteMenu.world.href}>
          <span class="text-button-sm">{siteMenu.world.label}</span>
          <Icon name="cube-3d-sphere" size={24} />
        </a>
      </div>
    </div>
    <div class="container mobile-menu__links">
      <ul class="mobile-menu__utility">
        {
          [...mobileUtility.map((l) => ({ label: l.label, href: l.url, external: l.external })), ...socialLinks.map((l) => ({ label: l.label, href: l.href, external: true }))].map((link) => (
            <li>
              <a
                class="menu-accordion__link text-body"
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {link.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                {link.external && <Icon name="arrow-up-right" size={16} class="menu-accordion__icon" />}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mobile-menu__legal">
        {
          legalLinks.map((link) => (
            <li>
              <a class="text-caption" href={link.url}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style is:global>
  .mobile-menu {
    position: fixed;
    inset: var(--header-offset, 64px) 0 0 0;
    z-index: 30;
    overflow-y: auto;
    background-color: var(--wp--custom--color--bg--default);
  }
  .mobile-menu__body {
    display: flex;
    flex-direction: column;
    padding-block: var(--wp--preset--spacing--8) var(--wp--preset--spacing--48);
  }
  .mobile-menu__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wp--preset--spacing--12);
    min-height: 56px;
    color: var(--wp--custom--color--text--primary);
  }
  /* The desktop menu strip: bg/tint, full bleed; the shared 3D World button (SiteMenuPanel) at full width */
  .mobile-menu__strip {
    margin-top: var(--wp--custom--stack--md);
    padding-block: var(--wp--preset--spacing--16);
    background-color: var(--wp--custom--color--bg--tint);
  }
  .mobile-menu .mobile-menu__world {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-left: 0;
  }
  /* Small links and legal links share two columns: the first as wide as its longest link (Privacy & Cookie Policy
     never wraps), the second takes the rest, so both groups line up */
  .mobile-menu__links {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--wp--custom--grid--gutter);
    margin-top: var(--wp--custom--stack--md);
  }
  .mobile-menu__utility,
  .mobile-menu__legal {
    display: contents;
  }
  .mobile-menu__legal li {
    margin-top: var(--wp--custom--stack--sm);
  }
  /* The legal links start their own row, whatever the count of small links above (odd since FAQ became a row) */
  .mobile-menu__legal li:first-child {
    grid-column: 1;
  }
  .mobile-menu__legal a {
    color: var(--wp--custom--color--text--secondary);
  }
  /* 900–1199 (Ross, 9 Oct 2026): one row, the small links on the left and the legal links pushed right; below 900
     the row doesn't fit (it needs ~760) and the links stack in the two columns above */
  @media (min-width: 900px) {
    .mobile-menu__links {
      display: flex;
      align-items: center;
      column-gap: var(--wp--custom--grid--gutter);
    }
    .mobile-menu__utility,
    .mobile-menu__legal {
      display: flex;
      column-gap: var(--wp--custom--grid--gutter);
    }
    .mobile-menu__legal {
      margin-left: auto;
    }
    .mobile-menu__legal li {
      margin-top: 0;
    }
  }
</style>
