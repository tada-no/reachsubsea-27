---
// Pictogram tile (4 Oct 2026, Assets overview › Survey and monitoring equipment). The line pictogram (64, 48 on
// phones) beside a title, one line of text and optionally the item's own link. Used by Split media's `tiles`
// under the body copy, one per row in the text column, where two or three short items would be too few for a
// card row. 6 Oct 2026 (Ross: the right column felt clunky, boxes and a separate link row): open rows, no tinted
// box, and the link sits in the row it belongs to. Rows are divided by a hairline between tiles, none over the
// first (Ross, 7 Oct 2026: tried without, the lines back; they match the Spec rows beside them on HSEQ).
import Pictogram from './Pictogram.astro';
import Link from './Link.astro';
import type { LinkField } from '../lib/types';

interface Props {
  pictogram: string;
  title: string;
  text: string;
  link?: LinkField;
  /** Visual style is independent of level (docs/05 §0); default h3 matches other item titles. */
  headingLevel?: 'h3' | 'h4';
  class?: string;
}

const { pictogram, title, text, link, headingLevel: Heading = 'h3', class: className } = Astro.props;
---

<li class:list={['pictogram-tile', className]}>
  <Pictogram name={pictogram} size={64} />
  <div class="pictogram-tile__body">
    <Heading class="pictogram-tile__title text-h5">{title}</Heading>
    <p class="pictogram-tile__text text-small">{text}</p>
    {link && <Link label={link.label} href={link.url} action={link.action ?? 'page'} context={link.context} />}
  </div>
</li>

<style is:global>
  .pictogram-tile {
    --pg-bg: var(--wp--custom--color--bg--default);
    display: flex;
    align-items: flex-start;
    gap: var(--wp--preset--spacing--24);
    padding-block: var(--wp--preset--spacing--24);
  }
  .pictogram-tile:first-child {
    padding-top: 0;
  }
  .pictogram-tile + .pictogram-tile {
    border-top: 1px solid var(--wp--custom--color--border--subtle);
  }
  /* Title + text read as one unit, 4 apart, as Card's heading (Ross, 7 Oct 2026: the lines felt loose at 8).
     The link follows straight on: its own 12 of hit-area padding is the gap above it, and the same 12 is
     pulled back below so the tile's bottom padding still reads 24, not 36. */
  .pictogram-tile__body {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--4);
    min-width: 0;
  }
  .pictogram-tile__body .link-arrow {
    margin-bottom: calc(-1 * var(--wp--preset--spacing--12));
  }
  /* Optical top (Ross, 7 Oct 2026): the glyph sits ~12 inside its 64 frame and the H5's cap top ~7 inside its
     line, so the frame rises 4 to put the drawing's top on the title's cap height, not the boxes' tops. */
  .pictogram-tile .pictogram {
    margin-top: calc(-1 * var(--wp--preset--spacing--4));
  }
  .pictogram-tile__title {
    color: var(--wp--custom--color--text--primary);
  }
  .pictogram-tile__text {
    color: var(--wp--custom--color--text--secondary);
  }
  @media (max-width: 599px) {
    .pictogram-tile {
      gap: var(--wp--preset--spacing--16);
      padding-block: var(--wp--preset--spacing--16);
    }
    .pictogram-tile:first-child {
      padding-top: 0;
    }
    .pictogram-tile .pictogram {
      width: 48px;
      height: 48px;
    }
  }
</style>
