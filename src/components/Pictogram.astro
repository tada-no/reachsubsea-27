    53%, 56% { stroke-dashoffset: 110; }
  }
  /* Reach pilot: the eye blinks (squashed from its centre: lid and iris close to one line about a stroke thick), then the pupil
     looks left and right and back, tracking. Only the pupil moves, and only as far as the gap inside the iris
     allows, so nothing crosses the eye's outline. */
  .pictogram--reach-pilot :is(.pg-eye, .pg-pupil) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .pictogram--reach-pilot.is-playing .pg-eye { animation-name: pg-pl-blink; }
  .pictogram--reach-pilot.is-playing .pg-pupil { animation-name: pg-pl-look; }
  @keyframes pg-pl-blink {
    0%, 6%, 26%, 100% { transform: scale(1, 1); }
    14%, 16% { transform: scale(1, 0.1); }
  }
  @keyframes pg-pl-look {
    0%, 32%, 92%, 100% { transform: translate3d(0, 0, 0); }
    44%, 54% { transform: translate3d(-2.5px, 0, 0); }
    68%, 78% { transform: translate3d(2.5px, 0, 0); }
  }
  /* Satellite (Reach Relay): the dish's feed flares, then its two signal arcs ping outward, inner then
     outer, twice: data going out. Meanwhile each solar panel rolls on its spar in turn (the line through the
     arms and body, like a wing banking), upper panel first, then the lower: it narrows across its width about
     its own centre, keeps its full length, and turns back. The matrix scales along the panels' short side, the
     (1, 1) diagonal: a = d = (1 + k) / 2, b = c = (k - 1) / 2 for width factor k (0.6 at the turn: a little, so
     the lines along the panel thin only slightly, as on a real banked surface). */
  .pictogram--satellite .pg-feed {
    transform-box: fill-box;
    transform-origin: center;
  }
  .pictogram--satellite .pg-panel {
    transform-box: view-box;
  }
