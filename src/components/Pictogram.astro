  .pictogram--settings-screen.is-playing .pg-arc--a { animation-name: pg-hz-hub-a; }
  .pictogram--settings-screen.is-playing .pg-arc--b { animation-name: pg-hz-hub-b; }
  .pictogram--settings-screen .pg-cog-slot {
