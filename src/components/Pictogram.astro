---
// Reach line pictogram (docs/04 §2), 96px grid, fill icon/accent. SVGs in src/assets/pictograms.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 64, class: className } = Astro.props;

const cache: Map<string, string | null> = ((globalThis as any).__reachPictograms ??= new Map());
let inner = cache.get(name);
if (inner === undefined) {
  const file = path.join(process.cwd(), 'src/assets/pictograms', `${name}.svg`);
  inner = fs.existsSync(file)
    ? fs
        .readFileSync(file, 'utf8')
        .replace(/^[\s\S]*?<svg[^>]*>/, '')
        .replace(/<\/svg>\s*$/, '')
    : null;
  cache.set(name, inner);
}
---

{
  inner ? (
    <svg
      class:list={['pictogram', `pictogram--${name}`, className]}
      width={size}
      height={size}
      viewBox="0 0 96 96"
      fill="none"
      aria-hidden="true"
      focusable="false"
      set:html={inner}
    />
  ) : (
    <span
      class:list={['pictogram', 'pictogram--missing', className]}
      style={`width:${size}px;height:${size}px`}
      aria-hidden="true"
      data-missing={name}
    />
  )
}

<style is:global>
  .pictogram {
    flex: none;
    color: var(--wp--custom--color--icon--accent);
  }
  .pictogram--missing {
    display: block;
    border-radius: var(--wp--custom--radius--sm);
    background-color: var(--wp--custom--color--bg--disabled);
  }
</style>
