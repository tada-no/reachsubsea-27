  }
  @keyframes pg-shoot {
    0%, 8% { transform: translate3d(0, 0, 0) rotate(0deg); }
    28%, 40% { transform: translate3d(34px, 0, 0) rotate(0deg); animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45); }
    52% { transform: translate3d(0, 0, 0) rotate(0deg); }
    58% { transform: translate3d(0, 0, 0) rotate(-4deg); }
    64% { transform: translate3d(0, 0, 0) rotate(2.5deg); }
