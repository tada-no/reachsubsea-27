  }
  /* Company values (19 Sep 2026, About): Learn · Teach · Reach. The artwork is the dev site's icon set
     (a figure beside its subject: open book, presentation board, target), scaled onto the 96 grid;
     only the moving parts are tagged. Same trim-path feel as the service loops. Solid only.
     Learn: the right page turns over the spine (scaleX 1 → -0.88; it is filled with the surface colour,
     so it covers the left page) and the new page's lines write themselves in, one by one. At 100% the
     turned page snaps back to the right, where it looks exactly like the page underneath.
     Teach: the ship on the board sails out to the right and comes back in from the left (clipped to
     the board).
     Reach: the arrow draws back out of the target, flies in and lands; the rings ripple on impact. */
  .pictogram--value-learn,
  .pictogram--value-teach,
  .pictogram--value-reach {
    --pg-cycle: 3.2s;
  }
  .pictogram--value-learn .pg-page {
    transform-box: view-box;
    transform-origin: 60.67px 50px;
  }
  .pictogram--value-learn .pg-line {
    stroke-dasharray: 100 120;
  }
  .pictogram--value-learn.is-playing .pg-page {
    animation-name: pg-turn;
  }
  .pictogram--value-learn.is-playing .pg-line--1 {
    animation-name: pg-write-1;
  }
  .pictogram--value-learn.is-playing .pg-line--2 {
    animation-name: pg-write-2;
  }
  .pictogram--value-learn.is-playing .pg-line--3 {
    animation-name: pg-write-3;
  }
  .pictogram--value-learn.is-playing .pg-line--4 {
    animation-name: pg-write-4;
  }
  @keyframes pg-turn {
    0%, 10% { transform: scaleX(1); }
    42%, 99.9% { transform: scaleX(-0.88); }
    100% { transform: scaleX(1); }
  }
  @keyframes pg-write-1 {
    0%, 11% { stroke-dashoffset: 0; }
    12%, 46% { stroke-dashoffset: 110; }
    58%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-write-2 {
    0%, 11% { stroke-dashoffset: 0; }
    12%, 54% { stroke-dashoffset: 110; }
    66%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-write-3 {
    0%, 11% { stroke-dashoffset: 0; }
    12%, 62% { stroke-dashoffset: 110; }
    74%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-write-4 {
    0%, 11% { stroke-dashoffset: 0; }
    12%, 70% { stroke-dashoffset: 110; }
    82%, 100% { stroke-dashoffset: 0; }
  }
  .pictogram--value-teach .pg-board {
    clip-path: inset(25px 13.5px 34.5px 36px) view-box;
