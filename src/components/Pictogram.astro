---
// Reach line pictogram (docs/04 §2), 96px grid, fill icon/accent. SVGs in src/assets/pictograms.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 64, class: className } = Astro.props;

// Pictograms with tagged parts (class="pg-…" in the SVG source) get a looping micro animation:
// motion.ts plays one cycle when the card scrolls in, and again on hover. Keyframes below.

// Cache keyed on the file's mtime so an edited SVG shows up in the dev server without a restart.
const cache: Map<string, string | null> = ((globalThis as any).__reachPictograms ??= new Map());
const file = path.join(process.cwd(), 'src/assets/pictograms', `${name}.svg`);
const exists = fs.existsSync(file);
const key = exists ? `${name}@${fs.statSync(file).mtimeMs}` : name;
let inner = cache.get(key);
if (inner === undefined) {
  inner = exists
    ? fs
        .readFileSync(file, 'utf8')
        .replace(/^[\s\S]*?<svg[^>]*>/, '')
        .replace(/<\/svg>\s*$/, '')
    : null;
  cache.set(key, inner);
}
const live = Boolean(inner && inner.includes('class="pg-'));
---

{
  inner ? (
    <svg
      class:list={['pictogram', `pictogram--${name}`, live && 'pictogram--live', className]}
      width={size}
      height={size}
      viewBox="0 0 96 96"
      fill="none"
      aria-hidden="true"
      focusable="false"
      set:html={inner}
    />
  ) : (
    <span
      class:list={['pictogram', 'pictogram--missing', className]}
      style={`width:${size}px;height:${size}px`}
      aria-hidden="true"
      data-missing={name}
    />
  )
}

<style is:global>
  .pictogram {
    flex: none;
    color: var(--wp--custom--color--icon--accent);
  }
  /* A pictogram that does not exist yet (6 Oct 2026, Ross: never reuse an icon for a new meaning): a dashed
     accent box that says so, so it cannot pass for finished art. Name it `needed-<what-it-stands-for>`. */
  .pictogram--missing {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    border: 2px dashed var(--wp--custom--color--border--accent);
    border-radius: var(--wp--custom--radius--sm);
    background-color: var(--wp--custom--color--bg--tint);
    color: var(--wp--custom--color--text--secondary);
    text-align: center;
  }
  .pictogram--missing::after {
    content: 'Icon needed';
    font-size: var(--wp--preset--font-size--caption);
    line-height: var(--wp--custom--line-height--caption);
  }

  /* ── Micro loops (18 Sep 2026) ─────────────────────────────────
     Purpose: explanation. Each service pictogram acts out its subject once as the card reveals, and
     again on hover. Style: After Effects trim paths — quick eased moves with holds between them.
     Rule (18 Sep 2026): no transparency. The icons stay fully solid; highlights are travelling gaps,
     either trimmed out of the stroke itself or cut by an eraser stroke in the card's solid surface
     colour (--pg-bg, set by Card.astro). The moving parts are real strokes in the SVG source
     (pathLength 100) so stroke-dasharray can trim them; everything else stays the original filled
     artwork. Transform, stroke-dasharray, stroke-dashoffset and offset-distance only. Every part of one pictogram shares
     its --pg-cycle and rests at 0% and 100%, so the loop can stop cleanly at a cycle boundary:
     motion.ts removes .is-playing on the lead part's animationiteration. Phases live in the keyframes,
     never in animation-delay, for the same reason. Reduced motion: base.css clamps every animation to
     one 0.01ms iteration and motion.ts never adds .is-playing. */
  .pictogram--live [class*='pg-'] {
    animation-duration: var(--pg-cycle);
    animation-timing-function: var(--wp--custom--motion--ease-in-out);
    animation-iteration-count: infinite;
  }
  /* Trimmed strokes: dash 100 + a gap longer than the path, so an offset of ±110 hides the stroke
     completely (round caps included). */
  .pictogram--live :is(.pg-leg, .pg-arc, .pg-scan) {
    stroke-dasharray: 100 120;
  }
  .pictogram--live :is(.pg-bolt, .pg-hinge, .pg-nucleus) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Technology: electrons ride their orbits one after another, each dragging a gap that cuts through
     the orbit lines behind it — the same gap language the icon already uses where orbits weave. The
     gap is an eraser stroke in the surface colour whose length grows from 0 and shrinks back (pattern
     "0 G L 0": the dash L is anchored at its head, which tracks the electron). The electrons sit on
     their orbit with offset-path (rest = 0%); browsers without it keep the static transform from the
     SVG and still get the gaps. Without --pg-bg (outside a card) the gaps simply don't paint. */
  .pictogram--technology {
    --pg-cycle: 3.2s;
  }
  .pictogram--technology .pg-trail {
    stroke: var(--pg-bg, none);
    stroke-width: 4.5;
    stroke-dasharray: 0 100 0 0;
    stroke-dashoffset: 100;
  }
  .pictogram--technology .pg-electron {
    fill: var(--pg-bg, none);
  }
  @supports (offset-path: path('M0 0')) {
    .pictogram--technology .pg-electron {
      transform: none;
      offset-rotate: 0deg;
      offset-distance: 0%;
    }
    .pictogram--technology .pg-electron--a {
      offset-path: path('M42.42 21.07A10.6 32.56 0 1 0 54.48 74.93A10.6 32.56 0 1 0 42.42 21.07Z');
    }
    .pictogram--technology .pg-electron--b {
      offset-path: path('M21.3 57.23A32.56 10.6 -30 1 0 75.6 38.77A32.56 10.6 -30 1 0 21.3 57.23Z');
    }
    .pictogram--technology .pg-electron--c {
      offset-path: path('M74.7 56.51A32.56 10.6 30 1 0 22.2 39.49A32.56 10.6 30 1 0 74.7 56.51Z');
    }
  }
  .pictogram--technology.is-playing .pg-nucleus {
    animation-name: pg-kick;
  }
  .pictogram--technology.is-playing .pg-electron--a {
    animation-name: pg-ride-a;
  }
  .pictogram--technology.is-playing .pg-electron--b {
    animation-name: pg-ride-b;
  }
  .pictogram--technology.is-playing .pg-electron--c {
    animation-name: pg-ride-c;
  }
  .pictogram--technology.is-playing .pg-trail--a {
    animation-name: pg-trail-a, pg-trail-len-a;
  }
  .pictogram--technology.is-playing .pg-trail--b {
    animation-name: pg-trail-b, pg-trail-len-b;
  }
  .pictogram--technology.is-playing .pg-trail--c {
    animation-name: pg-trail-c, pg-trail-len-c;
  }
  @keyframes pg-kick {
    0%, 14%, 100% { transform: scale(1); }
    6% { transform: scale(1.7); }
  }
  @keyframes pg-ride-a {
    0%, 6% { offset-distance: 0%; }
    44%, 100% { offset-distance: 100%; }
  }
  @keyframes pg-ride-b {
    0%, 20% { offset-distance: 0%; }
    58%, 100% { offset-distance: 100%; }
  }
  @keyframes pg-ride-c {
    0%, 34% { offset-distance: 0%; }
    72%, 100% { offset-distance: 100%; }
  }
  @keyframes pg-trail-a {
    0%, 6% { stroke-dashoffset: 100; }
    44%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-trail-b {
    0%, 20% { stroke-dashoffset: 100; }
    58%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-trail-c {
    0%, 34% { stroke-dashoffset: 100; }
    72%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-trail-len-a {
    0%, 6%, 44%, 100% { stroke-dasharray: 0 100 0 0; }
    16%, 32% { stroke-dasharray: 0 84 16 0; }
  }
  @keyframes pg-trail-len-b {
    0%, 20%, 58%, 100% { stroke-dasharray: 0 100 0 0; }
    30%, 46% { stroke-dasharray: 0 84 16 0; }
  }
  @keyframes pg-trail-len-c {
    0%, 34%, 72%, 100% { stroke-dasharray: 0 100 0 0; }
    44%, 60% { stroke-dasharray: 0 84 16 0; }
  }

  /* Book (6 Oct 2026, Research partnerships; reworked from Ross's Icons8 "literature" Lottie): the right-hand
     page lifts and turns over the spine onto the left page, then the whole book dips 1px as it lands, as in
     the reference. The turning page is a copy drawn over the still right page, so once it has landed it can
     jump back to the right unseen (the real page is already there, at 54%) and every cycle is a one-way turn. The
     lift (-4) and the shrinking width follow the reference's page-bend keyframes. Solid, transform only;
     the page's origin is the spine, the left edge of its own box. */
  .pictogram--book {
    --pg-cycle: 3.2s;
  }
  .pictogram--book .pg-page {
    fill: var(--pg-bg, var(--wp--custom--color--bg--default));
    transform-box: fill-box;
    transform-origin: left center;
  }
  .pictogram--book.is-playing .pg-page {
    animation-name: pg-page-turn, pg-page-lift;
  }
  .pictogram--book.is-playing .pg-book {
    animation-name: pg-book-dip;
  }
  /* The bookmark is filled with the surface behind the icon so the left page's top edge runs unbroken beneath it.
     It shrinks away as the page lifts and pops back in once the page has landed (solid: scale only). */
  .pictogram--book .pg-mark {
    fill: var(--pg-bg, var(--wp--custom--color--bg--default));
    transform-box: fill-box;
    transform-origin: center top;
  }
  .pictogram--book.is-playing .pg-mark {
    animation-name: pg-mark-pop;
  }
  @keyframes pg-mark-pop {
    0%, 4% { scale: 1 1; animation-timing-function: var(--wp--custom--motion--ease-in-out); }
    20%, 58% { scale: 0 0; animation-timing-function: cubic-bezier(0.25, 1, 0.5, 1); }
    74%, 100% { scale: 1 1; }
  }
  /* One long ease across the whole turn (scale), with the lift riding it on its own curve (translate), so there are no stops mid-turn */
  @keyframes pg-page-turn {
    0%, 6% { scale: 1 1; animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1); }
    50%, 62% { scale: -1 1; }
    62.1%, 100% { scale: 1 1; }
  }
  @keyframes pg-page-lift {
    0%, 6% { translate: 0 0; animation-timing-function: cubic-bezier(0.3, 0, 0.5, 1); }
    28% { translate: 0 -4.3px; animation-timing-function: cubic-bezier(0.5, 0, 0.7, 1); }
    50%, 100% { translate: 0 0; }
  }
  @keyframes pg-book-dip {
    0%, 40% { transform: translateY(0); }
    52% { transform: translateY(1px); }
    66%, 100% { transform: translateY(0); }
  }

  /* Reach Remote (6 Oct 2026): the clouds ease across the icon on a loop while the sea flows exactly as in
     the other icons (Ross: the sea animates the same everywhere; no lines appearing on the antenna). The
     cloud set is drawn twice, one sky-width (76) apart, inside a fixed clip: both slide right by 76 at a
     constant speed, so as one leaves the window its twin enters and the loop is seamless. Solid
     throughout: transform only; every part rests as drawn at 0% and 100%. */
  .pictogram--reach-remote {
    --pg-cycle: 3.2s;
  }
  .pictogram--reach-remote .pg-sea {
    clip-path: inset(0 10.4px 0 10.4px) view-box;
  }
  .pictogram--reach-remote .pg-sky {
    clip-path: inset(0 10px 0 10px) view-box;
  }
  .pictogram--reach-remote .pg-wave,
  .pictogram--reach-remote .pg-cloudset {
    animation-timing-function: linear;
  }
  .pictogram--reach-remote .pg-cloudset--b {
    transform: translateX(-76px);
  }
  .pictogram--reach-remote.is-playing .pg-wave {
    animation-name: pg-flow-wide;
  }
  .pictogram--reach-remote.is-playing .pg-cloudset--a {
    animation-name: pg-sky-a;
  }
  .pictogram--reach-remote.is-playing .pg-cloudset--b {
    animation-name: pg-sky-b;
  }
  @keyframes pg-sky-a {
    to { transform: translateX(76px); }
  }
  @keyframes pg-sky-b {
    from { transform: translateX(-76px); }
    to { transform: translateX(0); }
  }

  /* Sea on its own (6 Oct 2026, Ross: the sea animates the same in every icon): Marine, Seabed repair and
     Survey ROV had a flattened, static wave. Each now carries the shared stroked sea (two extra periods
     outside a fixed clip, so the loop is seamless) and nothing else moves. */
  :is(.pictogram--marine, .pictogram--seabed-repair, .pictogram--survey-rov) {
    --pg-cycle: 3.2s;
  }
  :is(.pictogram--marine, .pictogram--seabed-repair, .pictogram--survey-rov) .pg-sea {
    clip-path: inset(0 12.7px 0 13px) view-box;
  }
  :is(.pictogram--marine, .pictogram--seabed-repair, .pictogram--survey-rov) .pg-wave {
    animation-timing-function: linear;
  }
  :is(.pictogram--marine, .pictogram--seabed-repair, .pictogram--survey-rov).is-playing .pg-wave {
    animation-name: pg-flow;
  }

  /* Global monitoring: the two sonar arcs wipe and redraw top-down, then a gap opens in the outer
     ring, sweeps once around clockwise and closes (pattern "D G": the gap's head tracks the offset). */
  .pictogram--global-monitoring {
    --pg-cycle: 3.2s;
  }
  .pictogram--global-monitoring .pg-ring {
    stroke-dasharray: 100 0;
  }
  .pictogram--global-monitoring.is-playing .pg-scan--inner {
    animation-name: pg-scan-inner;
  }
  .pictogram--global-monitoring.is-playing .pg-scan--mid {
    animation-name: pg-scan-mid;
  }
  .pictogram--global-monitoring.is-playing .pg-ring {
    animation-name: pg-sweep, pg-sweep-gap;
  }
  @keyframes pg-scan-inner {
    0% { stroke-dashoffset: 0; }
    13% { stroke-dashoffset: -110; }
    26%, 100% { stroke-dashoffset: -220; }
  }
  @keyframes pg-scan-mid {
    0%, 8% { stroke-dashoffset: 0; }
    21% { stroke-dashoffset: -110; }
    34%, 100% { stroke-dashoffset: -220; }
  }
  @keyframes pg-sweep {
    0%, 38% { stroke-dashoffset: 0; }
    82%, 100% { stroke-dashoffset: -100; }
  }
  @keyframes pg-sweep-gap {
    0%, 36%, 86%, 100% { stroke-dasharray: 100 0; }
    46%, 74% { stroke-dasharray: 78 22; }
  }

  /* Survey: the compass legs retract to the hinge and redraw, the hinge flares, then the compass
     plots an arc between its tips that draws on and trims away in the same direction. */
  .pictogram--survey {
    --pg-cycle: 3.2s;
  }
  .pictogram--survey .pg-arc {
    stroke-dashoffset: 110;
  }
  .pictogram--survey.is-playing .pg-leg--inner {
    animation-name: pg-leg-inner;
  }
  .pictogram--survey.is-playing .pg-leg--outer {
    animation-name: pg-leg-outer;
  }
  .pictogram--survey.is-playing .pg-hinge {
    animation-name: pg-hinge;
  }
  .pictogram--survey.is-playing .pg-arc {
    animation-name: pg-arc;
  }
  @keyframes pg-leg-inner {
    0%, 28%, 100% { stroke-dashoffset: 0; }
    8%, 14% { stroke-dashoffset: 110; }
  }
  @keyframes pg-leg-outer {
    0%, 38%, 100% { stroke-dashoffset: 0; }
    8%, 24% { stroke-dashoffset: 110; }
  }
  @keyframes pg-hinge {
    0%, 8%, 24%, 100% { transform: scale(1); }
    15% { transform: scale(1.9); }
  }
  @keyframes pg-arc {
    0%, 38% { stroke-dashoffset: 110; }
    60%, 70% { stroke-dashoffset: 0; }
    90%, 100% { stroke-dashoffset: -110; }
  }

  /* Subsea infrastructure: the swell flows (two extra wave periods sit outside a fixed clip, so the
     loop is seamless), the spanner takes two ratchet turns, the flange bolts tighten bottom to top,
     the seabed sediment is stirred in three phases. */
  .pictogram--subsea-infrastructure {
    --pg-cycle: 3.2s;
  }
  .pictogram--subsea-infrastructure .pg-sea {
    clip-path: inset(0 12.7px 0 13px) view-box;
  }
  .pictogram--subsea-infrastructure .pg-wave {
    animation-timing-function: linear;
  }
  .pictogram--subsea-infrastructure .pg-spanner {
    transform-box: view-box;
    transform-origin: 69.72px 37.11px;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-wave {
    animation-name: pg-flow;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-spanner {
    animation-name: pg-ratchet;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-bolt--1 {
    animation-name: pg-bolt-1;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-bolt--2 {
    animation-name: pg-bolt-2;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-bolt--3 {
    animation-name: pg-bolt-3;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-bolt--4 {
    animation-name: pg-bolt-4;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-dot--a {
    animation-name: pg-stir-a;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-dot--b {
    animation-name: pg-stir-b;
  }
  .pictogram--subsea-infrastructure.is-playing .pg-dot--c {
    animation-name: pg-stir-c;
  }
  @keyframes pg-flow {
    to { transform: translate3d(27.2px, 0, 0); }
  }

  /* Subsea telemetry (6 Oct 2026, the Seismic risk monitoring tile): the same swell as Subsea
     infrastructure, then the signal chain acts itself out on one 3.2s cycle: the seabed sensors ping
     (each arc shrinks back to its start and regrows, inner then outer), then the box, a gap runs up the
     cable from the box to the surface unit, and the antenna pings. Seabed sediment is stirred as in
     Subsea infrastructure. Arcs are real strokes (pathLength 100): every ping is a monotone 0 → 110 → 0
     offset, so nothing jumps mid-loop. Phases live in the keyframes. */
  .pictogram--subsea-telemetry {
    --pg-cycle: 3.2s;
  }
  .pictogram--subsea-telemetry .pg-sea {
    clip-path: inset(0 12.7px 0 13px) view-box;
  }
  .pictogram--subsea-telemetry .pg-wave {
    animation-timing-function: linear;
  }
  .pictogram--subsea-telemetry .pg-cable {
    stroke-dasharray: 100 12 300 0;
  }
  .pictogram--subsea-telemetry.is-playing .pg-wave {
    animation-name: pg-flow;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--sl1 {
    animation-name: pg-ping-1;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--sr1 {
    animation-name: pg-ping-2;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--sl2 {
    animation-name: pg-ping-3;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--sr2 {
    animation-name: pg-ping-4;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--box1 {
    animation-name: pg-ping-5;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--box2 {
    animation-name: pg-ping-6;
  }
  .pictogram--subsea-telemetry.is-playing .pg-cable {
    animation-name: pg-cable-pulse;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--ant1 {
    animation-name: pg-ping-7;
  }
  .pictogram--subsea-telemetry.is-playing .pg-arc--ant2 {
    animation-name: pg-ping-8;
  }
  .pictogram--subsea-telemetry.is-playing .pg-dot--a {
    animation-name: pg-stir-a;
  }
  .pictogram--subsea-telemetry.is-playing .pg-dot--b {
    animation-name: pg-stir-b;
  }
  .pictogram--subsea-telemetry.is-playing .pg-dot--c {
    animation-name: pg-stir-c;
  }
  @keyframes pg-ping-1 {
    0%, 2%, 24%, 100% { stroke-dashoffset: 0; }
    11%, 13% { stroke-dashoffset: 110; }
  }
  @keyframes pg-ping-2 {
    0%, 4%, 26%, 100% { stroke-dashoffset: 0; }
    13%, 15% { stroke-dashoffset: 110; }
  }
  @keyframes pg-ping-3 {
    0%, 7%, 29%, 100% { stroke-dashoffset: 0; }
    16%, 18% { stroke-dashoffset: 110; }
  }
  @keyframes pg-ping-4 {
    0%, 9%, 31%, 100% { stroke-dashoffset: 0; }
    18%, 20% { stroke-dashoffset: 110; }
  }
  @keyframes pg-ping-5 {
    0%, 32%, 54%, 100% { stroke-dashoffset: 0; }
    41%, 43% { stroke-dashoffset: 110; }
  }
  @keyframes pg-ping-6 {
    0%, 36%, 58%, 100% { stroke-dashoffset: 0; }
    45%, 47% { stroke-dashoffset: 110; }
  }
  @keyframes pg-cable-pulse {
    0%, 52% { stroke-dashoffset: 112; }
    74%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-ping-7 {
    0%, 70%, 92%, 100% { stroke-dashoffset: 0; }
    79%, 81% { stroke-dashoffset: 110; }
  }
  @keyframes pg-ping-8 {
    0%, 74%, 96%, 100% { stroke-dashoffset: 0; }
    83%, 85% { stroke-dashoffset: 110; }
  }

  /* Geothermal (6 Oct 2026, industry tile): the same swell on top; heat rises through the strata as a gap
     running up each arrow's shaft (pattern "D G rest": the gap's head tracks the offset, same language
     as the cable in Subsea telemetry), left to right, and each arrowhead lifts as the gap arrives. */
  .pictogram--geothermal {
    --pg-cycle: 3.2s;
  }
  .pictogram--geothermal .pg-sea {
    clip-path: inset(0 12.7px 0 13px) view-box;
  }
  .pictogram--geothermal .pg-wave {
    animation-timing-function: linear;
  }
  .pictogram--geothermal .pg-shaft {
    stroke-dasharray: 100 12 300 0;
  }
  .pictogram--geothermal.is-playing .pg-wave {
    animation-name: pg-flow;
  }
  .pictogram--geothermal.is-playing .pg-shaft--a {
    animation-name: pg-geo-rise-a;
  }
  .pictogram--geothermal.is-playing .pg-shaft--b {
    animation-name: pg-geo-rise-b;
  }
  .pictogram--geothermal.is-playing .pg-shaft--c {
    animation-name: pg-geo-rise-c;
  }
  .pictogram--geothermal.is-playing .pg-head--a {
    animation-name: pg-geo-head-a;
  }
  .pictogram--geothermal.is-playing .pg-head--b {
    animation-name: pg-geo-head-b;
  }
  .pictogram--geothermal.is-playing .pg-head--c {
    animation-name: pg-geo-head-c;
  }
  @keyframes pg-geo-rise-a {
    0%, 4% { stroke-dashoffset: 112; }
    40%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-geo-rise-b {
    0%, 16% { stroke-dashoffset: 112; }
    52%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-geo-rise-c {
    0%, 28% { stroke-dashoffset: 112; }
    64%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes pg-geo-head-a {
    0%, 36%, 48%, 100% { transform: translate3d(0, 0, 0); }
    42% { transform: translate3d(0, -1.5px, 0); }
  }
  @keyframes pg-geo-head-b {
    0%, 48%, 60%, 100% { transform: translate3d(0, 0, 0); }
    54% { transform: translate3d(0, -1.5px, 0); }
  }
  @keyframes pg-geo-head-c {
    0%, 60%, 72%, 100% { transform: translate3d(0, 0, 0); }
    66% { transform: translate3d(0, -1.5px, 0); }
  }

  /* Carbon storage (6 Oct 2026, industry tile): the CO2 is picked out first (C, O, ₂ hop in turn), then it
     goes down: a gap runs round each arrow's outline, left arrow then right (the outline starts at the
