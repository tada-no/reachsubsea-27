  }
  .pictogram--carbon-storage.is-playing .pg-letter--s {
    animation-name: pg-co2-hop-s;
  }
  .pictogram--carbon-storage.is-playing .pg-arrow--l {
    animation-name: pg-co2-down-l;
  }
  .pictogram--carbon-storage.is-playing .pg-arrow--r {
    animation-name: pg-co2-down-r;
  }
  @keyframes pg-co2-hop-c {
    0%, 2%, 12%, 100% { transform: translate3d(0, 0, 0); }
    7% { transform: translate3d(0, -1.5px, 0); }
  }
  @keyframes pg-co2-hop-o {
