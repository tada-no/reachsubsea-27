  }
  @keyframes pg-bolt-1 {
    0%, 10%, 26%, 100% { transform: scale(1); }
    18% { transform: scale(1.7); }
  }
  @keyframes pg-bolt-2 {
    0%, 18%, 34%, 100% { transform: scale(1); }
    26% { transform: scale(1.7); }
  }
  @keyframes pg-bolt-3 {
    0%, 40%, 56%, 100% { transform: scale(1); }
    48% { transform: scale(1.7); }
  }
  @keyframes pg-bolt-4 {
    0%, 48%, 64%, 100% { transform: scale(1); }
    56% { transform: scale(1.7); }
  }
  @keyframes pg-stir-a {
    0%, 0%, 30%, 100% { transform: translate3d(0, 0, 0); }
