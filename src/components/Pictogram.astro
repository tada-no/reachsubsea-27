    76%, 100% { transform: translate3d(0, 0, 0); }
  }
  @keyframes pg-reach-out {
    0%, 12% { stroke-dashoffset: 0; }
    30%, 50% { stroke-dashoffset: 110; }
    66%, 100% { stroke-dashoffset: 0; }
  }

  /* ── Contact topic pictograms (22 Sep 2026, Q75): library glyphs (Figma Pictograms page) with their
     parts tagged, moved by transform only, so nothing is redrawn. Each acts out its subject once:
     a handshake shakes, a team bobs in turn, a chat types, arrows climb, a coin hops, a tick pops. */
  .pictogram--handshake,
  .pictogram--team,
  .pictogram--chat-active,
  .pictogram--increase-percent-arrows,
  .pictogram--money-stack-dollars,
  .pictogram--shield-tick {
    --pg-cycle: 3.2s;
  }
  /* Handshake (traced as strokes, 22 Sep 2026): the hands draw back, clasp, then shake together */
  .pictogram--handshake {
    --pg-cycle: 4s;
  }
  .pictogram--handshake.is-playing .pg-hand--right {
    animation-name: pg-clasp-right;
  }
  .pictogram--handshake.is-playing .pg-hand--left {
    animation-name: pg-clasp-left;
  }
  .pictogram--handshake.is-playing .pg-shake {
    animation-name: pg-shake;
  }
  /* Draw back slowly, clasp with a spring (back-out easing), then a shake that dies away */
  @keyframes pg-clasp-right {
    0%, 100% { transform: translate3d(0, 0, 0); }
    4% { transform: translate3d(0, 0, 0); animation-timing-function: var(--wp--custom--motion--ease-in-out); }
    14% { transform: translate3d(3px, -1.5px, 0); animation-timing-function: cubic-bezier(0.34, 1.4, 0.64, 1); }
    24% { transform: translate3d(0, 0, 0); }
  }
  @keyframes pg-clasp-left {
    0%, 100% { transform: translate3d(0, 0, 0); }
    4% { transform: translate3d(0, 0, 0); animation-timing-function: var(--wp--custom--motion--ease-in-out); }
    14% { transform: translate3d(-3px, 1.5px, 0); animation-timing-function: cubic-bezier(0.34, 1.4, 0.64, 1); }
    24% { transform: translate3d(0, 0, 0); }
  }
  @keyframes pg-shake {
    0%, 24%, 100% { transform: translate3d(0, 0, 0); }
    30% { transform: translate3d(0, -2.6px, 0); }
    37% { transform: translate3d(0, 2px, 0); }
    44% { transform: translate3d(0, -1.3px, 0); }
    51% { transform: translate3d(0, 0.7px, 0); }
    58% { transform: translate3d(0, -0.3px, 0); }
    64% { transform: translate3d(0, 0, 0); }
  }
  /* Team (traced as strokes): a roll call. Each person lifts a touch in turn, left to right,
     and settles; nothing leans or hugs */
  .pictogram--team.is-playing .pg-person--l {
    animation-name: pg-roll-l;
  }
  .pictogram--team.is-playing .pg-person--m {
    animation-name: pg-roll-m;
  }
  .pictogram--team.is-playing .pg-person--r {
    animation-name: pg-roll-r;
  }
  @keyframes pg-roll-l {
    0%, 6%, 100% { transform: translate3d(0, 0, 0); }
    14%, 22% { transform: translate3d(0, -2.5px, 0); }
    32% { transform: translate3d(0, 0, 0); }
  }
  @keyframes pg-roll-m {
    0%, 18%, 100% { transform: translate3d(0, 0, 0); }
    26%, 34% { transform: translate3d(0, -2.5px, 0); }
    44% { transform: translate3d(0, 0, 0); }
  }
  @keyframes pg-roll-r {
    0%, 30%, 100% { transform: translate3d(0, 0, 0); }
    38%, 46% { transform: translate3d(0, -2.5px, 0); }
    56% { transform: translate3d(0, 0, 0); }
  }
  .pictogram--chat-active .pg-dot,
  .pictogram--increase-percent-arrows .pg-percent {
    transform-box: fill-box;
    transform-origin: center;
  }
  .pictogram--chat-active.is-playing .pg-dot--a {
