  }
  .pictogram--chat-active.is-playing .pg-dot--b {
    animation-name: pg-pop-b;
  }
  .pictogram--chat-active.is-playing .pg-dot--c {
    animation-name: pg-pop-c;
  }
  .pictogram--chat-active.is-playing .pg-dot--d {
    animation-name: pg-pop-d;
  }
  .pictogram--chat-active.is-playing .pg-dot--e {
