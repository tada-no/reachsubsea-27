---
// Section header (docs/05 §1). Eyebrow → H2 → Lead, text max 880, gap stack/sm.
// Start ≥900px: the action sits at the far end of the row, bottom-aligned. Center and narrow: below the intro.
// Meta (6 Oct 2026, Q102): 1–3 Meta items in a wrapping row under the intro (`space/8` × `space/24`).
import Eyebrow from './Eyebrow.astro';
import Link from './Link.astro';
import MetaItem from './MetaItem.astro';
import type { SectionHeaderField } from '../lib/types';

interface Props extends SectionHeaderField {
  /** Heading id, for the block's aria-labelledby. */
  id?: string;
  /** h1 only when the block opens a page without a Page hero (Contact, Q75). */
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { eyebrow, title, intro, meta = [], action, align = 'start', id, as: Heading = 'h2', class: className } = Astro.props;
---

<header
  class:list={['section-header', `section-header--${align}`, action && 'section-header--has-action', className]}
>
  <div class="section-header__text">
    {eyebrow && <Eyebrow text={eyebrow} />}
    <Heading id={id} class:list={['section-header__title', Heading === 'h1' ? 'text-h1' : 'text-h2']}>{title}</Heading>
    {intro && <p class="section-header__intro text-lead">{intro}</p>}
    {
      meta.length > 0 && (
        <ul class="section-header__meta">
          {meta.map((item) => (
            <MetaItem icon={item.icon} text={item.text} as="li" />
          ))}
        </ul>
      )
    }
  </div>
  {
    action && (
      <div class="section-header__action">
        <Link label={action.label} href={action.url} action={action.action ?? 'page'} context={action.context} />
      </div>
    )
  }
</header>

<style is:global>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
  }
  .section-header__text {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--sm);
    max-width: var(--wp--style--global--content-size);
  }
  .section-header__intro {
    color: var(--wp--custom--color--text--secondary);
  }
  .section-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wp--preset--spacing--8) var(--wp--preset--spacing--24);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .section-header--center .section-header__meta {
    justify-content: center;
  }
  .section-header--center {
    align-items: center;
    text-align: center;
  }
  .section-header--center .section-header__text {
    align-items: center;
  }

  @media (min-width: 900px) {
    .section-header--start.section-header--has-action {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--wp--custom--grid--gutter);
    }
    .section-header--start .section-header__action {
      flex: none;
    }
  }
</style>
