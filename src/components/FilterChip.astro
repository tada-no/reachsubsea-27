---
// Filter chip (docs/04 §10). Selected = aria-pressed="true" (navy fill + check icon).
// No jump on select (Q92): the check (16 + 8 gap = 24) appears inside the chip's own side padding, so the
// chip keeps its width and the chips after it stay put. Unselected 28 each side; selected 16 + check + 16.
// Counts are bracketed, "2025–26 (7)" (Q93). The chip hugs its content (Q142): a count only falls from the one it is
// built with (Data list counts are a share of it), so a hidden copy of that first count holds its width and a live
// count going from 14 to 5 moves nothing.
// With `href` (8 Oct 2026, Newsroom, Q145) the chip is a link to a filtered archive page instead of a toggle: the
// selected chip is the current page (aria-current), with the same look.
import Icon from './Icon.astro';

interface Props {
  label: string;
  count?: number | string;
  selected?: boolean;
  disabled?: boolean;
  /** A link chip: goes to this URL (a category archive) instead of toggling a filter in place. */
  href?: string;
  class?: string;
  [attr: string]: unknown;
}

const { label, count, selected = false, disabled = false, href, class: className, ...attrs } = Astro.props;
const Tag = href ? 'a' : 'button';
const state = href
  ? { href, 'aria-current': selected ? 'page' : undefined }
  : { type: 'button', 'aria-pressed': String(selected), disabled };
---

<Tag class:list={['filter-chip', 'text-label', className]} {...state} {...attrs}>
  <Icon name="check" size={16} class="filter-chip__check" />
  <span class="filter-chip__label">{label}</span>
  {count !== undefined && (
    <span class="filter-chip__count" data-reserve={`(${count})`}><span class="filter-chip__count-value">{count}</span></span>
  )}
</Tag>

<style is:global>
  .filter-chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: calc(var(--wp--preset--spacing--16) + var(--wp--preset--spacing--12));
    border-radius: var(--wp--custom--radius--full);
    background-color: var(--wp--custom--color--bg--default);
    color: var(--wp--custom--color--text--primary);
    box-shadow: inset 0 0 0 1px var(--wp--custom--color--border--default);
    white-space: nowrap;
    transition:
      background-color var(--wp--custom--motion--duration) var(--wp--custom--motion--easing),
      box-shadow var(--wp--custom--motion--duration) var(--wp--custom--motion--easing);
  }
  .filter-chip__check {
    display: none;
    margin-inline-end: var(--wp--preset--spacing--8);
  }
  /* The count is bracketed (Q93): a bare number after a label that is itself a number ("2025–26 7") read as
     part of it. A word space from its label, not a gap: "2025–26 (7)" reads as one phrase (Ross, 8 Oct 2026, Q142).
     Counts can change live (Data list, Q89): the live value and a hidden copy of the built count share one grid
     cell, so the chip hugs its own count and keeps that width as it falls (tabular figures) */
  .filter-chip__count {
    display: inline-grid;
    justify-items: start;
    margin-inline-start: var(--wp--preset--spacing--4);
    font-variant-numeric: tabular-nums;
    color: var(--wp--custom--color--text--secondary);
  }
  .filter-chip__count > *,
  .filter-chip__count::after {
    grid-area: 1 / 1;
  }
  .filter-chip__count::after {
    content: attr(data-reserve);
    visibility: hidden;
  }
  .filter-chip__count-value::before {
    content: '(';
  }
  .filter-chip__count-value::after {
    content: ')';
  }
  .filter-chip[aria-pressed='true'],
  .filter-chip[aria-current='page'] {
    padding-inline: var(--wp--preset--spacing--16);
    background-color: var(--wp--custom--color--action--primary--bg);
    color: var(--wp--custom--color--action--primary--fg);
    box-shadow: none;
  }
  .filter-chip[aria-pressed='true'] .filter-chip__check,
  .filter-chip[aria-current='page'] .filter-chip__check {
    display: block;
  }
  .filter-chip[aria-pressed='true'] .filter-chip__count,
  .filter-chip[aria-current='page'] .filter-chip__count {
    color: inherit;
  }

  @media (hover: hover) {
    .filter-chip:not(:disabled, [aria-pressed='true'], [aria-current='page']):hover {
      background-color: var(--wp--custom--color--action--outline--bg-hover);
      box-shadow: inset 0 0 0 1px var(--wp--custom--color--border--strong);
    }
  }

  .filter-chip:disabled {
    cursor: not-allowed;
    color: var(--wp--custom--color--text--disabled);
    box-shadow: inset 0 0 0 1px var(--wp--custom--color--border--subtle);
  }
  .filter-chip:disabled .filter-chip__count {
    color: inherit;
  }
</style>
