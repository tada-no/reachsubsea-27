---
// Seabed scan (9 Oct 2026, Q158): the 404's hero. The brand dot matrix (as the world map's dots) as a field of
// seabed filling the whole navy band, dot size standing for depth, with "404" sounded into it as a raised mound. It
// is the page's visual headline: this component is the digits' box in the text flow (7 rows tall, under the H1),
// and the field is drawn out from it in every direction, so the digits sit on the text's left edge and the grid
// runs under the header, the margins and the copy. The band clips it. Two layers: the field (z-index 0, under the
// band's scrim, so it fades in from the edges as a photo does in the Page hero) and the digits (z-index 2, over
// the scrim, so the 404 stays crisp); both share one geometry.
// Seen from straight above (Ross: no tilt).
// Motion: one pass only. On load a survey line in border/accent sweeps the band left to right (4.5 s); each column
// of dots lights as it passes and settles back, and the digits light and stay lit, so the scan "finds" the 404
// once. Until the line reaches them the digits are unlit field dots from the first paint (Ross, 9 Oct 2026: the 404
// showed lit on load, before the scan): an inline script marks the scan as waiting before the page paints. Under 5 s and then still, so no pause control is needed (WCAG 2.2.2; Ross asked to drop it). Solid colour
// throughout, no opacity. The pass waits until the tab is visible. Without JS, or with reduced motion: no sweep,
// the digits shown lit. Decorative (aria-hidden): the page's H1 stays text.
// Geometry, built here at render time: 120 × 61 dots on a 16 grid (30 columns left of the digits, 20 rows above,
// 34 below: enough for a 2560 window, the 800 hero height and a phone's taller copy). The grid is a CSS length, 12 px on phones to 22 at
// 1440. Field dots are drawn as round-capped zero-length strokes, one path per column and size step (as the Dot
// map poster), so 6,000 dots stay a few hundred elements; the 39 digit dots are circles.
// In WordPress: an inline SVG in 404.php (copy the built markup) plus this CSS and script.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const GAP = 16;
const LEFT = 30;
const TOP = 20;
const COLS = 120;
const ROWS = TOP + 7 + 34;
const W = COLS * GAP;
const H = ROWS * GAP;

// 5 × 7 digits, one dot per pixel, two dots apart
const GLYPHS: Record<string, string[]> = {
  '4': ['...#.', '..##.', '.#.#.', '#..#.', '#####', '...#.', '...#.'],
  '0': ['.###.', '#...#', '#...#', '#...#', '#...#', '#...#', '.###.'],
};
const hits = new Set<string>();
[...'404'].forEach((ch, i) =>
  GLYPHS[ch].forEach((row, y) =>
    [...row].forEach((px, x) => {
      if (px === '#') hits.add(`${LEFT + i * 7 + x},${TOP + y}`);
    }),
  ),
);

// A smooth, fixed depth field (no randomness: the same picture every build), snapped to six dot sizes
const SIZES = [1.1, 1.6, 2.1, 2.6, 3.2, 3.8];
const depth = (x: number, y: number) => {
  const d = 0.5 + 0.24 * Math.sin(x * 0.21 + y * 0.13) + 0.16 * Math.sin(x * 0.07 - y * 0.31 + 1.3) + 0.1 * Math.sin((x + y) * 0.43);
  return Math.min(1, Math.max(0, d));
};
const sizeOf = (x: number, y: number) => Math.min(SIZES.length - 1, Math.floor(depth(x, y) ** 1.4 * SIZES.length));
const centre = (i: number) => i * GAP + GAP / 2;

const columns = Array.from({ length: COLS }, (_, x) => {
  const paths: string[] = SIZES.map(() => '');
  for (let y = 0; y < ROWS; y += 1) {
    if (!hits.has(`${x},${y}`)) paths[sizeOf(x, y)] += `M${centre(x)} ${centre(y)}h0`;
  }
  return { cx: centre(x), paths };
});
const digits = [...hits].map((key) => {
  const [x, y] = key.split(',').map(Number);
  return { cx: centre(x), cy: centre(y) };
});
const geometry = `--cols: ${COLS}; --rows: ${ROWS}; --left: ${LEFT}; --top: ${TOP}`;
---

<div class:list={['seabed-scan', className]} data-seabed-scan>
  <svg class="seabed-scan__field" viewBox={`0 0 ${W} ${H}`} style={geometry} aria-hidden="true" focusable="false">
    {
      columns.map((col) => (
        <g class="seabed-scan__col" data-cx={col.cx}>
          {col.paths.map((d, i) => d && <path d={d} stroke-width={SIZES[i] * 2} />)}
        </g>
      ))
    }
    <rect class="seabed-scan__line" x="-1.5" y="0" width="3" height={H} />
  </svg>
  <svg class="seabed-scan__field seabed-scan__digits" viewBox={`0 0 ${W} ${H}`} style={geometry} aria-hidden="true" focusable="false">
    {digits.map((d) => <circle class="seabed-scan__hit" data-cx={d.cx} cx={d.cx} cy={d.cy} r="4.8" />)}
  </svg>
</div>
<script is:inline>
  // Before the first paint: the digits start unlit when the pass will run (not with reduced motion)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('[data-seabed-scan]').forEach((el) => el.classList.add('is-waiting'));
  }
</script>

<style is:global>
  .seabed-scan {
    --seabed-cell: clamp(12px, 8.7px + 0.91vw, 22px);
    --seabed-start: 0.4s;
    --seabed-sweep: 4.5s;
    --seabed-dot: var(--wp--preset--color--navy-600);
    --seabed-lit: var(--wp--custom--color--border--accent);
    --seabed-found: var(--wp--custom--color--text--accent);
    position: relative;
    height: calc(7 * var(--seabed-cell));
  }
  .seabed-scan__field {
    position: absolute;
    left: calc(-1 * var(--left) * var(--seabed-cell));
    top: calc(-1 * var(--top) * var(--seabed-cell));
    width: calc(var(--cols) * var(--seabed-cell));
    height: calc(var(--rows) * var(--seabed-cell));
    max-width: none;
    pointer-events: none;
    z-index: 0;
  }
  .seabed-scan__digits {
    z-index: 2;
  }
  .seabed-scan__col {
    color: var(--seabed-dot);
    stroke: currentColor;
    stroke-linecap: round;
    fill: none;
  }
  .seabed-scan__hit {
    fill: var(--seabed-found);
    stroke: none;
  }
  .seabed-scan__line {
    fill: var(--seabed-lit);
    visibility: hidden;
  }

  .seabed-scan.is-waiting .seabed-scan__hit {
    fill: var(--seabed-dot);
  }

  /* The pass (the script sets each column's --x, its place across the band 0–1, and the line's --from / --to) */
  .seabed-scan.is-scanning .seabed-scan__col {
    animation: seabed-ping 0.6s linear;
    animation-delay: calc(var(--seabed-start) + var(--x, 2) * var(--seabed-sweep));
  }
  .seabed-scan.is-scanning .seabed-scan__hit {
    fill: var(--seabed-dot);
    animation: seabed-found 0.9s linear forwards;
    animation-delay: calc(var(--seabed-start) + var(--x, 0) * var(--seabed-sweep));
  }
  .seabed-scan.is-scanning .seabed-scan__line {
    animation: seabed-sweep var(--seabed-sweep) linear var(--seabed-start) both;
  }
  @keyframes seabed-ping {
    0% {
      color: var(--seabed-lit);
    }
    100% {
      color: var(--seabed-dot);
    }
  }
  @keyframes seabed-found {
    0% {
      fill: var(--seabed-lit);
    }
    100% {
      fill: var(--seabed-found);
    }
  }
  @keyframes seabed-sweep {
    0% {
      visibility: visible;
      transform: translateX(var(--from));
    }
    99.9% {
      visibility: visible;
    }
    100% {
      visibility: hidden;
      transform: translateX(var(--to));
    }
  }
</style>

<script>
  // One pass when the page is visible: place each column on the band (0 = its left edge, 1 = its right), then start
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function scan(root: HTMLElement) {
    const field = root.querySelector<SVGSVGElement>('.seabed-scan__field');
    const band = root.closest<HTMLElement>('section') ?? document.documentElement;
    if (!field || root.classList.contains('is-scanning')) return;
    const f = field.getBoundingClientRect();
    const b = band.getBoundingClientRect();
    const scale = f.width / field.viewBox.baseVal.width;
    const from = (b.left - f.left) / scale;
    const to = (b.right - f.left) / scale;
    field.style.setProperty('--from', `${from}px`);
    field.style.setProperty('--to', `${to}px`);
    root.querySelectorAll<SVGElement>('.seabed-scan__col, .seabed-scan__hit').forEach((el) => {
      el.style.setProperty('--x', ((Number(el.dataset.cx) - from) / (to - from) || 0).toFixed(3));
    });
    root.classList.add('is-scanning');
  }

  if (!still) {
    document.querySelectorAll<HTMLElement>('[data-seabed-scan]').forEach((root) => {
      if (document.visibilityState === 'visible') scan(root);
      else document.addEventListener('visibilitychange', () => scan(root), { once: true });
    });
  }
</script>
