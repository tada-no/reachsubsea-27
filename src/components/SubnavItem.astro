---
// Subnav item pill (docs/04 §15). Also the tab look inside blocks (Data list, role="tab").
// Active = .is-active, aria-current (page/location) or aria-selected="true".
// Count (8 Oct 2026, FAQ index rail, Q141): bracketed as the Filter chip's (Q93), tabular so a live count keeps
// the pill's width.
interface Props {
  label: string;
  count?: number | string;
  href?: string;
  active?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const { label, count, href, active = false, class: className, ...attrs } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['subnav-item', 'text-label', active && 'is-active', className]}
  href={href}
  type={href ? undefined : 'button'}
  {...attrs}
>
  {count === undefined ? label : <span class="subnav-item__label">{label}</span>}
  {count !== undefined && <span class="subnav-item__count">{count}</span>}
</Tag>

<style is:global>
  .subnav-item {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 40px;
    padding-inline: var(--wp--preset--spacing--16);
    border-radius: var(--wp--custom--radius--full);
    color: var(--wp--custom--color--text--secondary);
    white-space: nowrap;
    transition:
      background-color var(--wp--custom--motion--duration) var(--wp--custom--motion--easing),
      color var(--wp--custom--motion--duration) var(--wp--custom--motion--easing);
  }
  .subnav-item__count {
    min-width: 4ch;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .subnav-item__count::before {
    content: '(';
  }
  .subnav-item__count::after {
    content: ')';
  }
  /* Nothing behind it right now (FAQ index search, Q141): greyed and not clickable */
  .subnav-item[aria-disabled='true'] {
    color: var(--wp--custom--color--text--disabled);
    pointer-events: none;
  }
  .subnav-item.is-active,
  .subnav-item[aria-current='page'],
  .subnav-item[aria-current='location'],
  .subnav-item[aria-current='true'],
  .subnav-item[aria-selected='true'] {
    background-color: var(--wp--custom--color--action--primary--bg);
    color: var(--wp--custom--color--action--primary--fg);
  }

  @media (hover: hover) {
    .subnav-item:not(.is-active, [aria-current='page'], [aria-current='location'], [aria-current='true'], [aria-selected='true']):hover {
      background-color: var(--wp--custom--color--action--outline--bg-hover);
      color: var(--wp--custom--color--text--primary);
    }
  }
</style>
