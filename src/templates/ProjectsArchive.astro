---
// Projects archive template (8 Oct 2026, Q150): WordPress archive-project.php (/projects/). Not a block: the query
// fills it. Every Project, newest first (undated last), filtered in place by service.
// Built to feel unlike the Newsroom (Ross: "think about the UI… a bit different to the Newsroom"). News is about
// when, so the Newsroom leads with its newest story and dates every card. Projects are about where and what, so this
// page leads with where: under the title and intro, the brand dot map with a pin per place sits beside the latest
// project (9 Oct 2026), the service chips
// head the list, and the cards carry work type, year and place instead of a date and an excerpt. Chips filter the map and the grid
// together (?service=, the Projects menu's links); a pin opens its place's projects on the map; hovering a card
// lights its pin, and a pin lights its cards.
// Header as the Newsroom archive (Q148): no Page hero, title and intro on white under the solid header, no
// breadcrumb at depth 2.
//
// Without JS: every card shows, the map is the static poster, the chips do nothing (the menu's ?service= links
// still land on the full list). WP: the same chips as a FacetWP facet or ?service= query var.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/Footer.astro';
import BlockSection from '../components/BlockSection.astro';
import Card from '../components/Card.astro';
import FilterChip from '../components/FilterChip.astro';
import DotMap from '../components/DotMap.astro';
import DotMapZoom from '../components/DotMapZoom.astro';
import Button from '../components/Button.astro';
import IconButton from '../components/IconButton.astro';
import CtaBand from '../blocks/CtaBand.astro';
import { projects, projectCard, type ProjectRef } from '../data/projects';
import { serviceLines } from '../data/services';
import type { DotMapPoint } from '../lib/dot-map-client';

/** Cards shown before "Show more", and per click. */
const PAGE = 12;

const list = [...projects].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
const lines = serviceLines.filter((l) => list.some((p) => p.service === l.id));
const chips = [
  { value: '', label: 'All', count: list.length },
  ...lines.map((l) => ({ value: l.id, label: l.short, count: list.filter((p) => p.service === l.id).length })),
];

// One pin per place: projects at the same place share it (Ormen Lange has three)
const placeId = (p: ProjectRef) => (p.place ? `place-${p.place.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : '');
const places = new Map<string, { id: string; name: string; lat: number; lon: number; projects: ProjectRef[] }>();
for (const p of list) {
  if (!p.place) continue;
  const id = placeId(p);
  if (!places.has(id)) places.set(id, { id, ...p.place, projects: [] });
  places.get(id)!.projects.push(p);
}
const points: DotMapPoint[] = [...places.values()].map((pl) => ({ id: pl.id, name: pl.name, lat: pl.lat, lon: pl.lon, count: pl.projects.length }));
const plural = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;
/** Projects with no single site (several fields, a whole sea, a research programme): in the list, not on the map */
const unmappedNote = (n: number) => (n === 1 ? '1 project has no single site, so it is in the list but not on the map.' : `${n} projects have no single site, so they are in the list but not on the map.`);
const unmapped = list.filter((p) => !p.place).length;
const summary = `Map of ${places.size} project locations, among them ${[...places.values()]
  .slice(0, 6)
  .map((pl) => pl.name)
  .join(', ')}. ${unmapped ? unmappedNote(unmapped) + ' ' : ''}Every project is in the list below.`;

// The latest project beside the map (9 Oct 2026, Ross: "similar to the region map on the home"), one per chip: the
// newest in the chosen service. It leaves the grid while it is shown, so a chip's count is the card plus the grid.
const latest = chips
  .map((c) => ({ value: c.value, project: list.find((p) => !c.value || p.service === c.value) }))
  .filter((l): l is { value: string; project: ProjectRef } => Boolean(l.project));
---

<BaseLayout title="Projects · Reach Subsea" motion>
  <Header current="projects" />
  <main id="main">
    <BlockSection slug="projects-archive" root="projects-archive" background="white" labelledBy="projects-archive-title" data-projects-archive data-page={PAGE}>
      <div class="block__body">
        <div class="projects-archive__top">
          <div class="projects-archive__intro">
            <h1 id="projects-archive-title" class="projects-archive__title text-h2">Projects</h1>
            <p class="projects-archive__lead text-lead">
              Subsea, survey and monitoring work from the North Sea to Western Australia, with crewed vessels and the uncrewed Reach Remote.
            </p>
          </div>

          {/* One row under the intro (Ross, 9 Oct 2026), as the home page's Live operations toolbar: the chips filter all
              three below them (the map, the latest project and the list), the zoom pill at the end of the row */}
          <div class="projects-archive__toolbar">
            <div class="projects-archive__chips" role="group" aria-label="Filter projects by service">
              {chips.map((c) => <FilterChip label={c.label} count={c.count} selected={c.value === ''} data-value={c.value} />)}
            </div>
            <DotMapZoom class="projects-archive__zoom" data-projects-archive-zoom />
          </div>

          <div class="projects-archive__stage">
            {/* The map and its place panels: on phones a panel docks inside this box, clear of the note under it */}
            <div class="projects-archive__mapbox">
              <DotMap class="projects-archive__map" points={points} summary={summary} labels data-projects-archive-map="" />
              {/* A place's projects, pinned to the map when its marker is clicked (hidden until then) */}
              {
                [...places.values()].map((pl) => (
                  <div class="projects-archive__popup has-surface-light" data-place-popup={pl.id} tabindex="-1" hidden>
                    <p class="projects-archive__popup-title text-h5">{pl.name}</p>
                    <ul class="projects-archive__popup-list">
                      {pl.projects.map((p) => (
                        <li data-service={p.service}>
                          {/* Critique 9 Oct 2026: the place's projects shown here with a photo, so a pin answers "what was done here"
                              without the grid, which sits below the fold. Title only (Ross: no year or work type) */}
                          <a class="projects-archive__popup-link" href={p.url}>
                            <span class="projects-archive__popup-thumb">
                              <img src={p.image.src} alt="" loading="lazy" decoding="async" />
                            </span>
                            <span class="projects-archive__popup-name text-small">{p.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <IconButton icon="x" label={`Close ${pl.name}`} variant="ghost" size="small" class="projects-archive__popup-close" data-place-popup-close="" />
                  </div>
                ))
              }
            </div>
            {/* Critique 9 Oct 2026: projects without a site no longer vanish silently. The line follows the chips and keeps
                its space when a filter has none (hidden, not removed), so nothing under it moves */}
            <p class="projects-archive__unmapped text-caption" data-projects-archive-unmapped aria-hidden="true">
              {unmappedNote(unmapped)}
            </p>
          </div>

          <div class="projects-archive__latest">
            {
              latest.map((l) => (
                <div class:list={['projects-archive__latest-item', l.value !== '' && 'is-off']} data-latest={l.value} data-project={l.project.url} data-place={placeId(l.project) || undefined} inert={l.value !== ''}>
                  <Card {...projectCard(l.project, 'tint')} badge={{ label: 'Latest', tone: 'accent' }} headingLevel="h2" />
                </div>
              ))
            }
          </div>
        </div>

        <div class="projects-archive__results">
          <h2 class="visually-hidden">Project list</h2>
          <ul class="projects-archive__grid">
            {
              list.map((p) => (
                <li class:list={['projects-archive__cell', p === latest[0]?.project && 'is-latest']} data-service={p.service} data-project={p.url} data-place={placeId(p) || undefined}>
                  <Card {...projectCard(p, 'tint')} headingLevel="h3" />
                </li>
              ))
            }
          </ul>
          <div class="projects-archive__more">
            <Button label="Show more projects" variant="outline" type="button" data-projects-archive-more hidden />
          </div>
          <p class="visually-hidden" aria-live="polite" data-projects-archive-announce></p>
        </div>
      </div>
    </BlockSection>

    <CtaBand
      anchor="contact"
      style="panel"
      background="white"
      title="Have a project in mind?"
      text="Tell us about the work, and we will propose the vessel, equipment and team."
      actions={[{ label: 'Contact us', url: '/contact/', action: 'page' }]}
    />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { createDotMap } from '../lib/dot-map-client';

  function initProjectsArchive(root: HTMLElement) {
    const page = Number(root.dataset.page) || 12;
    const figure = root.querySelector<HTMLElement>('[data-projects-archive-map]')!;
    const stage = figure.parentElement!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.projects-archive__chips .filter-chip')];
    const cells = [...root.querySelectorAll<HTMLElement>('.projects-archive__cell')];
    const latest = [...root.querySelectorAll<HTMLElement>('[data-latest]')];
    /** Everything a pin lights: the latest card and the grid's cards */
    const lit = [...latest, ...cells];
    const more = root.querySelector<HTMLElement>('[data-projects-archive-more]')!;
    const announce = root.querySelector<HTMLElement>('[data-projects-archive-announce]');
    const say = (text: string) => announce && (announce.textContent = text);
    const popupFor = (id: string) => root.querySelector<HTMLElement>(`[data-place-popup="${id}"]`);
    const phone = window.matchMedia('(max-width: 599px)');
    const wide = window.matchMedia('(min-width: 1200px)');
    const plural = (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`;
    const unmappedNote = (n: number) => (n === 1 ? '1 project has no single site, so it is in the list but not on the map.' : `${n} projects have no single site, so they are in the list but not on the map.`);
    const unmappedLine = root.querySelector<HTMLElement>('[data-projects-archive-unmapped]')!;

    const known = new Set(chips.map((c) => c.dataset.value ?? ''));
    const fromUrl = new URLSearchParams(location.search).get('service') ?? '';
    let service = known.has(fromUrl) ? fromUrl : '';
    let shown = page;
    let openId: string | null = null;

    const matches = (el: HTMLElement) => !service || el.dataset.service === service;
    /** Projects at a place that pass the filter: the pin's count, 0 hides it. */
    const countAt = (id: string) => cells.filter((c) => c.dataset.place === id && matches(c)).length;

    const dotMap = createDotMap(figure, {
      controls: root.querySelector<HTMLElement>('[data-projects-archive-zoom]'),
      // Zoom stops at 5 (critique 9 Oct 2026): at 6 a phone showed only sea, the dots no longer read as land
      maxZoom: 5,
      fitMaxZoom: 5,
      clusterMaxZoom: 4,
      clusterClick: 'fit',
      clusterRadius: 40,
      showCount: 'always',
      clusterLabel: (_points, n) => plural(n),
      countOf: countAt,
      announce: say,
      onSelect: (id) => open(openId === id ? null : id),
      onHover: (ids, on) => lit.forEach((c) => c.dataset.place && ids.includes(c.dataset.place) && c.classList.toggle('is-hover', on)),
    });

    function render() {
      // The chip's latest project beside the map (from 1200; below, it stays first in the grid); the grid shows the rest
      const top = latest.find((l) => (l.dataset.latest ?? '') === service) ?? latest[0];
      latest.forEach((l) => {
        l.classList.toggle('is-off', l !== top);
        l.inert = l !== top;
      });
      cells.forEach((c) => c.classList.toggle('is-latest', c.dataset.project === top?.dataset.project));
      const pulled = wide.matches ? top?.dataset.project : undefined;
      const hits = cells.filter((c) => matches(c) && c.dataset.project !== pulled);
      cells.forEach((c) => (c.hidden = true));
      hits.forEach((c, i) => (c.hidden = i >= shown));
      more.hidden = hits.length <= shown;
      chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.value ?? '') === service)));
      // Each place's list on the map keeps only the projects that pass
      root.querySelectorAll<HTMLElement>('[data-place-popup]').forEach((popup) => {
        const items = [...popup.querySelectorAll<HTMLElement>('li')];
        items.forEach((li) => (li.hidden = !matches(li)));
      });
      const off = cells.filter((c) => matches(c) && !c.dataset.place).length;
      unmappedLine.textContent = unmappedNote(off);
      unmappedLine.style.visibility = off ? '' : 'hidden';
      dotMap.refresh();
      return hits.length;
    }

    /** One place open at a time, pinned above its marker (docked along the map's foot on phones). */
    function open(id: string | null) {
      if (openId) {
        const was = popupFor(openId);
        if (was?.classList.contains('is-docked')) {
          was.classList.remove('is-docked');
          was.hidden = true;
        } else dotMap.hideOverlay();
        lit.forEach((c) => c.classList.remove('is-active'));
      }
      openId = id;
      dotMap.setActive(id);
      if (!id) return;
      const popup = popupFor(id)!;
      if (phone.matches) {
        popup.classList.add('is-docked');
        popup.hidden = false;
      } else dotMap.showOverlay(id, popup);
      lit.forEach((c) => c.classList.toggle('is-active', c.dataset.place === id && !c.hidden && !c.classList.contains('is-off')));
      popup.focus({ preventScroll: true });
      const n = popup.querySelectorAll('li:not([hidden])').length;
      say(`${popup.querySelector('.projects-archive__popup-title')?.textContent ?? ''}: ${plural(n)} shown on the map`);
    }

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const chip = target.closest<HTMLButtonElement>('.projects-archive__chips .filter-chip');
      if (chip) {
        service = chip.dataset.value ?? '';
        shown = page;
        open(null);
        const url = new URL(location.href);
        if (service) url.searchParams.set('service', service);
        else url.searchParams.delete('service');
        history.replaceState(null, '', url);
        render();
        // A chip also brings the map back to the whole world (critique 9 Oct 2026: the one-step way out of a zoom)
        dotMap.fitHome();
        const n = cells.filter(matches).length;
        const off = cells.filter((c) => matches(c) && !c.dataset.place).length;
        say(`${plural(n)}${service ? `, ${chip.querySelector('.filter-chip__label')?.textContent}` : ''}${off ? `. ${unmappedNote(off)}` : ''}`);
        return;
      }
      if (target.closest('[data-projects-archive-more]')) {
        const from = shown;
        shown += page;
        const added = Math.min(page, render() - from);
        say(`${plural(added)} more shown`);
        // Focus the first new card's link, so keyboard users carry on where the list grew
        cells.filter((c) => matches(c) && !c.hidden)[from]?.querySelector<HTMLElement>('a')?.focus();
        return;
      }
      if (target.closest('[data-place-popup-close]')) open(null);
      else if (stage.contains(target) && openId && !target.closest('.dot-map__marker, .projects-archive__popup')) open(null);
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && openId) open(null);
    });

    // A card lights its pin
    lit.forEach((cell) => {
      const id = cell.dataset.place;
      if (!id) return;
      const hover = (on: boolean) => dotMap.setHover(on ? [id] : []);
      cell.addEventListener('pointerenter', () => hover(true));
      cell.addEventListener('pointerleave', () => hover(false));
      cell.addEventListener('focusin', () => hover(true));
      cell.addEventListener('focusout', () => hover(false));
    });

    wide.addEventListener('change', () => render());
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-projects-archive]').forEach(initProjectsArchive);
</script>

<style is:global>
  /* Opens the page under the fixed solid header, as the Newsroom archive: clear the bar (72 / 96), then a short gap */
  .projects-archive {
    padding-top: calc(72px + var(--wp--custom--stack--xl));
  }
  /* Intro, toolbar, then what it filters: stack/lg after the lead, space/32 under the toolbar (Ross, 9 Oct 2026; the
     home page's Live operations toolbar has the same) */
  .projects-archive__top {
    display: flex;
    flex-direction: column;
  }
  .projects-archive__intro {
    display: flex;
    flex-direction: column;
    gap: var(--wp--preset--spacing--12);
    max-width: var(--wp--style--global--content-size);
    margin-bottom: var(--wp--custom--stack--lg);
  }
  .projects-archive__toolbar {
    display: flex;
    align-items: center;
    gap: var(--wp--preset--spacing--16);
    margin-bottom: var(--wp--preset--spacing--32);
  }
  .projects-archive__zoom {
    margin-inline-start: auto;
  }
  /* Clusters show their count only (Ross, 9 Oct 2026: "do we need 15 projects written out?"); the words stay in the
     announcements. A single place keeps its name */
  .projects-archive__map .dot-map__marker--cluster .dot-map__marker-label {
    display: none;
  }
  .projects-archive__title,
  .projects-archive__lead {
    color: var(--wp--custom--color--text--primary);
  }
  .projects-archive__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wp--preset--spacing--8);
    min-width: 0;
  }

  /* ── Map ──────────────────────────────────────────────── */
  .projects-archive__mapbox {
    position: relative;
  }
  /* A place's projects on the map: a small white panel above the pin, as the Offices map's address card */
  .projects-archive__popup {
    position: relative;
    display: grid;
    gap: var(--wp--preset--spacing--4);
    width: max-content;
    max-width: 320px;
    padding: var(--wp--preset--spacing--24);
    border-radius: var(--wp--custom--radius--lg);
    background-color: var(--wp--custom--color--bg--default);
    color: var(--wp--custom--color--text--primary);
    box-shadow:
      var(--wp--preset--shadow--md),
      0 0 0 1px var(--wp--custom--color--border--subtle);
    text-align: start;
    font-family: var(--wp--preset--font-family--inter);
  }
  .projects-archive__popup[hidden] {
    display: none;
  }
  .projects-archive__popup:focus {
    outline: none;
  }
  .projects-archive__popup::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 12px;
    height: 12px;
    translate: -50% 0;
    rotate: 45deg;
    background-color: inherit;
    box-shadow: 1px 1px 0 0 var(--wp--custom--color--border--subtle);
  }
  .projects-archive__popup-title {
    margin: 0;
    padding-inline-end: var(--wp--preset--spacing--32);
  }
  .projects-archive__popup-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--wp--preset--spacing--12);
    margin-top: var(--wp--preset--spacing--12);
  }
  .projects-archive__popup-list li[hidden] {
    display: none;
  }
  /* One project: the photo (4:3, the photo tint) beside its title, centred on it; the title's underline marks the link */
  .projects-archive__popup-link {
    display: grid;
    grid-template-columns: var(--wp--preset--spacing--64) minmax(0, 1fr);
    gap: var(--wp--preset--spacing--12);
    align-items: center;
    color: var(--wp--custom--color--text--primary);
    text-decoration: none;
  }
  .projects-archive__popup-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--wp--custom--radius--sm);
    background-color: var(--wp--custom--color--image-tint);
    isolation: isolate;
  }
  .projects-archive__popup-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: screen;
  }
  .projects-archive__popup-name {
    text-decoration: underline;
    text-decoration-color: var(--wp--custom--color--border--default);
    text-underline-offset: 0.2em;
  }
  .projects-archive__popup-link:hover .projects-archive__popup-name {
    color: var(--wp--custom--color--text--accent);
    text-decoration-color: currentColor;
  }
  .projects-archive__popup-link:focus-visible {
    outline: 2px solid var(--wp--custom--color--border--focus);
    outline-offset: 2px;
    border-radius: var(--wp--custom--radius--sm);
  }
  /* Under the map: one quiet line, as long as the map is wide */
  .projects-archive__unmapped {
    margin: var(--wp--preset--spacing--12) 0 0;
    color: var(--wp--custom--color--text--secondary);
  }
  /* Centred on the place name's first line (the 40px button against the h5 line) */
  .projects-archive__popup-close {
    position: absolute;
    top: calc(var(--wp--preset--spacing--24) + (var(--wp--custom--line-height--h5) - var(--wp--preset--spacing--40)) / 2);
    right: var(--wp--preset--spacing--12);
  }

  /* ── Latest project ───────────────────────────────────── */
  /* From 1200 only: the grid's card as it is (Ross, 9 Oct 2026: "the first card should be like the others") with a
     "Latest" badge. Below 1200 a full-width card would carry a 600-tall photo, so the latest stays first in the grid
     (.is-latest, hidden there from 1200) */
  .projects-archive__latest {
    display: none;
  }
  /* One card per chip in the same cell; the others keep their space (hidden, not removed), so the box is always the
     tallest card's height and a chip never moves the chips under it */
  .projects-archive__latest-item {
    grid-area: 1 / 1;
    display: grid;
    border-radius: var(--wp--custom--radius--lg);
    transition: box-shadow 200ms var(--wp--custom--motion--easing);
  }
  .projects-archive__latest-item.is-off {
    visibility: hidden;
  }
  .projects-archive__latest-item.is-hover {
    box-shadow: 0 0 0 2px var(--wp--custom--color--border--strong);
  }
  .projects-archive__latest-item.is-active {
    box-shadow: 0 0 0 2px var(--wp--custom--color--border--accent);
  }

  /* ── Cards ────────────────────────────────────────────── */
  .projects-archive__results {
    display: flex;
    flex-direction: column;
    gap: var(--wp--custom--stack--lg);
  }
  .projects-archive__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--wp--custom--grid--gutter);
  }
  .projects-archive__cell {
    display: grid;
    border-radius: var(--wp--custom--radius--lg);
    transition: box-shadow 200ms var(--wp--custom--motion--easing);
  }
  .projects-archive__cell[hidden] {
    display: none;
  }
  /* The map lights its cards: a pin hovered, or its place open on the map */
  .projects-archive__cell.is-hover {
    box-shadow: 0 0 0 2px var(--wp--custom--color--border--strong);
  }
  .projects-archive__cell.is-active {
    box-shadow: 0 0 0 2px var(--wp--custom--color--border--accent);
  }
  .projects-archive__more {
    display: flex;
    justify-content: center;
  }
  .projects-archive__more:has([hidden]) {
    display: none;
  }

  @media (max-width: 1199px) {
    .projects-archive__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .projects-archive__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Phones, as Live operations: the chips scroll sideways and fade into the zoom pill, pinned at the end */
  @media (max-width: 599px) {
    .projects-archive__toolbar {
      gap: var(--wp--preset--spacing--8);
    }
    .projects-archive__chips {
      flex: 1;
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline-start: calc(-1 * var(--wp--preset--spacing--16));
      padding-inline: var(--wp--preset--spacing--16) var(--wp--preset--spacing--24);
      scrollbar-width: none;
      mask-image: linear-gradient(to right, black calc(100% - var(--wp--preset--spacing--32)), transparent);
    }
    .projects-archive__chips::-webkit-scrollbar {
      display: none;
    }
    .projects-archive__chips > * {
      flex: none;
    }
    .projects-archive__map {
