---

<BaseLayout title="Reach Subsea · Transforming the way we work in the ocean" motion>
  <Header overlay />
  <main id="main">
    <PageHero
      style="video"
      titleStyle="display"
      eyebrow="Subsea · Survey · Monitoring · Remote Operations"
      title="Transforming the way we work in the ocean"
      lead="Subsea survey, inspection, monitoring and intervention services worldwide, through crewed vessels, remote operations and uncrewed surface vessels."
      video={{ src: `${import.meta.env.BASE_URL}video/promo.mp4`, poster: `${import.meta.env.BASE_URL}images/promo-poster.jpg`, loopStart: 1, loopEnd: 54.5 }}
      actions={[
        { label: 'Explore our services', url: '/services/', action: 'page' },
        { label: 'Beyond the surface', url: '/company/', action: 'page' },
      ]}
    />

    {/* Feature style leading on 500+ (chosen 17 Sep 2026 over the 4-across panel) */}
    <StatsBand
      style="feature"
      featureKey="people"
      background="tint"
      animate
      stats={pickFigures(['people', 'established', 'fleet', 'countries', 'rov-systems'])}
    />

    {/* Live operations (17 Sep 2026, Q56): straight after the figures, "9 countries" → where we are today.
        SAMPLE DATA until the Current operations feed exists (docs/07-live-operations.md). */}
    <LiveOperations feed={liveOperations} />

    <CardGrid
      sectionHeader={{
        title: 'Ocean operations, reimagined',
        action: { label: 'All services', url: '/services/' },
      }}
      layout="bento"
      cards={bentoCards}
    />

    <CardGrid
      sectionHeader={{ title: 'Four services, one partner' }}
      layout="4-columns"
      media="icon"
      surface="tint"
      cards={serviceCards}
    />

    <Embed
      type="3d-world"
      state="poster"
      title="See our operations in 3D"
      text="Fly through four working zones, from the vessel on the surface to the ROV on the seabed. An 18 MB scene, best on a tablet or computer."
      worldUrl={worldSceneUrl}
      fullScreenUrl={worldPath}
      poster={{ src: `${import.meta.env.BASE_URL}images/3d-world-poster.jpg`, alt: 'An ROV surveying a pipeline on the seabed in the Reach Subsea 3D World' }}
      posterVideo={{ src: `${import.meta.env.BASE_URL}video/promo.mp4`, start: 15, end: 45 }}
      showZones
    />

    <FeedGrid
      sectionHeader={{
        title: 'Reach Newsroom',
        action: { label: 'See all news & reports', url: '/newsroom/' },
      }}
      source="latest"
      layout="editorial"
      showLoadMore={false}
      items={newsroomItems}
    />

    <SocialFeed title="Latest news from LinkedIn" followUrl="https://www.linkedin.com/company/reach-subsea/" posts={linkedInPosts} />

    <Accordion
      sectionHeader={{
        title: 'Frequently asked questions',
        intro: 'Answers to what we are asked most, plus every other topic, organised by subject.',
        action: { label: 'See all FAQs', url: '/faq/' },
      }}
      layout="split"
      source="faq"
      background="tint"
      items={faqItems}
    />

    <CtaBand
      style="panel"
      background="tint"
      title="Would you like to know more?"
      text="Reach out to us today."
      actions={[{ label: 'Contact us', url: '/contact/', action: 'page' }]}
    />
  </main>
  <Footer />
</BaseLayout>
