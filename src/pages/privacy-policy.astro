---
// Privacy & Cookie Policy (9 Oct 2026, Q157), the legal page linked from the footer's and the menu's legal row. It
// keeps the live URL (/privacy-policy/), as the Transparency Act keeps /transparency-act/, outside any section: no
// subnav. The live policy in its own wording (src/data/legal.ts).
// Text hero on navy, as the Transparency Act (Q57). The policy is core content in the article style (base.css .article,
// as a news story): headings above their text, running text at the prose measure (720). The column starts on the
// container's left edge, under the hero title, not centred. (Headings beside the text on the grid were tried first:
// the eye had to cross a 400 px gap for every section, Ross, 9 Oct 2026.) The live "Contact us" closes it as the CTA panel.
// WordPress: core Heading + Paragraph blocks (docs/05 §0 Budget), the template's content column left-justified.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../blocks/PageHero.astro';
import BlockSection from '../components/BlockSection.astro';
import CtaBand from '../blocks/CtaBand.astro';
import { privacyPolicy as p } from '../data/legal';

const base = import.meta.env.BASE_URL;
const id = (title: string) => `privacy-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<BaseLayout title={p.title} motion>
  <Header overlay />
  <main id="main">
    <PageHero
      style="text"
      background="navy"
      breadcrumb={[{ label: 'Home', href: base }, { label: p.title }]}
      eyebrow={p.updated}
      title={p.title}
      lead={p.lead}
    />

    <BlockSection slug="legal" root="legal" background="white" label={p.title}>
      <div class="prose article">
        {
          p.sections.map((s) => (
            <Fragment>
              <h2 id={id(s.title)}>{s.title}</h2>
              <Fragment set:html={s.body} />
            </Fragment>
          ))
        }
      </div>
    </BlockSection>

    <CtaBand
      anchor="contact"
      style="panel"
      background="white"
      title={p.contactTitle}
      text={p.contactText}
      actions={[{ label: 'Contact us', url: '/contact/', action: 'page' }]}
    />
  </main>
  <Footer />
</BaseLayout>
