---
// Services › Survey (5 Oct 2026): the third service single, on the Subsea / Monitoring template. Content:
// client PDF p10 ("04 — Services — Survey Services"), the dev site's survey projects; name, capabilities,
// industries, lifecycle row and projects all come from src/data. Built for an operator, developer or asset
// owner planning offshore work who needs the seabed mapped and positioned first: what we do and who for ·
// when in the asset's life · the six capabilities · what we do it with (survey vessels, USVs, ROVs) · proof ·
// FAQ · contact. PDF p31: no third-party brand names in our own copy; video / spec links only when a real
// file exists. The PDF's stat strip (500+ / 9 / 2 modes) moves into the fleet bento.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/header/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../blocks/PageHero.astro';
import SectionSubnav from '../../../blocks/SectionSubnav.astro';
import SplitMedia from '../../../blocks/SplitMedia.astro';
import CardGrid from '../../../blocks/CardGrid.astro';
import CardBento from '../../../blocks/CardBento.astro';
import Lifecycle from '../../../blocks/Lifecycle.astro';
import FeedGrid from '../../../blocks/FeedGrid.astro';
import Accordion from '../../../blocks/Accordion.astro';
import CtaBand from '../../../blocks/CtaBand.astro';
import { worldPath } from '../../../data/world';
import { pickFigures } from '../../../data/key-figures';
import { projectsFor } from '../../../data/projects';
import { cardPresets } from '../../../data/card-presets';
import { navSections } from '../../../data/navigation';
import { serviceLines, lifecyclePhases, lifecycleRows, lifecycleTasks } from '../../../data/services';
import type { CardField } from '../../../lib/types';
import { faqsFor, faqHubHref } from '../../../data/faqs';

const base = import.meta.env.BASE_URL;
const line = serviceLines.find((l) => l.id === 'survey')!;
const services = navSections.find((s) => s.id === 'services')!;

const industryCards: CardField[] = (line.industries ?? []).map((ind) => ({
  media: 'icon',
  title: ind.label,
  pictogram: ind.pictogram,
}));
// The PDF's six capability boxes, titles verbatim, no video / spec links until real files exist
const capabilityCards: CardField[] = (line.capabilities ?? []).map((cap) => ({
  media: 'none',
  title: cap.title,
  description: cap.summary,
  scope: cap.scope,
  action: cap.link && { ...cap.link, action: 'page', context: cap.title },
}));

// What we survey with: a crewed survey vessel, the survey ROV, the uncrewed vessels (the PDF's "2 modes")
// and the two PDF figures. 12 columns as on Subsea. In WP: an Assets query picked on the Service.
const [people, countries] = pickFigures(['people', 'countries']);
const fleetCards: CardField[] = [
  {
    media: 'image-bg',
    size: 'featured',
    image: { src: `${base}images/vessel-northern-maria.jpg`, alt: 'Northern Maria, a red survey vessel, under way on calm water', focalPoint: { x: 0.6, y: 0.5 } },
    eyebrow: 'Survey & IMR vessel',
    title: 'Northern Maria',
    description: 'DP2 survey and ROV vessel with hull-mounted multibeam and sub-bottom profiler, plus towed sonar and UXO equipment.',
    action: { label: 'View vessel', url: '/assets/northern-maria/', context: 'Northern Maria' },
  },
  { media: 'stat', surface: 'navy', statValue: people.value, title: people.label },
  {
    media: 'image-bg',
    image: { src: `${base}images/rov-surveyor-launch.jpg`, alt: 'A Surveyor Interceptor survey ROV launched from a vessel side', focalPoint: { x: 0.5, y: 0.5 } },
    eyebrow: 'Survey ROV',
    title: 'Surveyor Interceptor',
    description: 'A sensor carrier for fast, stable survey.',
    action: { label: 'View ROV', url: '/assets/surveyor-interceptor/', context: 'Surveyor Interceptor' },
  },
  { media: 'stat', surface: 'white', statValue: countries.value, title: countries.label },
  {
    media: 'image-bg',
    image: { src: `${base}images/usv-drix-wind.jpg`, alt: 'A red DriX uncrewed survey vessel passing an offshore wind turbine', focalPoint: { x: 0.55, y: 0.55 } },
    eyebrow: 'Autonomous survey vehicle',
    title: 'DriX Orca 1 & 2',
    description: 'Hydrographic survey in shallow water, with multibeam.',
    action: { label: 'View vehicles', url: '/assets/drix-orca-1-and-orca-2/', context: 'DriX Orca 1 & 2' },
  },
  {
    media: 'image-bg',
    image: { src: `${base}images/reach-remote-side.jpg`, alt: 'Reach Remote 1 uncrewed surface vessel under way', focalPoint: { x: 0.5, y: 0.6 } },
    eyebrow: 'Uncrewed vessel',
    title: 'Reach Remote 1 & 2',
    description: 'The same survey package as our crewed vessels, run from shore.',
    action: { label: 'Meet Reach Remote', url: '/assets/reach-remote/' },
  },
];

const projectItems: CardField[] = projectsFor(line.id, 3).map((p) =>
  cardPresets.project({
    media: 'image-top',
    surface: 'white',
    image: p.image,
    eyebrow: p.year ? `${p.work} · ${p.year}` : p.work,
    title: p.title,
    description: undefined,
    meta: [{ icon: 'map-pin', text: p.field }],
    action: { label: 'Read project', url: p.url, context: p.title },
  }),
);
const faqItems = faqsFor('survey');
const subnavItems = [
  { label: 'Overview', href: services.href },
  ...services.links.map((l) => ({ label: l.label, href: l.href })),
];
---

<BaseLayout title={`${line.title} · Reach Subsea`} motion>
  <Header current="services" overlay />
  <main id="main">
    <PageHero
      style="photo"
      animate
      breadcrumb={[{ label: 'Home', href: base }, { label: 'Services', href: services.href }, { label: line.short }]}
      title="Seabed data for confident offshore decisions"
      lead="Seabed surveys, offshore cable support, marine construction survey and rig and mooring positioning."
      image={{ src: `${base}images/hero-survey.jpg`, alt: '', focalPoint: { x: 1, y: 0.5 } }}
      actions={[
        { label: 'Discuss your project', url: '#contact', action: 'anchor' },
        { label: 'See survey in 3D', url: worldPath, action: 'external', type: 'link' },
      ]}
    />

    <SectionSubnav source="section-pages" label="Services" items={subnavItems} current={line.href} />

    {/* How we deliver (PDF p10): the client's two paragraphs, tightened to one */}
    <SplitMedia
      anchor="how-we-deliver"
      background="white"
      pictogram={line.pictogram}
      title="Crewed and uncrewed, one clear picture of the seabed"
      body={`<p>Our survey work spans four areas: seabed surveys, offshore cable, marine construction and rig and mooring support, each combining experienced survey crews with modern acquisition and processing systems.</p><p>We deploy crewed DP survey vessels and uncrewed surface vessels, both carrying ROVs and survey spreads, to acquire multibeam, sidescan sonar, sub-bottom profiler and positioning data. Clients get a verified picture of the seabed and structures before, during and after construction.</p>`}
      actions={[{ label: 'Survey and monitoring equipment', url: '/assets/survey-monitoring-equipment/', action: 'page' }]}
      image={{ src: `${base}images/vessel-go-electra.jpg`, alt: 'Go Electra, a blue Reach Subsea survey vessel, alongside a quay', focalPoint: { x: 0.4, y: 0.55 } }}
    />

    <CardGrid anchor="industries" layout="strip" eyebrow="Industries we serve" background="white" spacing="sm" cards={industryCards} />

    {/* The Survey row of the overview's lifecycle, zoomed in. Placeholder tasks until Reach confirms */}
    <Lifecycle
      anchor="lifecycle"
      background="navy"
      layout="focus"
      focus={line.id}
      tasks={lifecycleTasks[line.id]}
      sectionHeader={{ title: 'From first survey to as-left' }}
      phases={lifecyclePhases}
      rows={lifecycleRows}
      services={serviceLines}
    />

    <CardGrid
      anchor="what-we-do"
      background="white"
      sectionHeader={{ eyebrow: 'Capabilities', title: 'Seabed to surface, mapped and positioned' }}
      layout="3-columns"
      media="none"
      surface="tint"
      cards={capabilityCards}
    />

    <CardBento
      anchor="fleet"
      pattern="lead-tall-wide"
      background="tint"
      sectionHeader={{
        title: 'Vessels and vehicles for survey',
        action: { label: 'All assets', url: '/assets/' },
      }}
      cards={fleetCards}
    />

    <FeedGrid
      anchor="projects"
      source="projects"
      scope={{ term: line.id }}
      columns={3}
      background="white"
      sectionHeader={{
        title: 'Survey in the field',
        action: { label: 'All projects', url: '/projects/' },
      }}
      items={projectItems}
      showLoadMore={false}
    />

    <Accordion
      sectionHeader={{
        title: 'Frequently asked questions',
        intro: 'About our seabed, cable and positioning survey work.',
        action: { label: 'See all FAQs', url: faqHubHref('survey') },
      }}
      layout="split"
      source="faq"
      topic="survey"
      background="tint"
      items={faqItems}
    />

    {/* No named Survey contact on the dev site or in the PDF (department email only, PDF p31) */}
    <CtaBand
      anchor="contact"
      style="panel"
      background="tint"
      title="Planning survey work?"
      text="Tell us about the site, route or structure, and we will propose the vessel, sensors and team."
      actions={[{ label: 'Contact us', url: '/contact/', action: 'page' }]}
      showContact={Boolean(line.contact)}
      contact={line.contact && { label: line.title, ...line.contact }}
    />
  </main>
  <Footer />
</BaseLayout>
