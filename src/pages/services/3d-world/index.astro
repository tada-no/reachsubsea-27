---
// Services › Explore 3D World (6 Oct 2026): the landing page for the interactive 3D World, from the client screens
// PDF p28–29 ("11 — Services — Explore 3D World") and the Design Reference p13 ("landing page introducing the real
// interactive 3D exploration tool"). The scene itself is a separate app with its content from WordPress (Q94); this
// page explains it, and its Launch button and zone cards open it on the in-site /3d-world/ page, under the header
// (Q96). Kept from the PDF: hero with Launch, How it works, the four zones, FAQ, CTA. Changed: the three cards over
// the hero's edge (no overlaps, docs/06 §2) become How it works below it, with "Best viewed on" under its intro and
// the steps as three cards, each with a screenshot that shows it (Q98–Q102). Cut: the 500+ / 9 / 2 modes stats band
// (repeats Home and Services) and Related services (the Services subnav links the three lines). Zone names, order
// and assets follow the world build, not the PDF's draft (src/data/world.ts).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/header/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../blocks/PageHero.astro';
import SectionSubnav from '../../../blocks/SectionSubnav.astro';
import CardGrid from '../../../blocks/CardGrid.astro';
import Accordion from '../../../blocks/Accordion.astro';
import CtaBand from '../../../blocks/CtaBand.astro';
import { worldPath, worldPagePath, worldZones, worldZoneUrl } from '../../../data/world';
import { navSections } from '../../../data/navigation';
import type { CardField } from '../../../lib/types';

const base = import.meta.env.BASE_URL;
const services = navSections.find((s) => s.id === 'services')!;

// Not one of the section's pills (Q79): the subnav shows the section with nothing current
const subnavItems = [
  { label: 'Overview', href: services.href },
  ...services.links.map((l) => ({ label: l.label, href: l.href })),
];

// How it works (Q102): one card per thing you do, each image showing it in the world (screenshots from reach-world
// review/shots and Ross, 6 Oct 2026; clean renders asked of the 3D World chat, docs/prompts/3d-world-embed.md §8)
const howItWorks: CardField[] = [
  {
    media: 'image-top',
    surface: 'white',
    title: 'Fly between four zones',
    description: 'Use the arrows to step between subsea infrastructure, an oil field, offshore wind and production monitoring, and drag to look around. Or jump straight to a zone from the cards below.',
    image: { src: `${base}images/world-step-zones.jpg`, alt: 'The 3D World at Subsea Infrastructure: the zone name between two arrows, pins on the vessel and ROVs, and the welcome panel listing the zones' },
  },
  {
    media: 'image-top',
    surface: 'white',
    title: 'Click any vessel or ROV',
    description: 'Pins mark the vessels, ROVs and structures at work. Click one to open a panel on what it is and the job it’s doing, or watch a ZeeROV launch from an uncrewed vessel.',
    image: { src: `${base}images/world-step-panel.jpg`, alt: 'Reach Remote 1 selected in the 3D World, with its panel open beside it' },
  },
  {
    media: 'image-top',
    surface: 'white',
    title: 'Take the controls',
    description: 'Press Pilot to fly an ROV yourself with the keyboard, with live depth, heading and speed. Then try a survey line: steer through the hoops along the pipeline.',
    image: { src: `${base}images/world-step-pilot.jpg`, alt: 'Pilot mode in the 3D World: an ROV over the seabed, the keyboard controls top left and its depth, heading and speed above' },
  },
];

const zoneCards: CardField[] = worldZones.map((z) => ({
  media: 'image-top',
  surface: 'white',
  image: { src: `${base}${z.image.src}`, alt: z.image.alt },
  eyebrow: `Zone ${z.zone}`,
  title: z.label,
  description: z.blurb,
  scope: z.assets,
  action: { label: 'Fly to this zone', url: worldZoneUrl(z.zone, worldPath), action: 'page', context: z.label },
}));

// The PDF's three FAQs (p29), FAQ post type, topic 3D World
const faqItems = [
  {
    slug: 'what-is-explore-3d-world',
    question: 'What is Explore 3D World?',
    answer:
      'An interactive 3D environment where you can fly between four working zones and click on vessels, ROVs, platforms and structures to learn more about each one.',
    open: true,
  },
  {
    slug: 'install-explore-3d-world',
    question: 'Do I need to install anything to use Explore 3D World?',
    answer:
      'No. It runs in your web browser. It loads an 18 MB scene, so it works best on a computer or tablet with a current version of Chrome, Edge, Firefox or Safari. On a phone it may run slowly.',
  },
  {
    slug: 'what-can-i-click-3d-world',
    question: 'What can I click on inside the 3D world?',
    answer:
      'The assets in each zone: vessels, ROVs, platforms and subsea structures, each with its own information panel.',
  },
];
---

<BaseLayout title="Explore 3D World · Reach Subsea" motion>
  <Header current="services" overlay />
  <main id="main">
    <PageHero
      style="photo"
      animate
      breadcrumb={[{ label: 'Home', href: base }, { label: 'Services', href: services.href }, { label: 'Explore 3D World' }]}
      title="Explore Reach in 3D"
      lead="Fly between four working zones and click any vessel, ROV or structure to see what it does."
      image={{ src: `${base}images/world-hero.jpg`, alt: '', focalPoint: { x: 0.6, y: 0.5 } }}
      actions={[{ label: 'Launch 3D World', url: worldPath }]}
    />

    <SectionSubnav source="section-pages" label="Services" items={subnavItems} current={worldPagePath} />

    {/* PDF "How it works" and "Best viewed on" cards: the section header carries the intro and the two notes,
        then the three things you do in the world as cards, each with a screenshot that shows it (Q102) */}
    <CardGrid
      anchor="how-it-works"
      background="white"
      sectionHeader={{
        title: 'How it works',
        intro: 'Four working sites, each a different operation carried out by a different mix of vessels and ROVs: our subsea, survey and monitoring work in one place.',
        meta: [
          { icon: 'device-desktop', text: 'Best on a computer or tablet' },
          { icon: 'browser', text: 'Runs in your browser' },
        ],
      }}
      layout="3-columns"
      media="image-top"
      surface="white"
      cards={howItWorks}
    />

    <CardGrid
      anchor="zones"
      background="tint"
      sectionHeader={{
        title: 'Different operations, different vessels and ROVs',
        intro: 'Each zone is set on a different piece of infrastructure. What sets them apart is the operation, and the vessels and ROVs that carry it out.',
      }}
      layout="2-columns"
      media="image-top"
      surface="white"
      cards={zoneCards}
    />

    <Accordion
      sectionHeader={{
        title: 'Frequently asked questions',
        intro: 'About our interactive 3D operations environment.',
        action: { label: 'See all FAQs', url: '/faq/' },
      }}
      layout="split"
      source="faq"
      topic="3d-world"
      background="white"
      items={faqItems}
    />

    {/* PDF p29 CTA wording */}
    <CtaBand
      anchor="contact"
      style="panel"
      background="tint"
      title="Would you like to know more?"
      text="Reach out to us today."
      actions={[{ label: 'Contact us', url: '/contact/', action: 'page' }]}
    />
  </main>
  <Footer />
</BaseLayout>
