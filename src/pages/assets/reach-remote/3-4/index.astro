---
// Assets › Reach Remote › Reach Remote 3 & 4 (11 Oct 2026, Q165, Q167 build step 6, Q169; client screens PDF p26–27,
// design reference p12). A short status page on the build of the next two vessels and their EU funding, updated
// at each reporting date. Rigid by design (Q165): the facts the grant's communication duties ask for, in order.
// Hero Text (navy, the "Funded by the European Union" emblem in the stack, so it is visible on landing without
// scrolling: Q169) · project facts (Split media Spec table) · spend to date (Share bars, one bar: the PDF's "Overall
// completion" panel, as money invested, since no build percentage exists) · build timeline · background (grant, investment,
// order) · the Innovation Fund's project summary (Read more) · coordinator (Q184, 11 Nov 2026) · EU funding and the
// EU's disclaimer · CTA. As the PDF: no subnav, no FAQ.
// Left out of the PDF's plan: the template banner and dashed placeholders, the disclaimer card over the hero's edge
// (nothing overlaps the hero), the stage statuses (hull, systems, sea trials, delivery: no dated stages yet, client
// checklist), and the "Why this project matters" and "Reporting & transparency" cards, folded into the facts and the
// funding text so each thing is said once. Figures: src/data/reach-remote-3-4.ts.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/header/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PageHero from '../../../../blocks/PageHero.astro';
import SplitMedia from '../../../../blocks/SplitMedia.astro';
import ShareBars from '../../../../blocks/ShareBars.astro';
import Timeline from '../../../../blocks/Timeline.astro';
import CtaBand from '../../../../blocks/CtaBand.astro';
import { navSections } from '../../../../data/navigation';
import { reportingDate, projectFacts, spend, spendShare, milestones, background, projectSummary, coordinator } from '../../../../data/reach-remote-3-4';

const base = import.meta.env.BASE_URL;
const section = navSections.find((s) => s.id === 'assets')!;
const parent = section.links.find((l) => l.href === '/assets/reach-remote/')!;
const page = parent.children!.find((l) => l.href === '/assets/reach-remote/3-4/')!;
const nok = (m: number) => `NOK ${m.toLocaleString('en-GB', { minimumFractionDigits: 1 })} million`;
---

<BaseLayout title={`${page.label} · Reach Subsea`} motion>
  <Header current="assets" overlay />
  <main id="main">
    <PageHero
      style="text"
      background="navy"
      breadcrumb={[
        { label: 'Home', href: base },
        { label: section.label, href: section.href },
        { label: parent.label, href: parent.href },
        { label: page.label },
      ]}
      badge={{ label: 'In build', tone: 'accent' }}
      title="Building Reach Remote 3 & 4"
      lead="Two more uncrewed vessels, built by Kongsberg Maritime with EU Innovation Fund support. Expected in operation in 2027."
      fundingLogo={{ src: `${base}images/eu-funded-innovation-fund-white.png`, alt: 'Funded by the European Union: Emissions Trading System, Innovation Fund', width: 286, height: 48 }}
    />

    <SplitMedia
      anchor="project"
      background="white"
      media="spec-table"
      eyebrow="The project"
      title="Two more of a proven design"
      body={`<p>Reach Remote 3 and 4 follow Reach Remote 1 and 2, with targeted changes from their qualification programme and time at sea. With nobody on board, they keep people out of harm's way offshore and use far less fuel than a crewed vessel.</p>`}
      actions={[{ label: 'About Reach Remote', url: parent.href, action: 'page' }]}
      specs={projectFacts}
    />

    <ShareBars
      anchor="progress"
      background="tint"
      sectionHeader={{
        eyebrow: 'Build progress',
        title: `${nok(spend.invested)} invested by ${reportingDate}`,
        intro: `Of about ${nok(spend.invested + spend.toComplete)} for the two vessels, with ${nok(spend.toComplete)} to go.`,
      }}
      parts={['Invested', 'To complete']}
      bars={[{ label: reportingDate, value: spendShare }]}
    />

    <Timeline
      anchor="milestones"
      background="tint"
      sectionHeader={{ eyebrow: 'Milestones', title: 'The build so far' }}
      milestones={milestones}
    />

    {/* Background, Project summary and the coordinator (11 Nov 2026, Q184): three Beside sections, the same shape
        each, so the EU texts read as one run. The summary is the Innovation Fund's own wording, so it is kept whole,
        its first paragraph shown and the rest behind Read more. The coordinator joins the summary on the same tint. */}
    <SplitMedia
      anchor="background"
      layout="beside"
      background="white"
      eyebrow="Background"
      title="From EU grant to vessel order"
      body={background}
    />

    <SplitMedia
      anchor="project-summary"
      layout="beside"
      background="tint"
      eyebrow="EU Innovation Fund"
      title="Project summary"
      body={projectSummary.lead}
      more={projectSummary.more}
      moreLabel="Read the full summary"
    />

    <SplitMedia
      anchor="coordinator"
      layout="beside"
      background="tint"
      joined
      headingLevel="h3"
      title="Coordinator’s contact details"
      body={`<p><strong>${coordinator.name}</strong>, ${coordinator.country}<br /><a href="mailto:${coordinator.email}">${coordinator.email}</a></p>`}
    />

    <SplitMedia
      anchor="eu-funding"
      layout="beside"
      background="white"
      eyebrow="EU funding"
      title="Funded by the European Union"
      body={`<p>Reach Remote 3 and 4 are funded by the EU Innovation Fund, which backs clean technologies on their way to market. As the grant asks, we report the project's progress here at each reporting date, and in our <a href="/investors/reports-presentations/">quarterly reports</a>.</p><p class="text-small">Views and opinions expressed are those of Reach Subsea only and do not necessarily reflect those of the European Union or the European Climate, Infrastructure and Environment Executive Agency (CINEA). Neither the European Union nor the granting authority can be held responsible for them.</p>`}
    />

    <CtaBand
      anchor="contact"
      style="panel"
      background="white"
      title="Questions about this project?"
      text="Get in touch with our team."
      actions={[{ label: 'Contact us', url: '/contact/', action: 'page' }]}
    />
  </main>
  <Footer />
</BaseLayout>
