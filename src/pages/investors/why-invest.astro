---
// Investors › Why invest (18 Sep 2026). Content: client PDF p40–41 ("Why invest in Reach Subsea"),
// dividend policy and IR contact from the live site. Decisions Q57–Q60 in docs/00-questions.md:
// photo hero (no gradient), breadcrumb pinned to the top of the hero, no eyebrow, Investors subnav
// under the hero; each reason carries its own proof figure (the PDF's "Proof points" is cut); revenue
// mix bar; next report date; live OMS share graph; named IR contact.
// Wireframe: https://claude.ai/artifact/7EUkMriFpTJyV6AdQ99sHr
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/header/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../blocks/PageHero.astro';
import SectionSubnav from '../../blocks/SectionSubnav.astro';
import StatsBand from '../../blocks/StatsBand.astro';
import SplitMedia from '../../blocks/SplitMedia.astro';
import Accordion from '../../blocks/Accordion.astro';
import CtaBand from '../../blocks/CtaBand.astro';
import { navSections } from '../../data/navigation';
import { latestResults as r } from '../../data/investor-results';

const base = import.meta.env.BASE_URL;
const investors = navSections.find((s) => s.id === 'investors')!;
const subnavItems = [
  { label: 'Overview', href: investors.href },
  ...investors.links.map((l) => ({ label: l.label, href: l.href })),
];
const pick = (key: string) => [...r.headline, ...r.secondary].find((s) => s.key === key)!;
const renewables = r.revenueMix[1];

// Each reason carries a figure the Results band above doesn't already show (review round 3).
const reasons = [
  {
    title: 'Operational excellence, record results',
    text: `Revenue and EBIT both grew sharply in ${r.period}, and net profit reached NOK ${pick('net-profit').value}. Higher activity is turning into utilisation and earnings.`,
    figure: '+84%',
    caption: `Net profit growth, ${r.period} year on year.`,
  },
  {
    title: 'Reach Remote is scaling commercially',
    text: "Uncrewed operations delivered every quarter, DNV's world-first AROS class notation, and remote-sailing permits in place in Norway, Australia and the UK.",
    figure: '750+',
    caption: 'Uncrewed operational days delivered per quarter.',
  },
  {
    title: 'Revenue diversifying beyond oil & gas',
    text: `Renewables and other segments now make up ${renewables.value}% of revenue. Offshore wind and emerging ocean industries are growing their share of demand.`,
    caption: 'Revenue by segment',
    period: r.period,
    split: r.revenueMix,
  },
  {
    title: 'A fleet built for growth',
    text: `A stronger balance sheet, with NOK ${pick('cash').value} in cash, supports continued fleet investment: the Viking Vigor newbuild due in H2 2026 and the Reach Remote 3 & 4 build.`,
    figure: '1,172.5m',
    caption: 'NOK in equity at quarter end.',
  },
];

const faqItems = [
  {
    slug: 'why-invest-in-reach-subsea',
    question: 'Why should I invest in Reach Subsea?',
    answer: `Strong recent growth (${r.period} revenue +44% and EBIT +111% year on year), a NOK 1,850m order backlog and a NOK 9bn tender pipeline, together with a differentiated uncrewed operations platform in Reach Remote and Reach Horizon.`,
    open: true,
  },
  {
    slug: 'reach-subsea-growth-strategy',
    question: "What is Reach Subsea's growth strategy?",
    answer:
      'Scaling Reach Remote and Reach Horizon commercially, including a carve-out into a dedicated technology company, alongside continued growth in the core chartered-vessel business.',
  },
  {
    slug: 'reach-subsea-revenue-growth',
    question: 'How has revenue grown recently?',
    answer: `Revenue reached NOK 988.1m in ${r.period}, up 44% year on year, with EBIT up 111% and net profit up 84% over the same period.`,
  },
];
---

<BaseLayout title="Why invest in Reach Subsea · Investors" motion>
  <Header current="investors" overlay />
  <main id="main">
    <PageHero
      style="photo"
      animate
      breadcrumb={[
        { label: 'Home', href: base },
        { label: 'Investors', href: investors.href },
        { label: 'Why invest' },
      ]}
      title="Why invest in Reach Subsea"
      lead="A technology-driven subsea partner with record results, a growing uncrewed operations platform and a fleet built for the next phase of offshore energy, across oil & gas and renewables."
      image={{ src: `${base}images/windfarm-turbine-install.jpg`, alt: '', focalPoint: { x: 0.6, y: 0.66 } }}
    />

    <SectionSubnav source="section-pages" label="Investors" items={subnavItems} current="/investors/why-invest/" />

    <StatsBand
      style="results"
      animate
      sectionHeader={{ title: `${r.period} results` }}
      published={r.published}
      currency={r.currency}
      stats={r.headline}
      secondary={r.secondary}
      documents={[
        { ...r.report, action: 'file', meta: `Published ${new Date(`${r.published}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}` },
        { ...r.annualReport, action: 'file' },
      ]}
      next={r.next}
    />

    <SplitMedia
      media="figures"
      layout="cards"
      background="white"
      spacing="lg"
      title="Four reasons we believe in Reach Subsea's next chapter"
      figures={reasons}
    />

    <SplitMedia
      media="embed"
      position="start"
      background="tint"
      eyebrow="Capital allocation"
      title="A dividend of around 50% of adjusted net profit"
      body="<p>Balanced against continued investment in fleet growth and the Reach Remote programme. Adjusted net profit is reported net profit, adjusted for items the Board regards as transitory.</p>"
      actions={[{ label: 'Dividend & IR policy', url: '/investors/governance-meetings/' }]}
      embed={{
        src: 'https://ir.oms.no/component/standardPage?token=reach_std&lang=en',
        title: 'Reach Subsea share price, live from Euronext',
        height: 2212,
        crop: 640,
        source: 'REACH · Oslo Stock Exchange (Euronext). Live data: OMS',
        link: { label: 'Full share information', url: '/investors/share-information/' },
      }}
    />

    <SplitMedia
      media="numbered-list"
      layout="stacked"
      background="white"
      title="Three priorities driving the next phase"
      items={[
        {
          title: 'Scale Reach Remote and Reach Horizon commercially',
          text: 'Grow uncrewed operational days while carving Reach Remote out into a dedicated technology company, with Reach Horizon as a standalone software product.',
        },
        {
          title: 'Diversify revenue across the energy transition',
          text: `Build on renewables and other segments, already ${renewables.value}% of revenue, alongside the established oil & gas base.`,
        },
        {
          title: 'Grow the fleet with a disciplined balance sheet',
          text: 'Add capacity such as the Viking Vigor newbuild (H2 2026) while managing the balance sheet. The Viking Reach divestment unlocks over NOK 200m in liquidity.',
        },
      ]}
    />

    <Accordion
      sectionHeader={{
        title: 'Frequently asked questions',
        intro: 'About the investment case for Reach Subsea.',
        action: { label: 'See all FAQs', url: '/faq/' },
      }}
      layout="split"
      source="faq"
      topic="investors"
      background="tint"
      items={faqItems}
    />

    <CtaBand
      style="panel"
      background="tint"
      title="Go deeper into the numbers"
      text="Full financial reports, presentations and share information."
      actions={[
        { label: 'Reports & presentations', url: '/investors/reports-presentations/', action: 'page' },
        { label: 'Share information', url: '/investors/share-information/', action: 'page' },
      ]}
      showContact
      contact={{ label: 'Investor relations', name: 'Arne Joa', role: 'Chief Financial Officer', phone: '+47 474 51 344', email: 'arne.joa@reachsubsea.com' }}
    />
  </main>
  <Footer />
</BaseLayout>
