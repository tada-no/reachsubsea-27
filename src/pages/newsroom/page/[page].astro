---
// Newsroom pages 2… (/newsroom/page/2/, as WordPress pages the posts index).
import NewsArchive from '../../../templates/NewsArchive.astro';
import { archivePages } from '../../../data/news';

export function getStaticPaths() {
  return archivePages()
    .slice(1)
    .map((p) => ({ params: { page: String(p.page) } }));
}

const page = Number(Astro.params.page);
---

<NewsArchive page={page} />
