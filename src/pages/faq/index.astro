---
// FAQ (7 Oct 2026, Q126). Sources: client PDF Design Reference p30 / screens p61–62 ("28 — FAQ": hero, topic jump
// chips, one group per topic, "Still have a question?" CTA) for the page; the questions are every FAQ on the site,
// from the FAQ post type (src/data/faqs.ts), each listed once, so every page's "See all FAQs" lands on a group that
// holds its questions. Not used from the PDF: its four drafted questions per group (the pages bring their own; new
// ones come with the pages still to build, Ross) and its "General" chip shown selected (the subnav marks the group in
// view instead).
// 1. Hero Text on navy (breadcrumb Home › FAQ, PDF title, lead shortened: the CTA closes with "reach out")
// 2. Section subnav In-page: the six groups, in the main navigation's order; below 1100 only (the rail has them)
// 3. FAQ index (8 Oct 2026, Q141; was Accordion Split × 6, white and tint in turn): every group on one ground beside
//    a sticky rail (search, count, topics), anchored by group, one FAQPage JSON-LD for the page
// 4. CTA Panel (tint): the PDF's wording
// Redirects: dev /faq/ and /faqs/ → here (dev /careers/opportunities/careers-faq/ → /faq/#careers).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/header/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../blocks/PageHero.astro';
import SectionSubnav from '../../blocks/SectionSubnav.astro';
import FaqIndex from '../../blocks/FaqIndex.astro';
import CtaBand from '../../blocks/CtaBand.astro';
import { faqGroupsForHub } from '../../data/faqs';
import { faqPageSchema } from '../../lib/faq-schema';

const base = import.meta.env.BASE_URL;
const groups = faqGroupsForHub().filter((g) => g.items.length > 0);
const subnavItems = groups.map((g) => ({ label: g.label, href: `#${g.id}` }));
const schema = faqPageSchema(groups.flatMap((g) => g.items));
---

<BaseLayout title="Frequently asked questions · Reach Subsea" motion>
  <Header overlay />
  <main id="main">
    <PageHero
      style="text"
      background="navy"
      breadcrumb={[{ label: 'Home', href: base }, { label: 'FAQ' }]}
      title="Frequently asked questions"
      lead="Answers to what we are asked most, organised by topic."
    />

    <SectionSubnav source="in-page" label="FAQ topics" items={subnavItems} hideOnDesktop />

    <FaqIndex groups={groups} />

    <CtaBand
      style="panel"
      background="tint"
      title="Still have a question?"
      text="Reach out to us today."
      actions={[{ label: 'Contact us', url: '/contact/', action: 'page' }]}
    />
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Footer />
</BaseLayout>
