---
// Reach Remote render test (9 Oct 2026): does the 3D World's Reach Remote model hold up at hero scale on the
// site's navy, next to the brochure's studio renders? If it does, the Reach Remote page opens on this stage and
// pins it for a scroll-driven walk-around of the vessel's features. Model: public/models/reach-remote-lod0–2.glb
// (reach-world/glb, Draco). Viewer: src/scripts/reach-remote-stage.ts. Brochure renders: public/review/.
//
// The tour (9 Oct 2026, Q167): the stage is pinned and six chapters scroll past behind it, deck to keel to ROV.
// Each chapter carries its camera key (`cam`: distance, elevation, azimuth in the launch's convention where
// 0 = starboard beam and +π/2 = ahead of the bow, the target on the hull in the holder's frame with the waterline
// at y = 0 and the bow at +X, and the composition shift), its text and spec rows, and its points: the brochure
// p7's labels, each anchored to a place on the model. The last chapter is the launch scrubber, driven by the
// same scroll. Without JS or with reduced motion the chapters read as a plain list under the stage (`?static=1`
// shows that fallback for review).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/Footer.astro';
import FilterChip from '../components/FilterChip.astro';
import SpecRow from '../components/SpecRow.astro';

const base = import.meta.env.BASE_URL;

interface Point {
  id: string;
  /** The card's eyebrow (the feature) and its one short line (the fact) */
  label: string;
  line: string;
  /** Holder frame (x along the hull, bow +X; y above the waterline; z to starboard), or `tms` / `rov` for the launch's moving parts */
  anchor: [number, number, number] | 'tms' | 'rov';
  /** Label offset from the marker, px */
  dx?: number;
  dy?: number;
  /** The side the card prefers (it still moves when that side runs off the stage) */
  side?: 'left' | 'right';
}
interface Chapter {
  id: string;
  eyebrow: string;
  title: string;
  text: string;
  /** dist, elev, az, tx, ty, tz, shift. The launch chapter has none: the launch's own camera takes over */
  cam?: [number, number, number, number, number, number, number];
  runs?: number;
  specs: { label: string; value: string; point?: string }[];
  points: Point[];
}

/** The brochure's main particulars (REA25 2595 170, A5): the size group under the tour */
const particulars = [
  { label: 'Length', value: '23.9 m' },
  { label: 'Breadth', value: '8.0 m' },
  { label: 'Max speed', value: '11 knots' },
  { label: 'Endurance', value: 'Min. 30 days' },
];
/** Dimension lines drawn on the model at the deck chapter (holder frame endpoints, the label at the midpoint) */
const dims = [
  { id: 'length', chapter: 1, order: 0, label: '23.9 m', a: [-11.95, 0.3, -5.8], b: [11.95, 0.3, -5.8] },
  { id: 'breadth', chapter: 1, order: 1, label: '8.0 m', a: [7.5, 2.6, -4.3], b: [7.5, 2.6, 4.3] },
];

// Measured on the model (9 Oct 2026, holder frame): hull x −13.4 (stern) … +13.4 (bow); deckhouse roof 4.4 m above the
// waterline from x −5 to +6; foredeck and aft deck 2.0 m; the forward lattice mast with the radar at x ≈ 7.3 (9–10.3 m up);
// the satellite dome at x ≈ −5.5 (10.6 m up); the A-frame over the stern at x ≈ −6.5 (8.7 m up). Under the hull, from
// reach-remote-propulsion.js: thrusters at x +9.1 and −8.5 with hubs 0.85 m under the keel (keel −2.1); the gondola from
// x −4.35 to +4.15 with its pods 2.95 m under the keel and the profiler bar across its front at y −4.6.
const chapters: Chapter[] = [
  {
    id: 'deck',
    eyebrow: 'Deck, drone and tools',
    title: 'Drone and tools on deck',
    text: 'A drone on the foredeck, tool garages for the ROV’s skids, and a launch system rated for three-metre seas.',
    cam: [45, 0.55, 2.45, 3, 3, 0, 0.1],
    specs: [
      { label: 'Drone', value: 'Foredeck capacity', point: 'drone' },
      { label: 'Tool garages', value: 'Two, for mission skids' },
      { label: 'Launch system', value: '8.6 t lift, seas to 3 m' },
    ],
    points: [{ id: 'drone', label: 'Drone deck', line: 'Foredeck capacity for a drone', anchor: [9.5, 3.0, 0], dx: 28, dy: -32, side: 'left' }],
  },
  {
    id: 'connected',
    eyebrow: 'Communications and awareness',
    title: 'Always connected',
    text: 'Redundant carriers keep the vessel in touch, and radar, cameras and AIS give shore the bridge’s view.',
    cam: [40, 0.22, 2.97, 2, 7, 0, 0.08],
    specs: [
      { label: 'Carriers', value: 'VSAT, Starlink ×2, Iridium, MBR, 5G, Pointlink', point: 'dome' },
      { label: 'Awareness', value: 'Radar, PTZ camera, AIS', point: 'radar' },
      { label: 'Positioning', value: 'Dual Seapath 380, DPS i4' },
    ],
    points: [
      { id: 'dome', label: 'Satellite dome', line: 'VSAT, Starlink, Iridium, 5G', anchor: [-5.5, 10.6, 0], dx: 28, dy: -24 },
      { id: 'radar', label: 'Radar and antennas', line: 'Radar, PTZ camera, AIS', anchor: [7.3, 10.3, 0], dx: 28, dy: -24 },
    ],
  },
  {
    id: 'onboard',
    eyebrow: 'Run from shore',
    title: 'Nobody on board',
    text: 'The master, navigator, ROV pilots and surveyors work from remote operations centres in Haugesund and Perth.',
    cam: [52, 0.25, 3.58, 0, 3, 0, 0.14],
    specs: [
      { label: 'Run from', value: 'Control rooms in Haugesund and Perth', point: 'shore' },
      { label: 'Autonomy', value: 'IMO degree three' },
      { label: 'Class', value: 'AROS notation, a world first' },
    ],
    points: [
      { id: 'shore', label: 'Run from shore', line: 'Control rooms in Haugesund and Perth', anchor: [0, 4.6, -3.6], dx: 28, dy: -30 },
      { id: 'lars-1', label: 'Launch and recovery', line: '8.6 t lift, seas to 3 m', anchor: [-6.5, 8.5, 0], dx: 28, dy: -20 },
    ],
  },
  {
    id: 'power',
    eyebrow: 'Power and propulsion',
    title: 'Hybrid power',
    text: 'Batteries and variable-speed gensets drive two azimuth thrusters, on up to 90% less fuel than a crewed vessel.',
    cam: [50, -0.32, 3.87, 0, -2, 0, 0.14],
    specs: [
      { label: 'Batteries', value: '2 × 369 kWh' },
      { label: 'Gensets', value: '2 × 441 kW' },
      { label: 'Thrusters', value: '2 × 350 kW azimuth', point: 'thruster-fwd' },
    ],
    points: [
      { id: 'thruster-fwd', label: 'Azimuth thruster', line: '2 × 350 kW', anchor: [9.1, -2.95, 0], dx: 28, dy: 24 },
      { id: 'thruster-aft', label: 'Hybrid plant', line: '2 × 369 kWh, 2 × 441 kW', anchor: [-3, -1.6, -3.9], dx: 28, dy: -40 },
    ],
  },
  {
    id: 'sensors',
    eyebrow: 'Survey sensors under the hull',
    title: 'Sensors in the keel',
    text: 'Multibeam and sub-bottom sensors in the gondola map the seabed to 500 m with no ROV in the water.',
    cam: [27, -0.8, 4.4, 0, -3.5, 0, 0.1],
    specs: [
      { label: 'Multibeam', value: 'Dual EM2040', point: 'mbes' },
      { label: 'Sub-bottom', value: 'Topas PS120', point: 'sbp' },
      { label: 'Positioning', value: 'HiPAP 502' },
    ],
    points: [
      { id: 'mbes', label: 'Multibeam', line: 'Dual EM2040', anchor: [-0.1, -4.95, -2.45], dx: 28, dy: 24 },
      { id: 'sbp', label: 'Sub-bottom profiler', line: 'Topas PS120', anchor: [3.6, -4.6, 0], dx: 28, dy: -24 },
    ],
  },
  {
    id: 'launch',
    eyebrow: 'Through the moonpool',
    title: 'The ROV goes to work',
    text: 'The TMS and ZEEROV lower out through the hull, then the electric work-class ROV flies off on its tether.',
    runs: 2,
    specs: [
      { label: 'ROV', value: 'ZEEROV, 115 kW electric', point: 'rov' },
      { label: 'Depth rating', value: '2,000 m' },
      { label: 'Tether', value: '330 m from the E-TMS', point: 'tms' },
    ],
    points: [
      { id: 'tms', label: 'E-TMS', line: '330 m tether', anchor: 'tms', dx: 72, dy: -56 },
      { id: 'rov', label: 'ZEEROV', line: '115 kW electric, rated to 2,000 m', anchor: 'rov', dx: 80, dy: 64 },
    ],
  },
];

const views = [
  { value: 'cover', label: 'Cover (port bow)' },
  { value: 'quarter', label: 'Port quarter' },
  { value: 'starboard', label: 'Starboard' },
  { value: 'stern', label: 'Stern' },
  { value: 'top', label: 'Top' },
];
const scenes = [
  { value: 'studio', label: 'Studio navy' },
  { value: 'sea', label: 'At sea (the 3D World)' },
];
const swells = [
  { value: '0.45', label: 'Calm' },
  { value: '0.6', label: 'Slight' },
  { value: '1', label: 'The world as it is' },
];
const brochure = [
  { src: 'reach-remote-brochure-cover.jpg', caption: 'Brochure cover render, port bow at the waterline' },
  { src: 'reach-remote-brochure-stern.jpg', caption: 'Brochure p7 render, dead astern with the six labels' },
  { src: 'reach-remote-brochure-top.jpg', caption: 'Brochure p2 render, plan view' },
];
---

<BaseLayout title="Reach Remote model · Review · Reach Subsea">
  <Header />
  <main id="main" class="rr-review">
    <div class="rr-review__intro container">
      <h1 class="text-h3">Reach Remote: the walk-around</h1>
      <p class="text-body">
        The 3D World's Reach Remote at sea, pinned while six chapters scroll past: the deck, the mast, the foredeck, then under the water
        to the thrusters and the survey gondola, and finally the ZeeROV launch. Scroll to walk round it; the brochure's labels appear on the
        model as each chapter arrives, and hovering a spec row lights its marker. The controls below the tour switch the scene, the sea
        state and the camera feel (follows the scroll, or snaps to each chapter).
      </p>
    </div>

    <section class="rr-tour" data-tour aria-label="Reach Remote walk-around">
      <div class="rr-tour__pin" data-tour-pin>
        <div class="rr-stage has-surface-navy" data-stage data-level="1" data-base={base}>
          <canvas class="rr-stage__canvas" aria-hidden="true"></canvas>
          <div class="rr-stage__scrim"></div>
          <div class="rr-stage__top-scrim"></div>
          <div class="rr-stage__hero container" data-stage-hero>
            <p class="text-eyebrow color-accent">Uncrewed surface vessel</p>
            <h2 class="text-h1">Reach Remote</h2>
            <p class="text-lead">A 24-metre vessel with nobody on board, flying a work-class ROV from a control room on shore.</p>
          </div>
          <div class="rr-points" data-tour-points aria-hidden="true">
            <svg class="rr-dims" aria-hidden="true">
              {dims.map((d) => (
                <g class="rr-dim" data-dim data-dim-id={d.id} data-chapter={d.chapter} data-order={d.order} data-a={d.a.join(',')} data-b={d.b.join(',')}>
                  <line class="rr-dim__line" data-dim-line />
                  <line class="rr-dim__line" data-dim-tick="a" />
                  <line class="rr-dim__line" data-dim-tick="b" />
                </g>
              ))}
            </svg>
            {dims.map((d) => (
              <span class="rr-dim__label text-label" data-dim-label={d.id}>{d.label}</span>
            ))}
            {chapters.map((c, ci) =>
              c.points.map((p, pi) => (
                <div
                  class="rr-point"
                  data-point
                  data-point-id={p.id}
                  data-chapter={ci + 1}
                  data-anchor={typeof p.anchor === 'string' ? p.anchor : p.anchor.join(',')}
                  data-dx={p.dx}
                  data-dy={p.dy}
                  data-side={p.side ?? 'right'}
                  data-order={pi}
                >
                  <div class="rr-point__body">
                    <span class="rr-point__leader" data-point-leader></span>
                    <span class="rr-point__marker"></span>
                    <span class="rr-point__label" data-point-label>
                      <span class="rr-point__name text-eyebrow color-accent">{p.label}</span>
                      <span class="rr-point__line text-small">{p.line}</span>
                    </span>
                  </div>
                </div>
              ))
            )}
          </div>
          <p class="rr-stage__status text-small" data-stage-status aria-live="polite">Loading…</p>
        </div>
        <div class="rr-tour__panel">
          <nav class="rr-tour__nav" aria-label="Tour progress">
            <ol class="rr-tour__ticks">
              {chapters.map((c) => (
                <li>
                  <button class="rr-tour__tick" type="button" data-tour-tick><span class="visually-hidden">{c.title}</span></button>
                </li>
              ))}
            </ol>
            <a class="rr-tour__skip text-label" href="#rr-after" data-tour-skip>Skip tour</a>
          </nav>
        </div>
      </div>

      <ol class="rr-tour__runway">
        <li class="rr-tour__chapter rr-tour__chapter--hero" data-tour-chapter="hero" style="--runs: 0.25"></li>
        {chapters.map((c) => (
          <li class="rr-tour__chapter" data-tour-chapter={c.id} data-cam={c.cam?.join(',')} style={`--runs: ${c.runs ?? 1}`} id={`rr-${c.id}`}>
            <div class="rr-tour__chapter-text">
              <p class="text-eyebrow">{c.eyebrow}</p>
              <h2 class="text-h3">{c.title}</h2>
              <p class="text-body">{c.text}</p>
            </div>
            <dl class="rr-tour__chapter-specs">
              {c.specs.map((s) => (
                <SpecRow label={s.label} value={s.value} />
              ))}
            </dl>
          </li>
        ))}
      </ol>
    </section>
    <section id="rr-after" class="rr-numbers has-surface-navy" aria-labelledby="rr-numbers-title">
      <div class="rr-numbers__inner container">
      <h2 id="rr-numbers-title" class="text-h3">The vessel in numbers</h2>
      <div class="rr-numbers__groups">
        <div class="rr-numbers__group">
          <h3 class="text-h5">The vessel</h3>
          <dl class="rr-numbers__rows">
            {particulars.map((sp) => (
              <SpecRow label={sp.label} value={sp.value} />
            ))}
          </dl>
        </div>
        {chapters.map((c) => (
          <div class="rr-numbers__group">
            <h3 class="text-h5">{c.title}</h3>
            <dl class="rr-numbers__rows">
              {c.specs.map((sp) => (
                <SpecRow label={sp.label} value={sp.value} />
              ))}
            </dl>
          </div>
        ))}
      </div>
      </div>
    </section>

    <div class="rr-review__controls container">
      <div class="rr-review__group">
        <p class="text-eyebrow">Camera feel</p>
        <div class="rr-review__chips">
          <FilterChip label="Follows the scroll" selected data-stage-feel="follow" />
          <FilterChip label="Snaps per chapter" data-stage-feel="snap" />
        </div>
      </div>
      <div class="rr-review__group">
        <p class="text-eyebrow">Fact cards</p>
        <div class="rr-review__chips">
          <FilterChip label="Navy at 88%" selected data-stage-card="overlay" />
          <FilterChip label="Solid navy" data-stage-card="solid" />
        </div>
      </div>
      <div class="rr-review__group">
        <p class="text-eyebrow">Scene</p>
        <div class="rr-review__chips">
          {scenes.map((v) => <FilterChip label={v.label} selected={v.value === 'sea'} data-stage-scene={v.value} />)}
        </div>
      </div>
      <div class="rr-review__group">
        <p class="text-eyebrow">Sea state</p>
        <div class="rr-review__chips">
          {swells.map((v) => <FilterChip label={v.label} selected={v.value === '0.6'} data-stage-swell={v.value} />)}
        </div>
      </div>
      <div class="rr-review__group">
        <p class="text-eyebrow">Reflection</p>
        <div class="rr-review__chips">
          <FilterChip label="Vessel mirrored" selected data-stage-mirror="on" />
          <FilterChip label="Sky only (the world)" data-stage-mirror="off" />
        </div>
      </div>
      <div class="rr-review__group">
        <p class="text-eyebrow">Hero view</p>
        <div class="rr-review__chips">
          {views.map((v) => <FilterChip label={v.label} selected={v.value === 'cover'} data-stage-view={v.value} />)}
        </div>
      </div>
      <div class="rr-review__group">
        <p class="text-eyebrow">Idle motion</p>
        <div class="rr-review__chips">
          <FilterChip label="Sway (afloat)" selected data-stage-spin="sway" />
          <FilterChip label="Orbit" data-stage-spin="orbit" />
          <FilterChip label="Off" data-stage-spin="off" />
        </div>
      </div>
      <p class="rr-review__note text-small">Launch chapter: <span class="rr-review__chapter" data-stage-chapter>Ready</span></p>
    </div>

    <section class="rr-review__brochure container" aria-label="Brochure renders for comparison">
      <p class="text-eyebrow">For comparison: the brochure's studio renders</p>
      <ul class="rr-review__renders">
        {brochure.map((b) => (
          <li>
            <img src={`${base}review/${b.src}`} alt={b.caption} loading="lazy" />
            <p class="text-small">{b.caption}</p>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../scripts/reach-remote-stage.ts';
</script>

<style is:global>
  .rr-review {
    padding-top: var(--header-offset, 80px);
  }
  .rr-review__intro {
    display: grid;
    gap: var(--wp--preset--spacing--12);
    padding-block: var(--wp--preset--spacing--48);
    max-width: 880px;
    margin-inline: auto;
  }

  /* The stage: navy ground with a soft lighter centre, the canvas over it, hero text in the content column */
  .rr-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--wp--preset--color--navy-900);
    background-image: radial-gradient(ellipse 70% 60% at 58% 55%, var(--wp--preset--color--navy-800), transparent 70%);
  }
  .rr-stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
    cursor: grab;
  }
  .rr-stage__canvas:active {
    cursor: grabbing;
  }
  .rr-stage__hero {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--wp--preset--spacing--64);
    display: grid;
    gap: var(--wp--preset--spacing--16);
    pointer-events: none;
  }
  /* At sea the text sits on daylight: a navy scrim rises from the stage's foot, like the photo heroes' tint */
  .rr-stage__scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: 70%;
    background-image: linear-gradient(to top, var(--wp--preset--color--navy-900) 0%, transparent 100%);
    opacity: 0;
    pointer-events: none;
  }
  .rr-stage.is-at-sea .rr-stage__scrim {
    opacity: 0.85;
    transition: opacity 0.6s var(--wp--custom--motion--ease-in-out);
  }
  /* On the tour the card carries the words, so the picture keeps its daylight to the foot */
  .rr-tour.is-live .rr-stage.is-at-sea.is-touring .rr-stage__scrim {
    opacity: 0.35;
  }
  .rr-stage__hero .text-h1 {
    max-width: 18ch;
    transform-origin: left top;
    transform: scale(calc(1 - var(--rr-rise, 0) * 0.3));
  }
  /* On the tour the eyebrow and title ride up to the stage's top and stay (scroll-driven: --rr-rise 0 → 1 over
     the first chapter's first half, --rr-rise-px measured by the script), the title at half size; the lead fades */
  .rr-stage {
    --rr-name-top: var(--wp--preset--spacing--40);
  }
  .rr-tour.is-live .rr-stage__hero {
    transform: translateY(calc(-1 * var(--rr-rise, 0) * var(--rr-rise-px, 0px)));
  }
  .rr-tour.is-live .rr-stage__hero .text-lead {
    opacity: calc(1 - min(1, var(--rr-rise, 0) * 2));
  }
  /* Eyebrows on the stage: the stronger sage (icon/accent), text/accent on navy is too pale over the picture */
  .rr-stage .text-eyebrow {
    color: var(--wp--custom--color--icon--accent);
  }
  .rr-stage__top-scrim {
    position: absolute;
    inset: 0 0 auto 0;
    height: 32%;
    background-image: linear-gradient(to bottom, var(--wp--preset--color--navy-900), transparent);
    opacity: calc(var(--rr-rise, 0) * 0.7);
    pointer-events: none;
  }
  .rr-stage__hero .text-lead {
    max-width: 34ch;
    color: var(--wp--custom--color--text--secondary);
  }
  .rr-stage__status {
    position: absolute;
    right: var(--wp--style--root--padding-right);
    bottom: var(--wp--preset--spacing--16);
    margin: 0;
    min-width: 20ch;
    text-align: right;
    color: var(--wp--custom--color--text--secondary);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  /* On the tour the readout only shows while something loads; the loaded sizes are review chrome, not page content */
  .rr-tour.is-live .rr-stage:not(.is-loading) .rr-stage__status {
    visibility: hidden;
  }
  @media (max-width: 899px) {
    .rr-stage {
      --rr-name-top: var(--wp--preset--spacing--24);
      aspect-ratio: 4 / 5;
    }
    .rr-stage__hero {
      bottom: var(--wp--preset--spacing--48);
    }
  }
  /* The stage's own ground only matters for the studio; at sea the scene paints the sky */
  .rr-stage.is-at-sea {
    background-image: none;
  }

  /* ── The tour ──────────────────────────────────────────────────────────────────────────────── */
  .rr-tour {
    position: relative;
  }
  .rr-tour__pin {
    position: relative;
  }
  /* Live (JS, no reduced motion): the pin holds the stage for the runway's length. The band is the viewport (the
     header overlays its top, as on the photo heroes); every chapter owns one run of scroll, the launch two. */
  .rr-tour.is-live,
  .rr-tour.is-live ~ .rr-numbers {
    --rr-band: max(640px, 100vh);
    --rr-run: clamp(360px, 55vh, 560px);
  }
  @supports (height: 100svh) {
    .rr-tour.is-live,
    .rr-tour.is-live ~ .rr-numbers {
      --rr-band: max(640px, 100svh);
    }
  }
  .rr-tour.is-live .rr-tour__pin {
    position: sticky;
    top: 0;
    /* Above the runway's chapters (positioned, later in the DOM), which would otherwise take the clicks meant for
       the dots and the skip */
    z-index: 1;
    height: var(--rr-band);
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
  }
  .rr-tour.is-live .rr-stage {
    aspect-ratio: auto;
    height: 100%;
  }
  .rr-tour__runway {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The runway starts under the pin's top and runs one band past its last chapter, so the pin holds (and the
     launch plays out) until that chapter's run is spent */
  .rr-tour.is-live .rr-tour__runway {
    margin-top: calc(var(--rr-band) * -1);
    padding-bottom: calc(var(--rr-band) * 2);
  }
  .rr-tour.is-live .rr-tour__chapter {
